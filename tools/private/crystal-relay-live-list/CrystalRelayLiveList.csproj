<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>CrystalRelayLiveList</AssemblyName>
    <Product>Crystal Relay Live List</Product>
    <Title>Crystal Relay Live Feedback</Title>
    <Description>Private Crystal Relay live feedback list viewer</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\..\VrcTwitchOscBridge\Assets\crystal-relay-icon.ico" Link="Assets\crystal-relay-icon.ico" />
    <Resource Include="..\..\..\VrcTwitchOscBridge\Assets\crystal-relay-icon.png" Link="Assets\crystal-relay-icon.png" />
    <None Include="live-list.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
