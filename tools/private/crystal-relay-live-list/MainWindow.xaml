<Window x:Class="CrystalRelayLiveList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Crystal Relay Live Feedback"
        Width="1180"
        Height="680"
        MinWidth="980"
        MinHeight="540"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#070A12"
        Icon="Assets/crystal-relay-icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F8F4FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#CDBEEE" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#E6F9FF" />
        <SolidColorBrush x:Key="DeepBrush" Color="#070A12" />
        <SolidColorBrush x:Key="PanelBrush" Color="#D0111422" />
        <SolidColorBrush x:Key="PanelStrongBrush" Color="#E5161028" />
        <SolidColorBrush x:Key="PanelInsetBrush" Color="#8A0C1020" />
        <SolidColorBrush x:Key="InputBrush" Color="#B9141830" />
        <SolidColorBrush x:Key="CyanBrush" Color="#7DF9FF" />
        <SolidColorBrush x:Key="VioletBrush" Color="#B388FF" />
        <SolidColorBrush x:Key="PinkBrush" Color="#FF78D8" />
        <SolidColorBrush x:Key="BorderBrush" Color="#725E9EFF" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#55436A93" />
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#130A1B" />

        <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#070A12" Offset="0" />
            <GradientStop Color="#120B22" Offset="0.4" />
            <GradientStop Color="#081527" Offset="0.72" />
            <GradientStop Color="#1B0B29" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ChromeBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1C1232" Offset="0" />
            <GradientStop Color="#10172B" Offset="0.55" />
            <GradientStop Color="#221135" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E0131028" Offset="0" />
            <GradientStop Color="#DD1B0D38" Offset="0.5" />
            <GradientStop Color="#D50B2138" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CrystalBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D97DF9FF" Offset="0" />
            <GradientStop Color="#D9B388FF" Offset="0.5" />
            <GradientStop Color="#D9FF78D8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OuterFrameBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B87DF9FF" Offset="0" />
            <GradientStop Color="#DE7DF9FF" Offset="0.18" />
            <GradientStop Color="#D5B388FF" Offset="0.5" />
            <GradientStop Color="#E0FF78D8" Offset="0.82" />
            <GradientStop Color="#B6FF78D8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InnerFrameBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#807DF9FF" Offset="0" />
            <GradientStop Color="#40325A84" Offset="0.32" />
            <GradientStop Color="#55382662" Offset="0.68" />
            <GradientStop Color="#90FF78D8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopFrameGlowBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#007DF9FF" Offset="0" />
            <GradientStop Color="#D87DF9FF" Offset="0.22" />
            <GradientStop Color="#85B388FF" Offset="0.54" />
            <GradientStop Color="#D8FF78D8" Offset="0.86" />
            <GradientStop Color="#00FF78D8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SideFrameGlowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#007DF9FF" Offset="0" />
            <GradientStop Color="#827DF9FF" Offset="0.2" />
            <GradientStop Color="#36436A93" Offset="0.5" />
            <GradientStop Color="#8AFF78D8" Offset="0.82" />
            <GradientStop Color="#00FF78D8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CrystalSweepBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#007DF9FF" Offset="0" />
            <GradientStop Color="#997DF9FF" Offset="0.22" />
            <GradientStop Color="#66B388FF" Offset="0.5" />
            <GradientStop Color="#99FF78D8" Offset="0.78" />
            <GradientStop Color="#00FF78D8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CrystalSoftSweepBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#007DF9FF" Offset="0" />
            <GradientStop Color="#447DF9FF" Offset="0.3" />
            <GradientStop Color="#30FF78D8" Offset="0.72" />
            <GradientStop Color="#00FF78D8" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentButtonBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F4F9FF" Offset="0" />
            <GradientStop Color="#A8F7FF" Offset="0.45" />
            <GradientStop Color="#F7B7FF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LivePillBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C87DF9FF" Offset="0" />
            <GradientStop Color="#CDB388FF" Offset="0.55" />
            <GradientStop Color="#CFFF78D8" Offset="1" />
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CrystalGlowEffect"
                          BlurRadius="24"
                          ShadowDepth="0"
                          Opacity="0.42"
                          Color="#B388FF" />

        <DropShadowEffect x:Key="OuterFrameGlowEffect"
                          BlurRadius="18"
                          ShadowDepth="0"
                          Opacity="0.38"
                          Color="#7DF9FF" />

        <DropShadowEffect x:Key="CyanGlowEffect"
                          BlurRadius="16"
                          ShadowDepth="0"
                          Opacity="0.34"
                          Color="#7DF9FF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="#332A1E48" />
                                <Setter TargetName="ChromeSurface" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeSurface" Property="Background" Value="#55411E68" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Background" Value="{StaticResource AccentButtonBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ButtonTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CrystalBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect" Value="{StaticResource CyanGlowEffect}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFFFFF" Offset="0" />
                                            <GradientStop Color="#C6FAFF" Offset="0.45" />
                                            <GradientStop Color="#FFD0FA" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Background" Value="#241A2441" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <Style x:Key="ViewModeRadioStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeSurface"
                                Background="#241A2441"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeSurface" Property="Background" Value="{StaticResource LivePillBrush}" />
                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="{StaticResource CrystalBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ButtonTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeSurface" Property="BorderBrush" Value="{StaticResource CrystalBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommandInputStyle" TargetType="TextBox">
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,4,8,0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetaPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Background" Value="#3515192E" />
            <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinHeight" Value="56" />
        </Style>

        <Style x:Key="CompactMetaPillStyle" TargetType="Border" BasedOn="{StaticResource MetaPillStyle}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <Style x:Key="SoundToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="SwitchTrack"
                                    Width="38"
                                    Height="22"
                                    VerticalAlignment="Center"
                                    Background="#4415192E"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <Border x:Name="SwitchThumb"
                                        Width="14"
                                        Height="14"
                                        Margin="4,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource MutedBrush}"
                                        CornerRadius="7" />
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource LivePillBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource CrystalBorderBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Background" Value="{StaticResource ButtonTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource CrystalBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            BorderBrush="{StaticResource OuterFrameBrush}"
            BorderThickness="2"
            Background="{StaticResource DeepBrush}"
            CornerRadius="18"
            Effect="{StaticResource OuterFrameGlowEffect}">
        <Border Margin="1"
                BorderBrush="{StaticResource InnerFrameBrush}"
                BorderThickness="1"
                Background="{StaticResource WindowBrush}"
                CornerRadius="16">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrystalSweepOne"
                                                           Storyboard.TargetProperty="Opacity"
                                                           BeginTime="0:0:0">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.8" Value="0.22" KeySpline="0.25,0.1 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:7.5" Value="0" KeySpline="0.4,0 0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="CrystalSweepOne"
                                             Storyboard.TargetProperty="(Canvas.Left)"
                                             From="-140"
                                             To="1040"
                                             Duration="0:0:7.5" />

                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrystalSweepTwo"
                                                           Storyboard.TargetProperty="Opacity"
                                                           BeginTime="0:0:3.4">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.2" Value="0.15" KeySpline="0.25,0.1 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:6.4" Value="0" KeySpline="0.4,0 0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="CrystalSweepTwo"
                                             Storyboard.TargetProperty="(Canvas.Left)"
                                             BeginTime="0:0:3.4"
                                             From="980"
                                             To="-180"
                                             Duration="0:0:6.4" />

                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TopLightRail"
                                                           Storyboard.TargetProperty="Opacity">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.58" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.6" Value="0.95" KeySpline="0.25,0.1 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:5.2" Value="0.58" KeySpline="0.4,0 0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BottomLightRail"
                                                           Storyboard.TargetProperty="Opacity"
                                                           BeginTime="0:0:1.1">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.42" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.7" Value="0.86" KeySpline="0.25,0.1 0.25,1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:5.4" Value="0.42" KeySpline="0.4,0 0.2,1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TopLeftFacet"
                                                           Storyboard.TargetProperty="Opacity"
                                                           BeginTime="0:0:0.4">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.62" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.98" />
                                <SplineDoubleKeyFrame KeyTime="0:0:5.0" Value="0.62" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BottomRightFacet"
                                                           Storyboard.TargetProperty="Opacity"
                                                           BeginTime="0:0:2.0">
                                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.58" />
                                <SplineDoubleKeyFrame KeyTime="0:0:2.4" Value="0.96" />
                                <SplineDoubleKeyFrame KeyTime="0:0:5.0" Value="0.58" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Border Grid.RowSpan="2"
                    Margin="8"
                    BorderBrush="#27385D83"
                    BorderThickness="1"
                    Visibility="{Binding IsDecorativeBackdropVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsHitTestVisible="False" />
            <Rectangle x:Name="TopLightRail"
                       Grid.RowSpan="2"
                       Height="2"
                       VerticalAlignment="Top"
                       Fill="{StaticResource TopFrameGlowBrush}"
                       Visibility="{Binding IsDecorativeBackdropVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                       IsHitTestVisible="False" />
            <Rectangle x:Name="BottomLightRail"
                       Grid.RowSpan="2"
                       Height="1"
                       VerticalAlignment="Bottom"
                       Fill="{StaticResource TopFrameGlowBrush}"
                       Opacity="0.72"
                       Visibility="{Binding IsDecorativeBackdropVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                       IsHitTestVisible="False" />
            <Rectangle Grid.RowSpan="2"
                       Width="1"
                       HorizontalAlignment="Left"
                       Fill="{StaticResource SideFrameGlowBrush}"
                       Opacity="0.86"
                       Visibility="{Binding IsDecorativeBackdropVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                       IsHitTestVisible="False" />
            <Rectangle Grid.RowSpan="2"
                       Width="1"
                       HorizontalAlignment="Right"
                       Fill="{StaticResource SideFrameGlowBrush}"
                       Opacity="0.86"
                       Visibility="{Binding IsDecorativeBackdropVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                       IsHitTestVisible="False" />

            <Grid Grid.RowSpan="2"
                  Visibility="{Binding IsDecorativeBackdropVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                  IsHitTestVisible="False">
                <Canvas ClipToBounds="True">
                    <Rectangle x:Name="CrystalSweepOne"
                               Canvas.Left="-140"
                               Canvas.Top="-130"
                               Width="4"
                               Height="920"
                               Fill="{StaticResource CrystalSweepBrush}"
                               Opacity="0"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="-37" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle x:Name="CrystalSweepTwo"
                               Canvas.Left="980"
                               Canvas.Top="-90"
                               Width="3"
                               Height="820"
                               Fill="{StaticResource CrystalSoftSweepBrush}"
                               Opacity="0"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="39" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
                <Polygon Points="0,0 210,0 78,130"
                         Fill="#171A2F54"
                         Stroke="#337DF9FF"
                         StrokeThickness="1" />
                <Polygon Points="980,0 808,0 980,158"
                         HorizontalAlignment="Right"
                         Fill="#1F3A1454"
                         Stroke="#44FF78D8"
                         StrokeThickness="1" />
                <Polygon Points="0,168 0,0 150,168"
                         VerticalAlignment="Bottom"
                         Fill="#180B263F"
                         Stroke="#33B388FF"
                         StrokeThickness="1" />
                <Polygon x:Name="TopLeftFacet"
                         Points="18,18 48,18 18,48"
                         Fill="#2F7DF9FF"
                         Stroke="#887DF9FF"
                         Opacity="0.62"
                         StrokeThickness="1" />
                <Polygon Points="962,18 932,18 962,48"
                         HorizontalAlignment="Right"
                         Fill="#30FF78D8"
                         Stroke="#88FF78D8"
                         StrokeThickness="1" />
                <Grid Width="42"
                      Height="42"
                      Margin="20,0,0,20"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom">
                    <Polygon Points="0,42 0,12 30,42"
                             Fill="#2CB388FF"
                             Stroke="#74B388FF"
                             StrokeThickness="1" />
                    <Polyline Points="0,42 42,42"
                              Stroke="#8A7DF9FF"
                              StrokeThickness="1.2" />
                </Grid>
                <Grid x:Name="BottomRightFacet"
                      Width="42"
                      Height="42"
                      Margin="0,0,20,20"
                         VerticalAlignment="Bottom"
                      HorizontalAlignment="Right"
                      Opacity="0.58">
                    <Polygon Points="42,42 42,12 12,42"
                             Fill="#2CFF78D8"
                             Stroke="#74FF78D8"
                             StrokeThickness="1" />
                    <Polyline Points="0,42 42,42"
                              Stroke="#8AFF78D8"
                              StrokeThickness="1.2" />
                </Grid>
            </Grid>

            <Border Grid.Row="0"
                    Background="{StaticResource ChromeBrush}"
                    CornerRadius="16,16,0,0" />

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="34"
                        Height="34"
                        Margin="14,0,10,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource PanelInsetBrush}"
                        BorderBrush="{StaticResource CrystalBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Image Width="24"
                           Height="24"
                           Source="Assets/crystal-relay-icon.png" />
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="Crystal Relay Live Feedback"
                               FontSize="15"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="Void Crystal stream heartbeat monitor"
                               Margin="0,1,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Content="_"
                            Click="OnMinimizeClicked" />
                    <Button Style="{StaticResource ChromeButtonStyle}"
                            Content="X"
                            Click="OnCloseClicked" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="314" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Padding="16,14"
                        Background="{StaticResource HeroBrush}"
                        BorderBrush="{StaticResource CrystalBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="104"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource LivePillBrush}"
                                    CornerRadius="999">
                                <TextBlock Text="LIVE WATCH"
                                           Foreground="{StaticResource ButtonTextBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           TextAlignment="Center" />
                            </Border>

                            <WrapPanel Grid.Column="1"
                                       Margin="18,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Width="148"
                                        Height="42"
                                        Margin="0,0,10,0"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Content="Refresh"
                                        IsEnabled="{Binding CanRefresh}"
                                        Click="OnRefreshClicked" />
                                <Border Width="150"
                                        Height="42"
                                        Margin="0,0,10,0"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource CompactMetaPillStyle}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Auto refresh"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="Every 5 minutes"
                                                   Margin="0,1,0,0"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold" />
                                    </StackPanel>
                                </Border>
                                <Border Width="198"
                                        Height="42"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource CompactMetaPillStyle}">
                                    <CheckBox Style="{StaticResource SoundToggleStyle}"
                                              Content="Live sound alert"
                                              IsChecked="{Binding SoundAlertsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Plays once when a streamer newly appears live." />
                                </Border>
                            </WrapPanel>
                        </Grid>

                        <StackPanel Grid.Row="1"
                                    Margin="0,12,0,0">
                            <TextBlock Text="{Binding ViewTitleText}"
                                       FontSize="30"
                                       FontWeight="Black"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,8,0,0"
                                        Orientation="Horizontal">
                                <RadioButton x:Name="LiveNowModeButton"
                                             GroupName="LiveListMode"
                                             Style="{StaticResource ViewModeRadioStyle}"
                                             Content="Live Now"
                                             IsChecked="True"
                                             Checked="OnShowLiveNowClicked" />
                                <RadioButton x:Name="HistoryModeButton"
                                             GroupName="LiveListMode"
                                             Style="{StaticResource ViewModeRadioStyle}"
                                             Content="24h History"
                                             Checked="OnShowHistoryClicked" />
                            </StackPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Margin="0,0,16,0"
                                           Text="{Binding ViewPrimaryStatusText}"
                                           Foreground="{StaticResource SoftTextBrush}"
                                           FontSize="14"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ViewSecondaryStatusText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Margin="0,12,0,0">
                    <Border Padding="28"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Visibility="{Binding IsLiveEmptyVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="1"
                                  Width="96"
                                  Height="96"
                                  HorizontalAlignment="Center"
                                  Effect="{StaticResource CyanGlowEffect}">
                                <Polygon Points="48,4 84,32 72,84 24,84 12,32"
                                         Fill="#33202A46"
                                         Stroke="{StaticResource CrystalBorderBrush}"
                                         StrokeThickness="1.4" />
                                <Polygon Points="48,12 68,34 48,76 28,34"
                                         Fill="#44436A93"
                                         Stroke="#777DF9FF"
                                         StrokeThickness="1" />
                            </Grid>
                            <StackPanel Grid.Row="2"
                                        Margin="0,18,0,0"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="No Crystal Relay users are live right now"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding LastUpdatedText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsLiveViewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="284"
                                            MinHeight="178"
                                            Margin="0,0,14,14"
                                            Padding="16"
                                            Background="{StaticResource PanelStrongBrush}"
                                            BorderBrush="{StaticResource CrystalBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayName}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="19"
                                                           FontWeight="Black"
                                                           TextWrapping="Wrap" />
                                                <Border Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        Padding="8,4"
                                                        VerticalAlignment="Top"
                                                        Background="{StaticResource LivePillBrush}"
                                                        CornerRadius="999">
                                                    <TextBlock Text="LIVE"
                                                               Foreground="{StaticResource ButtonTextBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Margin="0,12,0,0"
                                                    Padding="10,7"
                                                    Background="{StaticResource PanelInsetBrush}"
                                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <TextBlock Text="{Binding TwitchUrl}"
                                                           Foreground="{StaticResource CyanBrush}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                            </Border>

                                            <TextBlock Grid.Row="2"
                                                       Margin="0,12,0,14"
                                                       Text="{Binding DetailText}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" />

                                            <WrapPanel Grid.Row="3">
                                                <Button Width="88"
                                                        Margin="0,0,8,0"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Content="View"
                                                        Tag="{Binding TwitchUrl}"
                                                        Click="OnViewStreamClicked" />
                                                <Button Width="126"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Content="Open Stream"
                                                        Tag="{Binding TwitchUrl}"
                                                        Click="OnOpenStreamClicked" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Padding="28"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Visibility="{Binding IsHistoryEmptyVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="1"
                                  Width="96"
                                  Height="96"
                                  HorizontalAlignment="Center"
                                  Effect="{StaticResource CyanGlowEffect}">
                                <Polygon Points="48,4 84,32 72,84 24,84 12,32"
                                         Fill="#33202A46"
                                         Stroke="{StaticResource CrystalBorderBrush}"
                                         StrokeThickness="1.4" />
                                <Polygon Points="48,12 68,34 48,76 28,34"
                                         Fill="#44436A93"
                                         Stroke="#777DF9FF"
                                         StrokeThickness="1" />
                            </Grid>
                            <StackPanel Grid.Row="2"
                                        Margin="0,18,0,0"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="No live history in the last 24 hours"
                                           Foreground="{StaticResource TextBrush}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,7,0,0"
                                           Text="{Binding HistoryStatusText}"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsHistoryViewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,12"
                                       Text="{Binding HistoryStatusText}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding HistoryEntries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="284"
                                                MinHeight="214"
                                                Margin="0,0,14,14"
                                                Padding="16"
                                                Background="{StaticResource PanelStrongBrush}"
                                                BorderBrush="{StaticResource CrystalBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               Foreground="{StaticResource TextBrush}"
                                                               FontSize="19"
                                                               FontWeight="Black"
                                                               TextWrapping="Wrap" />
                                                    <Border Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            Padding="8,4"
                                                            VerticalAlignment="Top"
                                                            Background="#3515192E"
                                                            BorderBrush="{StaticResource SubtleBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="999">
                                                        <TextBlock Text="24H"
                                                                   Foreground="{StaticResource CyanBrush}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold" />
                                                    </Border>
                                                </Grid>

                                                <Border Grid.Row="1"
                                                        Margin="0,12,0,0"
                                                        Padding="10,7"
                                                        Background="{StaticResource PanelInsetBrush}"
                                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10">
                                                    <TextBlock Text="{Binding TwitchUrl}"
                                                               Foreground="{StaticResource CyanBrush}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                </Border>

                                                <TextBlock Grid.Row="2"
                                                           Margin="0,12,0,14"
                                                           Text="{Binding DetailText}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" />

                                                <WrapPanel Grid.Row="3">
                                                    <Button Margin="0,0,8,0"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Content="Open Channel"
                                                            Tag="{Binding TwitchUrl}"
                                                            Click="OnOpenStreamClicked" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="Open VODs"
                                                            Tag="{Binding VodUrl}"
                                                            Click="OnOpenVodsClicked" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Padding="14"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource CrystalBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Visibility="{Binding IsStreamViewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding StreamViewerTitleText}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="20"
                                               FontWeight="Black"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding StreamViewerStatusText}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <WrapPanel Grid.Column="1"
                                           Margin="14,0,0,0"
                                           HorizontalAlignment="Right">
                                    <Button Width="130"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Content="Back to List"
                                            Click="OnBackToLiveListClicked" />
                                    <Button Width="142"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Content="Clear Twitch Login"
                                            Click="OnClearTwitchLoginClicked" />
                                    <Button Width="126"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Content="Open Stream"
                                            Tag="{Binding CurrentStreamTwitchUrl}"
                                            Click="OnOpenStreamClicked" />
                                </WrapPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="{StaticResource DeepBrush}"
                                    BorderBrush="{StaticResource SubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    ClipToBounds="True">
                                <wv2:WebView2 x:Name="StreamWebView" />
                            </Border>

                            <TextBlock Grid.Row="2"
                                       Margin="0,10,0,0"
                                       Text="Twitch sign-in and chat stay inside this dev tool profile."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        Padding="14"
                        Background="{StaticResource PanelStrongBrush}"
                        BorderBrush="{StaticResource CrystalBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="!screm Commands"
                                       FontSize="20"
                                       FontWeight="Black" />
                            <TextBlock Margin="0,5,0,10"
                                       Text="Fill values, copy, then paste into Twitch chat."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" />
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Content="Randomize values"
                                    Click="OnRandomizeCommandsClicked" />
                            <TextBlock Margin="0,8,0,10"
                                       Text="{Binding CommandCopyStatus}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Margin="0,0,0,10"
                                        Padding="10"
                                        Background="{StaticResource PanelInsetBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="grow / shrink"
                                                   FontWeight="Bold" />
                                        <WrapPanel Margin="0,5,0,0">
                                            <StackPanel>
                                                <TextBlock Text="meters" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <TextBox x:Name="GrowMetersBox" Text="0.25" Style="{StaticResource CommandInputStyle}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="seconds" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <TextBox x:Name="GrowSecondsBox" Text="30" Style="{StaticResource CommandInputStyle}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="transition" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <TextBox x:Name="GrowTransitionBox" Text="1" Style="{StaticResource CommandInputStyle}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Margin="0,0,8,0"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Content="Copy grow"
                                                    Tag="grow"
                                                    Click="OnCopyDevCommandClicked" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Content="Copy shrink"
                                                    Tag="shrink"
                                                    Click="OnCopyDevCommandClicked" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,10"
                                        Padding="10"
                                        Background="{StaticResource PanelInsetBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="scalerandom"
                                                   FontWeight="Bold" />
                                        <WrapPanel Margin="0,5,0,0">
                                            <StackPanel>
                                                <TextBlock Text="min" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <TextBox x:Name="ScaleRandomMinBox" Text="0.8" Style="{StaticResource CommandInputStyle}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="max" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <TextBox x:Name="ScaleRandomMaxBox" Text="2.0" Style="{StaticResource CommandInputStyle}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="seconds" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <TextBox x:Name="ScaleRandomSecondsBox" Text="20" Style="{StaticResource CommandInputStyle}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <Button Margin="0,8,0,0"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Content="Copy scalerandom"
                                                Tag="scalerandom"
                                                Click="OnCopyDevCommandClicked" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,10"
                                        Padding="10"
                                        Background="{StaticResource PanelInsetBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="move"
                                                   FontWeight="Bold" />
                                        <WrapPanel Margin="0,5,0,0">
                                            <StackPanel Margin="0,4,8,0">
                                                <TextBlock Text="direction" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <ComboBox x:Name="MoveDirectionBox"
                                                          Width="110"
                                                          Height="30"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="forward" />
                                                    <ComboBoxItem Content="back" />
                                                    <ComboBoxItem Content="left" />
                                                    <ComboBoxItem Content="right" />
                                                    <ComboBoxItem Content="jump" />
                                                    <ComboBoxItem Content="spinleft" />
                                                    <ComboBoxItem Content="spinright" />
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="seconds" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <TextBox x:Name="MoveSecondsBox" Text="5" Style="{StaticResource CommandInputStyle}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <Button Margin="0,8,0,0"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Content="Copy move"
                                                Tag="move"
                                                Click="OnCopyDevCommandClicked" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,10"
                                        Padding="10"
                                        Background="{StaticResource PanelInsetBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="moverandom"
                                                   FontWeight="Bold" />
                                        <WrapPanel Margin="0,5,0,0">
                                            <StackPanel>
                                                <TextBlock Text="seconds" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <TextBox x:Name="MoveRandomSecondsBox" Text="12" Style="{StaticResource CommandInputStyle}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <Button Margin="0,8,0,0"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Content="Copy moverandom"
                                                Tag="moverandom"
                                                Click="OnCopyDevCommandClicked" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="10"
                                        Background="{StaticResource PanelInsetBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="firesale"
                                                   FontWeight="Bold" />
                                        <WrapPanel Margin="0,5,0,0">
                                            <StackPanel>
                                                <TextBlock Text="percent" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <TextBox x:Name="FireSalePercentBox" Text="25" Style="{StaticResource CommandInputStyle}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="seconds" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                                <TextBox x:Name="FireSaleSecondsBox" Text="120" Style="{StaticResource CommandInputStyle}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <Button Margin="0,8,0,0"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Content="Copy firesale"
                                                Tag="firesale"
                                                Click="OnCopyDevCommandClicked" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        </Border>
    </Border>
</Window>
