<Window x:Class="VrcTwitchOscBridge.AvatarSwapManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VrcTwitchOscBridge.Services"
        xmlns:vm="clr-namespace:VrcTwitchOscBridge.ViewModels"
        xmlns:models="clr-namespace:VrcTwitchOscBridge.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:VrcTwitchOscBridge"
        xmlns:conv="clr-namespace:VrcTwitchOscBridge.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AvatarSwapManagerViewModel}"
        Title="{loc:Translate 'Avatar Swap'}"
        Icon="Assets/crystal-relay-icon.ico"
        Width="1040"
        Height="680"
        MinWidth="780"
        MinHeight="520"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource BodyFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <local:CollapseChevronTextConverter x:Key="CollapseChevronTextConverter" />
        <local:CollapseChevronColorConverter x:Key="CollapseChevronColorConverter" />
        <conv:ReturnAvatarModeToVisibilityConverter x:Key="ReturnAvatarModeToVisibilityConverter" />

        <DataTemplate x:Key="AvatarSwapCardTemplate" DataType="{x:Type vm:AvatarSwapCardViewModel}">
            <Border Width="240" Height="200" Margin="0,0,10,10"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{Binding StatusStripeBrush}"
                    BorderThickness="3,1,1,1"
                    CornerRadius="12"
                    Padding="10"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding Profile}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="110" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource NestedPanelBrush}" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Image}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <TextBlock Text="&#x1F3AD;" FontSize="32" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="{loc:Translate 'Pick Avatar'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{Binding AvatarSubtitle}" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Bottom">
                        <Border Padding="6,2" Background="{DynamicResource AccentDimBrush}" CornerRadius="8" Margin="0,0,6,0">
                            <TextBlock Text="{Binding RuleCountText}" FontSize="10" Foreground="{DynamicResource TextBrush}" />
                        </Border>
                        <Border Padding="6,2" Background="{DynamicResource StatusChipBrush}" CornerRadius="8">
                            <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{DynamicResource TextBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="OnTitleBarMouseDown">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{loc:Translate 'Avatar Swap'}" Margin="14,0,0,0" VerticalAlignment="Center"
                           FontFamily="{DynamicResource HeadingFontFamily}" FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource TitleBarTextBrush}" />
                <Button DockPanel.Dock="Right" Content="&#x2715;" Width="32" Height="32"
                        Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource TitleBarTextBrush}"
                        Click="OnCloseClicked" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="14">
                <StackPanel>
                    <Border Background="{DynamicResource NestedPanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Return Avatar'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding ReturnAvatarDisplayName}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{loc:Translate 'Pick...'}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                        Command="{Binding PickReturnAvatarCommand}" />
                                <Button Content="{loc:Translate 'Use Current Avatar'}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,6,0"
                                        Command="{Binding UseCurrentAvatarForReturnCommand}" />
                                <Button Content="{loc:Translate 'Clear'}" Style="{DynamicResource SecondaryButtonStyle}"
                                        Command="{Binding ClearReturnAvatarCommand}" />
                            </StackPanel>
                            <TextBlock Text="{loc:Translate 'Pick the Return Avatar first so timed Avatar Swap and Avatar Roulette redeems know the exact VRChat avatar ID to switch back to.'}"
                                       FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasReturnAvatar, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0" Margin="0,0,0,10">
                        <StackPanel>
                            <Border Background="{DynamicResource NestedPanelBrush}" Padding="10,8" Cursor="Hand"
                                    MouseLeftButtonUp="OnChannelPointSectionHeaderClick">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="&#x1F381;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Translate 'Channel Point Swaps'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding ChannelPointSectionSuffix}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding IsChannelPointSectionCollapsed, Converter={StaticResource CollapseChevronTextConverter}}" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ChannelPointCardsView}" Margin="10,8,10,10"
                                          Visibility="{Binding IsChannelPointSectionCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AvatarSwapCardTemplate}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{loc:Translate 'New Swap'}" Margin="10,0,10,10" Padding="10,6"
                                    Style="{DynamicResource AccentButtonStyle}"
                                    Command="{Binding AddNewSwapCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                        <StackPanel>
                            <Border Background="{DynamicResource NestedPanelBrush}" Padding="10,8" Cursor="Hand"
                                    MouseLeftButtonUp="OnBitsSubsSectionHeaderClick">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="&#x1F48E;" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock Text="{loc:Translate 'Bits + Subs Swaps'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding BitsSubsSectionSuffix}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding IsBitsSubsSectionCollapsed, Converter={StaticResource CollapseChevronTextConverter}}" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                                </DockPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding BitsSubsCardsView}" Margin="10,8,10,10"
                                          Visibility="{Binding IsBitsSubsSectionCollapsed, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AvatarSwapCardTemplate}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Width="420" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource NestedPanelBrush}" Padding="12,10">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="{loc:Translate 'Edit Avatar Swap'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextBrush}" />
                            <Button DockPanel.Dock="Right" Content="&#x2715;" Width="24" Height="24" Background="Transparent" BorderBrush="Transparent"
                                    Foreground="{DynamicResource TextBrush}" Command="{Binding CloseEditorCommand}" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Target Avatar'}" FontWeight="Bold" Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}" />
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="{loc:Translate 'Browse...'}" Margin="6,0,0,0"
                                        Command="{Binding PickTargetAvatarCommand}" CommandParameter="{Binding SelectedProfile}" />
                                <TextBlock Text="{Binding EditorTargetAvatarName}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                            </DockPanel>
                            <Button Content="{loc:Translate 'Use Current Avatar'}" Margin="0,0,0,14" HorizontalAlignment="Left"
                                    Command="{Binding UseCurrentAvatarForTargetCommand}" CommandParameter="{Binding SelectedProfile}" />

                            <TextBlock Text="{loc:Translate 'Return Avatar'}" FontWeight="Bold" Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}" />
                            <ComboBox SelectedItem="{Binding EditorReturnMode}" ItemsSource="{Binding ReturnAvatarModes}" Margin="0,0,0,8" />
                            <StackPanel Visibility="{Binding EditorReturnMode, Converter={StaticResource ReturnAvatarModeToVisibilityConverter}, ConverterParameter=UseCustom}">
                                <TextBlock Text="{loc:Translate 'Custom Return Avatar'}" Margin="0,0,0,4" Foreground="{DynamicResource MutedBrush}" />
                                <TextBox Text="{Binding EditorReturnAvatarName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock Text="{loc:Translate 'Channel Point Swaps'}" FontWeight="Bold" Margin="0,14,0,4" Foreground="{DynamicResource TextBrush}" />
                            <ItemsControl ItemsSource="{Binding EditorChannelPointRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="8" Margin="0,4">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="&#x1F5D1;" Width="28" Height="24" Background="Transparent" BorderBrush="Transparent"
                                                        Command="{Binding DataContext.DeleteChannelPointRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource TextBrush}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{loc:Translate 'Bits + Subs Swaps'}" FontWeight="Bold" Margin="0,14,0,4" Foreground="{DynamicResource TextBrush}" />
                            <ItemsControl ItemsSource="{Binding EditorBitsSubsRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="8" Margin="0,4">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="&#x1F5D1;" Width="28" Height="24" Background="Transparent" BorderBrush="Transparent"
                                                        Command="{Binding DataContext.DeleteBitsSubsRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource TextBrush}" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{DynamicResource NestedPanelBrush}" Padding="12,10">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Left" Content="{loc:Translate 'Delete'}" Style="{DynamicResource DangerButtonStyle}" Padding="14,6"
                                    Command="{Binding DeleteSelectedProfileCommand}" />
                            <Button DockPanel.Dock="Right" Content="{loc:Translate 'Save'}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6"
                                    Command="{Binding SaveEditorCommand}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
