<Window x:Class="VrcTwitchOscBridge.AvatarSetsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VrcTwitchOscBridge.Services"
        xmlns:vm="clr-namespace:VrcTwitchOscBridge.ViewModels"
        xmlns:models="clr-namespace:VrcTwitchOscBridge.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:VrcTwitchOscBridge"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AvatarSetsManagerViewModel}"
        Title="{loc:Translate 'Avatar Sets Manager Title'}"
        Icon="Assets/crystal-relay-icon.ico"
        Width="1100"
        Height="700"
        MinWidth="800"
        MinHeight="500"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource BodyFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#130B1E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#CC1C132B" />
        <SolidColorBrush x:Key="PanelSecondaryBrush" Color="#C8241739" />
        <SolidColorBrush x:Key="NestedPanelBrush" Color="#B8241739" />
        <SolidColorBrush x:Key="BorderBrush" Color="#4B2B78" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A855F7" />
        <SolidColorBrush x:Key="RuleCardHoverBrush" Color="#8D56E8" />
        <SolidColorBrush x:Key="AccentDimBrush" Color="#552D1B47" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5EEFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#C9B8E3" />
        <SolidColorBrush x:Key="InputBrush" Color="#B8271A3D" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#5B3A8E" />
        <SolidColorBrush x:Key="ComboTextBrush" Color="#140C20" />
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#2C1C48" />
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#6942A7" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#20122F" />
        <SolidColorBrush x:Key="TitleBarTextBrush" Color="#F5EEFF" />
        <SolidColorBrush x:Key="TitleBarSubTextBrush" Color="#CBB9E5" />
        <SolidColorBrush x:Key="TitleBarButtonBrush" Color="#00000000" />
        <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#3B235B" />
        <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#543183" />
        <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#B43D62" />
        <SolidColorBrush x:Key="TitleBarClosePressedBrush" Color="#8C2648" />
        <SolidColorBrush x:Key="StatusStripeReadyBrush" Color="#4ADE80" />
        <SolidColorBrush x:Key="StatusStripeWarnBrush" Color="#FBBF24" />
        <SolidColorBrush x:Key="StatusStripeOffBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="ModePillStandardBrush" Color="#6366F1" />
        <SolidColorBrush x:Key="ModePillWardrobeBrush" Color="#EC4899" />
        <SolidColorBrush x:Key="LiveTextReadyBrush" Color="#4ADE80" />
        <SolidColorBrush x:Key="LiveTextWarnBrush" Color="#FBBF24" />
        <SolidColorBrush x:Key="LiveTextOffBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="WarnBrush" Color="#7A4A1B" />
        <SolidColorBrush x:Key="WarnTextBrush" Color="#FBBF24" />
        <SolidColorBrush x:Key="WarnBorderBrush" Color="#A66A1F" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8D56E8" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#1A0E22" />
        <SolidColorBrush x:Key="ComboSurfaceBrush" Color="#F7F2FF" />
        <SolidColorBrush x:Key="ComboHighlightBrush" Color="#D8C2FF" />
        <SolidColorBrush x:Key="ComboDropButtonBrush" Color="#2C1C48" />
        <SolidColorBrush x:Key="ComboDropButtonHoverBrush" Color="#3F2D5C" />
        <SolidColorBrush x:Key="ComboDropButtonPressedBrush" Color="#553080" />
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#4B2B78" />
        <FontFamily x:Key="HeadingFontFamily">Constantia</FontFamily>
        <FontFamily x:Key="BodyFontFamily">Verdana</FontFamily>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:EnumBooleanConverter x:Key="EnumBooleanConverter" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <local:GuidToSelectedOutfitBrushConverter x:Key="GuidToSelectedOutfitBrushConverter" />
        <local:GuidToRuleNameConverter x:Key="GuidToRuleNameConverter" />
        <local:BoolToHorizontalAlignmentConverter x:Key="BoolToHorizontalAlignmentConverter" />
        <local:BoolToThicknessConverter x:Key="BoolToThicknessConverter" />
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <local:IsSelectedOutfitBrushMultiConverter x:Key="IsSelectedOutfitBrushMultiConverter" />
        <local:IsSelectedOutfitThicknessMultiConverter x:Key="IsSelectedOutfitThicknessMultiConverter" />
        <local:IsSelectedRuleBrushMultiConverter x:Key="IsSelectedRuleBrushMultiConverter" />
        <local:IsSelectedRuleThicknessMultiConverter x:Key="IsSelectedRuleThicknessMultiConverter" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="MinWidth" Value="48" />
        </Style>
        <Style x:Key="FloatModeChipButtonStyle" TargetType="Button" BasedOn="{StaticResource ChipButtonStyle}" />
        <Style x:Key="FilterChipToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome"
                                Margin="2"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="8" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ComboDropButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="{TemplateBinding Width}"
                  MinWidth="18"
                  Background="Transparent">
                <Border Background="{DynamicResource ScrollTrackBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8" />
                <Track x:Name="PART_Track"
                       Margin="2"
                       IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageUpCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageDownCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Template" Value="{DynamicResource VerticalScrollBarTemplate}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource ComboSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Margin="10,0,4,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{DynamicResource ComboTextBrush}"
                                                      IsHitTestVisible="False" />
                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{DynamicResource ComboBoxToggleButtonStyle}" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Margin="0,4,0,0"
                                            Padding="4"
                                            Background="{DynamicResource ComboSurfaceBrush}"
                                            TextElement.Foreground="{DynamicResource ComboTextBrush}"
                                            BorderBrush="{DynamicResource PopupBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource ComboSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="0,1"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter TextElement.Foreground="{DynamicResource ComboTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboHighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboHighlightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                                <Grid>
                                    <Border x:Name="CheckChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" />
                                    <Path x:Name="CheckMark"
                                          Width="12"
                                          Height="9"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 1 5 L 4.5 8 L 11 1"
                                          Stroke="White"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              ContentSource="Content" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource RuleCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="6,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource RuleCardHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource ComboDropButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DropButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,11,11,0">
                            <Path x:Name="DropArrow"
                                  Width="11"
                                  Height="7"
                                  Stretch="Fill"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 5.5 6 L 11 0"
                                  Stroke="{DynamicResource TextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AvatarSetCardTemplate: 280x320 card with 6px left status stripe -->
        <DataTemplate x:Key="AvatarSetCardTemplate" DataType="{x:Type vm:AvatarSetCardViewModel}">
            <Border Width="280"
                    Height="320"
                    Margin="0,0,12,12"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{Binding StatusStripeBrush}"
                    BorderThickness="6,1,1,1"
                    CornerRadius="14"
                    Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding OpenEditorCommand}" />
                </Border.InputBindings>
                <Grid x:Name="CardContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Hero image area -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource NestedPanelBrush}"
                            CornerRadius="10,10,0,0"
                            Margin="8,8,8,0">
                        <Grid>
                            <!-- Avatar image or placeholder -->
                            <Border CornerRadius="10"
                                    Margin="0"
                                    Background="{DynamicResource InputBrush}"
                                    Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Grid>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="🎭"
                                                   FontSize="40"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{loc:Translate 'Avatar Sets Card Pick Avatar'}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Image Source="{Binding Image}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- Emoji badge top-left -->
                            <Border Width="36"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    CornerRadius="10"
                                    Background="{DynamicResource AccentDimBrush}">
                                <TextBlock Text="🎯"
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- Toggle top-right (proper switch style) -->
                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="8"
                                    Width="44"
                                    Height="22"
                                    CornerRadius="11"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#6B7280" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                <Setter Property="Background" Value="#22C55E" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <ToggleButton IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  Cursor="Hand"
                                                  ToolTip="Enable/disable this avatar set">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <Ellipse Width="16"
                                             Height="16"
                                             Fill="White"
                                             IsHitTestVisible="False"
                                             VerticalAlignment="Center">
                                        <Ellipse.HorizontalAlignment>
                                            <Binding Path="IsEnabled" Converter="{StaticResource BoolToHorizontalAlignmentConverter}" />
                                        </Ellipse.HorizontalAlignment>
                                        <Ellipse.Margin>
                                            <Binding Path="IsEnabled" Converter="{StaticResource BoolToThicknessConverter}" />
                                        </Ellipse.Margin>
                                    </Ellipse>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Info panel -->
                    <StackPanel Grid.Row="1"
                                Margin="10,8,10,10">
                        <!-- Title + subtitle -->
                        <TextBlock Text="{Binding DisplayTitle}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayTitle}" />
                        <TextBlock Text="{Binding AvatarSubtitle}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"
                                   ToolTip="{Binding AvatarSubtitle}" />

                        <!-- Pills row -->
                        <WrapPanel Margin="0,8,0,0">
                            <!-- Count pill -->
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="8"
                                    Padding="6,2"
                                    Margin="0,0,4,0">
                                <TextBlock Text="{Binding CountPillText}"
                                           Foreground="{DynamicResource ComboTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold" />
                            </Border>
                            <!-- Mode pill -->
                            <Border Background="{Binding ModePillBrush}"
                                    CornerRadius="8"
                                    Padding="6,2"
                                    Margin="0,0,4,0">
                                <TextBlock Text="{Binding ModePillText}"
                                           Foreground="{DynamicResource ComboTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold" />
                            </Border>
                            <!-- Status pill -->
                            <Border Background="{Binding StatusStripeBrush}"
                                    CornerRadius="8"
                                    Padding="6,2"
                                    Margin="0,0,4,0">
                                <TextBlock Text="{Binding StatusPillText}"
                                           Foreground="{DynamicResource ComboTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold" />
                            </Border>
                            <!-- Master badge -->
                            <Border Background="{DynamicResource WarnBrush}"
                                    CornerRadius="8"
                                    Padding="6,2"
                                    Visibility="{Binding IsMaster, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{loc:Translate 'Avatar Sets Master Badge'}"
                                           Foreground="{DynamicResource WarnTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold" />
                            </Border>
                        </WrapPanel>

                        <!-- Bottom row: live text + buttons -->
                        <DockPanel Margin="0,8,0,0"
                                   LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding LiveText}"
                                       Foreground="{Binding LiveTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="6,3"
                                        FontSize="10"
                                        Content="{loc:Translate 'Avatar Sets Card Edit'}"
                                        Command="{Binding OpenEditorCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter TargetName="CardContent" Property="Opacity" Value="0.55" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Placeholder editor DataTemplate for AvatarTriggerProfile -->
        <!-- TODO: Move full editor DataTemplate from MainWindow.xaml in a follow-up task.
             For now this placeholder shows the name field. -->
        <DataTemplate x:Key="AvatarSetEditorTemplate" DataType="{x:Type models:AvatarTriggerProfile}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20">
                <StackPanel>
                    <TextBlock Text="{loc:Translate 'Avatar Sets Edit Avatar Set'}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,16" />

                    <!-- Step 1: Avatar picker (most prominent) -->
                    <Border Background="{DynamicResource NestedPanelBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Avatar Sets Step 1 Pick Avatar'}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Margin="0,0,0,10" />
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right"
                                        Content="{loc:Translate 'Browse...'}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{Binding DataContext.OpenAvatarPickerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="Profile" />
                                <TextBlock Text="{Binding AvatarDisplayName}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Margin="0,0,8,0"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{loc:Translate 'Use Current Avatar'}"
                                    Command="{Binding DataContext.UseCurrentVrChatAvatarForProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Name -->
                    <Border Background="{DynamicResource NestedPanelBrush}"
                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Avatar Sets Step 2 Name'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <!-- Step 3: Mode toggle (Make Set / Make Wardrobe) -->
                    <Border Background="{DynamicResource NestedPanelBrush}"
                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Avatar Sets Step 3 What Making'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <UniformGrid Columns="2">
                                <Button Margin="0,0,4,0"
                                        Padding="14,8"
                                        Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseWardrobeMode}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="🎁" FontSize="20" HorizontalAlignment="Center" />
                                        <TextBlock Text="{loc:Translate 'Avatar Sets Make Set'}"
                                                   FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="4,0,0,0"
                                        Padding="14,8"
                                        Command="{Binding DataContext.WardrobeModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UseWardrobeMode}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel>
                                        <TextBlock Text="👗" FontSize="20" HorizontalAlignment="Center" />
                                        <TextBlock Text="{loc:Translate 'Avatar Sets Make Wardrobe'}"
                                                   FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Step 4: Content based on mode -->
                    <Border Background="{DynamicResource NestedPanelBrush}"
                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,14">
                        <Grid>
                            <!-- Set Mode: Channel Point Rules with add/edit/delete -->
                            <StackPanel Visibility="{Binding UseWardrobeMode, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Translate 'Avatar Sets Step 4 Rules'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="+ Add Rule"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="8,4"
                                            FontSize="10"
                                            Command="{Binding DataContext.AddChannelPointRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ChannelPointRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    CornerRadius="8"
                                                    Padding="10,6"
                                                    Margin="0,0,0,4"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="OnRuleItemClicked"
                                                    Tag="{Binding}">
                                                <Border.BorderBrush>
                                                    <MultiBinding Converter="{StaticResource IsSelectedRuleBrushMultiConverter}">
                                                        <Binding Path="DataContext.SelectedAvatarRule" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </Border.BorderBrush>
                                                <Border.BorderThickness>
                                                    <MultiBinding Converter="{StaticResource IsSelectedRuleThicknessMultiConverter}">
                                                        <Binding Path="DataContext.SelectedAvatarRule" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </Border.BorderThickness>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1"
                                                            Margin="8,0,0,0"
                                                            Padding="6,1"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource StatusChipBrush}"
                                                            CornerRadius="8"
                                                            ToolTip="{loc:Translate 'Rule has paired rules that will be hidden while this one is on cooldown.'}"
                                                            Visibility="Collapsed">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasSpecialRuleLockouts}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{loc:Translate 'paired'}"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   FontSize="9"
                                                                   FontStyle="Italic" />
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Content="✕"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="6,2"
                                                            FontSize="10"
                                                            Margin="6,0,0,0"
                                                            Click="OnDeleteRuleClicked"
                                                            Tag="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Rule editor (visible when a rule is selected) -->
                                <Border Visibility="{Binding DataContext.SelectedAvatarRule, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}}"
                                        Background="{DynamicResource NestedPanelBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0,14,0,0">
                                    <StackPanel DataContext="{Binding DataContext.SelectedAvatarRule, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right"
                                                    Content="Test"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="10,4"
                                                    FontSize="10"
                                                    Command="{Binding DataContext.TestSelectedAvatarRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    ToolTip="Send a test trigger for the selected rule" />
                                            <TextBlock Text="Edit Rule"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Name"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="11"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8" />
                                        <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                  Content="Enabled"
                                                  Foreground="{DynamicResource TextBrush}"
                                                  Margin="0,0,0,8" />
                                         <!-- Reward Sync Mode: Manage and Create vs Link to listen only -->
                                         <TextBlock Text="Reward Sync Mode"
                                                    Foreground="{DynamicResource TextBrush}"
                                                    FontWeight="SemiBold"
                                                    FontSize="11"
                                                    Margin="0,0,0,4" />
                                         <TextBlock Text="Manage and Create: Crystal Relay creates the reward, hides/deletes it when not in use, and recycles to stay under the 50-reward limit. Link to listen only: use an existing reward, listen-only."
                                                    Foreground="{DynamicResource MutedBrush}"
                                                    FontSize="10"
                                                    TextWrapping="Wrap"
                                                    Margin="0,0,0,6" />
                                         <ComboBox SelectedValue="{Binding RewardSyncMode, UpdateSourceTrigger=PropertyChanged}"
                                                   SelectedValuePath="Tag"
                                                   Style="{StaticResource ComboBoxStyle}"
                                                   Margin="0,0,0,8">
                                             <ComboBoxItem Content="Manage and Create" Tag="{x:Static models:TwitchRewardSyncMode.CreateOrManage}" />
                                             <ComboBoxItem Content="Link to listen only" Tag="{x:Static models:TwitchRewardSyncMode.LinkExisting}" />
                                         </ComboBox>

                                          <!-- LinkExisting mode: pick an existing Twitch reward from the broadcaster's catalog -->
                                          <StackPanel Margin="0,0,0,8">
                                              <StackPanel.Style>
                                                  <Style TargetType="StackPanel">
                                                      <Setter Property="Visibility" Value="Collapsed" />
                                                      <Style.Triggers>
                                                          <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                                              <Setter Property="Visibility" Value="Visible" />
                                                          </DataTrigger>
                                                      </Style.Triggers>
                                                  </Style>
                                              </StackPanel.Style>
                                              <Grid>
                                                  <Grid.ColumnDefinitions>
                                                      <ColumnDefinition Width="*" />
                                                      <ColumnDefinition Width="Auto" />
                                                  </Grid.ColumnDefinitions>
                                                  <TextBlock Text="Existing Twitch Reward"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             FontSize="11"
                                                             Margin="0,0,0,4" />
                                                  <Button Grid.Column="1"
                                                          Content="↻"
                                                          ToolTip="Reload Twitch rewards"
                                                          Padding="6,2"
                                                          Margin="0,0,0,4"
                                                          Command="{Binding DataContext.LoadTwitchRewardsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Style="{StaticResource SecondaryButtonStyle}" />
                                              </Grid>
                                              <ComboBox ItemsSource="{Binding DataContext.AvailableTwitchRewards, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        SelectedValue="{Binding ChannelPointRewardId, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedValuePath="Id"
                                                        DisplayMemberPath="Title"
                                                        IsEditable="False"
                                                        Margin="0,0,0,4" />
                                              <TextBlock Text="{Binding DataContext.TwitchRewardsLoadStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Foreground="{DynamicResource MutedBrush}"
                                                         FontSize="10"
                                                         Margin="0,0,0,4" />
                                              <TextBlock Text="Reward ID (auto-filled when selected)"
                                                         Foreground="{DynamicResource MutedBrush}"
                                                         FontSize="10"
                                                         Margin="0,0,0,2" />
                                              <TextBox Text="{Binding ChannelPointRewardId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="{DynamicResource NestedPanelBrush}" />
                                          </StackPanel>

                                          <!-- CreateOrManage mode: title + cost + delete-when-inactive (no reward ID — auto-named from rule) -->
                                          <StackPanel Margin="0,0,0,8">
                                              <StackPanel.Style>
                                                  <Style TargetType="StackPanel">
                                                      <Setter Property="Visibility" Value="Collapsed" />
                                                      <Style.Triggers>
                                                          <DataTrigger Binding="{Binding UsesCreateOrManageReward}" Value="True">
                                                              <Setter Property="Visibility" Value="Visible" />
                                                          </DataTrigger>
                                                      </Style.Triggers>
                                                  </Style>
                                              </StackPanel.Style>
                                              <TextBlock Text="Crystal Relay will create this reward in Twitch and name it after the rule. The reward ID is assigned at runtime."
                                                         Foreground="{DynamicResource MutedBrush}"
                                                         FontSize="10"
                                                         TextWrapping="Wrap"
                                                         Margin="0,0,0,8" />

                                              <TextBlock Text="Reward Title"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         FontSize="11"
                                                         Margin="0,0,0,4" />
                                              <TextBox Text="{Binding ChannelPointRewardTitle, UpdateSourceTrigger=PropertyChanged}" />

                                              <TextBlock Text="Reward Cost"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         FontSize="11"
                                                         Margin="0,8,0,4" />
                                              <TextBox Text="{Binding ChannelPointRewardCost, UpdateSourceTrigger=PropertyChanged}" />

                                              <CheckBox IsChecked="{Binding DeleteManagedRewardWhenInactive, UpdateSourceTrigger=PropertyChanged}"
                                                        Content="Delete when inactive (cleanup on rule disable/delete, recycle if hitting 50-reward limit)"
                                                        Foreground="{DynamicResource TextBrush}"
                                                        FontSize="11"
                                                        Margin="0,12,0,0" />

                                              <!-- Reward Background Colors (Ready / Cooldown) -->
                                              <TextBlock Text="Reward Colors"
                                                         Foreground="{DynamicResource TextBrush}"
                                                         FontSize="11"
                                                         FontWeight="SemiBold"
                                                         Margin="0,12,0,4" />
                                              <TextBlock Text="Ready color = the reward's background when available. Cooldown color = the reward's background while the timer is running or it's been redeemed. Twitch shows these on the channel points page."
                                                         Foreground="{DynamicResource MutedBrush}"
                                                         FontSize="10"
                                                         TextWrapping="Wrap"
                                                         Margin="0,0,0,8" />

                                              <!-- Ready Color row -->
                                              <Grid Margin="0,0,0,6">
                                                  <Grid.ColumnDefinitions>
                                                      <ColumnDefinition Width="Auto" />
                                                      <ColumnDefinition Width="*" />
                                                      <ColumnDefinition Width="Auto" />
                                                      <ColumnDefinition Width="Auto" />
                                                  </Grid.ColumnDefinitions>
                                                  <Border Grid.Column="0"
                                                          Width="24" Height="24"
                                                          CornerRadius="4"
                                                          BorderBrush="{DynamicResource BorderBrush}"
                                                          BorderThickness="1"
                                                          Background="{Binding ManagedRewardReadyColorBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                                  <TextBox Grid.Column="1"
                                                           Text="{Binding ManagedRewardReadyColor, UpdateSourceTrigger=PropertyChanged}"
                                                           VerticalContentAlignment="Center"
                                                           ToolTip="Hex color in #RRGGBB format" />
                                                  <Button Grid.Column="2"
                                                          Content="Pick..."
                                                          Style="{StaticResource SecondaryButtonStyle}"
                                                          Margin="6,0,0,0"
                                                          Padding="8,4"
                                                          Click="OnPickReadyColorClicked"
                                                          Tag="{Binding}" />
                                                  <Button Grid.Column="3"
                                                          Content="Reset"
                                                          Style="{StaticResource SecondaryButtonStyle}"
                                                          Margin="4,0,0,0"
                                                          Padding="8,4"
                                                          Click="OnResetReadyColorClicked"
                                                          Tag="{Binding}"
                                                          ToolTip="Reset to default ready color" />
                                              </Grid>

                                              <!-- Cooldown Color row -->
                                              <Grid Margin="0,0,0,4">
                                                  <Grid.ColumnDefinitions>
                                                      <ColumnDefinition Width="Auto" />
                                                      <ColumnDefinition Width="*" />
                                                      <ColumnDefinition Width="Auto" />
                                                      <ColumnDefinition Width="Auto" />
                                                  </Grid.ColumnDefinitions>
                                                  <Border Grid.Column="0"
                                                          Width="24" Height="24"
                                                          CornerRadius="4"
                                                          BorderBrush="{DynamicResource BorderBrush}"
                                                          BorderThickness="1"
                                                          Background="{Binding ManagedRewardCooldownColorBrush}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,8,0" />
                                                  <TextBox Grid.Column="1"
                                                           Text="{Binding ManagedRewardCooldownColor, UpdateSourceTrigger=PropertyChanged}"
                                                           VerticalContentAlignment="Center"
                                                           ToolTip="Hex color in #RRGGBB format" />
                                                  <Button Grid.Column="2"
                                                          Content="Pick..."
                                                          Style="{StaticResource SecondaryButtonStyle}"
                                                          Margin="6,0,0,0"
                                                          Padding="8,4"
                                                          Click="OnPickCooldownColorClicked"
                                                          Tag="{Binding}" />
                                                  <Button Grid.Column="3"
                                                          Content="Reset"
                                                          Style="{StaticResource SecondaryButtonStyle}"
                                                          Margin="4,0,0,0"
                                                          Padding="8,4"
                                                          Click="OnResetCooldownColorClicked"
                                                          Tag="{Binding}"
                                                          ToolTip="Reset to default cooldown color" />
                                              </Grid>
                                          </StackPanel>

                                          <!-- Side-by-side: Active Time (left) + Twitch Cooldown (right, CreateOrManage only) -->
                                          <Grid Margin="0,8,0,8">
                                              <Grid.ColumnDefinitions>
                                                  <ColumnDefinition Width="*" />
                                                  <ColumnDefinition Width="8" />
                                                  <ColumnDefinition Width="*">
                                                      <ColumnDefinition.Style>
                                                          <Style TargetType="ColumnDefinition">
                                                              <Setter Property="Width" Value="*" />
                                                              <Style.Triggers>
                                                                  <DataTrigger Binding="{Binding UsesCreateOrManageReward}" Value="False">
                                                                      <Setter Property="Width" Value="0" />
                                                                  </DataTrigger>
                                                              </Style.Triggers>
                                                          </Style>
                                                      </ColumnDefinition.Style>
                                                  </ColumnDefinition>
                                              </Grid.ColumnDefinitions>

                                              <StackPanel Grid.Column="0">
                                                  <TextBlock Text="Active Time (seconds)"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             FontSize="11"
                                                             Margin="0,0,0,2" />
                                                  <TextBlock Text="0 = no timer (toggle: read current OSC value and flip it)"
                                                             Foreground="{DynamicResource MutedBrush}"
                                                             FontSize="9"
                                                             TextWrapping="Wrap"
                                                             Margin="0,0,0,4" />
                                                  <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                              </StackPanel>

                                              <StackPanel Grid.Column="2">
                                                  <StackPanel.Style>
                                                      <Style TargetType="StackPanel">
                                                          <Setter Property="Visibility" Value="Visible" />
                                                          <Style.Triggers>
                                                              <DataTrigger Binding="{Binding UsesCreateOrManageReward}" Value="False">
                                                                  <Setter Property="Visibility" Value="Collapsed" />
                                                              </DataTrigger>
                                                          </Style.Triggers>
                                                      </Style>
                                                  </StackPanel.Style>
                                                  <TextBlock Text="Twitch Cooldown (seconds)"
                                                             Foreground="{DynamicResource TextBrush}"
                                                             FontSize="11"
                                                             Margin="0,0,0,2" />
                                                  <TextBlock Text="0 = no cooldown (PATCH'd to Twitch on save)"
                                                             Foreground="{DynamicResource MutedBrush}"
                                                             FontSize="9"
                                                             TextWrapping="Wrap"
                                                             Margin="0,0,0,4" />
                                                  <TextBox Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                              </StackPanel>
                                          </Grid>

                                           <!-- Parameter Value (bool True/False) — only relevant for bool parameters -->
                                           <StackPanel Visibility="{Binding UsesBoolParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                               <TextBlock Text="Parameter Value"
                                                          Foreground="{DynamicResource TextBrush}"
                                                          FontSize="11"
                                                          Margin="0,8,0,4" />
                                               <UniformGrid Columns="2" Margin="0,0,0,8">
                                                   <Button Margin="0,0,2,0" Padding="8,4" FontSize="11" FontWeight="Bold"
                                                           Click="OnParameterValueTrueClicked"
                                                           Tag="{Binding}">
                                                       <Button.Style>
                                                           <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                               <Style.Triggers>
                                                                   <DataTrigger Binding="{Binding ParameterValue}" Value="True">
                                                                       <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                       <Setter Property="Foreground" Value="White" />
                                                                   </DataTrigger>
                                                                   <DataTrigger Binding="{Binding ParameterValue}" Value="true">
                                                                       <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                       <Setter Property="Foreground" Value="White" />
                                                                   </DataTrigger>
                                                               </Style.Triggers>
                                                           </Style>
                                                       </Button.Style>
                                                       <TextBlock Text="True" />
                                                   </Button>
                                                   <Button Margin="2,0,0,0" Padding="8,4" FontSize="11" FontWeight="Bold"
                                                           Click="OnParameterValueFalseClicked"
                                                           Tag="{Binding}">
                                                       <Button.Style>
                                                           <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                               <Style.Triggers>
                                                                   <DataTrigger Binding="{Binding ParameterValue}" Value="False">
                                                                       <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                       <Setter Property="Foreground" Value="White" />
                                                                   </DataTrigger>
                                                                   <DataTrigger Binding="{Binding ParameterValue}" Value="false">
                                                                       <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                       <Setter Property="Foreground" Value="White" />
                                                                   </DataTrigger>
                                                               </Style.Triggers>
                                                           </Style>
                                                       </Button.Style>
                                                       <TextBlock Text="False" />
                                                   </Button>
                                               </UniformGrid>
                                           </StackPanel>

                                            <!-- Int action inputs (mode selector + Min/Max or When/After) -->
                                            <StackPanel Margin="0,8,0,8"
                                                        Visibility="{Binding UsesIntParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                               <StackPanel Visibility="{Binding UsesIntInstantModeOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                   <TextBlock Text="{loc:Translate 'Instant Int Action'}"
                                                              Foreground="{DynamicResource TextBrush}"
                                                              FontWeight="SemiBold"
                                                              FontSize="11"
                                                              Margin="0,0,0,4" />
                                                   <ComboBox ItemsSource="{Binding DataContext.IntZeroDurationModes, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                                             SelectedItem="{Binding IntZeroDurationMode, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource ComboBoxStyle}"
                                                             Margin="0,0,0,8" />
                                                   <StackPanel Margin="0,0,0,8"
                                                               Visibility="{Binding UsesIntFixedInstantValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                                       <TextBlock Text="{loc:Translate 'Send This Number'}"
                                                                  Foreground="{DynamicResource TextBrush}"
                                                                  FontWeight="SemiBold"
                                                                  FontSize="11"
                                                                  Margin="0,0,0,4" />
                                                       <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                   </StackPanel>
                                                   <UniformGrid Columns="2" Margin="0,0,0,8"
                                                                Visibility="{Binding UsesIntRangeInputs, Converter={StaticResource BoolToVisibilityConverter}}">
                                                       <StackPanel Margin="0,0,4,0">
                                                           <TextBlock Text="{loc:Translate 'Minimum Number'}"
                                                                      Foreground="{DynamicResource TextBrush}"
                                                                      FontWeight="SemiBold"
                                                                      FontSize="11"
                                                                      Margin="0,0,0,4" />
                                                           <TextBox Text="{Binding RangeMinimum, UpdateSourceTrigger=PropertyChanged}" />
                                                       </StackPanel>
                                                       <StackPanel Margin="4,0,0,0">
                                                           <TextBlock Text="{loc:Translate 'Maximum Number'}"
                                                                      Foreground="{DynamicResource TextBrush}"
                                                                      FontWeight="SemiBold"
                                                                      FontSize="11"
                                                                      Margin="0,0,0,4" />
                                                           <TextBox Text="{Binding RangeMaximum, UpdateSourceTrigger=PropertyChanged}" />
                                                       </StackPanel>
                                                   </UniformGrid>
                                               </StackPanel>
                                               <StackPanel Visibility="{Binding UsesIntTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                                   <UniformGrid Columns="2" Margin="0,0,0,8">
                                                       <StackPanel Margin="0,0,4,0">
                                                           <TextBlock Text="{loc:Translate 'When Triggered, Set To'}"
                                                                      Foreground="{DynamicResource TextBrush}"
                                                                      FontWeight="SemiBold"
                                                                      FontSize="11"
                                                                      Margin="0,0,0,4" />
                                                           <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                       </StackPanel>
                                                       <StackPanel Margin="4,0,0,0">
                                                           <TextBlock Text="{loc:Translate 'After Active Time Ends, Set Back To'}"
                                                                      Foreground="{DynamicResource TextBrush}"
                                                                      FontWeight="SemiBold"
                                                                      FontSize="11"
                                                                      Margin="0,0,0,4" />
                                                           <TextBox Text="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                                       </StackPanel>
                                                   </UniformGrid>
                                               </StackPanel>
                                           </StackPanel>

                                           <TextBlock Text="{loc:Translate 'Parameter List Filter'}"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      FontSize="11"
                                                      Margin="0,4,0,6" />
                                         <UniformGrid Columns="4" Margin="0,0,0,8">
                                             <Button Margin="0,0,3,0" Padding="8,4" FontSize="10"
                                                     Command="{Binding DataContext.FilterAllCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                 <Button.Style>
                                                     <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding DataContext.ParameterTypeFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="All">
                                                                 <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                 <Setter Property="Foreground" Value="White" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Button.Style>
                                                 <TextBlock Text="All" />
                                             </Button>
                                             <Button Margin="3,0,3,0" Padding="8,4" FontSize="10"
                                                     Command="{Binding DataContext.FilterBoolCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                 <Button.Style>
                                                     <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding DataContext.ParameterTypeFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="Bool">
                                                                 <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                 <Setter Property="Foreground" Value="White" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Button.Style>
                                                 <TextBlock Text="Bool" />
                                             </Button>
                                             <Button Margin="3,0,3,0" Padding="8,4" FontSize="10"
                                                     Command="{Binding DataContext.FilterIntCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                 <Button.Style>
                                                     <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding DataContext.ParameterTypeFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="Int">
                                                                 <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                 <Setter Property="Foreground" Value="White" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                     </Style>
                                                 </Button.Style>
                                                 <TextBlock Text="Int" />
                                             </Button>
                                             <Button Margin="3,0,0,0" Padding="8,4" FontSize="10"
                                                     Command="{Binding DataContext.FilterFloatCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                  <Button.Style>
                                                      <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                          <Style.Triggers>
                                                              <DataTrigger Binding="{Binding DataContext.ParameterTypeFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="Float">
                                                                  <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                  <Setter Property="Foreground" Value="White" />
                                                              </DataTrigger>
                                                          </Style.Triggers>
                                                      </Style>
                                                  </Button.Style>
                                                  <TextBlock Text="Float" />
                                              </Button>
                                          </UniformGrid>

                                          <Border Background="{DynamicResource NestedPanelBrush}" CornerRadius="6" Padding="8" Margin="0,4,0,4"
                                                  Visibility="{Binding UsesFloatActionMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                              <StackPanel>
                                                   <TextBlock Text="{loc:Translate 'FloatActionModeHeader'}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                    <UniformGrid Columns="5">
                                                        <Button Content="{loc:Translate 'FloatActionModeSet'}" Click="OnFloatModeSetClicked" Tag="{x:Static models:FloatActionMode.Set}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FloatModeChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FloatActionMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Set}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="{loc:Translate 'FloatActionModeRandom'}" Click="OnFloatModeRandomClicked" Tag="{x:Static models:FloatActionMode.Random}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FloatModeChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FloatActionMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Random}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="{loc:Translate 'FloatActionModeAdd'}" Click="OnFloatModeAddClicked" Tag="{x:Static models:FloatActionMode.Add}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FloatModeChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FloatActionMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Add}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="{loc:Translate 'FloatActionModeSubtract'}" Click="OnFloatModeSubtractClicked" Tag="{x:Static models:FloatActionMode.Subtract}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FloatModeChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FloatActionMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Subtract}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="±" Click="OnFloatModeAddSubtractClicked" Tag="{x:Static models:FloatActionMode.AddSubtract}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FloatModeChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FloatActionMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=AddSubtract}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="{loc:Translate 'FloatActionModeMultiply'}" Click="OnFloatModeMultiplyClicked" Tag="{x:Static models:FloatActionMode.Multiply}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FloatModeChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FloatActionMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Multiply}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="{loc:Translate 'FloatActionModeToggle'}" Click="OnFloatModeToggleClicked" Tag="{x:Static models:FloatActionMode.Toggle}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FloatModeChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FloatActionMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Toggle}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="{loc:Translate 'FloatActionModeCycle'}" Click="OnFloatModeCycleClicked" Tag="{x:Static models:FloatActionMode.Cycle}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FloatModeChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FloatActionMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Cycle}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="{loc:Translate 'FloatActionModeGlitchy'}" Click="OnFloatModeGlitchyClicked" Tag="{x:Static models:FloatActionMode.Glitchy}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FloatModeChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FloatActionMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Glitchy}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="{loc:Translate 'FloatActionModePulse'}" Click="OnFloatModePulseClicked" Tag="{x:Static models:FloatActionMode.Pulse}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource FloatModeChipButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FloatActionMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Pulse}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="White" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </UniformGrid>

                                                    <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatSetMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{loc:Translate 'Send This Value'}" Foreground="{DynamicResource TextBrush}" />
                                                        <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <Grid Margin="0,6,0,0" Visibility="{Binding UsesFloatRangeInputs, Converter={StaticResource BoolToVisibilityConverter}}">
                                                       <Grid.ColumnDefinitions>
                                                           <ColumnDefinition Width="*" />
                                                           <ColumnDefinition Width="8" />
                                                           <ColumnDefinition Width="*" />
                                                       </Grid.ColumnDefinitions>
                                                       <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{loc:Translate 'FloatActionModeRangeMin'}" Foreground="{DynamicResource TextBrush}" />
                                                           <TextBox Text="{Binding FloatRangeMin, UpdateSourceTrigger=PropertyChanged}" />
                                                       </StackPanel>
                                                       <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{loc:Translate 'FloatActionModeRangeMax'}" Foreground="{DynamicResource TextBrush}" />
                                                           <TextBox Text="{Binding FloatRangeMax, UpdateSourceTrigger=PropertyChanged}" />
                                                       </StackPanel>
                                                   </Grid>

                                                   <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatCycleStep, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{loc:Translate 'FloatActionModeCycleStep'}" Foreground="{DynamicResource TextBrush}" />
                                                       <TextBox Text="{Binding FloatCycleStep, UpdateSourceTrigger=PropertyChanged}" />
                                                   </StackPanel>

                                                   <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatAddMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{loc:Translate 'FloatActionModeAddAmount'}" Foreground="{DynamicResource TextBrush}" />
                                                       <TextBox Text="{Binding FloatAddAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                   </StackPanel>
                                                   <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatSubtractMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{loc:Translate 'FloatActionModeSubtractAmount'}" Foreground="{DynamicResource TextBrush}" />
                                                       <TextBox Text="{Binding FloatSubtractAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                   </StackPanel>
                                                   <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatAddSubtractMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{loc:Translate 'FloatActionModeAddSubtractValue'}" Foreground="{DynamicResource TextBrush}" />
                                                       <TextBox Text="{Binding FloatAddSubtractAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                   </StackPanel>
                                                   <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatMultiplyMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{loc:Translate 'FloatActionModeMultiplyFactor'}" Foreground="{DynamicResource TextBrush}" />
                                                       <TextBox Text="{Binding FloatMultiplyFactor, UpdateSourceTrigger=PropertyChanged}" />
                                                   </StackPanel>

                                                  <Grid Margin="0,6,0,0" Visibility="{Binding UsesFloatToggleValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="*" />
                                                          <ColumnDefinition Width="8" />
                                                          <ColumnDefinition Width="*" />
                                                      </Grid.ColumnDefinitions>
                                                       <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{loc:Translate 'FloatActionModeToggleOn'}" Foreground="{DynamicResource TextBrush}" />
                                                           <TextBox Text="{Binding FloatToggleOnValue, UpdateSourceTrigger=PropertyChanged}" />
                                                       </StackPanel>
                                                       <StackPanel Grid.Column="2">
                                                            <TextBlock Text="{loc:Translate 'FloatActionModeToggleOff'}" Foreground="{DynamicResource TextBrush}" />
                                                           <TextBox Text="{Binding FloatToggleOffValue, UpdateSourceTrigger=PropertyChanged}" />
                                                       </StackPanel>
                                                  </Grid>

                                                   <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatGlitchyInterval, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{loc:Translate 'FloatActionModeGlitchyInterval'}" Foreground="{DynamicResource TextBrush}" />
                                                       <TextBox Text="{Binding FloatGlitchyIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                                   </StackPanel>

                                                   <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatPulseSeconds, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{loc:Translate 'FloatActionModePulseSeconds'}" Foreground="{DynamicResource TextBrush}" />
                                                       <TextBox Text="{Binding FloatPulseSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                   </StackPanel>

                                                   <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatClampMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{loc:Translate 'FloatActionModeClampLabel'}" Foreground="{DynamicResource TextBrush}" />
                                                       <ComboBox SelectedValue="{Binding FloatClampMode}" SelectedValuePath="Tag"
                                                                 Style="{StaticResource ComboBoxStyle}">
                                                           <ComboBoxItem Content="{loc:Translate 'FloatActionModeClampNone'}" Tag="{x:Static models:FloatClampMode.None}" />
                                                           <ComboBoxItem Content="{loc:Translate 'FloatActionModeClampZeroToOne'}" Tag="{x:Static models:FloatClampMode.ZeroToOne}" />
                                                           <ComboBoxItem Content="{loc:Translate 'FloatActionModeClampMinToMax'}" Tag="{x:Static models:FloatClampMode.MinToMax}" />
                                                       </ComboBox>
                                                   </StackPanel>

                                                   <StackPanel Margin="0,8,0,0"
                                                               Visibility="{Binding UsesFloatHideOnLimit, Converter={StaticResource BoolToVisibilityConverter}}">
                                                       <CheckBox IsChecked="{Binding HideRewardWhenFloatMaxReached, UpdateSourceTrigger=PropertyChanged}"
                                                                 Content="{loc:Translate 'Hide reward at maximum float'}" />
                                                       <CheckBox Margin="0,4,0,0"
                                                                 IsChecked="{Binding HideRewardWhenFloatMinReached, UpdateSourceTrigger=PropertyChanged}"
                                                                 Content="{loc:Translate 'Hide reward at minimum float'}" />
                                                   </StackPanel>
                                              </StackPanel>
                                          </Border>

                                          <TextBlock Text="Parameter Name (selected)"
                                                    Foreground="{DynamicResource TextBrush}"
                                                    FontWeight="SemiBold"
                                                    FontSize="11"
                                                    Margin="0,0,0,4" />
                                         <TextBox Text="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,8"
                                                  ToolTip="The OSC parameter name that this rule controls. Click an item in the list below to set it." />

                                         <TextBlock Text="Search &amp; Pick Parameter"
                                                    Foreground="{DynamicResource TextBrush}"
                                                    FontSize="11"
                                                    Margin="0,0,0,4" />
                                         <Grid Margin="0,0,0,8">
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="Auto" />
                                                 <RowDefinition Height="Auto" />
                                             </Grid.RowDefinitions>
                                             <Grid Grid.Row="0" Margin="0,0,0,4">
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="*" />
                                                     <ColumnDefinition Width="Auto" />
                                                 </Grid.ColumnDefinitions>
                                                 <TextBox Grid.Column="0"
                                                          x:Name="ParameterNameTextBox"
                                                          Text="{Binding DataContext.ParameterNameFilter, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                          TextChanged="OnParameterNameTextChanged" />
                                                 <Button Grid.Column="1"
                                                         Content="⟳"
                                                         Style="{StaticResource SecondaryButtonStyle}"
                                                         Padding="8,4"
                                                         Margin="6,0,0,0"
                                                         Command="{Binding DataContext.LoadParametersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         ToolTip="Refresh parameters from avatar OSC file" />
                                             </Grid>
                                             <Border Grid.Row="1"
                                                     Background="{DynamicResource InputBrush}"
                                                     BorderBrush="{DynamicResource BorderBrush}"
                                                     BorderThickness="1"
                                                     CornerRadius="4"
                                                     MaxHeight="140">
                                                 <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                     <ItemsControl ItemsSource="{Binding DataContext.FilteredParameters, RelativeSource={RelativeSource AncestorType=Window}}">
                                                         <ItemsControl.ItemTemplate>
                                                              <DataTemplate>
                                                                  <Button BorderBrush="{DynamicResource BorderBrush}"
                                                                          BorderThickness="0,0,0,1"
                                                                          Background="Transparent"
                                                                          Padding="6,4"
                                                                          Cursor="Hand"
                                                                          HorizontalContentAlignment="Stretch"
                                                                          HorizontalAlignment="Stretch"
                                                                          Click="OnParameterItemClicked"
                                                                          Tag="{Binding}">
                                                                     <Button.Template>
                                                                         <ControlTemplate TargetType="Button">
                                                                             <Border Background="{TemplateBinding Background}"
                                                                                       BorderBrush="{TemplateBinding BorderBrush}"
                                                                                       BorderThickness="{TemplateBinding BorderThickness}"
                                                                                     Padding="{TemplateBinding Padding}">
                                                                                 <ContentPresenter HorizontalAlignment="Stretch" />
                                                                             </Border>
                                                                         </ControlTemplate>
                                                                     </Button.Template>
                                                                     <StackPanel HorizontalAlignment="Stretch">
                                                                         <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="11" />
                                                                         <TextBlock Text="{Binding ParameterType}" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                                                                     </StackPanel>
                                                                 </Button>
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                     </ItemsControl>
                                                 </ScrollViewer>
                                             </Border>
                                         </Grid>

                                           <!-- Bool reset chips -->
                                           <StackPanel Visibility="{Binding UsesBoolParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                               <TextBlock Text="When timer expires, restore parameter to:"
                                                          Foreground="{DynamicResource TextBrush}"
                                                          FontSize="11"
                                                          Margin="0,0,0,4" />
                                               <UniformGrid Columns="2" Margin="0,0,0,8">
                                                   <Button Margin="0,0,2,0" Padding="8,4" FontSize="11" FontWeight="Bold"
                                                           Click="OnResetValueTrueClicked"
                                                           Tag="{Binding}">
                                                       <Button.Style>
                                                           <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                               <Style.Triggers>
                                                                   <DataTrigger Binding="{Binding ResetValue}" Value="True">
                                                                       <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                       <Setter Property="Foreground" Value="White" />
                                                                   </DataTrigger>
                                                                   <DataTrigger Binding="{Binding ResetValue}" Value="true">
                                                                       <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                       <Setter Property="Foreground" Value="White" />
                                                                   </DataTrigger>
                                                               </Style.Triggers>
                                                           </Style>
                                                       </Button.Style>
                                                       <TextBlock Text="True" />
                                                   </Button>
                                                   <Button Margin="2,0,0,0" Padding="8,4" FontSize="11" FontWeight="Bold"
                                                           Click="OnResetValueFalseClicked"
                                                           Tag="{Binding}">
                                                       <Button.Style>
                                                           <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                               <Style.Triggers>
                                                                   <DataTrigger Binding="{Binding ResetValue}" Value="False">
                                                                       <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                       <Setter Property="Foreground" Value="White" />
                                                                   </DataTrigger>
                                                                   <DataTrigger Binding="{Binding ResetValue}" Value="false">
                                                                       <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                       <Setter Property="Foreground" Value="White" />
                                                                   </DataTrigger>
                                                               </Style.Triggers>
                                                           </Style>
                                                       </Button.Style>
                                                       <TextBlock Text="False" />
                                                   </Button>
                                               </UniformGrid>
                                           </StackPanel>

                                           <!-- Non-bool timed reset value (Float / String); Int uses its own After Active Time input -->
                                           <StackPanel Visibility="{Binding UsesTextOrFloatParameter, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Margin="0,0,0,8">
                                               <TextBlock Text="When timer expires, restore parameter to:"
                                                          Foreground="{DynamicResource TextBrush}"
                                                          FontSize="11"
                                                          Margin="0,0,0,4" />
                                               <TextBox Text="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                           </StackPanel>

                                         <!-- Paired Rules section - clearer visual choice -->
                                         <TextBlock Text="Paired Rules"
                                                    Foreground="{DynamicResource TextBrush}"
                                                    FontWeight="SemiBold"
                                                    FontSize="13"
                                                    Margin="0,16,0,4" />
                                         <TextBlock Text="Pair this rule with other rules in the same set. When this rule is redeemed, the paired rules will be affected based on the pairing mode you choose."
                                                    Foreground="{DynamicResource MutedBrush}"
                                                    FontSize="10"
                                                    TextWrapping="Wrap"
                                                    Margin="0,0,0,8" />

                                         <!-- Two visual choice cards for the pairing mode -->
                                         <Border Background="{DynamicResource PanelBrush}"
                                                 BorderThickness="2"
                                                 CornerRadius="10"
                                                 Padding="10"
                                                 Margin="0,0,0,4"
                                                 Cursor="Hand"
                                                 MouseLeftButtonUp="OnHideModeClicked">
                                             <Border.Style>
                                                 <Style TargetType="Border">
                                                     <Setter Property="BorderBrush" Value="#4B2B78" />
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding SpecialRulePairingMode}" Value="HidePairedWhileActive">
                                                             <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Border.Style>
                                             <StackPanel>
                                                  <TextBlock Text="● Hide Paired While On Cooldown"
                                                            Foreground="{DynamicResource TextBrush}"
                                                            FontWeight="SemiBold"
                                                            FontSize="12" />
                                                  <TextBlock Text="Default. Paired rules stay visible by default, but get hidden while this rule is on cooldown. Good when you want this rule to be the only one of its kind visible at a time."
                                                            Foreground="{DynamicResource MutedBrush}"
                                                            FontSize="10"
                                                            TextWrapping="Wrap"
                                                            Margin="0,2,0,0" />
                                             </StackPanel>
                                         </Border>
                                         <Border Background="{DynamicResource PanelBrush}"
                                                 BorderThickness="2"
                                                 CornerRadius="10"
                                                 Padding="10"
                                                 Cursor="Hand"
                                                 MouseLeftButtonUp="OnShowModeClicked">
                                             <Border.Style>
                                                 <Style TargetType="Border">
                                                     <Setter Property="BorderBrush" Value="#4B2B78" />
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding SpecialRulePairingMode}" Value="ShowPairedWhileActive">
                                                             <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Border.Style>
                                             <StackPanel>
                                                  <TextBlock Text="● Show Paired Only While On Cooldown"
                                                            Foreground="{DynamicResource TextBrush}"
                                                            FontWeight="SemiBold"
                                                            FontSize="12" />
                                                  <TextBlock Text="Paired rules are hidden by default, only appearing while this rule is on cooldown. Good for 'reveal a secret option' patterns."
                                                            Foreground="{DynamicResource MutedBrush}"
                                                            FontSize="10"
                                                            TextWrapping="Wrap"
                                                            Margin="0,2,0,0" />
                                             </StackPanel>
                                         </Border>

                                         <!-- Currently paired rules list -->
                                         <TextBlock Margin="0,8,0,4" TextWrapping="Wrap">
                                             <Run Text="Currently Paired: " Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="11" />
                                             <Run Text="{Binding DataContext.PairedRules.Count, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, StringFormat={}{0} rule(s)}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                         </TextBlock>
                                          <ItemsControl ItemsSource="{Binding DataContext.PairedRules, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8">
                                              <ItemsControl.ItemTemplate>
                                                  <DataTemplate>
                                                      <Border Background="{DynamicResource PanelBrush}"
                                                              BorderBrush="{DynamicResource BorderBrush}"
                                                              BorderThickness="1"
                                                              CornerRadius="6"
                                                              Padding="8,4"
                                                              Margin="0,0,0,2">
                                                          <Grid>
                                                              <Grid.ColumnDefinitions>
                                                                  <ColumnDefinition Width="*" />
                                                                  <ColumnDefinition Width="Auto" />
                                                              </Grid.ColumnDefinitions>
                                                              <TextBlock Grid.Column="0"
                                                                         Text="{Binding Name}"
                                                                         Foreground="{DynamicResource TextBrush}"
                                                                         FontSize="11"
                                                                         VerticalAlignment="Center" />
                                                              <Button Grid.Column="1"
                                                                      Content="✕"
                                                                      Style="{StaticResource SecondaryButtonStyle}"
                                                                      Padding="4,2"
                                                                      FontSize="10"
                                                                      Command="{Binding DataContext.RemovePairedRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding Id}" />
                                                          </Grid>
                                                      </Border>
                                                  </DataTemplate>
                                              </ItemsControl.ItemTemplate>
                                          </ItemsControl>

                                         <!-- Add a paired rule -->
                                         <TextBlock Text="Add another rule to pair:"
                                                    Foreground="{DynamicResource TextBrush}"
                                                    FontSize="11"
                                                    Margin="0,4,0,4" />
                                         <Grid>
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <ComboBox Grid.Column="0"
                                                       ItemsSource="{Binding DataContext.OtherRulesInSet, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       DisplayMemberPath="Name"
                                                       SelectedItem="{Binding DataContext.SelectedPairingTarget, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                                             <Button Grid.Column="1"
                                                     Content="+ Add"
                                                     Style="{StaticResource AccentButtonStyle}"
                                                     Padding="10,4"
                                                     FontSize="10"
                                                     Margin="6,0,0,0"
                                                     Command="{Binding DataContext.AddPairedRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                         </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- Wardrobe Mode: Wardrobe Outfits with add/edit/delete -->
                            <StackPanel Visibility="{Binding UseWardrobeMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{loc:Translate 'Avatar Sets Step 4 Outfits'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="+ Add Outfit"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Padding="8,4"
                                            FontSize="10"
                                            Command="{Binding DataContext.AddWardrobeOutfitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding WardrobeOutfits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource PanelBrush}"
                                                    MouseLeftButtonUp="OnOutfitItemClicked"
                                                    Tag="{Binding}">
                                                <Border.BorderBrush>
                                                    <MultiBinding Converter="{StaticResource IsSelectedOutfitBrushMultiConverter}">
                                                        <Binding Path="DataContext.SelectedWardrobeOutfit" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </Border.BorderBrush>
                                                <Border.BorderThickness>
                                                    <MultiBinding Converter="{StaticResource IsSelectedOutfitThicknessMultiConverter}">
                                                        <Binding Path="DataContext.SelectedWardrobeOutfit" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </Border.BorderThickness>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,6,0"
                                                            Width="36"
                                                            Height="18"
                                                            CornerRadius="9"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#6B7280" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Background" Value="#22C55E" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <ToggleButton IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                          Cursor="Hand">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent" />
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                            <Ellipse Width="12"
                                                                     Height="12"
                                                                     Fill="White"
                                                                     IsHitTestVisible="False"
                                                                     VerticalAlignment="Center">
                                                                <Ellipse.HorizontalAlignment>
                                                                    <Binding Path="IsEnabled" Converter="{StaticResource BoolToHorizontalAlignmentConverter}" />
                                                                </Ellipse.HorizontalAlignment>
                                                                <Ellipse.Margin>
                                                                    <Binding Path="IsEnabled" Converter="{StaticResource BoolToThicknessConverter}" />
                                                                </Ellipse.Margin>
                                                            </Ellipse>
                                                        </Grid>
                                                    </Border>
                                                    <Button Grid.Column="2"
                                                            Content="✕"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="6,2"
                                                            FontSize="10"
                                                            Click="OnDeleteOutfitClicked"
                                                            Tag="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Outfit editor (visible when an outfit is selected) -->
                                <Border Visibility="{Binding DataContext.SelectedWardrobeOutfit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}}"
                                        Background="{DynamicResource NestedPanelBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0,14,0,0">
                                    <StackPanel DataContext="{Binding DataContext.SelectedWardrobeOutfit, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="Edit Outfit"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Margin="0,0,0,10" />
                                         <TextBlock Text="Active time is clamped to 70s at runtime so the LocalAvatarData snapshot can refresh. Set a value at or above 70s."
                                                    Foreground="{DynamicResource WarnTextBrush}"
                                                    FontSize="10"
                                                    TextWrapping="Wrap"
                                                    Margin="0,0,0,8" />
                                         <TextBlock Text="Name"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="11"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8" />
                                        <TextBlock Text="Active Time (seconds)"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="11"
                                                   Margin="0,0,0,2" />
                                        <TextBox Text="{Binding ActiveTimeSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,4" />
                                        <TextBlock Text="Below 70s the runtime will clamp and extend the active window."
                                                   Foreground="{DynamicResource WarnTextBrush}"
                                                   FontSize="9"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"
                                                   Visibility="{Binding UsesShortActiveTime, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <TextBlock Text="Reward Sync Mode"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Margin="0,4,0,4" />
                                        <TextBlock Text="Manage and Create: Crystal Relay creates the reward, hides/deletes it when not in use. Link to listen only: use an existing reward, listen-only."
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />
                                        <ComboBox SelectedValue="{Binding TwitchRewardSyncMode, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag" Margin="0,0,0,8">
                                            <ComboBoxItem Content="Manage and Create" Tag="{x:Static models:TwitchRewardSyncMode.CreateOrManage}" />
                                            <ComboBoxItem Content="Link to listen only" Tag="{x:Static models:TwitchRewardSyncMode.LinkExisting}" />
                                        </ComboBox>

                                        <!-- LinkExisting mode -->
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Existing Twitch Reward"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="11"
                                                           Margin="0,0,0,4" />
                                                <Button Grid.Column="1"
                                                        Content="↻"
                                                        ToolTip="Reload Twitch rewards"
                                                        Padding="6,2"
                                                        Margin="0,0,0,4"
                                                        Command="{Binding DataContext.LoadTwitchRewardsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </Grid>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableTwitchRewards, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedValue="{Binding TwitchRewardId, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="Title"
                                                      IsEditable="False"
                                                      Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding DataContext.TwitchRewardsLoadStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="10"
                                                       Margin="0,0,0,4" />
                                            <TextBlock Text="Reward ID (auto-filled when selected)"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="10"
                                                       Margin="0,0,0,2" />
                                            <TextBox Text="{Binding TwitchRewardId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Background="{DynamicResource NestedPanelBrush}" />
                                        </StackPanel>

                                        <!-- CreateOrManage mode -->
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsesCreateOrManageReward}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="Reward Title"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11"
                                                               Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding TwitchRewardTitle, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="Reward Cost"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontSize="11"
                                                               Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding TwitchRewardCost, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="Reward Description"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="11"
                                                       Margin="0,0,0,2" />
                                            <TextBox Text="{Binding TwitchRewardDescription, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" Height="48"
                                                     Margin="0,0,0,8" />
                                            <TextBlock Text="Chat Command"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="11"
                                                       Margin="0,0,0,2" />
                                            <TextBox Text="{Binding ChatCommandText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                            <CheckBox IsChecked="{Binding DeleteManagedRewardWhenInactive, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="Delete when inactive (cleanup on outfit disable/delete, recycle if hitting 50-reward limit)"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      FontSize="11"
                                                      Margin="0,0,0,8" />

                                            <!-- Reward Background Colors (Ready / Cooldown) -->
                                            <TextBlock Text="Reward Colors"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,4" />
                                            <TextBlock Text="Ready color = the reward's background when available. Cooldown color = the reward's background while the timer is running or it's been redeemed. Twitch shows these on the channel points page."
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,8" />

                                            <!-- Ready Color row -->
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="24" Height="24"
                                                        CornerRadius="4"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        Background="{Binding ManagedRewardReadyColorBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ManagedRewardReadyColor, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="Hex color in #RRGGBB format" />
                                                <Button Grid.Column="2"
                                                        Content="Pick..."
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="6,0,0,0"
                                                        Padding="8,4"
                                                        Click="OnPickWardrobeReadyColorClicked"
                                                        Tag="{Binding}" />
                                                <Button Grid.Column="3"
                                                        Content="Reset"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="4,0,0,0"
                                                        Padding="8,4"
                                                        Click="OnResetWardrobeReadyColorClicked"
                                                        Tag="{Binding}"
                                                        ToolTip="Reset to default ready color" />
                                            </Grid>

                                            <!-- Cooldown Color row -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="24" Height="24"
                                                        CornerRadius="4"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        Background="{Binding ManagedRewardCooldownColorBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding ManagedRewardCooldownColor, UpdateSourceTrigger=PropertyChanged}"
                                                         VerticalContentAlignment="Center"
                                                         ToolTip="Hex color in #RRGGBB format" />
                                                <Button Grid.Column="2"
                                                        Content="Pick..."
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="6,0,0,0"
                                                        Padding="8,4"
                                                        Click="OnPickWardrobeCooldownColorClicked"
                                                        Tag="{Binding}" />
                                                <Button Grid.Column="3"
                                                        Content="Reset"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="4,0,0,0"
                                                        Padding="8,4"
                                                        Click="OnResetWardrobeCooldownColorClicked"
                                                        Tag="{Binding}"
                                                        ToolTip="Reset to default cooldown color" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Param sub-toolbar -->
                                        <TextBlock Text="Outfit Parameters"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Margin="0,8,0,4" />
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button Content="+ Add Param" Style="{StaticResource AccentButtonStyle}" Padding="6,3" FontSize="10" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.AddWardrobeSnapshotParamCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Remove" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" FontSize="10" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.RemoveWardrobeSnapshotParamCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" FontSize="10" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.CopySelectedWardrobeSnapshotParamsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Paste" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" FontSize="10" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.PasteWardrobeSnapshotParamsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" FontSize="10" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.RefreshWardrobeParametersCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Test Outfit" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" FontSize="10"
                                                    Command="{Binding DataContext.TestWardrobeOutfitCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </WrapPanel>

                                        <!-- Param list -->
                                        <ListBox x:Name="WardrobeParamListBox"
                                                 ItemsSource="{Binding SnapshotParams}"
                                                 SelectionMode="Extended"
                                                 ToolTip="{loc:Translate 'Wardrobe Multi-Select Tooltip'}"
                                                 SelectedItem="{Binding DataContext.SelectedWardrobeSnapshotParam, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 SelectionChanged="OnWardrobeParamListSelectionChanged"
                                                 KeyDown="OnWardrobeParamListKeyDown"
                                                 Background="{DynamicResource PanelBrush}"
                                                 Foreground="{DynamicResource TextBrush}"
                                                 MaxHeight="160"
                                                 Margin="0,0,0,6"
                                                 BorderBrush="{DynamicResource BorderBrush}">
                                            <ListBox.InputBindings>
                                                <KeyBinding Key="C" Modifiers="Ctrl"
                                                            Command="{Binding DataContext.CopySelectedWardrobeSnapshotParamsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <KeyBinding Key="V" Modifiers="Ctrl"
                                                            Command="{Binding DataContext.PasteWardrobeSnapshotParamsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <KeyBinding Key="A" Modifiers="Ctrl"
                                                            Command="{Binding DataContext.SelectAllWardrobeSnapshotParamsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <KeyBinding Key="Delete"
                                                            Command="{Binding DataContext.RemoveWardrobeSnapshotParamCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <KeyBinding Key="Escape"
                                                            Command="{Binding DataContext.ClearWardrobeSnapshotParamSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </ListBox.InputBindings>
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy"
                                                              Command="{Binding DataContext.CopySelectedWardrobeSnapshotParamsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <MenuItem Header="Paste"
                                                              Command="{Binding DataContext.PasteWardrobeSnapshotParamsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Separator />
                                                    <MenuItem Header="{loc:Translate 'Select All'}"
                                                              Command="{Binding DataContext.SelectAllWardrobeSnapshotParamsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplaySummary}" Foreground="{DynamicResource TextBrush}" FontSize="11" Padding="4,2" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Multi-select banner (visible when 2+ params are selected) -->
                                        <Border Margin="0,0,0,6"
                                                Padding="10,6"
                                                CornerRadius="6"
                                                Background="{DynamicResource PanelHighlightBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding DataContext.HasMultipleWardrobeSnapshotParamsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DataContext.SelectedWardrobeSnapshotParamCount, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11" />
                                                <TextBlock Margin="6,0,0,0"
                                                           Text="{loc:Translate 'Wardrobe Multi-Select Banner'}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Param editor (visible when a param is selected) -->
                                        <Border Visibility="{Binding DataContext.IsWardrobeParamEditorVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"
                                                Background="{DynamicResource PanelBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10"
                                                Margin="0,4,0,0">
                                            <StackPanel DataContext="{Binding DataContext.SelectedWardrobeSnapshotParam, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <TextBlock Text="Parameter Path"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="11"
                                                           Margin="0,0,0,2" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             x:Name="WardrobeParameterNameTextBox"
                                                             Text="{Binding DataContext.WardrobeParameterNameFilter, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                             TextChanged="OnWardrobeParameterNameTextChanged" />
                                                    <Button Grid.Column="1"
                                                            Content="⟳"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Padding="8,4"
                                                            Margin="6,0,0,0"
                                                            Command="{Binding DataContext.RefreshWardrobeParametersCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ToolTip="Refresh parameters from avatar OSC file" />
                                                </Grid>
                                                <UniformGrid Columns="3" Margin="0,0,0,4" Rows="1">
                                                    <Button Content="Bool" Margin="0,0,2,0"
                                                            Command="{Binding DataContext.WardrobeFilterBoolCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.WardrobeParameterTypeFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="Bool">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Int" Margin="2,0,2,0"
                                                            Command="{Binding DataContext.WardrobeFilterIntCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.WardrobeParameterTypeFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="Int">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="Float" Margin="2,0,0,0"
                                                            Command="{Binding DataContext.WardrobeFilterFloatCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.WardrobeParameterTypeFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="Float">
                                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </UniformGrid>
<Border Background="{DynamicResource InputBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="4"
        MinHeight="60"
        MaxHeight="140">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DataContext.FilteredWardrobeParameters, RelativeSource={RelativeSource AncestorType=Window}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Background="Transparent"
                                Padding="6,4"
                                Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                Click="OnWardrobeParameterItemClicked"
                                Tag="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="11" />
                                <TextBlock Text="{Binding ParameterType}" Foreground="{DynamicResource MutedBrush}" FontSize="9" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Text="Loading parameters..."
                   x:Name="WardrobeParameterEmptyState"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedBrush}"
                   FontSize="11"
                   Padding="0,12,0,0"
                   Visibility="{Binding DataContext.FilteredWardrobeParameters.Count, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverted}" />
    </Grid>
</Border>
                                                <TextBlock Text="Pick from list or type a custom path. Auto-detects Bool/Int/Float type."
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="9"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,6" />
                                                <StackPanel Margin="0,0,0,4">
                                                    <TextBlock Text="Value" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="0,0,0,2" />
                                                    <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding SetValue}"
                                                              Visibility="{Binding UsesBoolParameter, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <TextBox x:Name="WardrobeIntValueTextBox"
                                                             Text="{Binding SetValue, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding UsesIntParameter, Converter={StaticResource BoolToVisibilityConverter}}"
                                                             PreviewTextInput="OnWardrobeIntValuePreviewTextInput"
                                                             DataObject.Pasting="OnWardrobeIntValuePasting"
                                                             LostFocus="OnWardrobeIntValueLostFocus" />
                                                    <TextBox x:Name="WardrobeFloatValueTextBox"
                                                             Text="{Binding SetValue, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding UsesFloatParameter, Converter={StaticResource BoolToVisibilityConverter}}"
                                                             PreviewTextInput="OnWardrobeFloatValuePreviewTextInput"
                                                             DataObject.Pasting="OnWardrobeFloatValuePasting"
                                                             LostFocus="OnWardrobeFloatValueLostFocus" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Global wardrobe cooldown (per profile) -->
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Global Wardrobe Cooldown (seconds)"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="11"
                                                   Margin="0,0,0,2" />
                                        <TextBlock Text="All outfits share this cooldown. 0 = no cooldown."
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="9"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding WardrobeCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Save & Close / Cancel / Delete buttons -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,20,0,0">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="{loc:Translate 'Avatar Sets Editor Save Close'}"
                                Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{loc:Translate 'Avatar Sets Editor Cancel'}"
                                Command="{Binding DataContext.CloseEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                    <Button Style="{StaticResource DangerButtonStyle}"
                            Content="{loc:Translate 'Avatar Sets Delete Set'}"
                            Command="{Binding DataContext.DeleteSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Border Margin="1"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Background="Transparent"
                            Foreground="{DynamicResource TitleBarTextBrush}"
                            BorderThickness="0"
                            Padding="8,4"
                            Margin="6,0,0,0"
                            Click="OnCloseClicked"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="32"
                            Height="28" />
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="🎯  Avatar Sets"
                                   Foreground="{DynamicResource TitleBarTextBrush}"
                                   FontWeight="Bold"
                                   FontSize="14" />
                        <TextBlock Text="{Binding SubtitleSummary}"
                                   Foreground="{DynamicResource TitleBarSubTextBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1">
                <!-- Empty state (visible when CountAll == 0) -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="460"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="🎯"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{loc:Translate 'Avatar Sets Empty Title'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="{loc:Translate 'Avatar Sets Empty Body'}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,8,0,0" />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Content="{loc:Translate 'Avatar Sets Toolbar New'}"
                            Command="{Binding AddNewSetCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0"
                            MinWidth="160" />
                </StackPanel>

                <!-- Main content when not empty -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CountAll}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar: New button + Search -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource NestedPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,4"
                                    Margin="0,0,0,0"
                                    Content="{loc:Translate 'Avatar Sets Enable All'}"
                                    Command="{Binding EnableAllCommand}" />
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="10,4"
                                    Margin="0,0,6,0"
                                    Content="{loc:Translate 'Avatar Sets Disable All'}"
                                    Command="{Binding DisableAllCommand}" />
                            <ComboBox DockPanel.Dock="Right"
                                      Width="180"
                                      Margin="0,0,12,0"
                                      SelectedItem="{Binding SortMode}"
                                      ItemsSource="{Binding SortModeOptions}" />
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="12,6"
                                    Margin="0,0,12,0"
                                    Content="{loc:Translate 'Avatar Sets Toolbar New'}"
                                    Command="{Binding AddNewSetCommand}" />
                            <!-- Search box -->
                            <Grid DockPanel.Dock="Right"
                                  Width="220"
                                  Height="28"
                                  Margin="0,0,12,0">
                                <TextBox Background="{DynamicResource InputBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         VerticalContentAlignment="Center"
                                         Padding="28,4,8,4"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="🔍"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12"
                                           IsHitTestVisible="False"
                                           Margin="10,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Translate 'Avatar Sets Toolbar Search'}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11"
                                           IsHitTestVisible="False"
                                           Margin="30,0,8,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Filter chips row -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource NestedPanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource FilterChipToggleStyle}"
                                          IsChecked="{Binding FilterMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=All}"
                                          Command="{Binding ShowAllCommand}">
                                <TextBlock Text="{Binding AllFilterText}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource FilterChipToggleStyle}"
                                          IsChecked="{Binding FilterMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Active}"
                                          Command="{Binding ShowActiveCommand}">
                                <TextBlock Text="{Binding ActiveFilterText}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource FilterChipToggleStyle}"
                                          IsChecked="{Binding FilterMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Disabled}"
                                          Command="{Binding ShowDisabledCommand}">
                                <TextBlock Text="{Binding DisabledFilterText}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource FilterChipToggleStyle}"
                                          IsChecked="{Binding FilterMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=LiveNow}"
                                          Command="{Binding ShowLiveNowCommand}">
                                <TextBlock Text="{Binding LiveNowFilterText}" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource FilterChipToggleStyle}"
                                          IsChecked="{Binding FilterMode, Converter={StaticResource EnumBooleanConverter}, ConverterParameter=Master}"
                                          Command="{Binding ShowMasterCommand}">
                                <TextBlock Text="{Binding MasterFilterText}" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- Card grid -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,10">
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="AvatarSetCardTemplate" />
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Editor overlay (slides in from right, 480px wide) -->
            <Grid Grid.Row="0"
                  Grid.RowSpan="2"
                  HorizontalAlignment="Right"
                  Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Backdrop click to close -->
                <Border Background="#55000000"
                        MouseLeftButtonDown="OnEditorBackdropClicked" />
                <!-- Editor panel -->
                <Border Width="480"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0"
                        HorizontalAlignment="Right">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- Editor header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource TitleBarBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="14,10">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Content="✕"
                                        Background="Transparent"
                                        Foreground="{DynamicResource TitleBarTextBrush}"
                                        BorderThickness="0"
                                        Padding="8,4"
                                        Margin="6,0,0,0"
                                        Click="OnCloseClicked"
                                        Width="32"
                                        Height="28" />
                                <TextBlock Text="Edit Avatar Set"
                                           Foreground="{DynamicResource TitleBarTextBrush}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <!-- Editor content -->
                        <ContentControl Grid.Row="1"
                                        Content="{Binding SelectedProfile}"
                                        ContentTemplate="{StaticResource AvatarSetEditorTemplate}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
