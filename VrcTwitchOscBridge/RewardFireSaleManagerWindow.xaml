<Window x:Class="VrcTwitchOscBridge.RewardFireSaleManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:VrcTwitchOscBridge.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:models="clr-namespace:VrcTwitchOscBridge.Models"
        xmlns:vm="clr-namespace:VrcTwitchOscBridge.ViewModels"
        xmlns:local="clr-namespace:VrcTwitchOscBridge"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RewardFireSaleManagerViewModel}"
        Title="{loc:Translate 'Reward Fire Sale'}"
        Icon="Assets/crystal-relay-icon.ico"
        Width="720"
        Height="680"
        MinWidth="540"
        MinHeight="480"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FontFamily="{DynamicResource BodyFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#130B1E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#CC1C132B" />
        <SolidColorBrush x:Key="PanelSecondaryBrush" Color="#C8241739" />
        <SolidColorBrush x:Key="NestedPanelBrush" Color="#B8241739" />
        <SolidColorBrush x:Key="PanelHighlightBrush" Color="#C4311C4E" />
        <SolidColorBrush x:Key="BorderBrush" Color="#4B2B78" />
        <SolidColorBrush x:Key="HighlightBorderBrush" Color="#774AC7" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A855F7" />
        <SolidColorBrush x:Key="AccentDimBrush" Color="#552D1B47" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5EEFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#C9B8E3" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#5B3A8E" />
        <SolidColorBrush x:Key="InputBrush" Color="#241733" />
        <SolidColorBrush x:Key="DangerBrush" Color="#4A1729" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#A94A71" />
        <SolidColorBrush x:Key="ComboTextBrush" Color="#F5EEFF" />
        <SolidColorBrush x:Key="ComboSurfaceBrush" Color="#241733" />
        <SolidColorBrush x:Key="ComboHighlightBrush" Color="#4B2B78" />
        <SolidColorBrush x:Key="ComboDropButtonBrush" Color="#2C1C48" />
        <SolidColorBrush x:Key="ComboDropButtonHoverBrush" Color="#3B235B" />
        <SolidColorBrush x:Key="ComboDropButtonPressedBrush" Color="#543183" />
        <SolidColorBrush x:Key="PopupBorderBrush" Color="#8B5CD6" />
        <SolidColorBrush x:Key="RuleCardHoverBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="#241733" />
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A855F7" />
        <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#C084FC" />
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#2C1C48" />
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#6942A7" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#20122F" />
        <SolidColorBrush x:Key="TitleBarTextBrush" Color="#F5EEFF" />
        <SolidColorBrush x:Key="TitleBarSubTextBrush" Color="#CBB9E5" />
        <SolidColorBrush x:Key="TitleBarButtonBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#3B235B" />
        <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#543183" />
        <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#B43D62" />
        <SolidColorBrush x:Key="TitleBarClosePressedBrush" Color="#8C2648" />
        <FontFamily x:Key="HeadingFontFamily">Constantia</FontFamily>
        <FontFamily x:Key="BodyFontFamily">Verdana</FontFamily>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome"
                                Margin="2"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="8" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource ScrollThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="{TemplateBinding Width}"
                  MinWidth="18"
                  Background="Transparent">
                <Border Background="{DynamicResource ScrollTrackBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8" />
                <Track x:Name="PART_Track"
                       Margin="2"
                       IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageUpCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageDownCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TitleBarTextBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18"
                                    Height="18"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                                <Grid>
                                    <Border x:Name="CheckChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5" />
                                    <Path x:Name="CheckMark"
                                          Width="10"
                                          Height="8"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 1 5 L 4.5 8 L 11 1"
                                          Stroke="White"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              ContentSource="Content" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource RuleCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource ComboDropButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DropButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,8,8,0">
                            <Path x:Name="DropArrow"
                                  Width="11"
                                  Height="7"
                                  Stretch="Fill"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 5.5 6 L 11 0"
                                  Stroke="{DynamicResource TitleBarTextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropButtonBorder" Property="Opacity" Value="0.55" />
                                <Setter TargetName="DropArrow" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboPopupTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboPopupThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ComboPopupThumbBorder"
                                Width="8"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboPopupThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ComboPopupThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboPopupVerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="{TemplateBinding Width}" Background="Transparent">
                <Border Width="8"
                        HorizontalAlignment="Center"
                        Margin="0,2"
                        Background="{DynamicResource ScrollTrackBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                <Track x:Name="PART_Track"
                       Margin="0,2"
                       IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageUpCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ComboPopupThumbStyle}" MinHeight="30" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageDownCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ComboPopupHorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="{TemplateBinding Height}" Background="Transparent">
                <Border Height="8"
                        VerticalAlignment="Center"
                        Margin="2,0"
                        Background="{DynamicResource ScrollTrackBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                <Track x:Name="PART_Track" Margin="2,0">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageLeftCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ComboPopupThumbStyle}" MinWidth="30" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageRightCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style x:Key="ComboPopupScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource ComboPopupVerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template" Value="{StaticResource ComboPopupHorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Margin="10,0,4,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{DynamicResource TitleBarTextBrush}"
                                                      IsHitTestVisible="False" />
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Margin="10,0,4,0"
                                             Foreground="{DynamicResource TitleBarTextBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Visibility="Hidden"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" />
                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource ComboBoxToggleButtonStyle}" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Margin="0,4,0,0"
                                            Padding="4"
                                            Background="{DynamicResource InputBrush}"
                                            TextElement.Foreground="{DynamicResource TitleBarTextBrush}"
                                            BorderBrush="{DynamicResource PopupBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ComboPopupScrollBarStyle}" />
                                            </ScrollViewer.Resources>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="0,1"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="6">
                            <Border.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
                                </Style>
                            </Border.Resources>
                            <ContentPresenter TextElement.Foreground="{DynamicResource TitleBarTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboHighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource RuleCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource SectionActiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Margin" Value="0,10,10,0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource RuleCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerChrome" Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                <Setter TargetName="DangerChrome" Property="Background" Value="{DynamicResource DangerBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DangerChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4" />
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Height="38"
                    Background="{DynamicResource TitleBarBrush}"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <TextBlock Text="{loc:Translate 'Reward Fire Sale'}"
                               FontFamily="{DynamicResource HeadingFontFamily}"
                               FontSize="14"
                               Foreground="{DynamicResource TitleBarTextBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="40,0,40,0"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton"
                                Width="38" Height="38"
                                Background="{DynamicResource TitleBarButtonBrush}"
                                BorderThickness="0"
                                Click="OnMinimizeClicked">
                            <TextBlock Text="&#xE921;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{DynamicResource TitleBarTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Width="38" Height="38"
                                Background="{DynamicResource TitleBarButtonBrush}"
                                BorderThickness="0"
                                Click="OnCloseClicked">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{DynamicResource TitleBarTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1"
                          Margin="20,16,20,20"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,18,0">

                    <!-- Status Section -->
                    <Border Padding="14"
                            Background="{DynamicResource NestedPanelBrush}"
                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <ProgressBar Margin="0,10,0,0"
                                         Height="10"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                         Background="{DynamicResource InputBrush}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         BorderThickness="1" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,10,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{loc:Translate 'Reset Progress'}"
                                        Command="{Binding ResetProgressCommand}" />
                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Margin="10,0,0,0"
                                        Content="{loc:Translate 'Stop Sale'}"
                                        Command="{Binding StopSaleCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Active Warning -->
                    <Border Padding="12"
                            CornerRadius="12"
                            Background="{DynamicResource DangerBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding ActiveWarningText}"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Goal Sources -->
                    <Border Padding="14"
                            Background="{DynamicResource NestedPanelBrush}"
                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Goal Sources'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" />
                            <CheckBox Margin="0,10,0,8"
                                      IsChecked="{Binding Settings.IsEnabled, UpdateSourceTrigger=PropertyChanged}">
                                <TextBlock Text="{loc:Translate 'Enable Reward Fire Sale'}" TextWrapping="Wrap" />
                            </CheckBox>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Row="0"
                                          Grid.Column="0"
                                          Margin="0,0,0,8"
                                          IsChecked="{Binding Settings.CountBits, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock Text="{loc:Translate 'Count Bits'}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox Grid.Row="0"
                                          Grid.Column="2"
                                          Margin="0,0,0,8"
                                          IsChecked="{Binding Settings.CountCashPayments, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock Text="{loc:Translate 'Count Cash Payments'}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox Grid.Row="1"
                                          Grid.Column="0"
                                          IsChecked="{Binding Settings.MultiTierEnabled, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock Text="{loc:Translate 'Use highest reached tier'}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                            </Grid>
                            <TextBlock Margin="0,8,0,0"
                                       Text="{loc:Translate 'Bits add their bit amount, including Custom Power-up redemptions. Optional funding reward redeems add progress using the conversion below. Linked rewards are ignored and never changed.'}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Funding Sources (two-column) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Channel Point Funding Reward -->
                        <Border Grid.Column="0"
                                Padding="14"
                                Background="{DynamicResource NestedPanelBrush}"
                                BorderBrush="{DynamicResource HighlightBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate 'Fire Sale Funding Reward'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <CheckBox Margin="0,10,0,0"
                                          IsChecked="{Binding Settings.FundingRewardEnabled, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock Text="{loc:Translate 'Enable Fire Sale funding reward'}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="0,8,0,0"
                                           Text="{loc:Translate 'Reward Name'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Text="{Binding Settings.FundingRewardTitle, UpdateSourceTrigger=PropertyChanged}" />
                                <UniformGrid Margin="0,8,0,0"
                                             Columns="2">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="{loc:Translate 'Reward Cost'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Settings.FundingRewardCost, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="{loc:Translate 'Cooldown (seconds)'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Settings.FundingRewardCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Margin="0,8,0,0"
                                           Text="{loc:Translate 'Points per progress'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Text="{Binding Settings.RewardPointsPerProgressUnit, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding FundingRewardConversionText}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{loc:Translate 'Reward Description'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Text="{Binding Settings.FundingRewardDescription, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         Height="70"
                                         TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding FundingRewardPrompt}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" />

                                <!-- Managed Reward Colors -->
                                <StackPanel Margin="0,12,0,0"
                                            DataContext="{Binding Settings}">
                                    <TextBlock Text="{loc:Translate 'Managed Reward Colors'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <StackPanel Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate 'Ready Color'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold" />
                                            <DockPanel Margin="0,6,0,0"
                                                       LastChildFill="False">
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Background="{Binding FundingRewardReadyColorBrush}"
                                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                                        BorderThickness="1" />
                                                <TextBlock Margin="12,0,16,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding FundingRewardReadyColor}" />
                                                <Button Content="{loc:Translate 'Choose Color'}"
                                                        Padding="16,6"
                                                        MinWidth="132"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Click="OnPickManagedRewardColorClicked"
                                                        Tag="Ready" />
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="{loc:Translate 'Cooldown Color'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold" />
                                            <DockPanel Margin="0,6,0,0"
                                                       LastChildFill="False">
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Background="{Binding FundingRewardCooldownColorBrush}"
                                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                                        BorderThickness="1" />
                                                <TextBlock Margin="12,0,16,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding FundingRewardCooldownColor}" />
                                                <Button Content="{loc:Translate 'Choose Color'}"
                                                        Padding="16,6"
                                                        MinWidth="132"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Click="OnPickManagedRewardColorClicked"
                                                        Tag="Cooldown" />
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right: Cash Payments -->
                        <Border Grid.Column="2"
                                Padding="14"
                                Background="{DynamicResource NestedPanelBrush}"
                                BorderBrush="{DynamicResource HighlightBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate 'Cash Payments'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{loc:Translate 'Progress ratio (cents per 1 progress)'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Text="{Binding Settings.CashPaymentProgressRatio, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap">
                                    <Run Text="{loc:Translate 'At a ratio of '}" />
                                    <Run Text="{Binding Settings.CashPaymentProgressRatio, Mode=OneWay}" />
                                    <Run Text="{loc:Translate ' cents per progress, each $1 adds '}" />
                                    <Run Text="{Binding Settings.CashPaymentProgressRatio, Mode=OneWay}" />
                                    <Run Text="{loc:Translate ' progress.'}" />
                                </TextBlock>
                                <TextBlock Margin="0,14,0,0"
                                           Text="{loc:Translate 'Connected payment services feed into Fire Sale progress when Count Cash Payments is enabled above.'}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Sale Mode -->
                    <Border Padding="14"
                            Background="{DynamicResource NestedPanelBrush}"
                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Sale Mode'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" />
                            <UniformGrid Margin="0,10,0,0"
                                         Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{loc:Translate 'Mode'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding ModeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.SaleMode, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTemporary}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{loc:Translate 'Duration (seconds)'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Settings.TemporaryDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Discount Tiers -->
                    <Border Padding="14"
                            Background="{DynamicResource NestedPanelBrush}"
                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{loc:Translate 'Discount Tiers'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="10,0,0,0"
                                        MinWidth="120"
                                        Content="{loc:Translate 'Add Tier'}"
                                        Command="{Binding AddTierCommand}" />
                            </DockPanel>
                            <ItemsControl Margin="0,10,0,0"
                                          ItemsSource="{Binding Settings.Tiers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:RewardFireSaleTier}">
                                        <Border Margin="0,0,0,10"
                                                Padding="12"
                                                CornerRadius="12"
                                                Background="{DynamicResource PanelHighlightBrush}"
                                                BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,10,0">
                                                    <TextBlock Text="{loc:Translate 'Goal Amount'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding GoalAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0,10,0">
                                                    <TextBlock Text="{loc:Translate 'Discount Percent'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        MinWidth="92"
                                                        VerticalAlignment="Bottom"
                                                        Content="{loc:Translate 'Delete'}"
                                                        Command="{Binding DataContext.RemoveTierCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
