                                                    <Border Background="{DynamicResource NestedPanelBrush}"
                                                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16"
                                                            Padding="14">
                                                        <StackPanel>
                                                            <TextBlock Text="{loc:Translate 'Scale Set Setup'}"
                                                                       Style="{StaticResource HeadingTextStyle}"
                                                                       FontSize="20"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextBrush}" />
