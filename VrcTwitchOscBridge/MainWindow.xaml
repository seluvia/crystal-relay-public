                                                            <TextBlock Text="{loc:Translate 'Scale Redeems In This Set'}"
                                                                       Style="{StaticResource HeadingTextStyle}"
                                                                       FontSize="20"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextBrush}" />
