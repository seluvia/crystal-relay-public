                                                            <ListBox Margin="0,14,0,0"
                                                                     MaxHeight="260"
                                                                     ItemsSource="{Binding ScaleRules}"
                                                                     SelectedItem="{Binding DataContext.SelectedAvatarScaleRule, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
