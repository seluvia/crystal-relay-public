                                    <TextBlock Text="{loc:Translate 'Delete Universal Triggers'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
