                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsTwitchSectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSettingsVrChatSectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSettingsAppSectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSettingsSafetySectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            <Border Style="{StaticResource PanelBorderStyle}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False"
                                               Visibility="{Binding IsSettingsTwitchSectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{loc:Translate 'Twitch Settings'}" Style="{StaticResource HeadingTextStyle}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                Click="OnHelpButtonClicked"
                                                CommandParameter="Twitch Accounts"
                                                Tag="Connect the Twitch accounts Crystal Relay uses here. The broadcaster account listens for channel points, chat commands, stream status, and managed reward sync, while the optional bot account is only for sending chat messages back to Twitch. If Twitch shows a device code while linking, copy the code shown under that account into Twitch to finish the sign-in." />
                                    </DockPanel>
                                    <TextBlock Text="{loc:Translate 'VRChat Settings'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Visibility="{Binding IsSettingsVrChatSectionSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{loc:Translate 'App Settings'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Visibility="{Binding IsSettingsAppSectionSelected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{loc:Translate 'Safety Settings'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               Visibility="{Binding IsSettingsSafetySectionSelected, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <Border Margin="0,14,0,0" Background="{DynamicResource NestedPanelBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16"
                                            Visibility="{Binding IsSettingsAppSectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate 'Live Feedback Heartbeat'}"
                                                       Style="{StaticResource HeadingTextStyle}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{loc:Translate 'Crystal Relay includes a Live Feedback Heartbeat. This helps the developer find live Crystal Relay streams for feedback, support, and community interaction. You can turn this off anytime in Settings.'}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
