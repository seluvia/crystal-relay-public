<Window x:Class="VrcTwitchOscBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:VrcTwitchOscBridge"
        xmlns:loc="clr-namespace:VrcTwitchOscBridge.Services"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:VrcTwitchOscBridge.Models"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="Assets/crystal-relay-icon.ico"
        Height="940"
        Width="1540"
        MinHeight="820"
        MinWidth="1280"
        WindowStyle="None"
        ResizeMode="CanResize"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource BodyFontFamily}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <local:ScalePreviewConverter x:Key="ScalePreviewConverter" />
        <DataTemplate x:Key="AboutTwitchProfileTemplate">
            <Border x:Name="AboutProfileCard"
                    Margin="0,12,0,0"
                    Padding="12"
                    MinWidth="280"
                    Background="{DynamicResource PanelHighlightBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="56"
                          Height="56"
                          VerticalAlignment="Center">
                        <Border x:Name="AboutProfileIconBorder"
                                Background="{DynamicResource PanelHighlightBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="4"
                                CornerRadius="6" />
                        <Border x:Name="AboutProfilePlaceholder"
                                Margin="5"
                                Background="{DynamicResource SecondaryButtonBrush}"
                                CornerRadius="2">
                            <TextBlock Text="{Binding Initial}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Border>
                        <Border x:Name="AboutProfileImageFrame"
                                Margin="5"
                                CornerRadius="2"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <Image Source="{Binding ProfileImageUri}"
                                   Stretch="UniformToFill" />
                        </Border>
                        <Border x:Name="AboutProfileLiveBadge"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-8,-12,0"
                                Padding="6,2"
                                Background="#35C85D"
                                BorderBrush="#E8FFF0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="Collapsed">
                            <TextBlock Text="{loc:Translate 'LIVE'}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#08210F" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding DisplayName}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="15">
                            <Run Text="{loc:Translate 'Watch on '}" />
                            <Hyperlink NavigateUri="{Binding TwitchUri}"
                                       RequestNavigate="OnHyperlinkRequestNavigate"
                                       Foreground="{DynamicResource AccentBrush}">
                                <Run Text="Twitch" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasProfileImage}" Value="True">
                    <Setter TargetName="AboutProfilePlaceholder" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="AboutProfileImageFrame" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="AboutProfileCard" Property="BorderBrush" Value="#35C85D" />
                    <Setter TargetName="AboutProfileIconBorder" Property="BorderBrush" Value="#35C85D" />
                    <Setter TargetName="AboutProfileLiveBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="AboutTesterProfileTemplate">
            <Border x:Name="AboutTesterProfileCard"
                    Margin="0,12,12,0"
                    Padding="12"
                    MinWidth="236"
                    Background="{DynamicResource PanelHighlightBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="52"
                          Height="52"
                          VerticalAlignment="Center">
                        <Border x:Name="AboutTesterIconBorder"
                                Background="{DynamicResource PanelHighlightBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="4"
                                CornerRadius="6" />
                        <Border x:Name="AboutTesterProfilePlaceholder"
                                Margin="4"
                                Background="{DynamicResource SecondaryButtonBrush}"
                                CornerRadius="2">
                            <TextBlock Text="{Binding Initial}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Border>
                        <Border x:Name="AboutTesterProfileImageFrame"
                                Margin="4"
                                CornerRadius="2"
                                ClipToBounds="True"
                                Visibility="Collapsed">
                            <Image Source="{Binding ProfileImageUri}"
                                   Stretch="UniformToFill" />
                        </Border>
                        <Border x:Name="AboutTesterLiveBadge"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-8,-12,0"
                                Padding="6,2"
                                Background="#35C85D"
                                BorderBrush="#E8FFF0"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="Collapsed">
                            <TextBlock Text="{loc:Translate 'LIVE'}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#08210F" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding DisplayName}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="14">
                            <Run Text="{loc:Translate 'Watch on '}" />
                            <Hyperlink NavigateUri="{Binding TwitchUri}"
                                       RequestNavigate="OnHyperlinkRequestNavigate"
                                       Foreground="{DynamicResource AccentBrush}">
                                <Run Text="Twitch" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasProfileImage}" Value="True">
                    <Setter TargetName="AboutTesterProfilePlaceholder" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="AboutTesterProfileImageFrame" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter TargetName="AboutTesterProfileCard" Property="BorderBrush" Value="#35C85D" />
                    <Setter TargetName="AboutTesterIconBorder" Property="BorderBrush" Value="#35C85D" />
                    <Setter TargetName="AboutTesterLiveBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="VrChatAvatarOptionTemplate">
            <StackPanel>
                <TextBlock Text="{Binding DisplayLabel}"
                           Foreground="{DynamicResource ComboTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0"
                           Text="{Binding SecondaryHint}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSecondaryHint}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TwitchRewardOptionTemplate">
            <StackPanel>
                <TextBlock Text="{Binding DisplayLabel}"
                           Foreground="{DynamicResource ComboTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0"
                           Text="{Binding DetailText}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetailText}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="TwitchPowerUpOptionTemplate">
            <StackPanel>
                <TextBlock Text="{Binding DisplayLabel}"
                           Foreground="{DynamicResource ComboTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0"
                           Text="{Binding DetailText}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetailText}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
        <FontFamily x:Key="BodyFontFamily">Verdana</FontFamily>
        <FontFamily x:Key="HeadingFontFamily">Constantia</FontFamily>
        <sys:Double x:Key="HomeTitleFontSize">28</sys:Double>
        <SolidColorBrush x:Key="WindowBackgroundBrush" po:Freeze="False" Color="#130B1E" />
        <SolidColorBrush x:Key="PanelBrush" po:Freeze="False" Color="#CC1C132B" />
        <SolidColorBrush x:Key="PanelSecondaryBrush" po:Freeze="False" Color="#C8241739" />
        <SolidColorBrush x:Key="PanelHighlightBrush" po:Freeze="False" Color="#C4311C4E" />
        <SolidColorBrush x:Key="BorderBrush" po:Freeze="False" Color="#4B2B78" />
        <SolidColorBrush x:Key="AccentBrush" po:Freeze="False" Color="#A855F7" />
        <SolidColorBrush x:Key="TextBrush" po:Freeze="False" Color="#F5EEFF" />
        <SolidColorBrush x:Key="MutedBrush" po:Freeze="False" Color="#BFAFD8" />
        <SolidColorBrush x:Key="InputBrush" po:Freeze="False" Color="#B8271A3D" />
        <SolidColorBrush x:Key="InputBorderBrush" po:Freeze="False" Color="#5B3A8E" />
        <SolidColorBrush x:Key="ComboSurfaceBrush" po:Freeze="False" Color="#F7F2FF" />
        <SolidColorBrush x:Key="ComboTextBrush" po:Freeze="False" Color="#140C20" />
        <SolidColorBrush x:Key="ComboHighlightBrush" po:Freeze="False" Color="#D8C2FF" />
        <SolidColorBrush x:Key="SecondaryButtonBrush" po:Freeze="False" Color="#2C1C48" />
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" po:Freeze="False" Color="#6942A7" />
        <SolidColorBrush x:Key="SectionActiveBrush" po:Freeze="False" Color="#7C3AED" />
        <SolidColorBrush x:Key="RuleCardBrush" po:Freeze="False" Color="#B8241739" />
        <SolidColorBrush x:Key="RuleCardSelectedBrush" po:Freeze="False" Color="#351C57" />
        <SolidColorBrush x:Key="RuleCardHoverBrush" po:Freeze="False" Color="#8D56E8" />
        <SolidColorBrush x:Key="StatusChipBrush" po:Freeze="False" Color="#8E241841" />
        <SolidColorBrush x:Key="NestedPanelBrush" po:Freeze="False" Color="#B8241739" />
        <SolidColorBrush x:Key="DangerBrush" po:Freeze="False" Color="#4A1729" />
        <SolidColorBrush x:Key="DangerBorderBrush" po:Freeze="False" Color="#A94A71" />
        <SolidColorBrush x:Key="WarningTextBrush" po:Freeze="False" Color="#FF6B8A" />
        <SolidColorBrush x:Key="AttentionBrush" po:Freeze="False" Color="#46390F" />
        <SolidColorBrush x:Key="AttentionBorderBrush" po:Freeze="False" Color="#D9B84F" />
        <SolidColorBrush x:Key="HighlightBorderBrush" po:Freeze="False" Color="#774AC7" />
        <SolidColorBrush x:Key="PopupBorderBrush" po:Freeze="False" Color="#6942A7" />
        <SolidColorBrush x:Key="ComboDropButtonBrush" po:Freeze="False" Color="#E9DBFF" />
        <SolidColorBrush x:Key="ComboDropButtonHoverBrush" po:Freeze="False" Color="#D9C2FF" />
        <SolidColorBrush x:Key="ComboDropButtonPressedBrush" po:Freeze="False" Color="#C7A8FF" />
        <SolidColorBrush x:Key="ScrollTrackBrush" po:Freeze="False" Color="#25183D" />
        <SolidColorBrush x:Key="ScrollThumbBrush" po:Freeze="False" Color="#7B57D0" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" po:Freeze="False" Color="#966AF0" />
        <SolidColorBrush x:Key="ScrollThumbPressedBrush" po:Freeze="False" Color="#B388FF" />
        <SolidColorBrush x:Key="TitleBarBrush" po:Freeze="False" Color="#221333" />
        <SolidColorBrush x:Key="TitleBarTextBrush" po:Freeze="False" Color="#F5EEFF" />
        <SolidColorBrush x:Key="TitleBarSubTextBrush" po:Freeze="False" Color="#CBB9E5" />
        <SolidColorBrush x:Key="TitleBarButtonBrush" po:Freeze="False" Color="#00000000" />
        <SolidColorBrush x:Key="TitleBarButtonHoverBrush" po:Freeze="False" Color="#3B235B" />
        <SolidColorBrush x:Key="TitleBarButtonPressedBrush" po:Freeze="False" Color="#543183" />
        <SolidColorBrush x:Key="TitleBarCloseHoverBrush" po:Freeze="False" Color="#B43D62" />
        <SolidColorBrush x:Key="TitleBarClosePressedBrush" po:Freeze="False" Color="#8C2648" />

        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="20" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.SelectedTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static models:AppTheme.VoidCrystal}">
                    <Setter Property="BorderBrush" Value="{DynamicResource HighlightBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1.4" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16"
                                              ShadowDepth="0"
                                              Opacity="0.32"
                                              Color="#7C56E8"
                                              RenderingBias="Performance" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource TitleBarButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBarButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBarButtonBorder" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleBarButtonBorder" Property="Background" Value="{DynamicResource TitleBarButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TitleBarButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBarCloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBarCloseBorder" Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleBarCloseBorder" Property="Background" Value="{DynamicResource TitleBarClosePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TitleBarCloseBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="ComboBoxEditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{DynamicResource ComboTextBrush}" />
        </Style>

        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource ComboDropButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DropButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,13,13,0">
                            <Path x:Name="DropArrow"
                                  Width="12"
                                  Height="8"
                                  Stretch="Fill"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 0 L 6 6 L 12 0"
                                  Stroke="{DynamicResource ComboTextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropButtonBorder" Property="Opacity" Value="0.55" />
                                <Setter TargetName="DropArrow" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboPopupTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboPopupThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ComboPopupThumbBorder"
                                Width="8"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboPopupThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ComboPopupThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboPopupVerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="{TemplateBinding Width}"
                  Background="Transparent">
                <Border Width="8"
                        HorizontalAlignment="Center"
                        Margin="0,2"
                        Background="{DynamicResource ScrollTrackBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                <Track x:Name="PART_Track"
                       Margin="0,2"
                       IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageUpCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ComboPopupThumbStyle}"
                               MinHeight="30" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageDownCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ComboPopupHorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="{TemplateBinding Height}"
                  Background="Transparent">
                <Border Height="8"
                        VerticalAlignment="Center"
                        Margin="2,0"
                        Background="{DynamicResource ScrollTrackBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4" />
                <Track x:Name="PART_Track"
                       Margin="2,0">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageLeftCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ComboPopupThumbStyle}"
                               MinWidth="30" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageRightCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style x:Key="ComboPopupScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource ComboPopupVerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template" Value="{StaticResource ComboPopupHorizontalScrollBarTemplate}" />
