        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="PreviewMouseWheel" Handler="OnRuleTogglePreviewMouseWheel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{DynamicResource RuleCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="14">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource RuleCardSelectedBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource RuleCardHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                                <Grid>
                                    <Border x:Name="CheckChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" />
                                    <Path x:Name="CheckMark"
                                          Width="12"
                                          Height="9"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 1 5 L 4.5 8 L 11 1"
                                          Stroke="White"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              ContentSource="Content" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource RuleCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RuleToggleStyle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Content" Value="Off" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="PreviewMouseWheel" Handler="OnRuleTogglePreviewMouseWheel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="On" />
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource RuleCardHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type models:AvatarTriggerProfile}">
            <Grid HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0"
                              VerticalAlignment="Top"
                              Style="{StaticResource RuleToggleStyle}"
                              IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding DisplayTitle}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding AvatarDisplayName}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch">
                    <Border Margin="0,0,0,8"
                            Padding="10,4"
                            HorizontalAlignment="Left"
                            CornerRadius="10"
                            Background="{DynamicResource StatusChipBrush}"
                            Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMasterProfile}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{loc:Translate 'Return Avatar'}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                    </Border>
                    <Grid ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Padding="9,4"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                Background="{DynamicResource PanelHighlightBrush}">
                            <TextBlock Text="{Binding TriggerCountText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border Grid.Column="2"
                                Margin="0,0,0,0"
                                Padding="9,4"
                                HorizontalAlignment="Left"
                                MaxWidth="150"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource AccentBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentAvatarActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CurrentAvatarStatusText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentAvatarActive}" Value="True">
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:TriggerRule}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0"
                                  VerticalAlignment="Top"
                                  Style="{StaticResource RuleToggleStyle}"
                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayTitle}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                </Grid>
                <TextBlock Grid.Row="1"
                           Margin="0,8,0,0"
                           Text="{Binding TriggerSummary}"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        Padding="8,3"
                        HorizontalAlignment="Left"
                        CornerRadius="9"
                        Background="{DynamicResource StatusChipBrush}"
                        Visibility="{Binding HasSupporterAvatarScopeLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding SupporterAvatarScopeLabel}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:UniversalTriggerRule}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0"
                                  VerticalAlignment="Top"
                                  Style="{StaticResource RuleToggleStyle}"
                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayTitle}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                </Grid>
                <TextBlock Grid.Row="1"
                           Margin="0,8,0,0"
                           Text="{Binding TriggerSummary}"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:UniversalTriggerAction}">
            <TextBlock Text="{Binding DisplaySummary}"
                       Foreground="{DynamicResource TextBrush}"
                       TextWrapping="Wrap" />
        </DataTemplate>

        <DataTemplate x:Key="AvatarRedeemListItemTemplate"
                      DataType="{x:Type models:TriggerRule}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0"
                              VerticalAlignment="Top"
                              Style="{StaticResource RuleToggleStyle}"
                              IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding RewardDisplayTitle}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding AvatarRedeemListSummary}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="3"
                        Margin="12,0,0,0"
                        Padding="10,4"
                        VerticalAlignment="Top"
                        CornerRadius="10"
                        Background="{DynamicResource StatusChipBrush}"
                        Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSpecialRuleLockouts}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{loc:Translate 'Disable pairing set'}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AvatarScaleRuleListItemTemplate"
                      DataType="{x:Type models:AvatarScaleRule}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0"
                              VerticalAlignment="Top"
                              Style="{StaticResource RuleToggleStyle}"
                              IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding DisplayTitle}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding TriggerSummary}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="3"
                        Margin="12,0,0,0"
                        Padding="10,4"
                        VerticalAlignment="Top"
                        CornerRadius="10"
                        Background="{DynamicResource StatusChipBrush}"
                        Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasScaleDisablePairings}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{loc:Translate 'Disable pairing set'}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AvatarScaleSetListItemTemplate"
                      DataType="{x:Type models:AvatarScaleSet}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DisplayTitle}"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding ScaleCountText}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="10,4"
                        VerticalAlignment="Top"
                        CornerRadius="10"
                        Background="{DynamicResource StatusChipBrush}">
                    <TextBlock Text="{Binding ScaleCountText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="ThemeBackgroundHost"
                            Grid.RowSpan="2"
                            IsHitTestVisible="False"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="12,8,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Source="Assets/crystal-relay-icon.png"
                               Width="24"
                               Height="24"
                               Margin="0,0,10,0"
                               Stretch="Uniform" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Crystal Relay"
                                       Foreground="{DynamicResource TitleBarTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding WindowHeaderSubtitle}"
                                       Foreground="{DynamicResource TitleBarSubTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnMinimizeButtonClick"
                              ToolTip="{loc:Translate 'Minimize'}">
                            <TextBlock Text="&#x2013;"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,-6,0,0"
                                       Foreground="{DynamicResource TitleBarTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnToggleMaximizeButtonClick"
                              ToolTip="{loc:Translate 'Maximize or restore'}">
                            <TextBlock x:Name="WindowStateGlyph"
                                       Text="&#x25A1;"
                                       FontSize="14"
                                       Foreground="{DynamicResource TitleBarTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnHideToTrayButtonClick"
                              ToolTip="{loc:Translate 'Hide to tray'}">
                            <TextBlock Text="&#x00D7;"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBarTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="OnPowerButtonClick"
                              ToolTip="{loc:Translate 'Power Off'}">
                            <Viewbox Width="16"
                                     Height="16"
                                     Stretch="Uniform">
                                <Grid Width="24" Height="24">
                                    <Path Data="M12,3 L12,11"
                                          Stroke="{DynamicResource TitleBarTextBrush}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path Data="M7.4,5.2 A7.2,7.2 0 1 0 16.6,5.2"
                                          Stroke="{DynamicResource TitleBarTextBrush}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        <Grid Grid.Row="1" Margin="22" Opacity="{Binding Settings.InterfaceOpacity}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.14*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="1.66*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="5" Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource HomeSectionButtonStyle}"
                            Content="{loc:Translate 'Home'}"
                            Command="{Binding ShowHomeSectionCommand}" />
                    <Button Style="{StaticResource SettingsSectionButtonStyle}"
                            Content="{loc:Translate 'Settings'}"
                            Command="{Binding ShowSettingsSectionCommand}" />
                    <Button Style="{StaticResource ActivitySectionButtonStyle}"
                            Content="{loc:Translate 'Activity'}"
                            Command="{Binding ShowActivitySectionCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Top-right actions stay available from any main section:
                         stream-safe pause, test mode toggle, chatbox, and About. -->
                    <Button Margin="0,0,10,0"
                            Content="{Binding EmergencyRedeemStopButtonText}"
                            ToolTip="{Binding EmergencyRedeemStopHelpText}"
                            Command="{Binding ToggleEmergencyRedeemStopCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmergencyRedeemStopEnabled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="0,0,10,0"
                            Content="{Binding RewardTestOverrideButtonText}"
                            Command="{Binding ToggleSelectedAvatarRewardTestOverrideCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStreamingTestButtonVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Content="{loc:Translate 'Twitch Chatbox'}"
                            Command="{Binding OpenTwitchChatboxCommand}" />
                    <Grid Margin="10,0,0,0">
                        <Button Style="{StaticResource AboutSectionButtonStyle}"
                                Margin="0"
                                Content="{loc:Translate 'About'}"
                                Command="{Binding ShowAboutSectionCommand}" />
                        <Border Width="10"
                                Height="10"
                                CornerRadius="5"
                                Background="#44D36E"
                                BorderBrush="#E8FFF0"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-3,-3,0"
                                Panel.ZIndex="2"
                                ToolTip="{loc:Translate 'Someone in About is live right now.'}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLiveAboutProfiles}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0">
                <!-- Home section:
                     quick status cards, the main icon/home area, and first-stop actions for normal use. -->
                <ScrollViewer
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHomeSectionSelected}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                    <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource PanelBrush}" Padding="24">
                        <StackPanel>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                 <Button Width="138"
                                         Height="138"
                                         Margin="0,0,8,0"
                                         Padding="0"
                                         Background="Transparent"
                                         BorderBrush="Transparent"
                                         BorderThickness="0"
                                         Cursor="Arrow"
                                         Focusable="False"
                                         FocusVisualStyle="{x:Null}"
                                         Click="OnHomeBrandIconClicked">
                                     <Button.Template>
                                         <ControlTemplate TargetType="Button">
                                             <ContentPresenter />
                                         </ControlTemplate>
                                     </Button.Template>
                                    <Grid Width="138"
                                          Height="138">
                                         <Border Background="{DynamicResource PanelHighlightBrush}"
                                                 BorderBrush="{DynamicResource AccentBrush}"
                                                 BorderThickness="3"
                                                 CornerRadius="26" />
                                         <Border Margin="6"
                                                 Background="{DynamicResource PanelSecondaryBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 BorderThickness="1.5"
                                                 CornerRadius="20">
                                             <Grid>
                                                 <Grid.Clip>
                                                     <RectangleGeometry Rect="0,0,124,124"
                                                                        RadiusX="20"
                                                                        RadiusY="20" />
                                                 </Grid.Clip>
                                                 <Image Source="Assets/crystal-relay-icon.png"
                                                        Stretch="UniformToFill" />
                                                 <Border Background="Transparent"
                                                         BorderBrush="{DynamicResource PanelHighlightBrush}"
                                                         BorderThickness="2"
                                                         CornerRadius="20"
                                                         IsHitTestVisible="False" />
                                             </Grid>
                                         </Border>
                                     </Grid>
                                 </Button>
                                 <TextBlock Grid.Column="1"
                                            Margin="14,0,0,0"
                                            Text="{loc:Translate 'Crystal Relay'}"
                                            Style="{StaticResource HeadingTextStyle}"
                                            FontSize="{DynamicResource HomeTitleFontSize}"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource TextBrush}" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0" Text="{loc:Translate 'Twitch to OSC for VRChat'}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                            <Border Margin="0,16,0,0" Background="{DynamicResource StatusChipBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,10">
                                <TextBlock Text="{Binding RuntimeConfigStatus}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Margin="0,14,0,0">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Translate 'Support Crystal Relay'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource HelpIconButtonStyle}"
                                            Click="OnHelpButtonClicked"
                                            CommandParameter="Support Crystal Relay"
                                            Tag="Crystal Relay is free for everyone. If it helps your stream and you want to support development, you can leave a tip on Ko-fi." />
                                </WrapPanel>
                                <Border Margin="0,6,0,0"
                                        Background="{DynamicResource PanelHighlightBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="16"
                                        Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource StatusChipBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="9,4">
                                            <TextBlock Text="{loc:Translate '100% free, always'}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                        <Button Grid.Column="1"
                                                MinWidth="158"
                                                Margin="10,0,0,0"
                                                Padding="18,10"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="{loc:Translate 'Support on Ko-fi'}"
                                                Command="{Binding OpenKoFiSupportCommand}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="{loc:Translate 'Open Crystal Relay Folder'}" Command="{Binding OpenSaveFolderCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorderStyle}" Margin="0,16,0,0" Background="{DynamicResource PanelSecondaryBrush}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'OSC Status'}" Style="{StaticResource HeadingTextStyle}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Margin="0,10,0,0" Text="{Binding OscBridgeSummary}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding OscStatusDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                            <Button Margin="0,12,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{loc:Translate 'Force Refresh'}"
                                    Command="{Binding RefreshOscConnectionCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelBorderStyle}" Margin="0,16,0,0" Background="{DynamicResource PanelSecondaryBrush}" Padding="18">
                        <Border.Resources>
                            <Style x:Key="StreamingStatusIllustrationBorderStyle" TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="CornerRadius" Value="16" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Live">
                                        <Setter Property="Background" Value="{DynamicResource PanelHighlightBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Healthy">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Checking">
                                        <Setter Property="Background" Value="{DynamicResource StatusChipBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Error">
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="StreamingStatusIllustrationShapeStyle" TargetType="Shape">
                                <Setter Property="Stroke" Value="{DynamicResource InputBorderBrush}" />
                                <Setter Property="StrokeThickness" Value="2" />
                                <Setter Property="StrokeStartLineCap" Value="Round" />
                                <Setter Property="StrokeEndLineCap" Value="Round" />
                                <Setter Property="StrokeLineJoin" Value="Round" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Live">
                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Healthy">
                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Error">
                                        <Setter Property="Stroke" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <Style x:Key="StreamingStatusIndicatorDotStyle" TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource InputBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Live">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
