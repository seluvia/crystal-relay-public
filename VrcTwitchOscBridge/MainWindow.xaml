                                                </StackPanel>
                                            </Border>

                                            <Border Margin="0,18,0,0"
                                                    Background="{DynamicResource PanelHighlightBrush}"
                                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="18">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsesSupporterGrowth}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
