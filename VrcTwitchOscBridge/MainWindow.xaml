                                                           Text="{Binding DataContext.PowerUpRuleStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" />

                                                <Border Margin="0,16,0,0"
                                                        Background="{DynamicResource NestedPanelBrush}"
                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="16"
                                                        Padding="14">
                                                    <StackPanel>
                                                        <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}">
