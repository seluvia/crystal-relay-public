                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type models:UniversalTriggerRule}">
                                            <StackPanel>
                                                <WrapPanel Margin="0,14,0,0">
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="{loc:Translate 'Add Action'}"
                                                            Command="{Binding DataContext.AddUniversalTriggerActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="{loc:Translate 'Delete Action'}"
                                                            Command="{Binding DataContext.RemoveSelectedUniversalTriggerActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </WrapPanel>

                                                <Border Margin="0,20,0,0"
                                                        Background="{DynamicResource NestedPanelBrush}"
                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'Trigger Settings'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="17" />
                                                        <CheckBox Margin="0,10,0,0"
                                                                  Content="{loc:Translate 'Enabled'}"
                                                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                        <UniformGrid Columns="2"
                                                                     Margin="0,12,0,0">
                                                            <StackPanel Margin="0,0,14,0">
                                                                <TextBlock Text="{loc:Translate 'Display Name'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="14,0,0,0">
                                                                <TextBlock Text="{loc:Translate 'Trigger Type'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <ComboBox ItemsSource="{Binding DataContext.UniversalTriggerTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding TriggerType, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </UniformGrid>

                                                        <UniformGrid Columns="2"
                                                                     Margin="0,12,0,0">
                                                            <StackPanel Margin="0,0,14,0">
                                                                <TextBlock Text="{loc:Translate 'Global Delay (seconds)'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding GlobalDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="14,0,0,0">
                                                                <TextBlock Text="{loc:Translate 'User Delay (seconds)'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding UserDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <CheckBox Margin="0,12,0,0"
                                                                  Content="{loc:Translate 'Choose one random action instead of running all actions'}"
                                                                  IsChecked="{Binding ExecuteRandomAction, UpdateSourceTrigger=PropertyChanged}" />

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesChatCommand, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <UniformGrid Columns="2">
                                                                <StackPanel Margin="0,0,14,0">
                                                                    <TextBlock Text="{loc:Translate 'Exact Chat Command'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="14,0,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Who Can Use It'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <ComboBox ItemsSource="{Binding DataContext.ChatCommandPermissionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              DisplayMemberPath="Label"
                                                                              SelectedValuePath="Value"
                                                                              SelectedValue="{Binding ChatCommandPermission, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesChannelPointReward, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Twitch Redeem'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Twitch Redeem"
                                                                        Tag="{Binding DataContext.UniversalManagedChannelPointRewardHelpText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </DockPanel>
                                                            <StackPanel Margin="0,8,0,0">
                                                                <TextBlock Text="{loc:Translate 'Reward Source'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <ComboBox ItemsSource="{Binding DataContext.RewardSyncModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          DisplayMemberPath="Label"
                                                                          SelectedValuePath="Value"
                                                                          SelectedValue="{Binding RewardSyncMode, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,10,0,0"
                                                                        Visibility="{Binding UsesLinkedExistingReward, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{loc:Translate 'Existing Twitch Reward'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <ComboBox ItemsSource="{Binding DataContext.RewardOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          ItemTemplate="{StaticResource TwitchRewardOptionTemplate}"
                                                                          SelectedValuePath="Id"
                                                                          SelectedValue="{Binding RewardId, UpdateSourceTrigger=PropertyChanged}" />
                                                                <DockPanel Margin="0,8,0,0"
                                                                           LastChildFill="False">
                                                                    <Button Style="{StaticResource RewardLinkButtonStyle}"
                                                                            Content="{loc:Translate 'Refresh Rewards'}"
                                                                            Command="{Binding DataContext.RefreshTwitchRewardsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                    <Button Margin="8,0,0,0"
                                                                            Style="{StaticResource RewardLinkButtonStyle}"
                                                                            Content="{loc:Translate 'Unlink Reward'}"
                                                                            Command="{Binding DataContext.UnlinkTwitchRewardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </DockPanel>
                                                                <TextBlock Margin="0,6,0,0"
                                                                          Text="{loc:Translate 'Linked rewards are configured on Twitch. Crystal Relay only listens for this reward being redeemed and will not edit its name, cost, prompt, color, input settings, visibility, or cooldown.'}"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <UniformGrid Columns="2"
                                                                          Margin="0,8,0,0">
                                                                <UniformGrid.Style>
                                                                    <Style TargetType="UniformGrid">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </UniformGrid.Style>
                                                                <StackPanel Margin="0,0,14,0">
                                                                    <TextBlock Text="{loc:Translate 'Reward Name'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding RewardTitle, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="14,0,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Reward Cost'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding RewardCost, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                            <StackPanel Margin="0,10,0,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="{loc:Translate 'Reward Description'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding RewardDescription, UpdateSourceTrigger=PropertyChanged}"
                                                                         AcceptsReturn="True"
                                                                         Height="70"
                                                                         TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Text="{loc:Translate 'Shown on Twitch as the reward description. Leave blank to use the Crystal Relay default.'}"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,10,0,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="{loc:Translate 'Reward Cooldown (seconds)'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox MaxWidth="220"
                                                                         HorizontalAlignment="Left"
                                                                         Text="{Binding RewardCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Text="{loc:Translate 'Only Crystal Relay-created Universal channel-point rewards use this Twitch cooldown. Global Delay and User Delay are Crystal Relay-only trigger waits.'}"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                             <TextBlock Margin="0,10,0,0"
                                                                        Text="{Binding DataContext.UniversalManagedRewardStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Foreground="{DynamicResource MutedBrush}"
                                                                        TextWrapping="Wrap" />
                                                              <Border Margin="0,12,0,0"
                                                                      Background="{DynamicResource PanelSecondaryBrush}"
                                                                      BorderBrush="{DynamicResource InputBorderBrush}"
                                                                      BorderThickness="1"
                                                                      CornerRadius="14"
                                                                      Padding="12">
                                                                  <Border.Style>
                                                                      <Style TargetType="Border">
                                                                          <Setter Property="Visibility" Value="Visible" />
                                                                          <Style.Triggers>
                                                                              <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                                                                  <Setter Property="Visibility" Value="Collapsed" />
                                                                              </DataTrigger>
                                                                          </Style.Triggers>
                                                                      </Style>
                                                                  </Border.Style>
                                                                  <StackPanel>
                                                                      <CheckBox IsChecked="{Binding DeleteManagedRewardWhenInactive, UpdateSourceTrigger=PropertyChanged}">
                                                                         <TextBlock Text="{loc:Translate 'Delete Twitch reward when inactive'}"
                                                                                    TextWrapping="Wrap" />
                                                                     </CheckBox>
                                                                     <TextBlock Margin="26,6,0,0"
                                                                                Foreground="{DynamicResource MutedBrush}"
                                                                                TextWrapping="Wrap"
                                                                                Text="{loc:Translate 'Frees Twitch reward slots. Crystal Relay will recreate or relink this reward when it becomes active again.'}" />
                                                                 </StackPanel>
                                                             </Border>
                                                             <Border Margin="0,12,0,0"
                                                                     Background="{DynamicResource PanelSecondaryBrush}"
                                                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                                                     BorderThickness="1"
                                                                     CornerRadius="14"
                                                                     Padding="12">
                                                                 <StackPanel>
                                                                     <TextBlock Text="{loc:Translate 'Chat Command Fallback'}"
                                                                                Foreground="{DynamicResource TextBrush}"
                                                                                FontWeight="SemiBold" />
                                                                     <CheckBox Margin="0,8,0,0"
                                                                               Content="{loc:Translate 'Allow this reward to also run from a ! chat command'}"
                                                                               IsChecked="{Binding ChatCommandEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                                     <UniformGrid Columns="2"
                                                                                  Margin="0,12,0,0"
                                                                                  Visibility="{Binding ChatCommandEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                         <StackPanel Margin="0,0,14,0">
                                                                             <TextBlock Text="{loc:Translate 'Command'}"
                                                                                        Foreground="{DynamicResource TextBrush}"
                                                                                        FontWeight="SemiBold" />
                                                                             <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" />
                                                                         </StackPanel>
                                                                         <StackPanel Margin="14,0,0,0">
                                                                             <TextBlock Text="{loc:Translate 'Who Can Use It'}"
                                                                                        Foreground="{DynamicResource TextBrush}"
                                                                                        FontWeight="SemiBold" />
                                                                             <ComboBox ItemsSource="{Binding DataContext.ChatCommandPermissionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       DisplayMemberPath="Label"
                                                                                       SelectedValuePath="Value"
                                                                                       SelectedValue="{Binding ChatCommandPermission, UpdateSourceTrigger=PropertyChanged}" />
                                                                         </StackPanel>
                                                                     </UniformGrid>
                                                                 </StackPanel>
                                                              </Border>
                                                              <StackPanel Margin="0,12,0,0">
                                                                 <StackPanel.Style>
                                                                     <Style TargetType="StackPanel">
                                                                         <Setter Property="Visibility" Value="Visible" />
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </StackPanel.Style>
                                                                  <TextBlock Text="{loc:Translate 'Managed Reward Colors'}"
                                                                             Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding DataContext.ManagedRewardColorsDescriptionText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <StackPanel Margin="0,10,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Ready Color'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <DockPanel Margin="0,6,0,0"
                                                                               LastChildFill="False">
                                                                        <Border Width="28"
                                                                                Height="28"
                                                                                CornerRadius="14"
                                                                                Background="{Binding ManagedRewardReadyColorBrush}"
                                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                                BorderThickness="1" />
                                                                        <TextBlock Margin="12,0,16,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="{Binding ManagedRewardReadyColor}" />
                                                                        <Button Content="{loc:Translate 'Choose Color'}"
                                                                                Padding="16,6"
                                                                                MinWidth="132"
                                                                                Click="OnPickManagedRewardColorClicked"
                                                                                Tag="Ready" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,12,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Cooldown Color'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <DockPanel Margin="0,6,0,0"
                                                                               LastChildFill="False">
                                                                        <Border Width="28"
                                                                                Height="28"
                                                                                CornerRadius="14"
                                                                                Background="{Binding ManagedRewardCooldownColorBrush}"
                                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                                BorderThickness="1" />
                                                                        <TextBlock Margin="12,0,16,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="{Binding ManagedRewardCooldownColor}" />
                                                                        <Button Content="{loc:Translate 'Choose Color'}"
                                                                                Padding="16,6"
                                                                                MinWidth="132"
                                                                                Click="OnPickManagedRewardColorClicked"
                                                                                Tag="Cooldown" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesBits, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <UniformGrid Columns="2">
                                                                <StackPanel Margin="0,0,14,0">
                                                                    <TextBlock Text="{loc:Translate 'Minimum Bits'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MinimumBits, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="14,0,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Maximum Bits'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MaximumBits, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesSubscription, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <UniformGrid Columns="3">
                                                                <StackPanel Margin="0,0,10,0">
                                                                    <TextBlock Text="{loc:Translate 'Sub Tier'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding SubscriptionTier, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="10,0,10,0">
                                                                    <TextBlock Text="{loc:Translate 'Min Months'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MinimumMonths, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="10,0,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Max Months'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MaximumMonths, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,20,0,0"
                                                        Background="{DynamicResource NestedPanelBrush}"
                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'OSC Actions'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="17" />
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Text="{loc:Translate 'Run all actions in order, or enable random mode above to pick one action per trigger. Queued actions serialize repeated activations for this trigger.'}"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <Border Margin="0,12,0,0"
                                                                Padding="12"
                                                                Background="{DynamicResource PanelSecondaryBrush}"
                                                                BorderBrush="{DynamicResource DangerBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14">
                                                            <StackPanel>
                                                                <TextBlock Text="{loc:Translate 'Universal Trigger Setup Warning'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Text="{loc:Translate 'Avatar parameter actions can be written as twitch or /avatar/parameters/twitch. Managed Universal rewards only show for the current avatar when at least one avatar-parameter action exists in that avatar local OSC file. Direct OSC paths that start with /, such as /input/Jump, are sent as written and do not control reward visibility. Wrong value type, missing target/default values, or missing parameters can make a trigger look like it did nothing.'}"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ListBox Margin="0,12,0,0"
                                                                 MaxHeight="180"
                                                                 ItemsSource="{Binding Actions}"
                                                                 SelectedItem="{Binding DataContext.SelectedUniversalTriggerAction, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <ContentControl Margin="0,16,0,0"
                                                                        Content="{Binding DataContext.SelectedUniversalTriggerAction, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate DataType="{x:Type models:UniversalTriggerAction}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{loc:Translate 'Selected Action'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <UniformGrid Columns="2"
                                                                                     Margin="0,10,0,0">
                                                                            <StackPanel Margin="0,0,14,0">
                                                                                <TextBlock Text="{loc:Translate 'Avatar Parameter'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding OscAddress, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="14,0,0,0">
                                                                                <TextBlock Text="{loc:Translate 'Value Type'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <ComboBox ItemsSource="{Binding DataContext.UniversalTriggerValueKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                          SelectedItem="{Binding ValueKind, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                        </UniformGrid>
                                                                        <UniformGrid Columns="3"
                                                                                     Margin="0,12,0,0">
                                                                            <StackPanel Margin="0,0,10,0">
                                                                                <TextBlock Text="{loc:Translate 'Target Value'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="10,0,10,0">
                                                                                <TextBlock Text="{loc:Translate 'Default Value'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="10,0,0,0">
                                                                                <TextBlock Text="{loc:Translate 'Duration'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                        </UniformGrid>
                                                                        <CheckBox Margin="0,12,0,0"
                                                                                  Content="{loc:Translate 'Add this action to the trigger queue'}"
                                                                                  IsChecked="{Binding AddToQueue, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,18,0,0"
                                    Background="{DynamicResource PanelHighlightBrush}"
                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRule}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ContentControl Content="{Binding SelectedRule}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type models:TriggerRule}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock FontSize="22"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
                                                                <Setter Property="Text" Value="Redeem Editor" />
                                                                <Setter Property="FontSize" Value="22" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Text" Value="{loc:Translate 'Redeem Editor'}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataContext.IsViewingCashPayments, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Text" Value="{loc:Translate 'Cash Payment Action'}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataContext.IsViewingPowerUps, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Text" Value="{loc:Translate 'Power Up Action'}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
