                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <ListBox ItemsSource="{Binding AvatarScaleSets}"
                                 SelectedItem="{Binding SelectedAvatarScaleSet}"
                                 ItemTemplate="{StaticResource AvatarScaleSetListItemTemplate}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingAvatarScaling}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <ListBox ItemsSource="{Binding CashPaymentRules}"
                                 SelectedItem="{Binding SelectedCashPaymentRule}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingCashPayments}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CashPaymentRule}">
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            Background="{DynamicResource RuleCardBrush}"
                                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding TriggerSummary}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox ItemsSource="{Binding PowerUpRules}"
                                 SelectedItem="{Binding SelectedPowerUpRule}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingPowerUps}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:PowerUpRule}">
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            Background="{DynamicResource RuleCardBrush}"
                                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding TriggerSummary}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding AvatarScopeLabel}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Text" Value="{loc:Translate 'Add an avatar set to get started.'}" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsViewingAvatarTriggers}" Value="True" />
                                                <Condition Binding="{Binding AvatarRuleProfiles.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingMasterAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsViewingMovementRedeems}" Value="True" />
                                                <Condition Binding="{Binding MovementRedeemSets.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Text" Value="{loc:Translate 'Add a movement set to get started.'}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsViewingUniversalTriggers}" Value="True" />
                                                <Condition Binding="{Binding Settings.UniversalTriggers.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Text" Value="{loc:Translate 'Import a Fooma config or add a universal trigger.'}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsViewingAvatarScaling}" Value="True" />
                                                <Condition Binding="{Binding Settings.AvatarScaleSets.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Text" Value="{loc:Translate 'Add a scale set to get started.'}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsViewingCashPayments}" Value="True" />
                                                <Condition Binding="{Binding Settings.CashPaymentRules.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Text" Value="{loc:Translate 'Add a cash payment rule to get started.'}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsViewingPowerUps}" Value="True" />
                                                <Condition Binding="{Binding Settings.PowerUpRules.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Text" Value="{loc:Translate 'Add a Power Up rule to get started.'}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1" Grid.Column="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivitySectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAboutSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Style="{StaticResource PanelBorderStyle}"
                        Background="{DynamicResource PanelSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth}"
                        MaxWidth="920">
                    <ScrollViewer x:Name="RuleWorkspaceScrollViewer"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Redeem Workspace'}"
                                       Style="{StaticResource HeadingTextStyle}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <Border Margin="0,18,0,0"
                                    Background="{DynamicResource PanelHighlightBrush}"
                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
