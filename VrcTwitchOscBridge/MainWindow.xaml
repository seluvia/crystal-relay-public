                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="2" Margin="7,0,0,0">
                                                                            <TextBlock Text="{loc:Translate 'Current (meters)'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding MultCurrentPreview, UpdateSourceTrigger=LostFocus}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </StackPanel>

                                                                <!-- Preset variant -->
                                                                <StackPanel>
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UsesPreset}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="{loc:Translate 'Preset'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
