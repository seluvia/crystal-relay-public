                                                             </UniformGrid>
                                                         </StackPanel>
                                                     </Border>
                                                                 </StackPanel>
                                                             </StackPanel>
                                                         </Border>
                                        <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                            <TextBlock Text="{loc:Translate 'Global Wardrobe Cooldown:'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBox Width="60"
                                                     Margin="8,0,0,0"
                                                     Text="{Binding SelectedAvatarProfile.WardrobeCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="4,0,0,0"
                                                       Text="{loc:Translate 'seconds'}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Border Margin="0,14,0,0"
                                         Background="{DynamicResource NestedPanelBrush}"
                                         BorderBrush="{DynamicResource HighlightBorderBrush}"
                                             BorderThickness="1"
                                             CornerRadius="16"
                                             Padding="14">
                                         <Border.Style>
                                             <Style TargetType="Border">
                                                 <Setter Property="Visibility" Value="Visible" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding IsViewingWardrobe}" Value="True">
                                                         <Setter Property="Visibility" Value="Collapsed" />
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </Border.Style>
                                         <StackPanel>
                                             <Expander Margin="0,0,0,8"
                                                       IsExpanded="{Binding IsAvatarBoolRedeemsExpanded, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextBrush}">
                                                <Expander.Header>
                                                    <Border Padding="10,5"
                                                            Background="{DynamicResource StatusChipBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding AvatarBoolRedeemGroupTitle}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                            <TextBlock Margin="10,0,0,0"
                                                                       Text="{Binding SelectedAvatarBoolRedeems.Count}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                        </DockPanel>
                                                    </Border>
                                                </Expander.Header>
                                                <ListBox Margin="0,8,0,0"
                                                         ItemsSource="{Binding SelectedAvatarBoolRedeems}"
                                                         SelectedItem="{Binding SelectedRule, Mode=OneWay}"
                                                         ScrollViewer.CanContentScroll="True"
                                                         VirtualizingStackPanel.IsVirtualizing="True"
                                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                         ItemTemplate="{StaticResource AvatarRedeemListItemTemplate}" />
                                            </Expander>

                                            <Expander Margin="0,10,0,8"
                                                      IsExpanded="{Binding IsAvatarIntRedeemsExpanded, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextBrush}">
                                                <Expander.Header>
                                                    <Border Padding="10,5"
                                                            Background="{DynamicResource StatusChipBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding AvatarIntRedeemGroupTitle}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                            <TextBlock Margin="10,0,0,0"
                                                                       Text="{Binding SelectedAvatarIntRedeems.Count}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                        </DockPanel>
                                                    </Border>
                                                </Expander.Header>
                                                <ListBox Margin="0,8,0,0"
                                                         ItemsSource="{Binding SelectedAvatarIntRedeems}"
                                                         SelectedItem="{Binding SelectedRule, Mode=OneWay}"
                                                         ScrollViewer.CanContentScroll="True"
                                                         VirtualizingStackPanel.IsVirtualizing="True"
                                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                         ItemTemplate="{StaticResource AvatarRedeemListItemTemplate}" />
                                            </Expander>

                                            <Expander Margin="0,10,0,8"
                                                      IsExpanded="{Binding IsAvatarFloatRedeemsExpanded, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextBrush}">
                                                <Expander.Header>
                                                    <Border Padding="10,5"
                                                            Background="{DynamicResource StatusChipBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding AvatarFloatRedeemGroupTitle}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                            <TextBlock Margin="10,0,0,0"
                                                                       Text="{Binding SelectedAvatarFloatRedeems.Count}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                        </DockPanel>
                                                    </Border>
                                                </Expander.Header>
                                                <ListBox Margin="0,8,0,0"
                                                         ItemsSource="{Binding SelectedAvatarFloatRedeems}"
                                                         SelectedItem="{Binding SelectedRule, Mode=OneWay}"
                                                         ScrollViewer.CanContentScroll="True"
                                                         VirtualizingStackPanel.IsVirtualizing="True"
                                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                         ItemTemplate="{StaticResource AvatarRedeemListItemTemplate}" />
                                            </Expander>

                                            <Expander Margin="0,10,0,8"
                                                      IsExpanded="{Binding IsAvatarMixRedeemsExpanded, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      Visibility="{Binding HasAvatarMixRedeems, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Expander.Header>
                                                    <Border Padding="10,5"
                                                            Background="{DynamicResource StatusChipBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding AvatarMixRedeemGroupTitle}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                            <TextBlock Margin="10,0,0,0"
                                                                       Text="{Binding SelectedAvatarMixRedeems.Count}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                        </DockPanel>
                                                    </Border>
                                                </Expander.Header>
                                                <ListBox Margin="0,8,0,0"
                                                         ItemsSource="{Binding SelectedAvatarMixRedeems}"
                                                         SelectedItem="{Binding SelectedRule, Mode=OneWay}"
                                                         ScrollViewer.CanContentScroll="True"
                                                         VirtualizingStackPanel.IsVirtualizing="True"
                                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                         ItemTemplate="{StaticResource AvatarRedeemListItemTemplate}" />
                                            </Expander>

                                            <Expander Margin="0,10,0,0"
                                                      IsExpanded="{Binding IsAvatarOtherRedeemsExpanded, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextBrush}"
                                                      Visibility="{Binding HasAvatarOtherRedeems, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Expander.Header>
                                                    <Border Padding="10,5"
                                                            Background="{DynamicResource StatusChipBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding AvatarOtherRedeemGroupTitle}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                            <TextBlock Margin="10,0,0,0"
                                                                       Text="{Binding SelectedAvatarOtherRedeems.Count}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                        </DockPanel>
                                                    </Border>
                                                </Expander.Header>
                                                <ListBox Margin="0,8,0,0"
                                                         ItemsSource="{Binding SelectedAvatarOtherRedeems}"
                                                         SelectedItem="{Binding SelectedRule, Mode=OneWay}"
                                                         ScrollViewer.CanContentScroll="True"
                                                         VirtualizingStackPanel.IsVirtualizing="True"
                                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                         ItemTemplate="{StaticResource AvatarRedeemListItemTemplate}" />
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,18,0,0"
                                    Background="{DynamicResource PanelHighlightBrush}"
                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingCashPayments}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedCashPaymentRule}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ContentControl Content="{Binding SelectedCashPaymentRule}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type models:CashPaymentRule}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="{loc:Translate 'Cash Payment Rule'}"
                                                               Style="{StaticResource HeadingTextStyle}"
                                                               FontSize="22"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <Button Style="{StaticResource HelpIconButtonStyle}"
                                                            Click="OnHelpButtonClicked"
                                                            CommandParameter="Cash Payment Rule"
                                                            Tag="{Binding DataContext.CashPaymentActionEditorHelpText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </DockPanel>
                                                <TextBlock Margin="0,10,0,0"
                                                           Text="{Binding DataContext.CashPaymentRuleStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,14,0,0">
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="{loc:Translate 'Test Cash Rule'}"
                                                            Command="{Binding DataContext.TestSelectedCashPaymentRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </WrapPanel>

                                                <Border Margin="0,18,0,0"
                                                        Background="{DynamicResource NestedPanelBrush}"
                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'Payment Match'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="17" />
                                                        <CheckBox Margin="0,10,0,0"
                                                                  Content="{loc:Translate 'Rule enabled'}"
                                                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                        <UniformGrid Columns="2"
                                                                     Margin="0,12,0,0">
                                                            <StackPanel Margin="0,0,14,0">
                                                                <TextBlock Text="{loc:Translate 'Rule Name'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="14,0,0,0">
                                                                <TextBlock Text="{loc:Translate 'Provider'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <ComboBox ItemsSource="{Binding DataContext.CashPaymentProviderOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          DisplayMemberPath="Label"
                                                                          SelectedValuePath="Value"
                                                                          SelectedValue="{Binding Provider, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <UniformGrid Columns="3"
                                                                     Margin="0,12,0,0">
                                                            <StackPanel Margin="0,0,10,0">
                                                                <TextBlock Text="{loc:Translate 'Minimum Amount'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding MinimumAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="10,0,10,0">
                                                                <TextBlock Text="{loc:Translate 'Maximum Amount'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding MaximumAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="10,0,0,0">
                                                                <TextBlock Text="{loc:Translate 'Currency'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <UniformGrid Columns="2"
                                                                     Margin="0,12,0,0">
                                                            <StackPanel Margin="0,0,14,0">
                                                                <TextBlock Text="{loc:Translate 'Message Contains'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding MessageContains, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="14,0,0,0">
                                                                <TextBlock Text="{loc:Translate 'Cooldown Seconds'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Text="{loc:Translate 'Leave maximum amount at 0 for no upper limit. Leave currency blank to accept any currency; v1 does not convert between currencies.'}"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,18,0,0"
                                                        Background="{DynamicResource NestedPanelBrush}"
                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'Cash Action'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="17" />
                                                        <TextBlock Margin="0,10,0,0"
                                                                   Text="{loc:Translate 'Action Family'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <ComboBox ItemsSource="{Binding DataContext.CashPaymentActionKindOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValuePath="Value"
                                                                  SelectedValue="{Binding ActionKind, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{loc:Translate 'Use the action editor below for OSC parameters, Set Trigger, Avatar Change, or Avatar Roulette.'}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesAvatarScaling}" Value="True">
                                                                            <Setter Property="Text" Value="{loc:Translate 'Use the scaling controls below for this cash payment rule.'}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,18,0,0"
                                                        Background="{DynamicResource NestedPanelBrush}"
                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="16">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UsesAvatarScaling}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel DataContext="{Binding ScaleAction}">
                                                        <!-- Heading -->
                                                        <TextBlock Text="{loc:Translate 'Avatar Scaling Action'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="17" />

                                                        <!-- Mode sub-card: six buttons in a row, current mode highlighted -->
                                                        <Border Margin="0,12,0,0"
                                                                Background="{DynamicResource NestedPanelBrush}"
                                                                BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                                BorderThickness="1" CornerRadius="8" Padding="6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0" Margin="2" Tag="SetHeight" Click="ScaleActionModeButton_Click"
                                                                        Content="{loc:Translate 'Set Height'}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ActiveMode}" Value="SetHeight">
                                                                                    <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Grid.Column="1" Margin="2" Tag="RandomHeight" Click="ScaleActionModeButton_Click"
                                                                        Content="{loc:Translate 'Random'}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ActiveMode}" Value="RandomHeight">
                                                                                    <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Grid.Column="2" Margin="2" Tag="RelativeHeight" Click="ScaleActionModeButton_Click"
                                                                        Content="{loc:Translate 'Relative'}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ActiveMode}" Value="RelativeHeight">
                                                                                    <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Grid.Column="3" Margin="2" Tag="Multiplier" Click="ScaleActionModeButton_Click"
                                                                        Content="{loc:Translate 'Multiplier'}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ActiveMode}" Value="Multiplier">
                                                                                    <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Grid.Column="4" Margin="2" Tag="Preset" Click="ScaleActionModeButton_Click"
                                                                        Content="{loc:Translate 'Preset'}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ActiveMode}" Value="Preset">
                                                                                    <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Grid.Column="5" Margin="2" Tag="GlitchyRandomHeight" Click="ScaleActionModeButton_Click"
                                                                        Content="{loc:Translate 'Glitchy'}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ActiveMode}" Value="GlitchyRandomHeight">
                                                                                    <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                    <Setter Property="Foreground" Value="White" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Value sub-card: per-mode fields -->
                                                        <Border Margin="0,12,0,0"
                                                                Background="{DynamicResource NestedPanelBrush}"
                                                                BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                                BorderThickness="1" CornerRadius="8" Padding="14">
                                                            <StackPanel>
                                                                <!-- SetHeight variant -->
                                                                <StackPanel>
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UsesTargetHeight}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="{loc:Translate 'Target Height Meters'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding TargetHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                                </StackPanel>

                                                                <!-- Random / Glitchy shared range variant -->
                                                                <StackPanel>
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UsesRandomHeightRange}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <UniformGrid Columns="2">
                                                                        <StackPanel Margin="0,0,7,0">
                                                                            <TextBlock Text="{loc:Translate 'Random Min Height'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding MinimumHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                                        </StackPanel>
                                                                        <StackPanel Margin="7,0,0,0">
                                                                            <TextBlock Text="{loc:Translate 'Random Max Height'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding MaximumHeightMeters, UpdateSourceTrigger=LostFocus}" />
