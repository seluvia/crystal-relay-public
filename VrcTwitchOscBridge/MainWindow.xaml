                                                          Foreground="{DynamicResource TextBrush}">
                                                    <Expander.Header>
                                                        <Border Padding="10,5"
                                                                Background="{DynamicResource StatusChipBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="12">
                                                            <DockPanel LastChildFill="False">
