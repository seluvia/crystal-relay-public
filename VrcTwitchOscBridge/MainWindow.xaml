                                                                BorderThickness="1"
                                                                CornerRadius="12">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{Binding UniversalGiftSubscriptionGroupTitle}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12" />
                                                                <TextBlock Margin="10,0,0,0"
