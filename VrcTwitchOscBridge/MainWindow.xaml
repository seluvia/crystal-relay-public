                                                                    <StackPanel Margin="10,0,0,0">
                                                                        <TextBlock Text="{loc:Translate 'Smooth Seconds'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
