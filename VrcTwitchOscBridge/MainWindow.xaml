                                                                       Text="{loc:Translate 'Pick a scale redeem in this set to edit it below, test it, or delete it.'}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <WrapPanel Margin="0,14,0,0">
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Content="{loc:Translate 'Add Scale Redeem'}"
                                                                        Command="{Binding DataContext.AddAvatarScaleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Content="{loc:Translate 'Delete Scale Redeem'}"
                                                                        Command="{Binding DataContext.RemoveSelectedAvatarScaleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Content="{loc:Translate 'Test Scale'}"
                                                                        Command="{Binding DataContext.TestSelectedAvatarScaleRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Content="{loc:Translate 'Disable Pairing'}"
                                                                        Command="{Binding DataContext.OpenAvatarScaleRuleLockoutPickerCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
