                                                                           Text="{Binding DataContext.ManagedRewardColorsDescriptionText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <StackPanel Margin="0,10,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Ready Color'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <DockPanel Margin="0,6,0,0"
                                                                               LastChildFill="False">
                                                                        <Border Width="28"
                                                                                Height="28"
                                                                                CornerRadius="14"
                                                                                Background="{Binding ManagedRewardReadyColorBrush}"
                                                                                BorderBrush="{DynamicResource InputBorderBrush}"
