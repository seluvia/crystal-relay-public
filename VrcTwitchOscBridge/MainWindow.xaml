                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
