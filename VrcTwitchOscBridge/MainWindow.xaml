                                                                </StackPanel>
                                                            </StackPanel>
                                                            <CheckBox Margin="0,10,0,0"
                                                                      Content="{loc:Translate 'Enable chat command fallback'}"
                                                                      IsChecked="{Binding ChatCommandEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Margin="0,16,0,0"
                                                            Padding="14"
                                                            Background="{DynamicResource NestedPanelBrush}"
                                                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesChatCommand}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UsesChannelPointReward}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{loc:Translate 'Chat Command'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <UniformGrid Columns="2"
                                                                         Margin="0,10,0,0">
                                                                <StackPanel Margin="0,0,14,0">
                                                                    <TextBlock Text="{loc:Translate 'Command Text'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="14,0,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Permission'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <ComboBox ItemsSource="{Binding DataContext.ChatCommandPermissionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              DisplayMemberPath="Label"
                                                                              SelectedValuePath="Value"
                                                                              SelectedValue="{Binding ChatCommandPermission, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Margin="0,16,0,0"
                                                            Padding="14"
                                                            Background="{DynamicResource NestedPanelBrush}"
                                                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesBits}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
