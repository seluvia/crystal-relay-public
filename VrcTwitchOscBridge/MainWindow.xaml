                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Text="{loc:Translate 'Supporter Growth listens to subs, gift subs, and bits. Each event adds height, resets the timer, then returns to normal when support stops.'}"
