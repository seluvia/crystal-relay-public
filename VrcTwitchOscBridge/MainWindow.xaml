                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </Border>
                                    <ContentControl Margin="0,14,0,0"
                                                    Content="{Binding SelectedAvatarScaleSet}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
