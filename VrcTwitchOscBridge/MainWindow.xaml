                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock Text="{Binding BotDeviceCodeDisplayText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                                                        <Button Style="{StaticResource HelpIconButtonStyle}"
