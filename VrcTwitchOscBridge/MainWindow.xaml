                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Border Margin="0,12,0,0"
                                                                Background="{DynamicResource PanelSecondaryBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="12">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesBitsOutfitSetTrigger}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{loc:Translate 'Bits Outfit Trigger'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{loc:Translate 'Viewers cheer at least the minimum bits and type this outfit name in the cheer message. Capitalization, spaces, punctuation, and small spelling mistakes are okay, but unclear names will not trigger. Bits outfit triggers use the same safe Set Trigger snapshot and restore flow.'}" />
                                                                <StackPanel Margin="0,12,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Outfit name'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding SharedRewardHelpText, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <Border Margin="0,12,0,0"
                                                                Background="{DynamicResource PanelSecondaryBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="12">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesForceMovementBitsTrigger}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{loc:Translate 'Force Movement Word Trigger'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{loc:Translate 'Viewers cheer at least the minimum bits and type this word in the cheer message. Capitalization, spaces, punctuation, and small spelling mistakes are okay, but unclear words will not trigger.'}" />
                                                                <StackPanel Margin="0,12,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Word Trigger'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding SupporterKeywordText, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <StackPanel Margin="0,10,0,0"
                                                                    Visibility="{Binding UsesAmountThreshold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{loc:Translate 'Minimum Amount'}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UsesBitsOutfitSetTrigger}" Value="True">
                                                                                    <Setter Property="Text" Value="{loc:Translate 'Minimum Bits'}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding UsesForceMovementBitsTrigger}" Value="True">
                                                                                    <Setter Property="Text" Value="{loc:Translate 'Minimum Bits'}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Minimum Amount"
                                                                        Tag="This setting is only for bits and subscriptions overrides. For bits, it is the minimum number of bits needed in one cheer event. For subs, it is the minimum number of subscriptions or gift subs the event must include before Crystal Relay runs the rule. Paid overrides ignore avatar matching and can fire no matter which avatar you are using." />
                                                            </DockPanel>
                                                            <TextBox Text="{Binding MinimumAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesSupporterAmountTimerSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Bits/Subs Amount Timer'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Bits/Subs Amount Timer"
                                                                        Tag="{loc:Translate 'When enabled, Crystal Relay starts this paid override with Active Time, then adds time from separate Bits and Subs ratios. Bits use the bit count, normal subs count as 1, and gift subs use the gift total. Later same-rule events extend the running timer by the amount only.'}" />
                                                            </DockPanel>
                                                            <CheckBox Margin="0,8,0,0"
                                                                      Content="{loc:Translate 'Scale active time by amount'}"
                                                                      IsChecked="{Binding AmountScaledDurationEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="{loc:Translate 'When enabled, Crystal Relay starts this paid override with Active Time, then adds time from separate Bits and Subs ratios. Bits use the bit count, normal subs count as 1, and gift subs use the gift total. Later same-rule events extend the running timer by the amount only.'}" />
                                                            <Button Margin="0,10,0,0"
                                                                    HorizontalAlignment="Left"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Content="{loc:Translate 'Configure Added Time...'}"
                                                                    Command="{Binding DataContext.OpenSupporterOverrideTimeSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding SupporterTimeSettingsSummary}" />
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Chat Command Fallback'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Chat Command Fallback"
                                                                        Tag="{Binding DataContext.ChatCommandFallbackHelpText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </DockPanel>
                                                            <CheckBox Margin="0,8,0,0"
                                                                      Content="{loc:Translate 'Enable chat command fallback'}"
                                                                      IsChecked="{Binding ChatCommandEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                            <StackPanel Margin="0,10,0,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ChatCommandEnabled}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <UniformGrid Columns="2">
                                                                    <StackPanel Margin="0,0,14,0">
                                                                        <TextBlock Text="{loc:Translate 'Exact Command'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding ChatCommandText}" />
                                                                    </StackPanel>
                                                                    <StackPanel Margin="14,0,0,0">
                                                                        <TextBlock Text="{loc:Translate 'Who Can Use It'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <ComboBox ItemsSource="{Binding DataContext.ChatCommandPermissionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                  DisplayMemberPath="Label"
                                                                                  SelectedValuePath="Value"
                                                                                  SelectedValue="{Binding ChatCommandPermission, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                </UniformGrid>
                                                                <TextBlock Margin="0,10,0,0"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{loc:Translate 'Crystal Relay matches the whole chat message exactly. Example: !wave'}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,20,0,0"
                                                        Background="{DynamicResource NestedPanelBrush}"
                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'OSC Action'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="17" />
                                                        <TextBlock Margin="0,10,0,0"
                                                                   Text="{loc:Translate 'Action Type'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <Border Margin="0,8,0,0"
                                                                Padding="14,10"
                                                                Background="{DynamicResource InputBackgroundBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SharedRewardChoiceEnabled}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{loc:Translate 'Avatar Parameter'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Margin="0,8,0,0"
                                                                Padding="14,10"
                                                                Background="{DynamicResource InputBackgroundBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{loc:Translate 'Avatar Change'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Margin="0,8,0,0"
                                                                Padding="14,10"
                                                                Background="{DynamicResource InputBackgroundBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingMovementRedeems, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{loc:Translate 'Player Movement'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailableActionTypesForSelectedContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  Margin="0,8,0,0"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedItem="{Binding DataContext.SelectedActionTypeOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                            <ComboBox.Style>
                                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingMasterAvatar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingCashPayments, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingPowerUps, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                                <Condition Binding="{Binding SharedRewardChoiceEnabled}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ComboBox.Style>
                                                        </ComboBox>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesPlayerMovement, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Movement Action'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                                Width="24"
                                                                                Height="24"
                                                                                MinWidth="24"
                                                                                MinHeight="24"
                                                                                Click="OnHelpButtonClicked"
                                                                                CommandParameter="Movement Action"
                                                                        Tag="{loc:Translate 'Choose which VRChat movement input Crystal Relay should send for this rule. Random Movement rolls one direction per use. Glitchy Movement keeps rolling random directions until Active Time ends.'}" />
                                                            </DockPanel>
                                                            <ComboBox ItemsSource="{Binding DataContext.MovementDirections, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value"
                                                                      SelectedValue="{Binding MovementDirection, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesAvatarParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Value Type'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Value Type"
                                                                        Tag="Pick the kind of VRChat parameter value this redeem should send. Bool means simple on or off values like True and False. Int means whole numbers only, like 0, 1, or 2. Float means decimal numbers, like 0.0, 0.5, or 1.0. When you switch this type, Crystal Relay resets the value boxes so they match the type you chose." />
                                                            </DockPanel>
                                                            <ComboBox ItemsSource="{Binding DataContext.ParameterTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding ParameterType, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Margin="0,12,0,0"
                                                                       Text="{loc:Translate 'Avatar Parameter'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <ComboBox ItemsSource="{Binding DataContext.AvatarParameterOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      Margin="0,8,0,0"
                                                                      IsEditable="True"
                                                                      IsTextSearchEnabled="True"
                                                                      StaysOpenOnEdit="True"
                                                                      TextSearch.TextPath="DisplayLabel"
                                                                      DisplayMemberPath="DisplayLabel"
                                                                      SelectedItem="{Binding DataContext.SelectedAvatarParameterOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <WrapPanel Margin="0,8,0,0">
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Content="{loc:Translate 'Copy Path'}"
                                                                        Command="{Binding DataContext.CopySelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Content="{loc:Translate 'Paste Path'}"
                                                                        Command="{Binding DataContext.PasteSelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </WrapPanel>
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{Binding DataContext.VrChatOscParameterStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap" />

                                                            <StackPanel Margin="0,14,0,0"
                                                                        Visibility="{Binding UsesFloatParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{loc:Translate 'Float Input Mode'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <ComboBox ItemsSource="{Binding DataContext.FloatValueModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          SelectedItem="{Binding FloatValueMode, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Text="{Binding FloatValueModeHelpText}"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap" />
                                                                <StackPanel Margin="0,12,0,0"
                                                                            Visibility="{Binding UsesFloatTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{loc:Translate 'Smooth Transition (seconds)'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding FloatTransitionSeconds, UpdateSourceTrigger=LostFocus}" />
                                                                    <Button Margin="0,12,0,0"
                                                                            HorizontalAlignment="Left"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Content="{loc:Translate 'Active Boost Reward...'}"
                                                                            Command="{Binding DataContext.OpenActiveFloatBoostRewardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Text="{Binding ActiveFloatBoostRewardStatusText}"
                                                                               Foreground="{DynamicResource MutedBrush}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel Margin="0,14,0,0"
                                                                            Visibility="{Binding UsesSupporterFloatAdd, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <DockPanel LastChildFill="False">
                                                                        <TextBlock Text="{loc:Translate 'Bits/Subs Add'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                                Width="24"
                                                                                Height="24"
                                                                                MinWidth="24"
                                                                                MinHeight="24"
                                                                                Click="OnHelpButtonClicked"
                                                                                CommandParameter="Bits/Subs Add"
                                                                                Tag="{loc:Translate 'Each matching Bits/Subs event adds to the current value, restarts the timer, and stops at your max value.'}" />
                                                                    </DockPanel>
                                                                    <CheckBox Margin="0,8,0,0"
                                                                              Content="{loc:Translate 'Add on top of the current value'}"
                                                                              IsChecked="{Binding SupporterFloatAddEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <TextBlock Margin="0,6,0,0"
                                                                               Text="{Binding SupporterFloatAddSummary}"
                                                                               Foreground="{DynamicResource MutedBrush}"
                                                                               TextWrapping="Wrap" />
                                                                    <StackPanel Margin="0,10,0,0"
                                                                                Visibility="{Binding UsesActiveSupporterFloatAdd, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <UniformGrid Columns="2">
                                                                            <StackPanel Margin="0,0,8,0">
                                                                                <TextBlock Text="{loc:Translate 'Start Value'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding SupporterFloatAddMinimumValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="8,0,0,0">
                                                                                <TextBlock Text="{loc:Translate 'Max Value'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding SupporterFloatAddMaximumValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                        </UniformGrid>
                                                                        <DockPanel Margin="0,12,0,0"
                                                                                   LastChildFill="False">
                                                                            <TextBlock Text="{loc:Translate 'Rules'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold"
                                                                                       VerticalAlignment="Center" />
                                                                            <Button Margin="8,0,0,0"
                                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                                    Content="{loc:Translate 'Add Rule'}"
                                                                                    Click="OnAddSupporterFloatAddRangeClicked" />
                                                                        </DockPanel>
                                                                        <ItemsControl Margin="0,8,0,0"
                                                                                      ItemsSource="{Binding SupporterFloatAddRanges}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="{x:Type models:SupporterFloatAddRange}">
                                                                                    <Grid Margin="0,0,0,8">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <StackPanel Grid.Column="0"
                                                                                                    Margin="0,0,6,0">
                                                                                            <TextBlock Text="{loc:Translate 'From'}"
                                                                                                       Foreground="{DynamicResource MutedBrush}" />
                                                                                            <TextBox Text="{Binding MinimumAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Grid.Column="1"
                                                                                                    Margin="6,0,6,0">
                                                                                            <TextBlock Text="{loc:Translate 'To'}"
                                                                                                       Foreground="{DynamicResource MutedBrush}" />
                                                                                            <TextBox Text="{Binding MaximumAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                                                        </StackPanel>
                                                                                        <StackPanel Grid.Column="2"
                                                                                                    Margin="6,0,6,0">
                                                                                            <TextBlock Text="{loc:Translate 'Add'}"
                                                                                                       Foreground="{DynamicResource MutedBrush}" />
                                                                                            <TextBox Text="{Binding AddValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                                        </StackPanel>
                                                                                        <Button Grid.Column="3"
                                                                                                Margin="6,18,0,0"
                                                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                                                Content="{loc:Translate 'Remove'}"
                                                                                                Click="OnRemoveSupporterFloatAddRangeClicked" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <TextBlock Margin="0,2,0,0"
                                                                                   Text="{loc:Translate 'Use 0 in To for no limit.'}"
                                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Margin="0,14,0,0"
                                                                        Visibility="{Binding UsesBoolParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <StackPanel Visibility="{Binding UsesBoolToggleHint, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <DockPanel LastChildFill="False">
                                                                        <TextBlock Text="{loc:Translate 'Instant Bool Toggle'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                                Width="24"
                                                                                Height="24"
                                                                                MinWidth="24"
                                                                                MinHeight="24"
                                                                                Click="OnHelpButtonClicked"
                                                                                CommandParameter="Instant Bool Toggle"
                                                                                Tag="When Active Time is 0, this bool rule becomes a toggle instead of a timed hold. Each use flips the current VRChat bool parameter from off to on or from on to off. Use a timed Active Time above 0 when you want Crystal Relay to turn it on first and reset it later." />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                                <StackPanel Visibility="{Binding UsesBoolTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <UniformGrid Columns="2"
                                                                                 Margin="0,12,0,0">
                                                                        <StackPanel Margin="0,0,14,0">
                                                                            <TextBlock Text="{loc:Translate 'When Triggered'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                      SelectedItem="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                        <StackPanel Margin="14,0,0,0">
                                                                            <TextBlock Text="{loc:Translate 'After Active Time Ends'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                      SelectedItem="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Margin="0,14,0,0"
                                                                        Visibility="{Binding UsesIntParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <StackPanel Visibility="{Binding UsesIntInstantModeOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <DockPanel LastChildFill="False">
                                                                        <TextBlock Text="{loc:Translate 'Instant Int Action'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                                Width="24"
                                                                                Height="24"
                                                                                MinWidth="24"
                                                                                MinHeight="24"
                                                                                Click="OnHelpButtonClicked"
                                                                                CommandParameter="Instant Int Action"
                                                                                Tag="{Binding IntModeHelpText}" />
                                                                    </DockPanel>
                                                                    <ComboBox ItemsSource="{Binding DataContext.IntZeroDurationModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              SelectedItem="{Binding IntZeroDurationMode, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <StackPanel Margin="0,12,0,0"
                                                                                Visibility="{Binding UsesIntFixedInstantValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{loc:Translate 'Send This Number'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Margin="0,12,0,0"
                                                                                Visibility="{Binding UsesIntRangeInputs, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <UniformGrid Columns="2">
                                                                            <StackPanel Margin="0,0,14,0">
                                                                                <TextBlock Text="{loc:Translate 'Minimum Number'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding RangeMinimum, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="14,0,0,0">
                                                                                <TextBlock Text="{loc:Translate 'Maximum Number'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding RangeMaximum, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                        </UniformGrid>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <StackPanel Visibility="{Binding UsesIntTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                                                        <StackPanel Margin="0,0,14,0">
                                                                            <TextBlock Text="{loc:Translate 'When Triggered, Set To'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                        <StackPanel Margin="14,0,0,0">
                                                                            <TextBlock Text="{loc:Translate 'After Active Time Ends, Set Back To'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Margin="0,14,0,0"
                                                                        Visibility="{Binding UsesTextOrFloatParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <StackPanel Visibility="{Binding UsesDirectInstantValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{loc:Translate 'Send This Value'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Visibility="{Binding UsesDirectTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                                                        <StackPanel Margin="0,0,14,0">
                                                                            <TextBlock Text="{loc:Translate 'When Triggered, Send This Value'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                        <StackPanel Margin="14,0,0,0">
                                                                            <TextBlock Text="{loc:Translate 'After Active Time Ends, Send This Value'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesSetTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{loc:Translate 'Outfit Parameters'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                             <TextBlock Margin="0,6,0,0"
                                                                         Text="{loc:Translate 'Add bool, int, or float parameters that should change together. Crystal Relay snapshots safe LocalAvatarData values before sending, waits 70 seconds when needed to learn what changed, then restores changed parameters from the copied pre-trigger snapshot after Active Time.'}"
                                                                        Foreground="{DynamicResource MutedBrush}"
                                                                        TextWrapping="Wrap" />
                                                             <Border Margin="0,10,0,0"
                                                                     Padding="12,10"
                                                                     Background="{DynamicResource DangerBrush}"
                                                                     BorderBrush="{DynamicResource DangerBorderBrush}"
                                                                     BorderThickness="1"
                                                                     CornerRadius="8">
                                                                 <StackPanel>
                                                                     <TextBlock Text="{loc:Translate 'Warning: Set Trigger restore uses delayed VRChat avatar data'}"
                                                                                Foreground="#FFFFD6E2"
                                                                                FontWeight="Bold"
                                                                                TextWrapping="Wrap" />
                                                                     <TextBlock Margin="0,4,0,0"
                                                                                 Text="{loc:Translate 'After manually changing outfit toggles or parameters in VRChat, wait at least 70 seconds before testing or redeeming a Set Trigger. Crystal Relay uses LocalAvatarData snapshots and diffs for safe restore, and triggering before VRChat updates that file can restore the wrong outfit values.'}"
                                                                                Foreground="#FFFFEEF4"
                                                                                TextWrapping="Wrap" />
                                                                 </StackPanel>
                                                             </Border>
                                                             <StackPanel Margin="0,10,0,0">
                                                                 <CheckBox IsChecked="{Binding SetTriggerAutoRestoreRelatedOutfitParameters, UpdateSourceTrigger=PropertyChanged}">
                                                                     <TextBlock Text="{loc:Translate 'Also restore related outfit toggles'}"
                                                                                TextWrapping="Wrap" />
                                                                 </CheckBox>
                                                                 <TextBlock Margin="26,6,0,0"
                                                                            Text="{Binding SetTriggerRestoreModeSummary}"
                                                                            Foreground="{DynamicResource MutedBrush}"
                                                                            TextWrapping="Wrap" />
                                                                 <TextBlock Margin="26,6,0,0"
                                                                            Text="{loc:Translate 'This outfit is using the legacy full safe diff restore from an older save. Change the checkbox above to move it to the new outfit restore mode.'}"
                                                                            Foreground="{DynamicResource MutedBrush}"
                                                                            TextWrapping="Wrap">
                                                                     <TextBlock.Style>
                                                                         <Style TargetType="TextBlock">
                                                                             <Setter Property="Visibility" Value="Collapsed" />
                                                                             <Style.Triggers>
                                                                                 <DataTrigger Binding="{Binding UsesLegacySetTriggerFullDiffRestore}" Value="True">
                                                                                     <Setter Property="Visibility" Value="Visible" />
                                                                                 </DataTrigger>
                                                                             </Style.Triggers>
                                                                         </Style>
                                                                     </TextBlock.Style>
                                                                 </TextBlock>
                                                             </StackPanel>
                                                             <WrapPanel Margin="0,10,0,0">
                                                                 <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                         Content="{loc:Translate 'Add Set Parameter'}"
                                                                         Command="{Binding DataContext.AddSetTriggerActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Content="{loc:Translate 'Delete Set Parameter'}"
                                                                        Command="{Binding DataContext.RemoveSelectedSetTriggerActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </WrapPanel>
                                                            <ListBox Margin="0,10,0,0"
                                                                     MaxHeight="130"
                                                                     ItemsSource="{Binding SetTriggerActions}"
                                                                     SelectedItem="{Binding DataContext.SelectedSetTriggerAction, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                                     DisplayMemberPath="DisplaySummary"
                                                                     ScrollViewer.CanContentScroll="True"
                                                                     VirtualizingStackPanel.IsVirtualizing="True"
                                                                     VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                                            <ContentControl Margin="0,12,0,0"
                                                                            Content="{Binding DataContext.SelectedSetTriggerAction, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.SelectedSetTriggerAction, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                                <ContentControl.ContentTemplate>
                                                                    <DataTemplate DataType="{x:Type models:SetTriggerAction}">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{loc:Translate 'Selected Set Parameter'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <UniformGrid Columns="2"
                                                                                         Margin="0,10,0,0">
                                                                                <StackPanel Margin="0,0,14,0">
                                                                                    <TextBlock Text="{loc:Translate 'Avatar Parameter'}"
                                                                                               Foreground="{DynamicResource TextBrush}"
                                                                                               FontWeight="SemiBold" />
                                                                                    <ComboBox ItemsSource="{Binding DataContext.SetTriggerParameterOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                              Margin="0,8,0,0"
                                                                                              IsTextSearchEnabled="True"
                                                                                              TextSearch.TextPath="DisplayLabel"
                                                                                              DisplayMemberPath="DisplayLabel"
                                                                                              SelectedItem="{Binding DataContext.SelectedSetTriggerParameterOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                    <WrapPanel Margin="0,8,0,0">
                                                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                                                Content="{loc:Translate 'Copy Path'}"
                                                                                                Command="{Binding DataContext.CopySelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                                                Content="{loc:Translate 'Paste Path'}"
                                                                                                Command="{Binding DataContext.PasteSelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                    </WrapPanel>
                                                                                    <TextBlock Margin="0,6,0,0"
                                                                                               Text="{Binding DataContext.VrChatOscParameterStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                               Foreground="{DynamicResource MutedBrush}"
                                                                                               TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                                <StackPanel Margin="14,0,0,0">
                                                                                    <TextBlock Text="{loc:Translate 'Value Type'}"
                                                                                               Foreground="{DynamicResource TextBrush}"
                                                                                               FontWeight="SemiBold" />
                                                                                    <ComboBox ItemsSource="{Binding DataContext.ParameterTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                              SelectedItem="{Binding ParameterType, UpdateSourceTrigger=PropertyChanged}" />
                                                                                </StackPanel>
                                                                            </UniformGrid>
                                                                            <StackPanel Margin="0,12,0,0">
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Bool}">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <TextBlock Text="{loc:Translate 'When Triggered'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                          SelectedItem="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="0,12,0,0">
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Int}">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <TextBlock Text="{loc:Translate 'When Triggered, Set To'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="0,12,0,0">
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Float}">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <TextBlock Text="{loc:Translate 'When Triggered, Send This Value'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <TextBlock Margin="0,8,0,0"
                                                                                       Text="{loc:Translate 'Restore values come from the copied pre-trigger snapshot, not from a later VRChat file read.'}"
                                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                                       TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ContentControl.ContentTemplate>
                                                            </ContentControl>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesAvatarChange, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Avatar To Switch To'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Avatar To Switch To"
                                                                        Tag="Choose the exact VRChat avatar this rule should switch you to. Crystal Relay shows clean avatar names here, but it still stores the real avatar ID behind the scenes so OSC avatar changes go to the correct target. Start typing to search the cached avatar list by name." />
                                                            </DockPanel>
                                                            <DockPanel Margin="0,8,0,0">
                                                                <Button DockPanel.Dock="Right"
                                                                        Content="{loc:Translate 'Browse...'}"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Command="{Binding DataContext.OpenAvatarPickerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="AvatarChange" />
                                                                <TextBlock Text="{Binding AvatarChangeDisplayName}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,8,0"
                                                                           TextWrapping="Wrap" />
                                                            </DockPanel>
                                                            <Button Margin="0,8,0,0"
                                                                    Content="{loc:Translate 'Use Current Avatar'}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.UseCurrentAvatarForAvatarChangeRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <TextBlock Margin="0,12,0,0"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding DataContext.MasterAvatarReturnText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesAvatarRoulet, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Avatar Roulette Pool'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Avatar Roulette Pool"
                                                                        Tag="Choose the pool of avatars this Avatar Roulette rule is allowed to roll from. When the rule fires, Crystal Relay randomly picks one avatar from this pool, switches to it as a temporary avatar, then returns to the shared return avatar when the Active Time ends. The roulette rule does not rewrite your shared return avatar." />
                                                            </DockPanel>
                                                            <Button Margin="0,8,0,0"
                                                                    Content="{loc:Translate 'Pick Avatar Roulette Pool'}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.OpenAvatarRouletPoolPickerCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <TextBlock Margin="0,10,0,0"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding AvatarRouletPoolSummary}" />
                                                            <TextBlock Margin="0,8,0,0"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="{loc:Translate 'Avatar Roulette always stays temporary. It rolls from the selected pool, then uses the shared return avatar for the switch back without rewriting it.'}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <UniformGrid Columns="2" Margin="0,20,0,0">
                                                    <StackPanel Margin="0,0,14,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding UsesAvatarChange}" Value="True" />
                                                                            <Condition Binding="{Binding DataContext.Settings.AvatarChangeCooldownOnlyModeEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{loc:Translate 'Active Time (seconds)'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                    Width="24"
                                                                    Height="24"
                                                                    MinWidth="24"
                                                                    MinHeight="24"
                                                                    Click="OnHelpButtonClicked"
                                                                    CommandParameter="Active Time"
                                                                    Tag="{Binding DurationHelpText}" />
                                                        </DockPanel>
                                                        <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="{loc:Translate 'Amount-scaled timer is enabled, so Active Time is the starting time before Bits/Subs added time extends the override.'}"
                                                                   Visibility="{Binding UsesAmountScaledDuration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="14,0,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesCooldown}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UsesSetTrigger}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{loc:Translate 'Cooldown (seconds)'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                    Width="24"
                                                                    Height="24"
                                                                    MinWidth="24"
                                                                    MinHeight="24"
                                                                    Click="OnHelpButtonClicked"
                                                                    CommandParameter="Cooldown"
                                                                    Tag="Cooldown is the wait time before the same rule can trigger again. Crystal Relay uses it locally to block repeats, and for managed channel point redeems it also syncs the same cooldown back to Twitch. Avatar Roulette also keeps avatar-switch redeems disabled for its cooldown window." />
                                                        </DockPanel>
                                                        <TextBox Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <DockPanel Margin="0,20,0,0"
                                                           LastChildFill="False">
                                                    <TextBlock Text="{loc:Translate 'Bot Message'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <Button Style="{StaticResource HelpIconButtonStyle}"
                                                            Width="24"
                                                            Height="24"
                                                            MinWidth="24"
                                                            MinHeight="24"
                                                            Click="OnHelpButtonClicked"
                                                            CommandParameter="Bot Message"
                                                            Tag="This is an optional chat reply sent by your connected bot account after the rule fires. Use it for confirmations, jokes, or quick status messages. Placeholders like {user}, {reward}, {duration}, and {value} are filled in from the trigger that just ran." />
                                                </DockPanel>
                                                <TextBox Text="{Binding BotMessageTemplate, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         Height="100"
                                                         TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>

                            <TextBlock Margin="0,22,0,0"
                                       Text="{Binding SelectedRuleEmptyStateText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="{Binding ElementName=RuleWorkspaceScrollViewer, Path=ActualWidth}"
                                       VerticalAlignment="Center"
                                       FontSize="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRule}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsViewingRewardFireSale}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsViewingPowerUps}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,22,0,0"
                                       Text="{Binding SelectedRuleEmptyStateText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="{Binding ElementName=RuleWorkspaceScrollViewer, Path=ActualWidth}"
                                       VerticalAlignment="Center"
                                       FontSize="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsViewingUniversalTriggers}" Value="True" />
                                                    <Condition Binding="{Binding SelectedUniversalTrigger}" Value="{x:Null}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="5"
                    Background="{DynamicResource PanelBrush}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivitySectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top"
                               LastChildFill="False">
                        <TextBlock Text="{loc:Translate 'Activity'}" Style="{StaticResource HeadingTextStyle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                Click="OnHelpButtonClicked"
                                CommandParameter="Activity"
                                Tag="Activity is Crystal Relay's running event log. It shows Twitch connection changes, reward sync results, VRChat avatar detection, OSC events, chat-command triggers, and errors so you can see what the app is doing without guessing. If something behaves strangely, this is usually the first place to check." />
                    </DockPanel>
                    <Border DockPanel.Dock="Top"
                            Margin="0,14,0,0"
                            Padding="14,10"
                            Background="{DynamicResource AttentionBrush}"
                            BorderBrush="{DynamicResource AttentionBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasActivityWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Activity warning'}"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding ActivityAttentionMessage}"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ListBox Margin="0,18,0,0"
                             ItemsSource="{Binding LogEntries}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="5"
                    Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAboutSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Width="980"
                          HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/rikuknifesticker.png"
                               Width="320"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,300,12,22"
                               Opacity="0.9"
                               Stretch="Uniform"
                               IsHitTestVisible="False"
                               Panel.ZIndex="0"
                               RenderOptions.BitmapScalingMode="Fant">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.Theme}" Value="{x:Static models:AppTheme.DreamScape}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <StackPanel MaxWidth="980"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,250"
                                    Panel.ZIndex="1">
                        <!-- About intro explains the goal of Crystal Relay before the profile cards below. -->
                        <Border HorizontalAlignment="Center"
                                Width="940"
                                Background="{DynamicResource PanelHighlightBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="24">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate 'About Crystal Relay'}"
                                           Style="{StaticResource HeadingTextStyle}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextAlignment="Center" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{loc:Translate 'Crystal Relay is built to make Twitch-to-OSC control for VRChat easier to understand and easier to use.'}"
                                           FontSize="22"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{loc:Translate 'Crystal Relay exists because too many Twitch-to-OSC tools felt harder to learn than they needed to be.'}"
                                           FontSize="18"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,22,0,0"
                              HorizontalAlignment="Center">
                            <!-- About profile area:
                                 creator card on the left, playtester cards on the right. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="598" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource PanelHighlightBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Made By'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{loc:Translate 'Creator and main tester'}"
                                               FontSize="16"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <ContentControl Content="{Binding AboutCreatorProfile}"
                                                    ContentTemplate="{StaticResource AboutTwitchProfileTemplate}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource PanelSecondaryBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Playtesters'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{loc:Translate 'These streamers help test Crystal Relay before updates go out.'}"
                                               FontSize="16"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding AboutTesterProfiles}"
                                                  Margin="0,6,0,0"
                                                  ItemTemplate="{StaticResource AboutTesterProfileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"
                                                           ItemWidth="274"
                                                           HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
            <Grid x:Name="LoadingOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="999"
                  Background="{DynamicResource WindowBackgroundBrush}">
                <Grid.Resources>
                    <Storyboard x:Key="CrystalRotateStoryboard">
                        <DoubleAnimation Storyboard.TargetName="CrystalRotateTransform"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:4"
                                         RepeatBehavior="Forever" />
                    </Storyboard>
                    <Storyboard x:Key="CrystalPulseStoryboard">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrystalScaleTransform"
                                                       Storyboard.TargetProperty="ScaleX"
                                                       RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1" Value="1.1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrystalScaleTransform"
                                                       Storyboard.TargetProperty="ScaleY"
                                                       RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1" Value="1.1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                    <Storyboard x:Key="GlowPulseStoryboard">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlowEllipse"
                                                       Storyboard.TargetProperty="Opacity"
                                                       RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.25" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.7" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2" Value="0.25" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                    <Storyboard x:Key="OrbitStoryboard">
                        <DoubleAnimation Storyboard.TargetName="OrbitRingRotateTransform"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:7"
                                         RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="SparkOrbitOneRotateTransform"
                                         Storyboard.TargetProperty="Angle"
                                         From="360" To="0" Duration="0:0:5"
                                         RepeatBehavior="Forever" />
                        <DoubleAnimation Storyboard.TargetName="SparkOrbitTwoRotateTransform"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:6.5"
                                         RepeatBehavior="Forever" />
                    </Storyboard>
                    <Storyboard x:Key="ShimmerStoryboard">
                        <DoubleAnimation Storyboard.TargetName="CrystalShimmerTransform"
                                         Storyboard.TargetProperty="X"
                                         From="-86" To="86" Duration="0:0:2.4"
                                         BeginTime="0:0:0.3"
                                         RepeatBehavior="Forever" />
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrystalShimmer"
                                                       Storyboard.TargetProperty="Opacity"
                                                       RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.45" Value="0.58" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.05" Value="0" />
                            <LinearDoubleKeyFrame KeyTime="0:0:2.4" Value="0" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                    <Storyboard x:Key="TextFadeStoryboard">
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LoadingTextBlock"
                                                       Storyboard.TargetProperty="Opacity"
                                                       RepeatBehavior="Forever">
                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.65" />
                            <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="1" />
                            <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.65" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </Grid.Resources>

                <!-- Glow behind crystal -->
                <Ellipse x:Name="GlowEllipse"
                         Width="180"
                         Height="180"
                         Fill="{DynamicResource AccentBrush}"
                         Opacity="0.45"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,0,0,40">
                    <Ellipse.Effect>
                        <BlurEffect Radius="45" />
                    </Ellipse.Effect>
                </Ellipse>

                <Canvas Width="220"
                        Height="220"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,42"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="OrbitRingRotateTransform" Angle="0" />
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="37"
                             Canvas.Top="37"
                             Width="146"
                             Height="146"
                             Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="1.4"
                             StrokeDashArray="6 8"
                             Opacity="0.42" />
                    <Ellipse Canvas.Left="106"
                             Canvas.Top="22"
                             Width="8"
                             Height="8"
                             Fill="{DynamicResource AccentBrush}"
                             Opacity="0.82">
                        <Ellipse.Effect>
                            <BlurEffect Radius="1.5" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <Canvas Width="220"
                        Height="220"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,42"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="SparkOrbitOneRotateTransform" Angle="0" />
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="54"
                             Canvas.Top="44"
                             Width="5"
                             Height="5"
                             Fill="{DynamicResource TextBrush}"
                             Opacity="0.72" />
                </Canvas>

                <Canvas Width="180"
                        Height="180"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,0,0,42"
                        IsHitTestVisible="False"
                        RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="SparkOrbitTwoRotateTransform" Angle="0" />
                    </Canvas.RenderTransform>
                    <Ellipse Canvas.Left="132"
                             Canvas.Top="118"
                             Width="6"
                             Height="6"
                             Fill="{DynamicResource MutedBrush}"
                             Opacity="0.64" />
                </Canvas>

                <!-- Crystal with animations -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Grid Width="106"
                          Height="106"
                          Margin="0,0,0,24"
                          ClipToBounds="True"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="CrystalRotateTransform" Angle="0" />
                                <ScaleTransform x:Name="CrystalScaleTransform" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Image Source="Assets/crystal-relay-icon.png"
                               Width="96"
                               Height="96"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                        <Rectangle x:Name="CrystalShimmer"
                                   Width="24"
                                   Height="118"
                                   Opacity="0"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#A8FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="24" />
                                    <TranslateTransform x:Name="CrystalShimmerTransform" X="-86" />
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <TextBlock x:Name="LoadingTextBlock"
                               Text="{loc:Translate 'Loading Crystal Relay...'}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{loc:Translate 'Preparing your workspace...'}"
                               FontSize="13"
                               Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
            <Grid x:Name="AdvertisementOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="1000"
                  Background="#F2000000"
                  ClipToBounds="True"
                  Visibility="Collapsed">
                <MediaElement x:Name="AdvertisementMediaElement"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Manual"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              MediaEnded="OnAdvertisementMediaEnded"
                              MediaFailed="OnAdvertisementMediaFailed" />
            </Grid>
        </Grid>
    </Border>
</Window>
