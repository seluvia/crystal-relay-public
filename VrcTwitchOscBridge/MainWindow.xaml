                                                        </StackPanel>
                                                        <StackPanel Margin="14,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Max Added Height'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthMaxAddedHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{loc:Translate 'Use 0 for unlimited added height until VRChat or safe range clamps it.'}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <UniformGrid Columns="2"
                                                                 Margin="0,12,0,0">
                                                        <StackPanel Margin="0,0,14,0">
                                                            <TextBlock Text="{loc:Translate 'Inactivity Timer Seconds'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthInactivityTimerSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="14,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Smooth Transition Seconds'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SmoothTransitionSeconds, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <TextBlock Margin="0,16,0,0"
                                                               Text="{loc:Translate 'Subscription Growth'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <UniformGrid Columns="3"
                                                                 Margin="0,10,0,0">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{loc:Translate 'Tier 1 Height Add'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthTier1HeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="10,0,10,0">
                                                            <TextBlock Text="{loc:Translate 'Tier 2 Height Add'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthTier2HeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="10,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Tier 3 Height Add'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthTier3HeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <DockPanel Margin="0,16,0,0"
                                                               LastChildFill="False">
                                                        <TextBlock Text="{loc:Translate 'Bits Growth Ranges'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <Button Margin="14,0,0,0"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Padding="16,6"
                                                                Content="{loc:Translate 'Add Bits Range'}"
                                                                Click="OnAddSupporterGrowthBitRangeClicked" />
                                                    </DockPanel>
                                                    <ItemsControl Margin="0,10,0,0"
                                                                  ItemsSource="{Binding SupporterGrowthBitRanges}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:AvatarScaleBitGrowthRange}">
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0"
                                                                                Margin="0,0,8,0">
                                                                        <TextBlock Text="{loc:Translate 'Minimum Bits'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding MinimumBits, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1"
                                                                                Margin="8,0,8,0">
                                                                        <TextBlock Text="{loc:Translate 'Maximum Bits'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding MaximumBits, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2"
                                                                                Margin="8,0,8,0">
                                                                        <TextBlock Text="{loc:Translate 'Height Added'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding HeightAddedMeters, UpdateSourceTrigger=LostFocus}" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="3"
                                                                            Margin="8,18,0,0"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Padding="14,6"
                                                                            VerticalAlignment="Top"
                                                                            Content="{loc:Translate 'Remove'}"
                                                                            Click="OnRemoveSupporterGrowthBitRangeClicked" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{loc:Translate 'Maximum Bits set to 0 means no upper limit for that row.'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <Border Margin="0,18,0,0"
                                                    Background="{DynamicResource PanelHighlightBrush}"
                                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="18">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsesStandardScaleAction}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Translate 'Scale Action'}"
                                                               Style="{StaticResource HeadingTextStyle}"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <UniformGrid Columns="2"
                                                                 Margin="0,12,0,0">
                                                        <StackPanel Margin="0,0,14,0">
                                                            <TextBlock Text="{loc:Translate 'Mode'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <ComboBox ItemsSource="{Binding DataContext.AvatarScaleModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding ScaleMode, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="14,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Smooth Transition Seconds'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SmoothTransitionSeconds, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <UniformGrid Columns="2"
                                                                 Margin="0,12,0,0">
                                                        <StackPanel Margin="0,0,14,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesTargetHeight}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{loc:Translate 'Target Height Meters'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding TargetHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="14,0,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesPreset}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{loc:Translate 'Preset'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <ComboBox ItemsSource="{Binding DataContext.AvatarScalePresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding Preset, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <UniformGrid Columns="2"
                                                                 Margin="0,12,0,0">
                                                        <UniformGrid.Style>
                                                            <Style TargetType="UniformGrid">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesRandomHeight}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </UniformGrid.Style>
                                                        <StackPanel Margin="0,0,14,0">
                                                            <TextBlock Text="{loc:Translate 'Random Min Height'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding MinimumHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="14,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Random Max Height'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding MaximumHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <StackPanel Margin="0,12,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesRelativeHeight}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="{loc:Translate 'Relative Height Change'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBox Width="220"
                                                                 HorizontalAlignment="Left"
                                                                 Text="{Binding RelativeHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        <StackPanel Margin="0,12,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesRelativeMinimumHeight}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{loc:Translate 'Minimum Height'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Width="220"
                                                                     HorizontalAlignment="Left"
                                                                     Text="{Binding RelativeMinimumHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{loc:Translate 'Minimum Height stops negative relative scaling at this height.'}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,12,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesRelativeMaximumHeight}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{loc:Translate 'Maximum Height'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Width="220"
                                                                     HorizontalAlignment="Left"
                                                                     Text="{Binding RelativeMaximumHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{loc:Translate 'Maximum Height stops positive relative scaling at this height.'}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Margin="0,12,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesMultiplier}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="{loc:Translate 'Height Multiplier'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBox Width="220"
                                                                 HorizontalAlignment="Left"
                                                                 Text="{Binding HeightMultiplier, UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>

                                                    <UniformGrid Columns="2"
                                                                 Margin="0,12,0,0">
                                                        <StackPanel Margin="0,0,14,0">
                                                            <TextBlock Text="{loc:Translate 'Active Time Seconds'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding ActiveTimeSeconds, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="14,0,0,0">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasActiveTime}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{loc:Translate 'Return Height'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding RestoreHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <TextBlock Margin="0,8,0,0"
                                                               Text="{loc:Translate 'After Active Time ends, Crystal Relay returns this scale redeem to the configured Return Height.'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasActiveTime, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <CheckBox Margin="0,14,0,0"
                                                              Content="{loc:Translate 'Unlock advanced VRChat scale range'}"
                                                              IsChecked="{Binding AdvancedRangeEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                    <CheckBox Margin="0,10,0,0"
                                                              Content="{loc:Translate 'Bypass VRChat world min/max'}"
                                                              IsChecked="{Binding BypassVrChatScaleLimits, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Text="{loc:Translate 'When enabled, this scale redeem ignores VRChat world min/max values. Worlds may still block extreme scaling, and very large or tiny values can be uncomfortable.'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Text="{Binding ScaleRangeHelpText}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <Border Margin="0,18,0,0"
                                    Background="{DynamicResource PanelHighlightBrush}"
                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingAvatarTriggers}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedAvatarProfile}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{loc:Translate 'Redeems In This Avatar Set'}"
                                                   Style="{StaticResource HeadingTextStyle}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                Click="OnHelpButtonClicked"
                                                CommandParameter="Redeems In This Avatar Set"
                                                Tag="This list holds the redeems that belong to the avatar set you selected. These rules turn on when Crystal Relay detects that exact avatar, and they turn off again when you switch away. Add Redeem creates another rule for this avatar, Delete Redeem removes the selected one, Test Redeem lets you try it locally, and Disable Pairing lets you temporarily hide sibling redeems while one is active." />
                                    </DockPanel>
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{loc:Translate 'This is the redeem list for this avatar set. Pick a redeem to edit it below, test it, or choose which sibling redeems should stay off while it is active.'}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="{loc:Translate 'Add Redeem'}"
                                                Command="{Binding AddRuleCommand}" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{loc:Translate 'Delete Redeem'}"
                                                Command="{Binding RemoveSelectedRuleCommand}" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{loc:Translate 'Test Redeem'}"
                                                Command="{Binding TestSelectedRuleCommand}" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="{loc:Translate 'Disable Pairing'}"
                                                Command="{Binding OpenSpecialRuleLockoutPickerCommand}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{Binding SpecialRuleLockoutSummaryText}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRule}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Margin="0,14,0,0"
                                        Background="{DynamicResource NestedPanelBrush}"
                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSetTriggerMasterRewardEditorVisible}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel DataContext="{Binding SelectedAvatarProfile}">
                                        <TextBlock Text="{loc:Translate 'Master Outfit Set Reward'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{loc:Translate 'These outfit choices share one Twitch reward. Viewers type the choice number in the redeem input.'}" />
                                        <UniformGrid Columns="2"
                                                     Margin="0,12,0,0">
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="{loc:Translate 'Reward Name'}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBox Text="{Binding SetTriggerMasterRewardTitle, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="14,0,0,0">
                                                <TextBlock Text="{loc:Translate 'Reward Cost'}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBox Text="{Binding SetTriggerMasterRewardCost, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <UniformGrid Columns="2"
                                                     Margin="0,12,0,0">
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="{loc:Translate 'Reward Cooldown'}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBox Text="{Binding SetTriggerMasterRewardCooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Margin="14,0,0,0"
                                                        VerticalAlignment="Bottom">
                                                <CheckBox IsChecked="{Binding DeleteSetTriggerMasterRewardWhenInactive, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBlock Text="{loc:Translate 'Delete Twitch reward when inactive'}"
                                                               TextWrapping="Wrap" />
                                                </CheckBox>
                                            </StackPanel>
                                        </UniformGrid>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="{loc:Translate 'Managed Reward Colors'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold" />
                                            <DockPanel Margin="0,8,0,0"
                                                       LastChildFill="False">
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Background="{Binding SetTriggerMasterRewardReadyColorBrush}"
                                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                                        BorderThickness="1" />
                                                <TextBlock Margin="12,0,16,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding SetTriggerMasterRewardReadyColor}" />
                                                <Button Content="{loc:Translate 'Choose Color'}"
                                                        Padding="16,6"
                                                        MinWidth="132"
                                                        Click="OnPickManagedRewardColorClicked"
                                                        Tag="Ready" />
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,0"
                                                       LastChildFill="False">
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Background="{Binding SetTriggerMasterRewardCooldownColorBrush}"
                                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                                        BorderThickness="1" />
                                                <TextBlock Margin="12,0,16,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding SetTriggerMasterRewardCooldownColor}" />
                                                <Button Content="{loc:Translate 'Choose Color'}"
                                                        Padding="16,6"
                                                        MinWidth="132"
                                                        Click="OnPickManagedRewardColorClicked"
                                                        Tag="Cooldown" />
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,14,0,0"
                                        Background="{DynamicResource NestedPanelBrush}"
                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="14">
                                        <StackPanel>
                                            <Expander Margin="0,0,0,8"
                                                      IsExpanded="{Binding IsAvatarBoolRedeemsExpanded, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextBrush}">
                                                <Expander.Header>
                                                    <Border Padding="10,5"
                                                            Background="{DynamicResource StatusChipBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding AvatarBoolRedeemGroupTitle}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                            <TextBlock Margin="10,0,0,0"
                                                                       Text="{Binding SelectedAvatarBoolRedeems.Count}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12" />
                                                        </DockPanel>
                                                    </Border>
                                                </Expander.Header>
                                                <ListBox Margin="0,8,0,0"
                                                         ItemsSource="{Binding SelectedAvatarBoolRedeems}"
                                                         SelectedItem="{Binding SelectedRule}"
                                                         ScrollViewer.CanContentScroll="True"
                                                         VirtualizingStackPanel.IsVirtualizing="True"
                                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                         ItemTemplate="{StaticResource AvatarRedeemListItemTemplate}" />
                                            </Expander>

                                            <Expander Margin="0,10,0,8"
                                                      IsExpanded="{Binding IsAvatarIntRedeemsExpanded, Mode=TwoWay}"
                                                      Foreground="{DynamicResource TextBrush}">
                                                <Expander.Header>
                                                    <Border Padding="10,5"
                                                            Background="{DynamicResource StatusChipBrush}"
                                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{Binding AvatarIntRedeemGroupTitle}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold"
