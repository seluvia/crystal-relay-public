                                                        CornerRadius="16"
                                                        Padding="14">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'Power Up Rules'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
