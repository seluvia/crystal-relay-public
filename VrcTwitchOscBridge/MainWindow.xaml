                                                                           FontWeight="SemiBold"
                                                                           FontSize="12" />
                                                            </DockPanel>
                                                        </Border>
                                                    </Expander.Header>
                                                    <ListBox Margin="0,8,0,0"
                                                             ItemsSource="{Binding UniversalGiftSubscriptionTriggers}"
                                                             SelectedItem="{Binding SelectedUniversalTrigger}"
                                                             ScrollViewer.CanContentScroll="True"
                                                             VirtualizingStackPanel.IsVirtualizing="True"
                                                             VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                                </Expander>

                                                <Expander Margin="0,10,0,8"
