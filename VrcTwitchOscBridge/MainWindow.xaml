            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                                <Grid>
                                    <Border x:Name="CheckChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" />
                                    <Path x:Name="CheckMark"
                                          Width="12"
                                          Height="9"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 1 5 L 4.5 8 L 11 1"
                                          Stroke="White"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              ContentSource="Content" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource RuleCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckChrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track"
                                   Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                        CornerRadius="3"
                                                        Background="{TemplateBinding Foreground}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6"
                                                         CornerRadius="3"
                                                         Background="{TemplateBinding Background}"
                                                         VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="SliderThumb"
                                           Width="18"
                                           Height="18"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="ThumbCircle"
                                                         Fill="{DynamicResource AccentBrush}"
                                                         Stroke="{DynamicResource AccentBrush}"
                                                         StrokeThickness="2"
                                                         Width="18"
                                                         Height="18" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="StrokeThickness" Value="3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4" />
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RuleToggleStyle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Content" Value="Off" />
            <Setter Property="Cursor" Value="Hand" />
            <EventSetter Event="PreviewMouseWheel" Handler="OnRuleTogglePreviewMouseWheel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="On" />
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource RuleCardHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type models:TriggerRule}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0"
                                  VerticalAlignment="Top"
                                  Style="{StaticResource RuleToggleStyle}"
                                  IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DisplayTitle}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                </Grid>
                <TextBlock Grid.Row="1"
                           Margin="0,8,0,0"
                           Text="{Binding TriggerSummary}"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        Padding="8,3"
                        HorizontalAlignment="Left"
                        CornerRadius="9"
                        Background="{DynamicResource StatusChipBrush}"
                        Visibility="{Binding HasSupporterAvatarScopeLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding SupporterAvatarScopeLabel}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AvatarRedeemListItemTemplate"
                      DataType="{x:Type models:TriggerRule}">
            <Grid Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  CommandParameter="{Binding}" />
                </Grid.InputBindings>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0"
                              VerticalAlignment="Top"
                              Style="{StaticResource RuleToggleStyle}"
                              IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding RewardDisplayTitle}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding AvatarRedeemListSummary}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="3"
                        Margin="12,0,0,0"
                        Padding="10,4"
                        VerticalAlignment="Top"
                        CornerRadius="10"
                        Background="{DynamicResource StatusChipBrush}"
                        Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSpecialRuleLockouts}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SpecialRulePairingBadgeText}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="ThemeBackgroundHost"
                            Grid.RowSpan="2"
                            IsHitTestVisible="False"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid Margin="12,8,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Source="Assets/crystal-relay-icon.png"
                               Width="24"
                               Height="24"
                               Margin="0,0,10,0"
                               Stretch="Uniform" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Crystal Relay"
                                       Foreground="{DynamicResource TitleBarTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding WindowHeaderSubtitle}"
                                       Foreground="{DynamicResource TitleBarSubTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnMinimizeButtonClick"
                              ToolTip="{loc:Translate 'Minimize'}">
                            <TextBlock Text="&#x2013;"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,-6,0,0"
                                       Foreground="{DynamicResource TitleBarTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnToggleMaximizeButtonClick"
                              ToolTip="{loc:Translate 'Maximize or restore'}">
                            <TextBlock x:Name="WindowStateGlyph"
                                       Text="&#x25A1;"
                                       FontSize="14"
                                       Foreground="{DynamicResource TitleBarTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource TitleBarButtonStyle}"
                                Click="OnHideToTrayButtonClick"
                              ToolTip="{loc:Translate 'Hide to tray'}">
                            <TextBlock Text="&#x00D7;"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TitleBarTextBrush}" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="OnPowerButtonClick"
                              ToolTip="{loc:Translate 'Power Off'}">
                            <Viewbox Width="16"
                                     Height="16"
                                     Stretch="Uniform">
                                <Grid Width="24" Height="24">
                                    <Path Data="M12,3 L12,11"
                                          Stroke="{DynamicResource TitleBarTextBrush}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path Data="M7.4,5.2 A7.2,7.2 0 1 0 16.6,5.2"
                                          Stroke="{DynamicResource TitleBarTextBrush}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        <Grid Grid.Row="1" Margin="22" Opacity="{Binding Settings.InterfaceOpacity}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,8,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource HomeSectionButtonStyle}"
                            Content="{loc:Translate 'Home'}"
                            Command="{Binding ShowHomeSectionCommand}" />
                    <Button Style="{StaticResource SettingsSectionButtonStyle}"
                            Content="{loc:Translate 'Settings'}"
                            Command="{Binding ShowSettingsSectionCommand}" />
                    <Button Style="{StaticResource ActivitySectionButtonStyle}"
                            Content="{loc:Translate 'Activity'}"
                            Command="{Binding ShowActivitySectionCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <!-- Top-right actions stay available from any main section:
                         stream-safe pause, test mode toggle, chatbox, and About. -->
                    <Button Margin="0,0,10,0"
                            Content="{Binding EmergencyRedeemStopButtonText}"
                            ToolTip="{Binding EmergencyRedeemStopHelpText}"
                            Command="{Binding ToggleEmergencyRedeemStopCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmergencyRedeemStopEnabled}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="0,0,10,0"
                            Content="{Binding RewardTestOverrideButtonText}"
                            ToolTip="{Binding RewardTestOverrideHelpText}"
                            Command="{Binding OpenTestModeWindowCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStreamingTestButtonVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                     <Button Style="{StaticResource SecondaryButtonStyle}"
                             Margin="0,0,10,0"
                             Content="{loc:Translate 'Twitch Chatbox'}"
                             Command="{Binding OpenTwitchChatboxCommand}" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0"
                            Content="{loc:Translate 'Report Bug'}"
                            Command="{Binding OpenBugReportCommand}" />
                    <Grid Margin="0">
                        <Button Style="{StaticResource AboutSectionButtonStyle}"
                                Margin="0"
                                Content="{loc:Translate 'About'}"
                                Command="{Binding ShowAboutSectionCommand}" />
                        <Border Width="10"
                                Height="10"
                                CornerRadius="5"
                                Background="#44D36E"
                                BorderBrush="#E8FFF0"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-3,-3,0"
                                Panel.ZIndex="2"
                                ToolTip="{loc:Translate 'Someone in About is live right now.'}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLiveAboutProfiles}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Grid.Column="0">
                <!-- Home section:
                     quick status cards, the main icon/home area, and first-stop actions for normal use. -->
                <ScrollViewer
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHomeSectionSelected}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                    <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource PanelBrush}" Padding="24">
                        <StackPanel>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                 <Button Width="130"
                                         Height="130"
                                         Margin="0,0,8,0"
                                         Padding="0"
                                         Background="Transparent"
                                         BorderBrush="Transparent"
                                         BorderThickness="0"
                                         Cursor="Arrow"
                                         Focusable="False"
                                         FocusVisualStyle="{x:Null}"
                                         Click="OnHomeBrandIconClicked">
                                     <Button.Template>
                                         <ControlTemplate TargetType="Button">
                                             <ContentPresenter />
                                         </ControlTemplate>
                                     </Button.Template>
                                    <Grid Width="130"
                                          Height="130">
                                         <Border Background="{DynamicResource PanelHighlightBrush}"
                                                 BorderBrush="{DynamicResource AccentBrush}"
                                                 BorderThickness="3"
                                                 CornerRadius="26" />
                                         <Border Margin="6"
                                                 Background="{DynamicResource PanelSecondaryBrush}"
                                                 BorderBrush="{DynamicResource InputBorderBrush}"
                                                 BorderThickness="1.5"
                                                 CornerRadius="20">
                                             <Grid>
                                                 <Grid.Clip>
                                                     <RectangleGeometry Rect="0,0,116,116"
                                                                        RadiusX="20"
                                                                        RadiusY="20" />
                                                 </Grid.Clip>
                                                 <Image Source="Assets/crystal-relay-icon.png"
                                                        Stretch="UniformToFill" />
                                                 <Border Background="Transparent"
                                                         BorderBrush="{DynamicResource PanelHighlightBrush}"
                                                         BorderThickness="2"
                                                         CornerRadius="20"
                                                         IsHitTestVisible="False" />
                                             </Grid>
                                         </Border>
                                     </Grid>
                                 </Button>
                                 <StackPanel Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Margin="14,0,0,0">
                                     <TextBlock Text="{loc:Translate 'Crystal Relay'}"
                                                Style="{StaticResource HeadingTextStyle}"
                                                FontSize="26"
                                                FontWeight="Bold"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{DynamicResource TextBrush}" />
                                     <WrapPanel Margin="0,4,0,0">
                                         <TextBlock Text="{Binding HomeVersionDisplay}"
                                                    FontSize="14"
                                                    Foreground="{DynamicResource MutedBrush}"
                                                    VerticalAlignment="Center" />
                                         <Border Margin="8,0,0,0"
                                                 Padding="6,1,6,2"
                                                 CornerRadius="4"
                                                 Background="{DynamicResource AccentBrush}"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 Opacity="0.85"
                                                 Visibility="{Binding HasBetaBuildLabel, Converter={StaticResource BoolToVisibilityConverter}}">
                                             <TextBlock Text="beta"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="White" />
                                         </Border>
                                     </WrapPanel>
                                 </StackPanel>
                            </Grid>

                            <Border Margin="0,16,0,0"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,14,0,0">
                                <TextBlock FontSize="16"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontWeight="Medium"
                                           FontStyle="Italic"
                                           Text="{loc:Translate 'Your crystal bridge from Twitch to VRChat'}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Margin="0,16,0,0">
                                <TextBlock Text="{loc:Translate 'Support Crystal Relay'}"
                                           Style="{StaticResource HeadingTextStyle}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Margin="0,4,0,10"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Text="{loc:Translate 'Crystal Relay is free for everyone. If it helps your stream, you can leave a tip or join the community.'}"
                                           TextWrapping="Wrap" />

                                <Border Background="{DynamicResource PanelSecondaryBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32"
                                                CornerRadius="8"
                                                Background="{DynamicResource StatusChipBrush}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <Viewbox Width="16" Height="16"
                                                     Stretch="Uniform">
                                                <Grid Width="24" Height="24">
                                                    <Path Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"
                                                          Fill="{DynamicResource AccentBrush}" />
                                                </Grid>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Translate 'Support on Ko-fi'}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{loc:Translate 'One-time tips help keep development going'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="10,5"
                                                FontSize="11"
                                                Content="{loc:Translate 'Tip'}"
                                                Command="{Binding OpenKoFiSupportCommand}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource PanelSecondaryBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32"
                                                CornerRadius="8"
                                                Background="{DynamicResource StatusChipBrush}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <Viewbox Width="16" Height="16"
                                                     Stretch="Uniform">
                                                <Grid Width="24" Height="24">
                                                    <Path Data="M2,2H22V16H6L2,20V2Z"
                                                          Fill="{DynamicResource AccentBrush}" />
                                                </Grid>
