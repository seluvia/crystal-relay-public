                                            Command="{Binding ShowSettingsTwitchSectionCommand}" />
                                    <Button Style="{StaticResource SettingsVrChatSubsectionButtonStyle}"
                                            Content="{loc:Translate 'VRChat'}"
                                            Command="{Binding ShowSettingsVrChatSectionCommand}" />
                                    <Button Style="{StaticResource SettingsAppSubsectionButtonStyle}"
                                            Content="{loc:Translate 'App'}"
                                            Command="{Binding ShowSettingsAppSectionCommand}" />
                                </UniformGrid>
                                <UniformGrid Columns="2"
                                             Width="260"
                                             Margin="0,10,0,0"
                                             HorizontalAlignment="Center">
                                    <Button Style="{StaticResource SettingsVisualsSubsectionButtonStyle}"
                                            Content="{loc:Translate 'Visuals'}"
                                            Command="{Binding ShowSettingsVisualsSectionCommand}" />
