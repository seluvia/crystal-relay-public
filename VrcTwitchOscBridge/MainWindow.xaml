                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="16"
                                                        Padding="14">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'Twitch Custom Power-up'}"
