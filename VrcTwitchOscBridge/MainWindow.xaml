                                                   Text="{Binding StreamingStreamStateText}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Style="{StaticResource StreamingStatusChipValueStyle}"
                                                   Tag="{Binding StreamingStreamStateVisual}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Padding="12,10"
                                        Style="{StaticResource StreamingStatusChipBorderStyle}"
                                        Tag="{Binding StreamingListenerStateVisual}">
                                    <StackPanel>
                                            <TextBlock Text="{loc:Translate 'Twitch Listener'}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding StreamingListenerStateText}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Style="{StaticResource StreamingStatusChipValueStyle}"
                                                   Tag="{Binding StreamingListenerStateVisual}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
