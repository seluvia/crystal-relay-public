                                                                     ScrollViewer.CanContentScroll="True"
                                                                     VirtualizingStackPanel.IsVirtualizing="True"
                                                                     VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ContentControl.ContentTemplate>
                                    </ContentControl>
                                    <TextBlock Margin="0,18,0,0"
                                               Text="{loc:Translate 'Select or add a scale set to edit scale redeems.'}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAvatarScaleSet}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <ContentControl Margin="0,18,0,0"
                                            Content="{Binding SelectedAvatarScaleRule}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingAvatarScaling}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedAvatarScaleRule}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate DataType="{x:Type models:AvatarScaleRule}">
                                        <StackPanel>
                                            <Border Background="{DynamicResource PanelHighlightBrush}"
                                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="18">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Translate 'Scale Trigger Settings'}"
                                                               Style="{StaticResource HeadingTextStyle}"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <UniformGrid Columns="2"
                                                                 Margin="0,12,0,0">
                                                        <StackPanel Margin="0,0,14,0">
                                                            <TextBlock Text="{loc:Translate 'Display Name'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
