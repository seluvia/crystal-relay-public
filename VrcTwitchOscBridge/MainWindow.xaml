                                    <TextBlock Text="{loc:Translate 'Fire Sale Status'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding RewardFireSaleStatusText}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                    <ProgressBar Margin="0,10,0,0"
                                                 Height="8"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding RewardFireSaleProgressPercent, Mode=OneWay}"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 Background="{DynamicResource PanelBrush}" />
                                    <UniformGrid Margin="0,12,0,0"
                                                 Columns="2">
                                        <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                                Margin="0,0,6,0"
                                                Content="{loc:Translate 'Reset Progress'}"
                                                Command="{Binding ResetRewardFireSaleProgressCommand}" />
                                        <Button Style="{StaticResource RuleLibraryDangerButtonStyle}"
                                                Margin="6,0,0,0"
                                                Content="{loc:Translate 'Stop Fire Sale'}"
                                                Command="{Binding StopRewardFireSaleCommand}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    <Grid Margin="0,14,0,0"
                          HorizontalAlignment="Stretch">
                        <ListBox ItemsSource="{Binding AvatarRuleProfiles}"
                                 SelectedItem="{Binding SelectedAvatarProfile}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingMasterAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingSupporterOverrides}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingMovementRedeems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingAvatarScaling}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingCashPayments}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingPowerUps}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingRewardFireSale}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <ListBox ItemsSource="{Binding MasterAvatarRules}"
                                 SelectedItem="{Binding SelectedRule}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingMasterAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <ListBox ItemsSource="{Binding MovementRedeemSets}"
                                 SelectedItem="{Binding SelectedMovementRedeemSet}"
                                 ItemTemplate="{StaticResource MovementRedeemSetListItemTemplate}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingMovementRedeems}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingSupporterOverrides}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel>
                                <Border Background="{DynamicResource NestedPanelBrush}"
                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{loc:Translate 'Avatar Supporter Triggers'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button Style="{StaticResource HelpIconButtonStyle}"
                                                    Width="22"
                                                    Height="22"
                                                    MinWidth="22"
                                                    MinHeight="22"
                                                    Margin="6,0,0,0"
                                                    Click="OnHelpButtonClicked"
                                                    CommandParameter="Avatar Supporter Triggers"
                                                    Tag="Bits and subs rules in this group only run while you are wearing their assigned VRChat avatar." />
                                        </DockPanel>
                                        <ListBox ItemsSource="{Binding SelectedAvatarSupporterRules}"
                                                 SelectedItem="{Binding SelectedRule, Mode=OneWayToSource}"
                                                 Margin="0,8,0,0"
                                                 MinHeight="54"
                                                 MaxHeight="220"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,8,0,0"
                                        Background="{DynamicResource NestedPanelBrush}"
                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{loc:Translate 'Force Movement Overrides'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button Style="{StaticResource HelpIconButtonStyle}"
                                                    Width="22"
                                                    Height="22"
                                                    MinWidth="22"
                                                    MinHeight="22"
                                                    Margin="6,0,0,0"
                                                    Click="OnHelpButtonClicked"
                                                    CommandParameter="Force Movement Overrides"
                                                    Tag="Force Movement Overrides listen for Bits cheers with a configured word, then hold the selected VRChat movement input for the active time. Small spelling mistakes are okay, but unclear words will not trigger." />
                                        </DockPanel>
                                        <ListBox ItemsSource="{Binding ForceMovementOverrideRules}"
                                                 SelectedItem="{Binding SelectedRule, Mode=OneWayToSource}"
                                                 Margin="0,8,0,0"
                                                 MinHeight="54"
                                                 MaxHeight="190"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,8,0,0"
                                        Background="{DynamicResource NestedPanelBrush}"
                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{loc:Translate 'Avatar Change Overrides'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button Style="{StaticResource HelpIconButtonStyle}"
                                                    Width="22"
                                                    Height="22"
                                                    MinWidth="22"
                                                    MinHeight="22"
                                                    Margin="6,0,0,0"
                                                    Click="OnHelpButtonClicked"
                                                    CommandParameter="Avatar Change Overrides"
                                                    Tag="Global paid avatar changes live here so outfit-name Bits triggers can win when viewers type an outfit name." />
                                        </DockPanel>
                                        <ListBox ItemsSource="{Binding AvatarChangeOverrideRules}"
                                                 SelectedItem="{Binding SelectedRule, Mode=OneWayToSource}"
