        <Style x:Key="ComboPopupScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource ComboPopupVerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template" Value="{StaticResource ComboPopupHorizontalScrollBarTemplate}" />
