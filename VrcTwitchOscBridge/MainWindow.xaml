                                                    <DataTrigger Binding="{Binding SelectedAvatarScaleSet}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                        <ContentControl.ContentTemplate>
                                            <DataTemplate DataType="{x:Type models:AvatarScaleSet}">
