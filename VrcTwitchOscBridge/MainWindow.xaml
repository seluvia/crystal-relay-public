                                                                            Tag="Cooldown" />
                                                                </DockPanel>
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <TextBlock Margin="0,12,0,0"
                                                                   Text="{Binding DataContext.AvatarScaleMasterRewardStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
