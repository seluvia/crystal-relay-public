                                                        <TextBlock Grid.Column="0"
                                                                   Text="{loc:Translate 'Trigger info announcements'}"
                                                                   Style="{StaticResource HeadingTextStyle}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <Button Grid.Column="1"
                                                                Margin="8,0,0,0"
                                                                Style="{StaticResource HelpIconButtonStyle}"
                                                                Click="OnHelpButtonClicked"
                                                                CommandParameter="Trigger info announcements"
                                                                Tag="When enabled, Crystal Relay posts one compact Twitch chat message while you are live. The message lists current-avatar outfit choices, Bits outfit names, Bits grow/shrink scale words, and sub or gift-sub scale effects." />
                                                    </Grid>
                                                    <CheckBox Margin="0,10,0,0"
                                                              Content="{loc:Translate 'Post current trigger info while live'}"
                                                              IsChecked="{Binding Settings.TriggerInfoAnnouncementsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{loc:Translate 'Send every'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBox Grid.Column="1"
                                                                 Margin="8,0"
                                                                 Text="{Binding Settings.TriggerInfoAnnouncementIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Grid.Column="2"
                                                                   VerticalAlignment="Center"
                                                                   Text="{loc:Translate 'minutes'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                    <TextBlock Margin="0,8,0,0"
                                                               Text="{loc:Translate 'Crystal Relay only posts these automatic trigger messages while Twitch says the stream is live. It skips the timed message if no current-avatar trigger info is available.'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,14,0,0" Background="{DynamicResource NestedPanelBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16"
                                            Visibility="{Binding IsSettingsTwitchSectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{loc:Translate 'Bits/Subs override info messages'}" Style="{StaticResource HeadingTextStyle}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                        Click="OnHelpButtonClicked"
                                                        CommandParameter="Bits/Subs override info messages"
                                                        Tag="Paid override info messages use the optional bot account. They replace the normal per-rule Bot Message for Bits/Subs overrides while enabled, so chat only gets one bot post." />
                                            </DockPanel>
                                            <CheckBox Margin="0,10,0,0"
                                                      Content="{loc:Translate 'Enable automatic Bits/Subs info messages'}"
                                                      IsChecked="{Binding Settings.SupporterOverrideInfoMessageEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{loc:Translate 'When enabled, the connected bot posts one generated message when a Bits/Subs override runs. It shows the trigger amount, time added, and a compact list of configured paid override timers.'}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,14,0,0" Background="{DynamicResource NestedPanelBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16"
                                            Visibility="{Binding IsSettingsVrChatSectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{loc:Translate 'VRChat Avatar Access'}" Style="{StaticResource HeadingTextStyle}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                        Click="OnHelpButtonClicked"
                                                        CommandParameter="VRChat Avatar Access"
                                                        Tag="Sign in to the VRChat account whose avatars you want Crystal Relay to use. This login loads your selectable avatar list, keeps avatar names clean in the pickers, and lets Avatar Change and Avatar Roulette rules point at the correct avatar IDs. Your live current avatar and local OSC parameter data still come from your local VRChat files for the connected user." />
                                            </DockPanel>
                                            <TextBlock Margin="0,10,0,0"
                                                       Text="{Binding VrChatStatus}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding VrChatConnectionStateLabel}"
                                                       ToolTip="{Binding VrChatConnectionStateTooltip}"
                                                       Foreground="{Binding VrChatConnectionStateBrush}"
                                                       FontSize="11"
                                                       FontWeight="Normal" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding VrChatAvatarStatus}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="{loc:Translate 'Connect VRChat'}" Command="{Binding ConnectVrChatCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVrChatConnected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                 <Button Content="{loc:Translate 'Refresh Avatars'}" Command="{Binding RefreshVrChatAvatarsCommand}">
                                                     <Button.Style>
                                                         <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                             <Setter Property="Visibility" Value="Visible" />
                                                         </Style>
                                                     </Button.Style>
                                                 </Button>
                                                <Button Content="{loc:Translate 'Disconnect VRChat'}" Command="{Binding DisconnectVrChatCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVrChatConnected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{loc:Translate 'Clear VRChat Cache'}" Command="{Binding ClearVrChatCacheCommand}"
                                                        ToolTip="{loc:Translate 'Wipe the cached VRChat avatar list and OSC parameter cache. Disconnect keeps the cache by default; use this when you want a fresh start.'}"
                                                        Style="{StaticResource SecondaryButtonStyle}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,14,0,0" Background="{DynamicResource NestedPanelBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16"
                                            Visibility="{Binding IsSettingsSafetySectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate 'Saved Login Repair'}"
                                                       Style="{StaticResource HeadingTextStyle}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{loc:Translate 'Use this if Crystal Relay keeps signing out, rejects saved sessions, or gets stuck in login loops. It backs up your redeem setup and theme assets, clears saved login state, restores the redeems, and restarts Crystal Relay.'}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <Border Margin="0,10,0,0"
                                                    Padding="10"
                                                    Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource DangerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <TextBlock Text="{loc:Translate 'This clears Twitch, VRChat, StreamElements, Streamlabs, and Ko-fi saved login tokens. Redeems and custom theme assets are restored from the backup.'}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Content="{loc:Translate 'Repair and Restart'}"
                                                        Command="{Binding RepairSavedLoginStateCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsVisualsSectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource PanelBrush}" Padding="24" Margin="0,0,0,0">
                                <StackPanel>
                                    <!-- Visual Settings controls the look-and-feel of the app itself.
                                         These are UI preferences, not Twitch or bridge runtime settings. -->
                                    <TextBlock Text="{loc:Translate 'Visual Settings'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,14,0,0"
                                               Text="{loc:Translate 'Theme'}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <ComboBox Margin="0,8,0,0"
                                              Width="220"
                                              HorizontalAlignment="Center"
                                              ItemsSource="{Binding ThemeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Margin="0,16,0,0"
                                            Padding="16"
                                            Background="{DynamicResource PanelSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCustomThemeSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate 'Custom Theme'}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,12,0">
                                                    <TextBlock Text="{loc:Translate 'Window Background'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.WindowBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Panel Background'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.PanelBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Border'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.BorderHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Text'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.TextHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Input Background'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.InputBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Secondary Button'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.SecondaryButtonHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Body Font'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <ComboBox Margin="0,6,0,0"
                                                              ItemsSource="{Binding CustomThemeFontOptions}"
                                                              IsTextSearchEnabled="True"
                                                              SelectedItem="{Binding Settings.CustomTheme.BodyFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0">
                                                    <TextBlock Text="{loc:Translate 'Panel Secondary'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.PanelSecondaryHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Accent'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.AccentHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Muted Text'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.MutedTextHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Input Border'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.InputBorderHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Title Bar'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.TitleBarHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Danger'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.DangerHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Heading Font'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <ComboBox Margin="0,6,0,0"
                                                              ItemsSource="{Binding CustomThemeFontOptions}"
                                                              IsTextSearchEnabled="True"
                                                              SelectedItem="{Binding Settings.CustomTheme.HeadingFontFamily, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Background Image'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding CustomThemeBackgroundImageStatusText}" />
                                                    <WrapPanel Margin="0,8,0,0"
                                                               HorizontalAlignment="Left">
                                                        <Button Margin="0,0,8,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{loc:Translate 'Choose Image'}"
                                                                Click="OnChooseCustomThemeBackgroundImageClicked" />
                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{loc:Translate 'Clear Image'}"
                                                                IsEnabled="{Binding HasCustomThemeBackgroundImage}"
                                                                Click="OnClearCustomThemeBackgroundImageClicked" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="0,16,0,0"
                                               Text="{loc:Translate 'Language'}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <ComboBox Margin="0,8,0,0"
                                              Width="220"
                                              HorizontalAlignment="Center"
                                              ItemsSource="{Binding LanguageOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedLanguageOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding LanguageRestartNoticeText}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLanguageRestartNoticeVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,18,0,0"
                                               Text="{Binding UiOpacityStatusText}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <Slider Minimum="10"
                                            Maximum="100"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.InterfaceOpacityPercent, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,12,0,0" />
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,14,0">
                                            <TextBlock Text="{loc:Translate 'Enable Easter Eggs'}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Text>
                                                    <loc:TranslateExtension Text="Turns Crystal Relay's hidden joke interactions on or off." />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource RuleToggleStyle}"
                                                      IsChecked="{Binding Settings.EasterEggsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource PanelSecondaryBrush}" Margin="0,16,0,0" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Test Button'}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{loc:Translate 'This button exists because you asked for it. It does exactly one extremely important thing.'}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Center"
                                            Content="{loc:Translate 'Test Button'}"
                                            Command="{Binding ShowSettingsTestCommand}" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="1" Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivitySectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAboutSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="{loc:Translate 'Redeem Library'}"
                                   Style="{StaticResource HeadingTextStyle}"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                       <Grid Margin="0,10,0,0">
                           <Grid.Resources>
                               <Style x:Key="NavCardStyle" TargetType="Border">
                                   <Setter Property="Background" Value="{DynamicResource NestedPanelBrush}" />
                                   <Setter Property="BorderBrush" Value="{DynamicResource HighlightBorderBrush}" />
                                   <Setter Property="BorderThickness" Value="1" />
                                   <Setter Property="CornerRadius" Value="14" />
                                   <Setter Property="Padding" Value="18" />
                               </Style>
                               <Style x:Key="NavCardButtonStyle" TargetType="Button">
                                   <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                                   <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                   <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                                   <Setter Property="BorderThickness" Value="1" />
                                   <Setter Property="Padding" Value="8,10" />
                                   <Setter Property="Cursor" Value="Hand" />
                                   <Setter Property="FontSize" Value="11" />
                               </Style>
                               <Style x:Key="NavCardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource NavCardButtonStyle}">
                                   <Setter Property="FontWeight" Value="Bold" />
                                   <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                               </Style>
                           </Grid.Resources>

                           <Grid.ColumnDefinitions>
                               <ColumnDefinition Width="*" />
                               <ColumnDefinition Width="12" />
                               <ColumnDefinition Width="*" />
                           </Grid.ColumnDefinitions>
                           <Grid.RowDefinitions>
                               <RowDefinition Height="Auto" />
                               <RowDefinition Height="12" />
                               <RowDefinition Height="Auto" />
                           </Grid.RowDefinitions>

                           <!-- Card 1: Avatar Sets (top-left) -->
                           <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource NavCardStyle}">
                               <StackPanel>
                                   <TextBlock Text="{loc:Translate 'Avatar Sets'}"
                                              FontFamily="{DynamicResource HeadingFontFamily}"
                                              FontSize="10"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MutedBrush}" />
                                   <TextBlock Margin="0,4,0,0"
                                              Text="{loc:Translate 'Group redeems by avatar set'}"
                                              FontWeight="Bold"
                                              FontSize="15"
                                              Foreground="{DynamicResource TextBrush}" />
                                   <TextBlock Margin="0,6,0,14"
                                              Text="{loc:Translate 'Organize avatar swap and scale rules into themed sets'}"
                                              Foreground="{DynamicResource MutedBrush}"
                                              FontSize="11"
                                              TextWrapping="Wrap" />
                                   <Button Content="{loc:Translate 'Manage →'}"
                                           Style="{StaticResource NavCardActionButtonStyle}"
                                           Command="{Binding OpenAvatarSetsManagerCommand}"
                                           HorizontalAlignment="Left" />
                               </StackPanel>
                           </Border>

                           <!-- Card 2: Avatar Actions (top-right) -->
                           <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource NavCardStyle}">
                               <StackPanel>
                                   <TextBlock Text="{loc:Translate 'Avatar Actions'}"
                                              FontFamily="{DynamicResource HeadingFontFamily}"
                                              FontSize="10"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MutedBrush}" />
                                   <TextBlock Margin="0,4,0,0"
                                              Text="{loc:Translate 'Swap, scale, and roulette'}"
                                              FontWeight="Bold"
                                              FontSize="15"
                                              Foreground="{DynamicResource TextBrush}" />
                                   <TextBlock Margin="0,6,0,14"
                                              Text="{loc:Translate 'Change avatars, height, or run avatar roulette'}"
                                              Foreground="{DynamicResource MutedBrush}"
                                              FontSize="11"
                                              TextWrapping="Wrap" />
                                   <UniformGrid Columns="2">
                                       <Button Content="{loc:Translate 'Avatar Swap'}"
                                               Style="{StaticResource NavCardButtonStyle}"
                                               Command="{Binding OpenAvatarSwapManagerCommand}"
                                               Margin="0,0,6,0" />
                                       <Button Content="{loc:Translate 'Avatar Scaling'}"
                                               Style="{StaticResource NavCardButtonStyle}"
                                               Command="{Binding OpenAvatarScalingManagerCommand}"
                                               Margin="6,0,0,0" />
                                   </UniformGrid>
                               </StackPanel>
                           </Border>

                           <!-- Card 3: Trigger Systems (bottom-left) -->
                           <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource NavCardStyle}">
                               <StackPanel>
                                   <TextBlock Text="{loc:Translate 'Trigger Systems'}"
                                              FontFamily="{DynamicResource HeadingFontFamily}"
                                              FontSize="10"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MutedBrush}" />
                                   <TextBlock Margin="0,4,0,0"
                                              Text="{loc:Translate 'Universal triggers and movement'}"
                                              FontWeight="Bold"
                                              FontSize="15"
                                              Foreground="{DynamicResource TextBrush}" />
                                   <TextBlock Margin="0,6,0,14"
                                              Text="{loc:Translate 'Chat commands, channel points, bits, subs, and movement redeems'}"
                                              Foreground="{DynamicResource MutedBrush}"
                                              FontSize="11"
                                              TextWrapping="Wrap" />
                                   <UniformGrid Columns="2">
                                       <Button Content="{loc:Translate 'Universal Triggers'}"
                                               Style="{StaticResource NavCardButtonStyle}"
                                               Command="{Binding OpenUniversalTriggersManagerCommand}"
                                               Margin="0,0,6,0" />
                                       <Button Content="{loc:Translate 'Movement Redeems'}"
                                               Style="{StaticResource NavCardButtonStyle}"
                                               Command="{Binding ShowMovementRedeemsCommand}"
                                               Margin="6,0,0,0" />
                                   </UniformGrid>
                               </StackPanel>
                           </Border>

                           <!-- Card 4: Viewer Support (bottom-right) -->
                           <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource NavCardStyle}">
                               <StackPanel>
                                   <TextBlock Text="{loc:Translate 'Viewer Support'}"
                                              FontFamily="{DynamicResource HeadingFontFamily}"
                                              FontSize="10"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MutedBrush}" />
                                   <TextBlock Margin="0,4,0,0"
                                              Text="{loc:Translate 'Tips, donations, and sales'}"
                                              FontWeight="Bold"
                                              FontSize="15"
                                              Foreground="{DynamicResource TextBrush}" />
                                   <TextBlock Margin="0,6,0,14"
                                              Text="{loc:Translate 'StreamElements, Streamlabs, Ko-fi payments and reward fire sales'}"
                                              Foreground="{DynamicResource MutedBrush}"
                                              FontSize="11"
                                              TextWrapping="Wrap" />
                                   <UniformGrid Columns="2">
                                       <Button Content="{loc:Translate 'Cash Payments'}"
                                               Style="{StaticResource NavCardButtonStyle}"
                                               Command="{Binding OpenCashPaymentManagerCommand}"
                                               Margin="0,0,6,0" />
                                       <Button Content="{loc:Translate 'Reward Fire Sale'}"
                                               Style="{StaticResource NavCardButtonStyle}"
                                               Command="{Binding OpenRewardFireSaleManagerCommand}"
                                               Margin="6,0,0,0" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                            <!-- Connection Status -->
                            <Border Margin="0,20,0,0"
                                    Background="{DynamicResource NestedPanelBrush}"
                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Connection Status'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,0,0,12" />

                                    <!-- 2x2 Status Grid -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- VRChat (top-left) -->
                                        <Border Grid.Row="0" Grid.Column="0"
                                                Background="{DynamicResource PanelSecondaryBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{DynamicResource MutedBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVrChatConnected}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="VRChat"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Connected"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding IsVrChatConnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="Disconnected"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Visibility="{Binding IsVrChatDisconnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- OSC (top-right) -->
                                        <Border Grid.Row="0" Grid.Column="2"
                                                Background="{DynamicResource PanelSecondaryBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{DynamicResource MutedBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOscConnected}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="OSC"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Connected"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding IsOscConnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="Disconnected"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Visibility="{Binding IsOscDisconnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Twitch (bottom-left) -->
                                        <Border Grid.Row="2" Grid.Column="0"
                                                Background="{DynamicResource PanelSecondaryBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{DynamicResource MutedBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBroadcasterConnected}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="Twitch"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Connected"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding IsBroadcasterConnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="Disconnected"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Visibility="{Binding IsBroadcasterDisconnected, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Stream (bottom-right) -->
                                        <Border Grid.Row="2" Grid.Column="2"
                                                Background="{DynamicResource PanelSecondaryBrush}"
                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10,8">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8"
                                                             Fill="{DynamicResource MutedBrush}"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,6,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBroadcasterLive}" Value="True">
                                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="Stream"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="Live"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="{Binding IsBroadcasterLive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="Offline"
                                                           Margin="0,4,0,0"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Visibility="{Binding IsBroadcasterLive, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- OSC Controls Panel -->
                                    <Border Margin="0,12,0,0"
                                            Background="{DynamicResource PanelSecondaryBrush}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding OscBridgeSummary}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding OscStatusDetail}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Margin="0,0,8,8"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="{loc:Translate 'Restart Crystal Relay'}"
                                                        Click="OnRestartCrystalRelayClicked" />
                                                <Button Margin="0,0,0,8"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="{loc:Translate 'Restart VRChat + Crystal Relay'}"
                                                        Click="OnRestartVrChatAndCrystalRelayClicked" />
                                            </WrapPanel>
                                            <CheckBox Margin="0,4,0,0"
                                                      IsChecked="{Binding Settings.RestartVrChatInDesktopMode, UpdateSourceTrigger=PropertyChanged}">
                                                <TextBlock Text="{loc:Translate 'Restart VRChat in desktop mode'}"
                                                           TextWrapping="Wrap" />
                                            </CheckBox>
                                            <TextBlock Margin="26,4,0,0"
                                                       Text="{loc:Translate 'When checked, the VRChat restart button launches VRChat with --no-vr.'}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource PanelBrush}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivitySectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top"
                               LastChildFill="False">
                        <TextBlock Text="{loc:Translate 'Activity'}" Style="{StaticResource HeadingTextStyle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                Click="OnHelpButtonClicked"
                                CommandParameter="Activity"
                                Tag="Activity is Crystal Relay's running event log. It shows Twitch connection changes, reward sync results, VRChat avatar detection, OSC events, chat-command triggers, and errors so you can see what the app is doing without guessing. If something behaves strangely, this is usually the first place to check." />
                    </DockPanel>
                    <Border DockPanel.Dock="Top"
                            Margin="0,14,0,0"
                            Padding="14,10"
                            Background="{DynamicResource AttentionBrush}"
                            BorderBrush="{DynamicResource AttentionBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding HasActivityWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Activity warning'}"
                                       FontFamily="{DynamicResource HeadingFontFamily}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding ActivityAttentionMessage}"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ListBox Margin="0,18,0,0"
                             ItemsSource="{Binding LogEntries}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAboutSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Width="980"
                          HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/rikuknifesticker.png"
                               Width="320"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,300,12,22"
                               Opacity="0.9"
                               Stretch="Uniform"
                               IsHitTestVisible="False"
                               Panel.ZIndex="0"
                               RenderOptions.BitmapScalingMode="Fant">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.Theme}" Value="{x:Static models:AppTheme.DreamScape}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <StackPanel MaxWidth="980"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,250"
                                    Panel.ZIndex="1">
                        <!-- About intro explains the goal of Crystal Relay before the profile cards below. -->
                        <Border HorizontalAlignment="Center"
                                Width="940"
                                Background="{DynamicResource PanelHighlightBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="24">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate 'About Crystal Relay'}"
                                           Style="{StaticResource HeadingTextStyle}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextAlignment="Center" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{loc:Translate 'Crystal Relay is built to make Twitch-to-OSC control for VRChat easier to understand and easier to use.'}"
                                           FontSize="22"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{loc:Translate 'Crystal Relay exists because too many Twitch-to-OSC tools felt harder to learn than they needed to be.'}"
                                           FontSize="18"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,22,0,0"
                              HorizontalAlignment="Center">
                            <!-- About profile area:
                                 creator card on the left, playtester cards on the right. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="598" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource PanelHighlightBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Made By'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{loc:Translate 'Creator and main tester'}"
                                               FontSize="16"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <ContentControl Content="{Binding AboutCreatorProfile}"
                                                    ContentTemplate="{StaticResource AboutTwitchProfileTemplate}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource PanelSecondaryBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Playtesters'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{loc:Translate 'These streamers help test Crystal Relay before updates go out.'}"
                                               FontSize="16"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding AboutTesterProfiles}"
                                                  Margin="0,6,0,0"
                                                  ItemTemplate="{StaticResource AboutTesterProfileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"
                                                           ItemWidth="274"
                                                           HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
            <Grid x:Name="LoadingOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="999"
                  Background="#FF050508">
    <Grid.Resources>
        <!-- Crystal hologram animation: slow rotation + gentle pulse + glow breathing -->
        <Storyboard x:Key="HologramIdleStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HologramScaleTransform"
                                           Storyboard.TargetProperty="ScaleX"
                                           RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="1.03" />
                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HologramScaleTransform"
                                           Storyboard.TargetProperty="ScaleY"
                                           RepeatBehavior="Forever">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="1.03" />
                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Scanning line sweeping top to bottom -->
        <Storyboard x:Key="ScanLineStoryboard">
            <DoubleAnimation Storyboard.TargetName="ScanLineTranslateTransform"
                             Storyboard.TargetProperty="Y"
                             From="-400" To="600" Duration="0:0:3"
                             RepeatBehavior="Forever" />
        </Storyboard>



        <!-- HUD entrance: power-on flicker + header slide-down + HUD panel slide-up -->
        <Storyboard x:Key="HudEntranceStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CrystalHeaderText"
                                           Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.05" Value="0.4" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.15" Value="0.8" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="0" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.35" Value="0.6" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="CrystalHeaderTransform"
                             Storyboard.TargetProperty="Y"
                             From="-60" To="-120" Duration="0:0:0.5"
                             BeginTime="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="HudPanelBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.6"
                             BeginTime="0:0:0.3" />
            <ThicknessAnimation Storyboard.TargetName="HudPanelBorder"
                                Storyboard.TargetProperty="Margin"
                                From="0,40,0,0" To="0,160,0,0"
                                Duration="0:0:0.6"
                                BeginTime="0:0:0.3" />
        </Storyboard>

        <!-- Reveal transition: fade out overlay -->
        <Storyboard x:Key="RevealTransitionStoryboard">
            <DoubleAnimation Storyboard.TargetName="HologramGlowEllipse"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetName="LoadingOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.5"
                             BeginTime="0:0:0.3" />
        </Storyboard>
    </Grid.Resources>

    <!-- Star field (populated in code-behind) -->
    <Canvas x:Name="StarFieldCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Opacity="0.85" />

    <!-- Thin scan line bar at the very top -->
    <Rectangle Height="1"
               VerticalAlignment="Top"
               Fill="{DynamicResource AccentBrush}"
               Opacity="0.15"
                Margin="40,0,40,0" />

    <!-- CRYSTAL RELAY header text -->
    <TextBlock x:Name="CrystalHeaderText"
               Text="CRYSTAL RELAY"
               FontFamily="Consolas"
               FontSize="13"
               FontWeight="SemiBold"
               Foreground="{DynamicResource AccentBrush}"
               Opacity="0.3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,36,0,0"
                RenderTransformOrigin="0.5,0.5">
        <TextBlock.RenderTransform>
            <TranslateTransform x:Name="CrystalHeaderTransform" Y="-120" />
        </TextBlock.RenderTransform>
    </TextBlock>

    <!-- Holographic crystal projection area -->
    <Grid Width="106" Height="106"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          RenderTransformOrigin="0.5,0.5"
          Margin="0,0,0,60">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="HologramScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- Glow behind crystal -->
        <Ellipse x:Name="HologramGlowEllipse"
                 Width="140" Height="140"
                 Fill="{DynamicResource AccentBrush}"
                 Opacity="0.15"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
            <Ellipse.Effect>
                <BlurEffect Radius="40" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Crystal icon -->
        <Image Source="Assets/crystal-relay-icon.png"
               Width="80" Height="80"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.85" />
    </Grid>

    <!-- Scanning line sweep -->
    <Rectangle x:Name="ScanLineRectangle"
               Width="200" Height="1"
               Fill="{DynamicResource AccentBrush}"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Opacity="0.25"
                IsHitTestVisible="False"
                RenderTransformOrigin="0.5,0.5">
        <Rectangle.RenderTransform>
            <TranslateTransform x:Name="ScanLineTranslateTransform" Y="-400" />
        </Rectangle.RenderTransform>
        <Rectangle.Effect>
            <BlurEffect Radius="3" />
        </Rectangle.Effect>
    </Rectangle>

    <!-- HUD Status Panel -->
    <Border x:Name="HudPanelBorder"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,160,0,0"
            Opacity="0"
            BorderThickness="1"
            BorderBrush="{DynamicResource AccentBrush}"
            Background="#0A000000"
            CornerRadius="4"
            MinWidth="320">
        <StackPanel Margin="16,12,16,12">
            <TextBlock Text="INITIALIZATION SEQUENCE"
                       FontFamily="Consolas"
                       FontSize="10"
                       Foreground="{DynamicResource AccentBrush}"
                       Opacity="0.4"
                       Margin="0,0,0,10" />

            <ItemsControl ItemsSource="{Binding LoadingService.Phases}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Status tag -->
                            <TextBlock Text="{Binding StatusTag}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Opacity="{Binding RowOpacity}"
                                       VerticalAlignment="Center" />

                            <!-- Active pulsing glow dot -->
                            <Ellipse Grid.Column="1"
                                     Width="6" Height="6"
                                     Fill="{DynamicResource AccentBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"
                                     Opacity="0.7"
                                     Visibility="{Binding ShowActiveIndicator, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="3" />
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- Completed checkmark -->
                            <TextBlock Grid.Column="1"
                                       Text="✓"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Visibility="{Binding ShowCheckmark, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- Phase label -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Label}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Opacity="{Binding RowOpacity}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>

    <!-- Sign-off message (shown during reveal transition) -->
    <TextBlock x:Name="SignOffMessage"
               Text="All systems operational."
               FontFamily="Consolas"
               FontSize="12"
               FontWeight="SemiBold"
               Foreground="{DynamicResource AccentBrush}"
               Opacity="0"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               Margin="0,0,0,60" />

    <!-- Bottom-right version info -->
    <TextBlock x:Name="VersionInfoText"
               FontFamily="Consolas"
               FontSize="10"
               Foreground="{DynamicResource AccentBrush}"
               Opacity="0.2"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,16,12" />
            </Grid>
            <Grid x:Name="AdvertisementOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="1000"
                  Background="#F2000000"
                  ClipToBounds="True"
                  Visibility="Collapsed">
                <MediaElement x:Name="AdvertisementMediaElement"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Manual"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              MediaEnded="OnAdvertisementMediaEnded"
                              MediaFailed="OnAdvertisementMediaFailed" />
            </Grid>
        </Grid>
    </Border>
</Window>
