                                            Margin="0,10,0,0"
                                            Width="214"
                                            HorizontalAlignment="Center"
                                            Content="{loc:Translate 'Delete All Universal'}"
                                            Command="{Binding DeleteAllUniversalTriggersCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0"
