                                                    <Border Margin="0,16,0,0"
                                                            Padding="14"
                                                            Background="{DynamicResource NestedPanelBrush}"
                                                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
