                                                                         Margin="0,12,0,0">
                                                                <StackPanel Margin="0,0,14,0">
                                                                    <TextBlock Text="{loc:Translate 'Scale Set Name'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
