                                                <Button Content="{loc:Translate 'Connect VRChat'}" Command="{Binding ConnectVrChatCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVrChatConnected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{loc:Translate 'Refresh Avatars'}" Command="{Binding RefreshVrChatAvatarsCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVrChatConnected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{loc:Translate 'Disconnect VRChat'}" Command="{Binding DisconnectVrChatCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVrChatConnected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsVisualsSectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource PanelBrush}" Padding="24" Margin="0,0,0,0">
                                <StackPanel>
                                    <!-- Visual Settings controls the look-and-feel of the app itself.
                                         These are UI preferences, not Twitch or bridge runtime settings. -->
                                    <TextBlock Text="{loc:Translate 'Visual Settings'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,14,0,0"
                                               Text="{loc:Translate 'Theme'}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <ComboBox Margin="0,8,0,0"
                                              Width="220"
                                              HorizontalAlignment="Center"
                                              ItemsSource="{Binding ThemeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Margin="0,16,0,0"
                                            Padding="16"
                                            Background="{DynamicResource PanelSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCustomThemeSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate 'Custom Theme'}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,12,0">
                                                    <TextBlock Text="{loc:Translate 'Window Background'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.WindowBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Panel Background'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.PanelBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Border'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.BorderHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Text'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.TextHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Input Background'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.InputBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Secondary Button'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.SecondaryButtonHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Body Font'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <ComboBox Margin="0,6,0,0"
                                                              ItemsSource="{Binding CustomThemeFontOptions}"
                                                              IsTextSearchEnabled="True"
                                                              SelectedItem="{Binding Settings.CustomTheme.BodyFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0">
                                                    <TextBlock Text="{loc:Translate 'Panel Secondary'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.PanelSecondaryHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Accent'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.AccentHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Muted Text'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.MutedTextHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Input Border'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.InputBorderHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Title Bar'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.TitleBarHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Danger'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.DangerHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Heading Font'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <ComboBox Margin="0,6,0,0"
                                                              ItemsSource="{Binding CustomThemeFontOptions}"
                                                              IsTextSearchEnabled="True"
                                                              SelectedItem="{Binding Settings.CustomTheme.HeadingFontFamily, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Background Image'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding CustomThemeBackgroundImageStatusText}" />
                                                    <WrapPanel Margin="0,8,0,0"
                                                               HorizontalAlignment="Left">
                                                        <Button Margin="0,0,8,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{loc:Translate 'Choose Image'}"
                                                                Click="OnChooseCustomThemeBackgroundImageClicked" />
                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{loc:Translate 'Clear Image'}"
                                                                IsEnabled="{Binding HasCustomThemeBackgroundImage}"
                                                                Click="OnClearCustomThemeBackgroundImageClicked" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="0,16,0,0"
                                               Text="{loc:Translate 'Language'}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <ComboBox Margin="0,8,0,0"
                                              Width="220"
                                              HorizontalAlignment="Center"
                                              ItemsSource="{Binding LanguageOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedLanguageOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding LanguageRestartNoticeText}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLanguageRestartNoticeVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,18,0,0"
                                               Text="{Binding UiOpacityStatusText}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <Slider Minimum="10"
                                            Maximum="100"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.InterfaceOpacityPercent, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,12,0,0" />
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,14,0">
                                            <TextBlock Text="{loc:Translate 'Enable Easter Eggs'}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Text>
                                                    <loc:TranslateExtension Text="Turns Crystal Relay's hidden joke interactions on or off." />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource RuleToggleStyle}"
                                                      IsChecked="{Binding Settings.EasterEggsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource PanelSecondaryBrush}" Margin="0,16,0,0" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Test Button'}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{loc:Translate 'This button exists because you asked for it. It does exactly one extremely important thing.'}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Center"
                                            Content="{loc:Translate 'Test Button'}"
                                            Command="{Binding ShowSettingsTestCommand}" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="1" Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivitySectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAboutSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="{loc:Translate 'Redeem Library'}"
                                   Style="{StaticResource HeadingTextStyle}"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <!-- Rule Library tabs switch between the four editing modes:
                             avatar-tied redeems, avatar changes, movement redeems, and paid overrides. -->
                        <UniformGrid Margin="0,12,0,0"
                                     Width="340"
                                     Columns="2"
                                     HorizontalAlignment="Center">
                            <Button Content="{loc:Translate 'Avatar Sets'}"
                                    Command="{Binding ShowAvatarTriggerRulesCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RuleLibraryTabButtonStyle}">
                                        <Setter Property="Margin" Value="0,0,10,10" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingAvatarTriggers}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SectionActiveBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:Translate 'Avatar Change'}"
                                    Command="{Binding ShowMasterAvatarTabCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RuleLibraryTabButtonStyle}">
                                        <Setter Property="Margin" Value="10,0,0,10" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingMasterAvatar}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SectionActiveBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:Translate 'Movement Redeems'}"
                                    Command="{Binding ShowMovementRedeemsCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RuleLibraryTabButtonStyle}">
                                        <Setter Property="Margin" Value="0,0,10,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingMovementRedeems}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SectionActiveBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:Translate 'Bits + Subs'}"
                                    Command="{Binding ShowSupporterOverridesCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RuleLibraryTabButtonStyle}">
                                        <Setter Property="Margin" Value="10,0,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingSupporterOverrides}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SectionActiveBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:Translate 'Universal Triggers'}"
                                    Command="{Binding ShowUniversalTriggersCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RuleLibraryTabButtonStyle}">
                                        <Setter Property="Margin" Value="0,10,10,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SectionActiveBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:Translate 'Avatar Scaling'}"
                                    Command="{Binding ShowAvatarScalingCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RuleLibraryTabButtonStyle}">
                                        <Setter Property="Margin" Value="10,10,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingAvatarScaling}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SectionActiveBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                        <StackPanel Margin="0,16,0,0"
                                    Width="340"
                                    HorizontalAlignment="Center">
                            <DockPanel LastChildFill="False"
                                       HorizontalAlignment="Center">
                                <TextBlock Text="{loc:Translate 'Tab Actions'}"
                                           FontFamily="{DynamicResource HeadingFontFamily}"
                                           FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                        Width="24"
                                        Height="24"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Margin="8,0,0,0"
                                        Click="OnHelpButtonClicked"
                                        CommandParameter="Redeem Library"
                                        Tag="{Binding RuleLibraryHelpText}" />
                            </DockPanel>
                            <Border Margin="18,8,18,0"
                                    Height="1"
                                    Background="{DynamicResource HighlightBorderBrush}"
                                    Opacity="0.7" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0"
                                    Width="340"
                                    HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingMasterAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingSupporterOverrides}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingMovementRedeems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingAvatarScaling}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource RuleLibraryPrimaryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Content="{loc:Translate 'Add Avatar Set'}"
                                        Command="{Binding AddAvatarProfileCommand}" />
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="10,0,0,0"
                                        Content="{loc:Translate 'Delete Avatar Set'}"
                                        Command="{Binding DeleteSelectedAvatarProfileCommand}" />
                            </UniformGrid>
                            <Button Style="{StaticResource RuleLibraryDangerButtonStyle}"
                                    Margin="0,10,0,0"
                                    Width="196"
                                    HorizontalAlignment="Center"
                                    Content="{loc:Translate 'Delete All Avatar Sets'}"
                                    Command="{Binding DeleteAllAvatarProfilesCommand}" />
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0"
                                    Width="340"
                                    HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingMasterAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource RuleLibraryPrimaryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Content="{loc:Translate 'Add Avatar Change'}"
                                        Command="{Binding AddRuleCommand}" />
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="10,0,0,0"
                                        Content="{loc:Translate 'Delete Avatar Change'}"
                                        Command="{Binding RemoveSelectedRuleCommand}" />
                            </UniformGrid>
                            <UniformGrid Margin="0,10,0,0"
                                         Columns="2">
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Content="{loc:Translate 'Enable All'}"
                                        Command="{Binding EnableAllRulesCommand}" />
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="10,0,0,0"
                                        Content="{loc:Translate 'Disable All'}"
                                        Command="{Binding DisableAllRulesCommand}" />
                            </UniformGrid>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0"
                                    Width="340"
                                    HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingMovementRedeems}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource RuleLibraryPrimaryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Content="{loc:Translate 'Add Movement Redeem'}"
                                        Command="{Binding AddRuleCommand}" />
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="10,0,0,0"
                                        Content="{loc:Translate 'Delete Movement Redeem'}"
                                        Command="{Binding RemoveSelectedRuleCommand}" />
                            </UniformGrid>
                            <Button Style="{StaticResource RuleLibraryDangerButtonStyle}"
                                    Margin="0,10,0,0"
                                    Width="214"
                                    HorizontalAlignment="Center"
                                    Content="{loc:Translate 'Delete All Movement Redeems'}"
                                    Command="{Binding DeleteAllRulesCommand}" />
                            <UniformGrid Margin="0,10,0,0"
                                         Columns="2">
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Content="{loc:Translate 'Enable All'}"
                                        Command="{Binding EnableAllRulesCommand}" />
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="10,0,0,0"
                                        Content="{loc:Translate 'Disable All'}"
                                        Command="{Binding DisableAllRulesCommand}" />
                            </UniformGrid>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0"
                                    Width="340"
                                    HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingSupporterOverrides}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Style="{StaticResource RuleLibraryPrimaryButtonStyle}"
                                    Content="{loc:Translate 'Add Avatar Supporter Trigger'}"
                                    Command="{Binding AddAvatarSupporterTriggerCommand}" />
                            <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                    Margin="0,8,0,0"
                                    Content="{loc:Translate 'Add Avatar Change Override'}"
                                    Command="{Binding AddAvatarChangeOverrideCommand}" />
                            <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                    Margin="0,8,0,0"
                                    Content="{loc:Translate 'Delete Override'}"
                                    Command="{Binding RemoveSelectedRuleCommand}" />
                            <Button Style="{StaticResource RuleLibraryDangerButtonStyle}"
                                    Margin="0,8,0,0"
                                    Width="188"
                                    HorizontalAlignment="Center"
                                    Content="{loc:Translate 'Delete All Overrides'}"
                                    Command="{Binding DeleteAllRulesCommand}" />
                            <UniformGrid Margin="0,8,0,0"
                                         Columns="2">
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Content="{loc:Translate 'Enable All'}"
                                        Command="{Binding EnableAllRulesCommand}" />
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="10,0,0,0"
                                        Content="{loc:Translate 'Disable All'}"
                                Command="{Binding DisableAllRulesCommand}" />
                            </UniformGrid>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0"
                                    Width="340"
                                    HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Style="{StaticResource RuleLibraryPrimaryButtonStyle}"
                                        Content="{loc:Translate 'Import Fooma Config'}"
                                        Command="{Binding ImportFoomaInteractionConfigCommand}" />
                                <Button Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Style="{StaticResource HelpIconButtonStyle}"
                                        Click="OnFoomaHelpButtonClicked" />
                            </Grid>
                            <UniformGrid Margin="0,10,0,0"
                                         Columns="2">
                                <Button Style="{StaticResource RuleLibraryPrimaryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Content="{loc:Translate 'Add Universal'}"
                                        Command="{Binding AddUniversalTriggerCommand}" />
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="10,0,0,0"
                                        Content="{loc:Translate 'Enable All'}"
                                        Command="{Binding EnableAllUniversalTriggersCommand}" />
                            </UniformGrid>
                            <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                    Margin="0,10,0,0"
                                    Width="188"
                                    HorizontalAlignment="Center"
                                    Content="{loc:Translate 'Disable All'}"
                                    Command="{Binding DisableAllUniversalTriggersCommand}" />
                            <Border Margin="0,16,0,0"
                                    Padding="14"
                                    Background="{DynamicResource NestedPanelBrush}"
                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Delete Universal Triggers'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Style="{StaticResource RuleLibraryDangerButtonStyle}"
                                            Margin="0,10,0,0"
                                            Width="214"
                                            HorizontalAlignment="Center"
                                            Content="{loc:Translate 'Delete All Universal'}"
                                            Command="{Binding DeleteAllUniversalTriggersCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0"
                                    Width="340"
                                    HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingAvatarScaling}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <UniformGrid Columns="2">
                                <Button Style="{StaticResource RuleLibraryPrimaryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Content="{loc:Translate 'Add Scale Set'}"
                                        Command="{Binding AddAvatarScaleSetCommand}" />
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="10,0,0,0"
                                        Content="{loc:Translate 'Delete Scale Set'}"
                                        Command="{Binding RemoveSelectedAvatarScaleSetCommand}" />
                            </UniformGrid>
                            <UniformGrid Margin="0,10,0,0"
                                         Columns="2">
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Content="{loc:Translate 'Enable All Scale Redeems'}"
                                        Command="{Binding EnableAllAvatarScaleRulesCommand}" />
                                <Button Style="{StaticResource RuleLibraryButtonStyle}"
                                        Margin="10,0,0,0"
                                        Content="{loc:Translate 'Disable All Scale Redeems'}"
                                        Command="{Binding DisableAllAvatarScaleRulesCommand}" />
                            </UniformGrid>
                            <Border Margin="0,16,0,0"
                                    Padding="14"
                                    Background="{DynamicResource NestedPanelBrush}"
                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Delete Avatar Scale Sets'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <Button Style="{StaticResource RuleLibraryDangerButtonStyle}"
                                            Margin="0,10,0,0"
                                            Width="214"
                                            HorizontalAlignment="Center"
                                            Content="{loc:Translate 'Delete All Scale Sets'}"
                                            Command="{Binding DeleteAllAvatarScaleRulesCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    <Grid Margin="0,14,0,0"
                          HorizontalAlignment="Stretch">
                        <ListBox ItemsSource="{Binding AvatarRuleProfiles}"
                                 SelectedItem="{Binding SelectedAvatarProfile}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingMasterAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingSupporterOverrides}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingMovementRedeems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingAvatarScaling}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <ListBox ItemsSource="{Binding MasterAvatarRules}"
                                 SelectedItem="{Binding SelectedRule}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingMasterAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <ListBox ItemsSource="{Binding Settings.GlobalMovementRules}"
                                 SelectedItem="{Binding SelectedRule}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingMovementRedeems}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingSupporterOverrides}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel>
                                <Border Background="{DynamicResource NestedPanelBrush}"
                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{loc:Translate 'Avatar Supporter Triggers'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button Style="{StaticResource HelpIconButtonStyle}"
                                                    Width="22"
                                                    Height="22"
                                                    MinWidth="22"
                                                    MinHeight="22"
                                                    Margin="6,0,0,0"
                                                    Click="OnHelpButtonClicked"
                                                    CommandParameter="Avatar Supporter Triggers"
                                                    Tag="Bits and subs rules in this group only run while you are wearing their assigned VRChat avatar." />
                                        </DockPanel>
                                        <ListBox ItemsSource="{Binding SelectedAvatarSupporterRules}"
                                                 SelectedItem="{Binding SelectedRule, Mode=OneWayToSource}"
                                                 Margin="0,8,0,0"
                                                 MinHeight="54"
                                                 MaxHeight="220"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,8,0,0"
                                        Background="{DynamicResource NestedPanelBrush}"
                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{loc:Translate 'Avatar Change Overrides'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button Style="{StaticResource HelpIconButtonStyle}"
                                                    Width="22"
                                                    Height="22"
                                                    MinWidth="22"
                                                    MinHeight="22"
                                                    Margin="6,0,0,0"
                                                    Click="OnHelpButtonClicked"
                                                    CommandParameter="Avatar Change Overrides"
                                                    Tag="Global paid avatar changes live here so outfit-name Bits triggers can win when viewers type an outfit name." />
                                        </DockPanel>
                                        <ListBox ItemsSource="{Binding AvatarChangeOverrideRules}"
                                                 SelectedItem="{Binding SelectedRule, Mode=OneWayToSource}"
                                                 Margin="0,8,0,0"
                                                 MinHeight="54"
                                                 MaxHeight="190"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Settings.UniversalTriggers}"
                                 SelectedItem="{Binding SelectedUniversalTrigger}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <ListBox ItemsSource="{Binding AvatarScaleSets}"
                                 SelectedItem="{Binding SelectedAvatarScaleSet}"
                                 ItemTemplate="{StaticResource AvatarScaleSetListItemTemplate}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsViewingAvatarScaling}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                        </ListBox>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Text" Value="{loc:Translate 'Add an avatar set to get started.'}" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsViewingAvatarTriggers}" Value="True" />
                                                <Condition Binding="{Binding AvatarRuleProfiles.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding IsViewingMasterAvatar}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsViewingMovementRedeems}" Value="True" />
                                                <Condition Binding="{Binding Settings.GlobalMovementRules.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Text" Value="{loc:Translate 'Add a movement redeem to get started.'}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsViewingUniversalTriggers}" Value="True" />
                                                <Condition Binding="{Binding Settings.UniversalTriggers.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Text" Value="{loc:Translate 'Import a Fooma config or add a universal trigger.'}" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsViewingAvatarScaling}" Value="True" />
                                                <Condition Binding="{Binding Settings.AvatarScaleSets.Count}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Setter Property="Text" Value="{loc:Translate 'Add a scale set to get started.'}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1" Grid.Column="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivitySectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAboutSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Style="{StaticResource PanelBorderStyle}"
                        Background="{DynamicResource PanelSecondaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Width="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=ActualWidth}"
                        MaxWidth="920">
                    <ScrollViewer x:Name="RuleWorkspaceScrollViewer"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Redeem Workspace'}"
                                       Style="{StaticResource HeadingTextStyle}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <ContentControl Margin="0,18,0,0"
                                            Content="{Binding SelectedAvatarProfile}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingSupporterOverrides}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsViewingMovementRedeems}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsViewingAvatarScaling}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedAvatarProfile}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                                <ContentControl.ContentTemplate>
                                    <DataTemplate DataType="{x:Type models:AvatarTriggerProfile}">
                                        <Border Background="{DynamicResource PanelHighlightBrush}"
                                                BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="18"
                                                Padding="18">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <Border DockPanel.Dock="Right"
                                                            Padding="10,4"
                                                            CornerRadius="10"
                                                            Background="{DynamicResource StatusChipBrush}">
                                                        <TextBlock Text="{Binding MasterStatusText}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMasterProfile}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding DataContext.SelectedAvatarSetupTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Style="{StaticResource HeadingTextStyle}"
                                                               FontSize="22"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                </DockPanel>
                                                <TextBlock Margin="0,10,0,0"
                                                           Text="{Binding DataContext.SelectedAvatarProfileStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" />
                                                <UniformGrid Columns="2" Margin="0,18,0,0">
                                                    <StackPanel Margin="0,0,14,0">
                                                        <TextBlock Text="{Binding DataContext.SelectedAvatarNameFieldLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="14,0,0,0">
                                                        <TextBlock Text="{Binding DataContext.SelectedAvatarPickerLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <ComboBox ItemsSource="{Binding DataContext.ProfileAvatarOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  Margin="0,8,0,0"
                                                                  IsEditable="True"
                                                                  IsTextSearchEnabled="True"
                                                                  StaysOpenOnEdit="True"
                                                                  TextSearch.TextPath="SearchText"
                                                                  ItemTemplate="{StaticResource VrChatAvatarOptionTemplate}"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding AvatarId, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <WrapPanel Margin="0,16,0,0">
                                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                                            MinWidth="180"
                                                            Content="{Binding DataContext.UseCurrentAvatarButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ToolTip="{loc:Translate 'Use the avatar you are wearing in VRChat for this set.'}"
                                                            Command="{Binding DataContext.UseCurrentVrChatAvatarForProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                                            MinWidth="170"
                                                            Content="{loc:Translate 'Refresh Avatar List'}"
                                                            ToolTip="{loc:Translate 'Refresh your saved VRChat avatar list.'}"
                                                            Command="{Binding DataContext.RefreshVrChatAvatarsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                                            MinWidth="180"
                                                            Content="{loc:Translate 'Refresh OSC Parameters'}"
                                                            ToolTip="{loc:Translate 'Refresh the saved OSC parameter list for the avatar you are currently using.'}"
                                                            Command="{Binding DataContext.RefreshVrChatOscParametersCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </WrapPanel>
                                                <TextBlock Margin="0,12,0,0"
                                                           Text="{Binding DataContext.VrChatAvatarStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,8,0,0"
                                                           Text="{Binding DataContext.VrChatOscParameterStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Margin="0,8,0,0"
                                                            Text="{Binding DataContext.CurrentVrChatAvatarStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Foreground="{DynamicResource TextBrush}"
                                                            FontWeight="SemiBold"
                                                            TextWrapping="Wrap" />
                                                <TextBlock Margin="0,8,0,0"
                                                           Text="{Binding DataContext.MasterAvatarReturnText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsViewingMasterAvatar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <Border Margin="0,18,0,0"
                                    Background="{DynamicResource PanelHighlightBrush}"
                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsViewingAvatarScaling}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{loc:Translate 'Avatar Scaling'}"
                                                   Style="{StaticResource HeadingTextStyle}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                Click="OnHelpButtonClicked"
                                                CommandParameter="Avatar Scaling"
                                                Tag="Avatar Scaling sends VRChat OSC Avatar Scaling values to /avatar/eyeheight. Use it for Twitch rewards, commands, bits, subs, gift subs, and follows that change avatar height without mixing those rules into Avatar Sets." />
                                    </DockPanel>
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{loc:Translate 'Create Twitch-triggered height changes using /avatar/eyeheight. VRChat may still block scaling in some worlds or Udon setups.'}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,12,0,0"
                                               Text="{Binding AvatarScaleRuntimeStatusText}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                    <Border Margin="0,14,0,0"
                                            Background="{DynamicResource NestedPanelBrush}"
                                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="14">
                                        <ContentControl Content="{Binding Settings.AvatarScaleMasterReward}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate DataType="{x:Type models:AvatarScaleMasterRewardSettings}">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{loc:Translate 'Master Reward Redeem'}"
                                                                       Style="{StaticResource HeadingTextStyle}"
                                                                       FontSize="20"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextBrush}" />
                                                            <Button Style="{StaticResource HelpIconButtonStyle}"
