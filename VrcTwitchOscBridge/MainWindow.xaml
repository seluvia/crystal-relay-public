                                                                       TextWrapping="Wrap" />
                                                            <UniformGrid Columns="2"
                                                                          Margin="0,10,0,0">
                                                                <StackPanel Margin="0,0,14,0">
                                                                    <TextBlock Text="{loc:Translate 'Minimum Bits'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MinimumBits, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="14,0,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Maximum Bits'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MaximumBits, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Margin="0,16,0,0"
                                                            Padding="14"
                                                            Background="{DynamicResource NestedPanelBrush}"
                                                            BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="16">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesSubscription}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{loc:Translate 'Sub/Gift Sub Filter'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{loc:Translate 'Pick a Twitch sub tier. Months narrow how long the viewer has been subscribed; use -1 for both month fields to match any month count.'}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <UniformGrid Columns="3"
                                                                          Margin="0,10,0,0">
                                                                <StackPanel Margin="0,0,10,0">
                                                                    <TextBlock Text="{loc:Translate 'Tier'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <ComboBox ItemsSource="{Binding DataContext.AvatarScaleSubscriptionTierOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              DisplayMemberPath="Label"
                                                                              SelectedValuePath="Value"
                                                                              SelectedValue="{Binding SubscriptionTier, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="10,0,10,0">
                                                                    <TextBlock Text="{loc:Translate 'Min Months'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MinimumMonths, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="10,0,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Max Months'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MaximumMonths, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <Border Margin="0,14,0,0"
                                                    Background="{DynamicResource NestedPanelBrush}"
                                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    Padding="14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsesSupporterGrowth}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Translate 'Supporter Growth'}"
                                                               Style="{StaticResource HeadingTextStyle}"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Text="{loc:Translate 'Supporter Growth listens to bits, new subs, resubs, and gift subs. Paid events add height and add fair active time, then return to normal when the paid timer ends.'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" />
                                                    <CheckBox Margin="0,12,0,0"
                                                              Content="{loc:Translate 'Allow reward scale changes during paid growth'}"
                                                              IsChecked="{Binding SupporterGrowthAllowRewardScaleOverlay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="26,6,0,0"
                                                               Text="{loc:Translate 'When enabled, channel-point and chat scale redeems can temporarily adjust height during paid growth without changing the paid timer.'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" />
                                                    <UniformGrid Columns="2"
                                                                 Margin="0,14,0,0">
                                                        <StackPanel Margin="0,0,14,0">
                                                            <TextBlock Text="{loc:Translate 'Normal Height'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthNormalHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="14,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Max Added Height'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthMaxAddedHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{loc:Translate 'Use 0 for unlimited added height until VRChat or safe range clamps it.'}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <TextBlock Margin="0,16,0,0"
                                                               Text="{loc:Translate 'Paid Active Time'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Text="{loc:Translate 'Paid time is shared by bits, subs, resubs, and gift subs. Time adds to the remaining paid timer, then slows above the soft cap and never exceeds the max.'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" />
                                                    <UniformGrid Columns="3"
                                                                 Margin="0,10,0,0">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{loc:Translate 'Bits Timer Unit'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthBitsTimerUnit, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="10,0,10,0">
                                                            <TextBlock Text="{loc:Translate 'Seconds Per Bits Unit'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthSecondsPerBitsUnit, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="10,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Smooth Transition Seconds'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SmoothTransitionSeconds, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <UniformGrid Columns="3"
                                                                 Margin="0,10,0,0">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{loc:Translate 'Soft Cap Seconds'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthSoftCapSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="10,0,10,0">
                                                            <TextBlock Text="{loc:Translate 'Soft Cap Multiplier Percent'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthSoftCapMultiplierPercent, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="10,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Max Paid Time Seconds'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthMaxPaidTimeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <TextBlock Margin="0,16,0,0"
                                                               Text="{loc:Translate 'Supporter Growth Cheer Keywords'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Text="{loc:Translate 'Use cheer text like Cheer100 grow or Cheer100 shrink. No keyword keeps the existing positive growth behavior; if both words appear, Crystal Relay skips the scale instead of guessing.'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" />
                                                    <UniformGrid Columns="2"
                                                                 Margin="0,10,0,0">
                                                        <StackPanel Margin="0,0,14,0">
                                                            <TextBlock Text="{loc:Translate 'Grow Keyword'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthGrowKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="14,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Shrink Keyword'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthShrinkKeyword, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <TextBlock Margin="0,16,0,0"
                                                               Text="{loc:Translate 'Subscription Growth'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <UniformGrid Columns="3"
                                                                 Margin="0,10,0,0">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{loc:Translate 'Tier 1 Height Add'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthTier1HeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="10,0,10,0">
                                                            <TextBlock Text="{loc:Translate 'Tier 2 Height Add'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthTier2HeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="10,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Tier 3 Height Add'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthTier3HeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <TextBlock Margin="0,16,0,0"
                                                               Text="{loc:Translate 'Subscription Paid Time'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <UniformGrid Columns="3"
                                                                 Margin="0,10,0,0">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{loc:Translate 'Tier 1 Seconds'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthTier1Seconds, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="10,0,10,0">
                                                            <TextBlock Text="{loc:Translate 'Tier 2 Seconds'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthTier2Seconds, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="10,0,0,0">
                                                            <TextBlock Text="{loc:Translate 'Tier 3 Seconds'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <TextBox Text="{Binding SupporterGrowthTier3Seconds, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </UniformGrid>

                                                    <DockPanel Margin="0,16,0,0"
                                                               LastChildFill="False">
                                                        <TextBlock Text="{loc:Translate 'Bits Growth Ranges'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <Button Margin="14,0,0,0"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Padding="16,6"
                                                                Content="{loc:Translate 'Add Bits Range'}"
                                                                Click="OnAddSupporterGrowthBitRangeClicked" />
                                                    </DockPanel>
                                                    <ItemsControl Margin="0,10,0,0"
                                                                  ItemsSource="{Binding SupporterGrowthBitRanges}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type models:AvatarScaleBitGrowthRange}">
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0"
                                                                                Margin="0,0,8,0">
                                                                        <TextBlock Text="{loc:Translate 'Minimum Bits'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding MinimumBits, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1"
                                                                                Margin="8,0,8,0">
                                                                        <TextBlock Text="{loc:Translate 'Maximum Bits'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding MaximumBits, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2"
                                                                                Margin="8,0,8,0">
                                                                        <TextBlock Text="{loc:Translate 'Height Added'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding HeightAddedMeters, UpdateSourceTrigger=LostFocus}" />
                                                                    </StackPanel>
                                                                    <Button Grid.Column="3"
                                                                            Margin="8,18,0,0"
                                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                                            Padding="14,6"
                                                                            VerticalAlignment="Top"
                                                                            Content="{loc:Translate 'Remove'}"
                                                                            Click="OnRemoveSupporterGrowthBitRangeClicked" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Text="{loc:Translate 'Maximum Bits set to 0 means no upper limit for that row.'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <Border Margin="0,14,0,0"
                                                    Background="{DynamicResource NestedPanelBrush}"
                                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    Padding="14">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding UsesStandardScaleAction}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                 </Border.Style>
                                                 <StackPanel>
                                                     <TextBlock Text="{loc:Translate 'Scale Action'}"
                                                                        Style="{StaticResource HeadingTextStyle}"
                                                                        FontSize="20" FontWeight="Bold"
                                                                        Foreground="{DynamicResource TextBrush}" />

                                                     <!-- Mode sub-card: six buttons in a row, current mode highlighted -->
                                                     <Border Margin="0,12,0,0"
                                                                     Background="{DynamicResource NestedPanelBrush}"
                                                                     BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                                     BorderThickness="1" CornerRadius="8" Padding="6">
                                                                 <Grid>
                                                                     <Grid.ColumnDefinitions>
                                                                         <ColumnDefinition Width="*" />
                                                                         <ColumnDefinition Width="*" />
                                                                         <ColumnDefinition Width="*" />
                                                                         <ColumnDefinition Width="*" />
                                                                         <ColumnDefinition Width="*" />
                                                                         <ColumnDefinition Width="*" />
                                                                     </Grid.ColumnDefinitions>
                                                                     <Button Grid.Column="0" Margin="2" Tag="SetHeight" Click="ScaleActionModeButton_Click"
                                                                             Content="{loc:Translate 'Set Height'}">
                                                                             <Button.Style>
                                                                                 <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding ActiveMode}" Value="SetHeight">
                                                                                             <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                             <Setter Property="Foreground" Value="White" />
                                                                                             <Setter Property="FontWeight" Value="SemiBold" />
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </Button.Style>
                                                                         </Button>
                                                                     <Button Grid.Column="1" Margin="2" Tag="RandomHeight" Click="ScaleActionModeButton_Click"
                                                                             Content="{loc:Translate 'Random'}">
                                                                             <Button.Style>
                                                                                 <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding ActiveMode}" Value="RandomHeight">
                                                                                             <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                             <Setter Property="Foreground" Value="White" />
                                                                                             <Setter Property="FontWeight" Value="SemiBold" />
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </Button.Style>
                                                                         </Button>
                                                                     <Button Grid.Column="2" Margin="2" Tag="RelativeHeight" Click="ScaleActionModeButton_Click"
                                                                             Content="{loc:Translate 'Relative'}">
                                                                             <Button.Style>
                                                                                 <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding ActiveMode}" Value="RelativeHeight">
                                                                                             <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                             <Setter Property="Foreground" Value="White" />
                                                                                             <Setter Property="FontWeight" Value="SemiBold" />
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </Button.Style>
                                                                         </Button>
                                                                     <Button Grid.Column="3" Margin="2" Tag="Multiplier" Click="ScaleActionModeButton_Click"
                                                                             Content="{loc:Translate 'Multiplier'}">
                                                                             <Button.Style>
                                                                                 <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding ActiveMode}" Value="Multiplier">
                                                                                             <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                             <Setter Property="Foreground" Value="White" />
                                                                                             <Setter Property="FontWeight" Value="SemiBold" />
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </Button.Style>
                                                                         </Button>
                                                                     <Button Grid.Column="4" Margin="2" Tag="Preset" Click="ScaleActionModeButton_Click"
                                                                             Content="{loc:Translate 'Preset'}">
                                                                             <Button.Style>
                                                                                 <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding ActiveMode}" Value="Preset">
                                                                                             <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                             <Setter Property="Foreground" Value="White" />
                                                                                             <Setter Property="FontWeight" Value="SemiBold" />
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </Button.Style>
                                                                         </Button>
                                                                     <Button Grid.Column="5" Margin="2" Tag="GlitchyRandomHeight" Click="ScaleActionModeButton_Click"
                                                                             Content="{loc:Translate 'Glitchy'}">
                                                                             <Button.Style>
                                                                                 <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding ActiveMode}" Value="GlitchyRandomHeight">
                                                                                             <Setter Property="Background" Value="{DynamicResource HighlightBorderBrush}" />
                                                                                             <Setter Property="Foreground" Value="White" />
                                                                                             <Setter Property="FontWeight" Value="SemiBold" />
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </Button.Style>
                                                                         </Button>
                                                                 </Grid>
                                                     </Border>

                                                     <!-- Value sub-card: per-mode fields + live preview -->
                                                     <Border Margin="0,12,0,0"
                                                                     Background="{DynamicResource NestedPanelBrush}"
                                                                     BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                                     BorderThickness="1" CornerRadius="8" Padding="14">
                                                                 <StackPanel>
                                                                     <!-- SetHeight variant -->
                                                                     <StackPanel>
                                                                         <StackPanel.Style>
                                                                             <Style TargetType="StackPanel">
                                                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding UsesTargetHeight}" Value="True">
                                                                                         <Setter Property="Visibility" Value="Visible" />
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </StackPanel.Style>
                                                                         <TextBlock Text="{loc:Translate 'Target Height Meters'}"
                                                                                    Foreground="{DynamicResource TextBrush}"
                                                                                    FontWeight="SemiBold" />
                                                                         <TextBox Text="{Binding TargetHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                                     </StackPanel>

                                                                     <!-- Random / Glitchy shared range variant -->
                                                                     <StackPanel>
                                                                         <StackPanel.Style>
                                                                             <Style TargetType="StackPanel">
                                                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding UsesRandomHeightRange}" Value="True">
                                                                                         <Setter Property="Visibility" Value="Visible" />
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </StackPanel.Style>
                                                                         <UniformGrid Columns="2">
                                                                             <StackPanel Margin="0,0,7,0">
                                                                                 <TextBlock Text="{loc:Translate 'Random Min Height'}"
                                                                                            Foreground="{DynamicResource TextBrush}"
                                                                                            FontWeight="SemiBold" />
                                                                                 <TextBox Text="{Binding MinimumHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                                             </StackPanel>
                                                                             <StackPanel Margin="7,0,0,0">
                                                                                 <TextBlock Text="{loc:Translate 'Random Max Height'}"
                                                                                            Foreground="{DynamicResource TextBrush}"
                                                                                            FontWeight="SemiBold" />
                                                                                 <TextBox Text="{Binding MaximumHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                                             </StackPanel>
                                                                         </UniformGrid>
                                                                         <!-- Glitchy-only: Transition field -->
                                                                         <StackPanel Margin="0,12,0,0">
                                                                             <StackPanel.Style>
                                                                                 <Style TargetType="StackPanel">
                                                                                     <Setter Property="Visibility" Value="Collapsed" />
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding UsesGlitchyRandomHeight}" Value="True">
                                                                                             <Setter Property="Visibility" Value="Visible" />
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </StackPanel.Style>
                                                                             <TextBlock Text="{loc:Translate 'Glitchy Transition Seconds'}"
                                                                                        Foreground="{DynamicResource TextBrush}"
                                                                                        FontWeight="SemiBold" />
                                                                             <TextBox Text="{Binding GlitchyTransitionSeconds, UpdateSourceTrigger=LostFocus}" />
                                                                         </StackPanel>
                                                                     </StackPanel>

                                                                     <!-- Relative variant -->
                                                                     <StackPanel>
                                                                         <StackPanel.Style>
                                                                             <Style TargetType="StackPanel">
                                                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding UsesRelativeHeight}" Value="True">
                                                                                         <Setter Property="Visibility" Value="Visible" />
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </StackPanel.Style>
                                                                         <Grid>
                                                                             <Grid.ColumnDefinitions>
                                                                                 <ColumnDefinition Width="*" />
                                                                                 <ColumnDefinition Width="*" />
                                                                             </Grid.ColumnDefinitions>
                                                                             <StackPanel Grid.Column="0" Margin="0,0,7,0">
                                                                                 <TextBlock Text="{loc:Translate 'Change (meters)'}"
                                                                                            Foreground="{DynamicResource TextBrush}"
                                                                                            FontWeight="SemiBold" />
                                                                                 <TextBox Text="{Binding RelativeHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                                             </StackPanel>
                                                                             <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                                                                 <TextBlock Text="{loc:Translate 'Current (meters)'}"
                                                                                            Foreground="{DynamicResource TextBrush}"
                                                                                            FontWeight="SemiBold" />
                                                                                 <TextBox Text="{Binding MultCurrentPreview, UpdateSourceTrigger=LostFocus}" />
                                                                             </StackPanel>
                                                                         </Grid>
                                                                         <TextBlock Text="{loc:Translate 'Smooth Transition Seconds'}"
                                                                                    Margin="0,12,0,0"
                                                                                    Foreground="{DynamicResource TextBrush}"
                                                                                    FontWeight="SemiBold" />
                                                                         <TextBox Text="{Binding SmoothTransitionSeconds, UpdateSourceTrigger=LostFocus}" />
                                                                     </StackPanel>

                                                                     <!-- Multiplier variant -->
                                                                     <StackPanel>
                                                                         <StackPanel.Style>
                                                                             <Style TargetType="StackPanel">
                                                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding UsesMultiplier}" Value="True">
                                                                                         <Setter Property="Visibility" Value="Visible" />
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </StackPanel.Style>
                                                                         <Grid>
                                                                             <Grid.ColumnDefinitions>
                                                                                 <ColumnDefinition Width="Auto" />
                                                                                 <ColumnDefinition Width="*" />
                                                                                 <ColumnDefinition Width="*" />
                                                                             </Grid.ColumnDefinitions>
                                                                             <Button Grid.Column="0" Margin="0,0,6,0"
                                                                                     Tag="multOp" Click="ScaleActionMultOpButton_Click"
                                                                                     Content="{Binding MultiplierOperatorDisplay}"
                                                                                     Width="48" Height="32"
                                                                                     FontSize="20" FontWeight="Bold"
                                                                                     Foreground="White"
                                                                                     Background="{DynamicResource HighlightBorderBrush}" />
                                                                             <StackPanel Grid.Column="1" Margin="0,0,7,0">
                                                                                 <TextBlock Text="{loc:Translate 'Value'}"
                                                                                            Foreground="{DynamicResource TextBrush}"
                                                                                            FontWeight="SemiBold" />
                                                                                 <TextBox Text="{Binding HeightMultiplier, UpdateSourceTrigger=LostFocus}" />
                                                                             </StackPanel>
                                                                             <StackPanel Grid.Column="2" Margin="7,0,0,0">
                                                                                 <TextBlock Text="{loc:Translate 'Current (meters)'}"
                                                                                            Foreground="{DynamicResource TextBrush}"
                                                                                            FontWeight="SemiBold" />
                                                                                 <TextBox Text="{Binding MultCurrentPreview, UpdateSourceTrigger=LostFocus}" />
                                                                             </StackPanel>
                                                                         </Grid>
                                                                     </StackPanel>

                                                                     <!-- Preset variant -->
                                                                     <StackPanel>
                                                                         <StackPanel.Style>
                                                                             <Style TargetType="StackPanel">
                                                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding UsesPreset}" Value="True">
                                                                                         <Setter Property="Visibility" Value="Visible" />
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </StackPanel.Style>
                                                                         <TextBlock Text="{loc:Translate 'Preset'}"
                                                                                    Foreground="{DynamicResource TextBrush}"
                                                                                    FontWeight="SemiBold" />
                                                                         <ComboBox ItemsSource="{Binding DataContext.AvatarScalePresets, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                   SelectedItem="{Binding Preset, UpdateSourceTrigger=PropertyChanged}" />
                                                                     </StackPanel>

                                                                     <!-- Live preview block -->
                                                                     <Border Margin="0,10,0,0"
                                                                             Background="#1a0f30"
                                                                             BorderBrush="#4a2c7a"
                                                                             BorderThickness="1" CornerRadius="8" Padding="8,6">
                                                                             <TextBlock Foreground="{DynamicResource TextBrush}" FontSize="12" TextWrapping="Wrap">
                                                                                 <TextBlock.Text>
                                                                                     <MultiBinding Converter="{StaticResource ScalePreviewConverter}">
                                                                                         <Binding Path="ActiveMode" />
                                                                                         <Binding Path="TargetHeightMeters" />
                                                                                         <Binding Path="MinimumHeightMeters" />
                                                                                         <Binding Path="MaximumHeightMeters" />
                                                                                         <Binding Path="GlitchyTransitionSeconds" />
                                                                                         <Binding Path="RelativeHeightMeters" />
                                                                                         <Binding Path="MultCurrentPreview" />
                                                                                         <Binding Path="HeightMultiplier" />
                                                                                         <Binding Path="IsDivideDirection" />
                                                                                         <Binding Path="Preset" />
                                                                                         <Binding Path="PresetHeight" />
                                                                                     </MultiBinding>
                                                                                 </TextBlock.Text>
                                                                             </TextBlock>
                                                                     </Border>
                                                                 </StackPanel>
                                                     </Border>

                                                     <!-- Range limits sub-card: visible for Relative and Multiplier modes -->
                                                     <Border Margin="0,12,0,0"
                                                                     Background="{DynamicResource NestedPanelBrush}"
                                                                     BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                                     BorderThickness="1" CornerRadius="8" Padding="14">
                                                                 <Border.Style>
                                                                     <Style TargetType="Border">
                                                                         <Setter Property="Visibility" Value="Collapsed" />
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding UsesRelativeHeight}" Value="True">
                                                                                 <Setter Property="Visibility" Value="Visible" />
                                                                             </DataTrigger>
                                                                             <DataTrigger Binding="{Binding UsesMultiplier}" Value="True">
                                                                                 <Setter Property="Visibility" Value="Visible" />
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Border.Style>
                                                                 <StackPanel>
                                                                     <UniformGrid Columns="2">
                                                                         <StackPanel Margin="0,0,7,0">
                                                                             <TextBlock Text="{loc:Translate 'Min Height (meters)'}"
                                                                                        Foreground="{DynamicResource TextBrush}"
                                                                                        FontWeight="SemiBold" />
                                                                             <TextBox Text="{Binding MinimumHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                                         </StackPanel>
                                                                         <StackPanel Margin="7,0,0,0">
                                                                             <TextBlock Text="{loc:Translate 'Max Height (meters)'}"
                                                                                        Foreground="{DynamicResource TextBrush}"
                                                                                        FontWeight="SemiBold" />
                                                                             <TextBox Text="{Binding MaximumHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                                         </StackPanel>
                                                                     </UniformGrid>
                                                                     <TextBlock Margin="0,6,0,0"
                                                                                Text="{loc:Translate 'Min and Max are clamped between 0.20m and 100m. To go past the safe limit, enable Advanced VRChat scale range below.'}"
                                                                                Foreground="{DynamicResource MutedBrush}"
                                                                                TextWrapping="Wrap" />
                                                                     <TextBlock Margin="0,14,0,0"
                                                                                Text="{loc:Translate 'Hide this reward when reaching a limit'}"
                                                                                Style="{StaticResource HeadingTextStyle}"
                                                                                FontSize="14" FontWeight="SemiBold"
                                                                                Foreground="{DynamicResource TextBrush}" />
                                                                     <StackPanel Margin="0,6,0,0">
                                                                         <StackPanel.Style>
                                                                             <Style TargetType="StackPanel">
                                                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                                                 <Style.Triggers>
                                                                                     <MultiDataTrigger>
                                                                                         <MultiDataTrigger.Conditions>
                                                                                             <Condition Binding="{Binding UsesChannelPointReward}" Value="True" />
                                                                                             <Condition Binding="{Binding UsesCreateOrManageReward}" Value="True" />
                                                                                         </MultiDataTrigger.Conditions>
                                                                                         <Setter Property="Visibility" Value="Visible" />
                                                                                     </MultiDataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </StackPanel.Style>
                                                                         <CheckBox IsChecked="{Binding HideRewardWhenMinimumHeightReached, UpdateSourceTrigger=PropertyChanged}"
                                                                                   Content="{loc:Translate 'Hide reward at minimum height'}" />
                                                                         <CheckBox Margin="0,6,0,0"
                                                                                   IsChecked="{Binding HideRewardWhenMaximumHeightReached, UpdateSourceTrigger=PropertyChanged}"
                                                                                   Content="{loc:Translate 'Hide reward at maximum height'}" />
                                                                     </StackPanel>
                                                                 </StackPanel>
                                                     </Border>

                                                     <!-- Behavior sub-card: cooldown, active time, return height -->
                                                     <Border Margin="0,12,0,0"
                                                                     Background="{DynamicResource NestedPanelBrush}"
                                                                     BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                                     BorderThickness="1" CornerRadius="8" Padding="14">
                                                                 <StackPanel>
                                                                     <StackPanel>
                                                                         <StackPanel.Style>
                                                                             <Style TargetType="StackPanel">
                                                                                 <Setter Property="Visibility" Value="Collapsed" />
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding UsesCreateOrManageReward}" Value="True">
                                                                                         <Setter Property="Visibility" Value="Visible" />
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </StackPanel.Style>
                                                                         <TextBlock Text="{loc:Translate 'Reward Cooldown (seconds)'}"
                                                                                    Foreground="{DynamicResource TextBrush}"
                                                                                    FontWeight="SemiBold" />
                                                                         <TextBox Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                                         <TextBlock Margin="0,6,0,0"
                                                                                    Text="{loc:Translate 'Only Crystal Relay-created channel-point scale rewards use this cooldown. Linked rewards keep the cooldown set on Twitch.'}"
                                                                                    Foreground="{DynamicResource MutedBrush}"
                                                                                    TextWrapping="Wrap" />
                                                                     </StackPanel>
                                                                     <UniformGrid Columns="2" Margin="0,12,0,0">
                                                                         <StackPanel Margin="0,0,7,0">
                                                                             <TextBlock Text="{loc:Translate 'Active Time Seconds'}"
                                                                                        Foreground="{DynamicResource TextBrush}"
                                                                                        FontWeight="SemiBold" />
                                                                             <TextBox Text="{Binding ActiveTimeSeconds, UpdateSourceTrigger=LostFocus}" />
                                                                         </StackPanel>
                                                                         <StackPanel Margin="7,0,0,0">
                                                                             <StackPanel.Style>
                                                                                 <Style TargetType="StackPanel">
                                                                                     <Setter Property="Visibility" Value="Collapsed" />
                                                                                     <Style.Triggers>
                                                                                         <DataTrigger Binding="{Binding HasActiveTime}" Value="True">
                                                                                             <Setter Property="Visibility" Value="Visible" />
                                                                                         </DataTrigger>
                                                                                     </Style.Triggers>
                                                                                 </Style>
                                                                             </StackPanel.Style>
                                                                             <TextBlock Text="{loc:Translate 'Return Height'}"
                                                                                        Foreground="{DynamicResource TextBrush}"
                                                                                        FontWeight="SemiBold" />
                                                                             <TextBox Text="{Binding RestoreHeightMeters, UpdateSourceTrigger=LostFocus}" />
                                                                         </StackPanel>
                                                                     </UniformGrid>
                                                                 </StackPanel>
                                                     </Border>

                                                     <!-- Advanced sub-card: single advanced-range checkbox -->
                                                     <Border Margin="0,12,0,0"
                                                                     Background="{DynamicResource NestedPanelBrush}"
                                                                     BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                                     BorderThickness="1" CornerRadius="8" Padding="14">
                                                                 <StackPanel>
                                                                     <CheckBox IsChecked="{Binding AdvancedRangeEnabled, UpdateSourceTrigger=PropertyChanged}"
                                                                               Content="{loc:Translate 'Unlock advanced VRChat scale range (0.01m - 10000m)'}" />
                                                                  </StackPanel>
                                                  </Border>
                                                  </StackPanel>
                                             </Border>
                                             </StackPanel>
                                         </Border>
                                     </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>

                            <Border Margin="0,18,0,0"
                                    Background="{DynamicResource PanelHighlightBrush}"
                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                 <Border.Style>
                                     <Style TargetType="Border">
                                         <Setter Property="Visibility" Value="Collapsed" />
                                         <Style.Triggers>
                                             <DataTrigger Binding="{Binding IsViewingAvatarTriggers}" Value="True">
                                                 <Setter Property="Visibility" Value="Visible" />
                                             </DataTrigger>
                                             <DataTrigger Binding="{Binding IsViewingWardrobe}" Value="True">
                                                 <Setter Property="Visibility" Value="Visible" />
                                             </DataTrigger>
                                             <DataTrigger Binding="{Binding SelectedAvatarProfile}" Value="{x:Null}">
                                                 <Setter Property="Visibility" Value="Collapsed" />
                                             </DataTrigger>
                                         </Style.Triggers>
                                     </Style>
                                 </Border.Style>
                                 <StackPanel>
                                     <StackPanel>
                                         <StackPanel.Style>
                                             <Style TargetType="StackPanel">
                                                 <Setter Property="Visibility" Value="Visible" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding IsViewingWardrobe}" Value="True">
                                                         <Setter Property="Visibility" Value="Collapsed" />
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </StackPanel.Style>
                                         <DockPanel LastChildFill="False">
                                             <TextBlock Text="{loc:Translate 'Redeems In This Avatar Set'}"
                                                       Style="{StaticResource HeadingTextStyle}"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                             <Button Style="{StaticResource HelpIconButtonStyle}"
                                                     Click="OnHelpButtonClicked"
                                                     CommandParameter="Redeems In This Avatar Set"
                                                     Tag="This list holds the redeems that belong to the avatar set you selected. These rules turn on when Crystal Relay detects that exact avatar, and they turn off again when you switch away. Add Redeem creates another rule for this avatar, Delete Redeem removes the selected one, Test Redeem lets you try it locally, and Disable Pairing can hide sibling redeems while one is active or reveal special sibling redeems only after another one triggers." />
                                         </DockPanel>
                                         <TextBlock Margin="0,10,0,0"
                                                    Text="{loc:Translate 'This is the redeem list for this avatar set. Pick a redeem to edit it below, test it, or choose how paired sibling redeems should hide or reveal.'}"
                                                    Foreground="{DynamicResource MutedBrush}"
                                                    TextWrapping="Wrap" />
                                         <WrapPanel Margin="0,14,0,0">
                                             <Button Style="{StaticResource PrimaryButtonStyle}"
                                                     Content="{loc:Translate 'Add Redeem'}"
                                                     Command="{Binding AddRuleCommand}" />
                                             <Button Style="{StaticResource SecondaryButtonStyle}"
                                                     Content="{loc:Translate 'Delete Redeem'}"
                                                     Command="{Binding RemoveSelectedRuleCommand}" />
                                             <Button Style="{StaticResource SecondaryButtonStyle}"
                                                     Content="{loc:Translate 'Test Redeem'}"
                                                     Command="{Binding TestSelectedRuleCommand}" />
                                             <Button Style="{StaticResource SecondaryButtonStyle}"
                                                     Content="{loc:Translate 'Disable Pairing'}"
                                                     Command="{Binding OpenSpecialRuleLockoutPickerCommand}" />
                                         </WrapPanel>
                                         <TextBlock Margin="0,10,0,0"
                                                    Text="{Binding SpecialRuleLockoutSummaryText}"
                                                    Foreground="{DynamicResource MutedBrush}"
                                                    TextWrapping="Wrap">
                                             <TextBlock.Style>
                                                 <Style TargetType="TextBlock">
                                                     <Setter Property="Visibility" Value="Visible" />
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding SelectedRule}" Value="{x:Null}">
                                                             <Setter Property="Visibility" Value="Collapsed" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </TextBlock.Style>
                                         </TextBlock>
                                     </StackPanel>

                                <StackPanel Margin="0,14,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsViewingWardrobe}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <DockPanel>
                                        <TextBlock Text="{loc:Translate 'Wardrobe'}"
                                                   Style="{StaticResource HeadingTextStyle}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                Click="OnHelpButtonClicked"
                                                CommandParameter="Wardrobe"
                                                Tag="Wardrobe lets you create named outfits that capture snapshots of avatar parameters. When redeemed, the outfit applies its parameters and restores the original values after the active time ends." />
                                    </DockPanel>
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{loc:Translate 'Create named outfits for this avatar. Each outfit captures a snapshot of avatar parameters, applies them when redeemed, and restores the original values after the active time ends.'}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                                Text="{loc:Translate 'Wardrobe needs 70 seconds to safely read VRChat avatar data before it restores an outfit. Shorter active times will be extended during runtime.'}"
                                                Foreground="{DynamicResource WarningTextBrush}"
                                                TextWrapping="Wrap" />
                                    <StackPanel Margin="0,14,0,0">
                                        <WrapPanel>
                                            <Button MinWidth="120"
                                                    Margin="0,0,10,10"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="{loc:Translate 'Add Outfit'}"
                                                    Command="{Binding AddWardrobeOutfitCommand}" />
                                            <Button MinWidth="120"
                                                    Margin="0,0,10,10"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{loc:Translate 'Delete Outfit'}"
                                                    Command="{Binding RemoveWardrobeOutfitCommand}" />
                                            <Button MinWidth="120"
                                                    Margin="0,0,10,10"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{loc:Translate 'Copy Outfit'}"
                                                    Command="{Binding CopyWardrobeOutfitCommand}" />
                                            <Button MinWidth="120"
                                                    Margin="0,0,10,10"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{loc:Translate 'Paste Outfit'}"
                                                    Command="{Binding PasteWardrobeOutfitCommand}" />
                                            <Button MinWidth="120"
                                                    Margin="0,0,10,10"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{loc:Translate 'Refresh Parameters'}"
                                                    Command="{Binding RefreshWardrobeParametersCommand}" />
                                            <Button MinWidth="120"
                                                    Margin="0,0,10,10"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="{loc:Translate 'Test Outfit'}"
                                                    Command="{Binding TestWardrobeOutfitCommand}" />
                                        </WrapPanel>
                                        <ListBox Margin="0,12,0,0"
                                                 MaxHeight="200"
                                                 ItemsSource="{Binding SelectedAvatarProfile.WardrobeOutfits}"
                                                 SelectedItem="{Binding SelectedWardrobeOutfit, Mode=TwoWay}"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingStackPanel.IsVirtualizing="True"
                                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:WardrobeOutfit}">
                                                    <TextBlock Text="{Binding DisplaySummary}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="{loc:Translate 'No outfits yet. Add Outfit to create your first Wardrobe outfit.'}"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedAvatarProfile.WardrobeOutfits.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Margin="0,14,0,0"
                                                Background="{DynamicResource NestedPanelBrush}"
                                                BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="14"
                                                Visibility="{Binding SelectedWardrobeOutfit, Converter={StaticResource NullToVisibilityConverter}}">
                                            <StackPanel DataContext="{Binding SelectedWardrobeOutfit}">
                                                <TextBlock Text="{loc:Translate 'Outfit Name'}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBox Margin="0,6,0,0"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                                    <TextBlock Text="{loc:Translate 'Active Time:'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Width="60"
                                                             Margin="8,0,0,0"
                                                             Text="{Binding ActiveTimeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="4,0,0,0"
                                                               Text="{loc:Translate 'seconds'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Margin="0,6,0,0"
                                                           Text="{loc:Translate 'Active times below 70 seconds can restore before VRChat finishes writing outfit changes, so Crystal Relay will extend this outfit to 70 seconds when it runs.'}"
                                                            Foreground="{DynamicResource WarningTextBrush}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{Binding UsesShortActiveTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <StackPanel Margin="0,12,0,0">
                                                    <TextBlock Text="{loc:Translate 'Twitch Reward'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <ComboBox ItemsSource="{Binding DataContext.RewardSyncModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Value"
                                                              SelectedValue="{Binding TwitchRewardSyncMode, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'Reward Title'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBox Margin="0,6,0,0"
                                                                 Text="{Binding TwitchRewardTitle, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="12,0,0,0">
                                                        <TextBlock Text="{loc:Translate 'Cost'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBox Margin="0,6,0,0"
                                                                 Text="{Binding TwitchRewardCost, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </UniformGrid>
                                                <StackPanel Margin="0,12,0,0">
                                                    <TextBlock Text="{loc:Translate 'Reward Description'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding TwitchRewardDescription, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Margin="0,12,0,0">
                                                    <TextBlock Text="{loc:Translate 'Chat Command'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <TextBox Text="{Binding ChatCommandText, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,16,0,0">
                                                    <WrapPanel>
                                                        <TextBlock Text="{loc:Translate 'Parameters'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                        <Button Margin="12,0,0,0"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Content="{loc:Translate 'Add Parameter'}"
                                                                Command="{Binding DataContext.AddWardrobeSnapshotParamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Padding="10,6"
                                                                FontSize="11" />
                                                        <Button Margin="6,0,0,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{loc:Translate 'Remove'}"
                                                                Command="{Binding DataContext.RemoveWardrobeSnapshotParamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Padding="10,6"
                                                                FontSize="11" />
                                                        <Button Margin="6,0,0,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{loc:Translate 'Copy Parameter'}"
                                                                Command="{Binding DataContext.CopyWardrobeSnapshotParamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Padding="10,6"
                                                                FontSize="11" />
                                                        <Button Margin="6,0,0,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{loc:Translate 'Paste Parameter'}"
                                                                Command="{Binding DataContext.PasteWardrobeSnapshotParamCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Padding="10,6"
                                                                FontSize="11" />
                                                    </WrapPanel>
                                                                     <ListBox Margin="0,10,0,0"
                                                              MaxHeight="150"
                                                              ItemsSource="{Binding SnapshotParams}"
                                                              SelectedItem="{Binding DataContext.SelectedWardrobeSnapshotParam, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                              ScrollViewer.CanContentScroll="True">
                                                         <ListBox.ItemTemplate>
                                                             <DataTemplate DataType="{x:Type models:WardrobeSnapshotParam}">
                                                                 <TextBlock Text="{Binding DisplaySummary}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            Foreground="{DynamicResource TextBrush}" />
                                                             </DataTemplate>
                                                         </ListBox.ItemTemplate>
                                                     </ListBox>
                                                     <Border Margin="0,10,0,0"
                                                             Background="{DynamicResource NestedPanelBrush}"
                                                             BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                             BorderThickness="1"
                                                             CornerRadius="12"
                                                             Padding="12"
                                                             Visibility="{Binding DataContext.SelectedWardrobeSnapshotParam, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVisibilityConverter}}">
                                                         <StackPanel DataContext="{Binding DataContext.SelectedWardrobeSnapshotParam, RelativeSource={RelativeSource AncestorType=Window}}">
                                                             <TextBlock Text="{loc:Translate 'Parameter Path'}"
                                                                        Foreground="{DynamicResource TextBrush}"
                                                                        FontWeight="SemiBold" />
                                                             <ComboBox Margin="0,6,0,0"
                                                                       IsEditable="True"
                                                                       StaysOpenOnEdit="True"
                                                                       TextSearch.TextPath="DisplayLabel"
                                                                       DisplayMemberPath="DisplayLabel"
                                                                       ItemsSource="{Binding DataContext.AvailableWardrobeParameters, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       SelectedItem="{Binding DataContext.SelectedWardrobeParameterOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                       Text="{Binding DataContext.WardrobeParameterText, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                             <TextBlock Margin="0,4,0,0"
                                                                        FontSize="11"
                                                                        Foreground="{DynamicResource MutedBrush}"
                                                                        TextWrapping="Wrap"
                                                                        Text="{loc:Translate 'Pick from the list or type a custom path. Click Refresh Parameters first to load this avatar\'s parameters.'}" />
                                                             <UniformGrid Columns="2" Margin="0,12,0,0">
                                                                 <StackPanel Margin="0,0,8,0">
                                                                     <TextBlock Text="{loc:Translate 'Type'}"
