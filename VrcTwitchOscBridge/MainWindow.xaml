                        BorderThickness="1"
                        CornerRadius="8" />
                <Track x:Name="PART_Track"
                       Margin="2">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ScrollBarTrackButtonStyle}"
