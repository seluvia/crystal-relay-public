                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Text="{loc:Translate 'When enabled, Crystal Relay lets the developer know when your Twitch channel is live so they can visit your stream, observe real usage, and offer feedback or support. This does not send Twitch tokens, VRChat credentials, OSC data, chat messages, or private VRChat information.'}"
