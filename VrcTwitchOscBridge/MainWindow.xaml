                                                        Click="OnHelpButtonClicked"
                                                        CommandParameter="Bot + Broadcaster Chat Messages"
                                                        Tag="Choose which Twitch account Crystal Relay uses when it posts chat messages. The broadcaster can act as the bot after reconnecting once with chat-send permission, or you can keep using a separate bot account." />
                                            </Grid>
                                            <CheckBox Margin="0,10,0,0"
                                                      Content="{loc:Translate 'Let broadcaster send bot messages'}"
                                                      IsChecked="{Binding Settings.UseBroadcasterAsBotSender, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{Binding EffectiveBotSenderStatusText}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />

                                            <Border Margin="0,14,0,0"
                                                    Padding="14"
                                                    Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{loc:Translate 'Built-in bot commands'}"
                                                                       Style="{StaticResource HeadingTextStyle}"
                                                                       FontSize="16"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{Binding BuiltInCommandsSummaryText}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Text="{Binding BuiltInCommandsWarningText}"
                                                                        Foreground="{DynamicResource WarningTextBrush}"
                                                                        TextWrapping="Wrap"
                                                                        Visibility="{Binding HasBuiltInCommandsWarning, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Margin="14,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{loc:Translate 'Commands...'}"
                                                                Command="{Binding OpenBuiltInCommandsCommand}" />
                                                    </Grid>

                                                    <Border Margin="0,14,0,12"
                                                            Height="1"
                                                            Background="{DynamicResource InputBorderBrush}"
                                                            Opacity="0.75" />

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{loc:Translate 'Trigger info announcements'}"
                                                                   Style="{StaticResource HeadingTextStyle}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <Button Grid.Column="1"
                                                                Margin="8,0,0,0"
                                                                Style="{StaticResource HelpIconButtonStyle}"
                                                                Click="OnHelpButtonClicked"
                                                                CommandParameter="Trigger info announcements"
                                                                Tag="When enabled, Crystal Relay posts one compact Twitch chat message while you are live. The message lists current-avatar outfit choices, Bits outfit names, Bits grow/shrink scale words, and sub or gift-sub scale effects." />
                                                    </Grid>
                                                    <CheckBox Margin="0,10,0,0"
                                                              Content="{loc:Translate 'Post current trigger info while live'}"
                                                              IsChecked="{Binding Settings.TriggerInfoAnnouncementsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="82" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{loc:Translate 'Send every'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBox Grid.Column="1"
                                                                 Margin="8,0"
                                                                 Text="{Binding Settings.TriggerInfoAnnouncementIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock Grid.Column="2"
                                                                   VerticalAlignment="Center"
                                                                   Text="{loc:Translate 'minutes'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                    <TextBlock Margin="0,8,0,0"
                                                               Text="{loc:Translate 'Crystal Relay only posts these automatic trigger messages while Twitch says the stream is live. It skips the timed message if no current-avatar trigger info is available.'}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,14,0,0" Background="{DynamicResource NestedPanelBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16"
                                            Visibility="{Binding IsSettingsTwitchSectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{loc:Translate 'Bits/Subs override info messages'}" Style="{StaticResource HeadingTextStyle}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                        Click="OnHelpButtonClicked"
                                                        CommandParameter="Bits/Subs override info messages"
                                                        Tag="Paid override info messages use the optional bot account. They replace the normal per-rule Bot Message for Bits/Subs overrides while enabled, so chat only gets one bot post." />
                                            </DockPanel>
                                            <CheckBox Margin="0,10,0,0"
                                                      Content="{loc:Translate 'Enable automatic Bits/Subs info messages'}"
                                                      IsChecked="{Binding Settings.SupporterOverrideInfoMessageEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{loc:Translate 'When enabled, the connected bot posts one generated message when a Bits/Subs override runs. It shows the trigger amount, time added, and a compact list of configured paid override timers.'}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,14,0,0" Background="{DynamicResource NestedPanelBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16"
                                            Visibility="{Binding IsSettingsVrChatSectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock Text="{loc:Translate 'VRChat Avatar Access'}" Style="{StaticResource HeadingTextStyle}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                        Click="OnHelpButtonClicked"
                                                        CommandParameter="VRChat Avatar Access"
                                                        Tag="Sign in to the VRChat account whose avatars you want Crystal Relay to use. This login loads your selectable avatar list, keeps avatar names clean in the pickers, and lets Avatar Change and Avatar Roulette rules point at the correct avatar IDs. Your live current avatar and local OSC parameter data still come from your local VRChat files for the connected user." />
                                            </DockPanel>
                                            <TextBlock Margin="0,10,0,0"
                                                       Text="{Binding VrChatStatus}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding VrChatAvatarStatus}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="{loc:Translate 'Connect VRChat'}" Command="{Binding ConnectVrChatCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVrChatConnected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{loc:Translate 'Refresh Avatars'}" Command="{Binding RefreshVrChatAvatarsCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVrChatConnected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{loc:Translate 'Disconnect VRChat'}" Command="{Binding DisconnectVrChatCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsVrChatConnected}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,14,0,0" Background="{DynamicResource NestedPanelBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16"
                                            Visibility="{Binding IsSettingsSafetySectionSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate 'Saved Login Repair'}"
                                                       Style="{StaticResource HeadingTextStyle}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Text="{loc:Translate 'Use this if Crystal Relay keeps signing out, rejects saved sessions, or gets stuck in login loops. It backs up your redeem setup and theme assets, clears saved login state, restores the redeems, and restarts Crystal Relay.'}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                            <Border Margin="0,10,0,0"
                                                    Padding="10"
                                                    Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource DangerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                <TextBlock Text="{loc:Translate 'This clears Twitch, VRChat, StreamElements, Streamlabs, and Ko-fi saved login tokens. Redeems and custom theme assets are restored from the backup.'}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <WrapPanel Margin="0,12,0,0">
                                                <Button Content="{loc:Translate 'Repair and Restart'}"
                                                        Command="{Binding RepairSavedLoginStateCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettingsVisualsSectionSelected}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource PanelBrush}" Padding="24" Margin="0,0,0,0">
                                <StackPanel>
                                    <!-- Visual Settings controls the look-and-feel of the app itself.
                                         These are UI preferences, not Twitch or bridge runtime settings. -->
                                    <TextBlock Text="{loc:Translate 'Visual Settings'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,14,0,0"
                                               Text="{loc:Translate 'Theme'}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <ComboBox Margin="0,8,0,0"
                                              Width="220"
                                              HorizontalAlignment="Center"
                                              ItemsSource="{Binding ThemeOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedTheme, UpdateSourceTrigger=PropertyChanged}" />
                                    <Border Margin="0,16,0,0"
                                            Padding="16"
                                            Background="{DynamicResource PanelSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCustomThemeSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate 'Custom Theme'}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center" />
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,12,0">
                                                    <TextBlock Text="{loc:Translate 'Window Background'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.WindowBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Panel Background'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.PanelBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Border'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.BorderHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Text'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.TextHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Input Background'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.InputBackgroundHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Secondary Button'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.SecondaryButtonHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Body Font'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <ComboBox Margin="0,6,0,0"
                                                              ItemsSource="{Binding CustomThemeFontOptions}"
                                                              IsTextSearchEnabled="True"
                                                              SelectedItem="{Binding Settings.CustomTheme.BodyFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0">
                                                    <TextBlock Text="{loc:Translate 'Panel Secondary'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.PanelSecondaryHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Accent'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.AccentHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Muted Text'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.MutedTextHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Input Border'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.InputBorderHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Title Bar'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.TitleBarHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Danger'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBox Margin="0,6,0,0"
                                                             Text="{Binding Settings.CustomTheme.DangerHex, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Heading Font'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <ComboBox Margin="0,6,0,0"
                                                              ItemsSource="{Binding CustomThemeFontOptions}"
                                                              IsTextSearchEnabled="True"
                                                              SelectedItem="{Binding Settings.CustomTheme.HeadingFontFamily, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Margin="0,12,0,0"
                                                               Text="{loc:Translate 'Background Image'}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding CustomThemeBackgroundImageStatusText}" />
                                                    <WrapPanel Margin="0,8,0,0"
                                                               HorizontalAlignment="Left">
                                                        <Button Margin="0,0,8,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{loc:Translate 'Choose Image'}"
                                                                Click="OnChooseCustomThemeBackgroundImageClicked" />
                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="{loc:Translate 'Clear Image'}"
                                                                IsEnabled="{Binding HasCustomThemeBackgroundImage}"
                                                                Click="OnClearCustomThemeBackgroundImageClicked" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="0,16,0,0"
                                               Text="{loc:Translate 'Language'}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <ComboBox Margin="0,8,0,0"
                                              Width="220"
                                              HorizontalAlignment="Center"
                                              ItemsSource="{Binding LanguageOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedLanguageOption, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding LanguageRestartNoticeText}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLanguageRestartNoticeVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,18,0,0"
                                               Text="{Binding UiOpacityStatusText}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <Slider Minimum="10"
                                            Maximum="100"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.InterfaceOpacityPercent, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,12,0,0" />
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,14,0">
                                            <TextBlock Text="{loc:Translate 'Enable Easter Eggs'}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Text>
                                                    <loc:TranslateExtension Text="Turns Crystal Relay's hidden joke interactions on or off." />
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource RuleToggleStyle}"
                                                      IsChecked="{Binding Settings.EasterEggsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource PanelSecondaryBrush}" Margin="0,16,0,0" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Test Button'}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,10,0,0"
                                               Text="{loc:Translate 'This button exists because you asked for it. It does exactly one extremely important thing.'}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Center"
                                            Content="{loc:Translate 'Test Button'}"
                                            Command="{Binding ShowSettingsTestCommand}" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="1" Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivitySectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAboutSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Text="{loc:Translate 'Redeem Library'}"
                                   Style="{StaticResource HeadingTextStyle}"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center" />
                         <!-- Avatar-Tied Redeems group -->
                         <Border Margin="0,12,0,0"
                                 Background="{DynamicResource NestedPanelBrush}"
                                 BorderBrush="{DynamicResource HighlightBorderBrush}"
                                 BorderThickness="1"
                                 CornerRadius="14"
                                 Padding="12">
                             <StackPanel>
                                 <TextBlock Text="{loc:Translate 'Avatar-Tied Redeems'}"
                                            FontFamily="{DynamicResource HeadingFontFamily}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource MutedBrush}"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center" />
                                 <UniformGrid Margin="0,8,0,0"
                                              Columns="2">
                                     <Button Content="{loc:Translate 'Avatar Sets'}"
                                             Command="{Binding ShowAvatarTriggerRulesCommand}">
                                         <Button.Style>
                                             <Style TargetType="Button" BasedOn="{StaticResource RuleLibraryTabButtonStyle}">
                                                 <Setter Property="Margin" Value="0,0,5,0" />
                                                 <Style.Triggers>
                                                     <DataTrigger Binding="{Binding IsViewingAvatarTriggers}" Value="True">
                                                         <Setter Property="Background" Value="{DynamicResource SectionActiveBrush}" />
                                                         <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                         <Setter Property="Foreground" Value="White" />
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                         </Button.Style>
                                     </Button>
