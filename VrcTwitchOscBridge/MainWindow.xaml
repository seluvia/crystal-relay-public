                                                                                MinWidth="132"
                                                                                Click="OnPickManagedRewardColorClicked"
                                                                                Tag="Ready" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,12,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Cooldown Color'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <DockPanel Margin="0,6,0,0"
                                                                               LastChildFill="False">
                                                                        <Border Width="28"
                                                                                Height="28"
                                                                                CornerRadius="14"
                                                                                Background="{Binding ManagedRewardCooldownColorBrush}"
                                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                                BorderThickness="1" />
                                                                        <TextBlock Margin="12,0,16,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="{Binding ManagedRewardCooldownColor}" />
