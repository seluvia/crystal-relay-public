                                                                                Foreground="{DynamicResource MutedBrush}"
                                                                                TextWrapping="Wrap"
                                                                                Text="{loc:Translate 'Frees Twitch reward slots. Crystal Relay will recreate or relink this reward when it becomes active again.'}" />
                                                                 </StackPanel>
                                                             </Border>
                                                             <Border Margin="0,12,0,0"
                                                                     Background="{DynamicResource PanelSecondaryBrush}"
                                                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                                                     BorderThickness="1"
                                                                     CornerRadius="14"
                                                                     Padding="12">
                                                                 <StackPanel>
                                                                     <TextBlock Text="{loc:Translate 'Chat Command Fallback'}"
                                                                                Foreground="{DynamicResource TextBrush}"
                                                                                FontWeight="SemiBold" />
                                                                     <CheckBox Margin="0,8,0,0"
                                                                               Content="{loc:Translate 'Allow this reward to also run from a ! chat command'}"
                                                                               IsChecked="{Binding ChatCommandEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                                     <UniformGrid Columns="2"
                                                                                  Margin="0,12,0,0"
                                                                                  Visibility="{Binding ChatCommandEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                         <StackPanel Margin="0,0,14,0">
                                                                             <TextBlock Text="{loc:Translate 'Command'}"
                                                                                        Foreground="{DynamicResource TextBrush}"
                                                                                        FontWeight="SemiBold" />
                                                                             <TextBox Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" />
                                                                         </StackPanel>
                                                                         <StackPanel Margin="14,0,0,0">
                                                                             <TextBlock Text="{loc:Translate 'Who Can Use It'}"
                                                                                        Foreground="{DynamicResource TextBrush}"
                                                                                        FontWeight="SemiBold" />
                                                                             <ComboBox ItemsSource="{Binding DataContext.ChatCommandPermissionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                       DisplayMemberPath="Label"
                                                                                       SelectedValuePath="Value"
                                                                                       SelectedValue="{Binding ChatCommandPermission, UpdateSourceTrigger=PropertyChanged}" />
                                                                         </StackPanel>
                                                                     </UniformGrid>
                                                                 </StackPanel>
                                                             </Border>
                                                             <StackPanel Margin="0,12,0,0">
                                                                 <TextBlock Text="{loc:Translate 'Managed Reward Colors'}"
                                                                            Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding DataContext.ManagedRewardColorsDescriptionText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <StackPanel Margin="0,10,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Ready Color'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <DockPanel Margin="0,6,0,0"
                                                                               LastChildFill="False">
                                                                        <Border Width="28"
                                                                                Height="28"
                                                                                CornerRadius="14"
                                                                                Background="{Binding ManagedRewardReadyColorBrush}"
                                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                                BorderThickness="1" />
                                                                        <TextBlock Margin="12,0,16,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="{Binding ManagedRewardReadyColor}" />
                                                                        <Button Content="{loc:Translate 'Choose Color'}"
                                                                                Padding="16,6"
                                                                                MinWidth="132"
                                                                                Click="OnPickManagedRewardColorClicked"
                                                                                Tag="Ready" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,12,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Cooldown Color'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <DockPanel Margin="0,6,0,0"
                                                                               LastChildFill="False">
                                                                        <Border Width="28"
                                                                                Height="28"
                                                                                CornerRadius="14"
                                                                                Background="{Binding ManagedRewardCooldownColorBrush}"
                                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                                BorderThickness="1" />
                                                                        <TextBlock Margin="12,0,16,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="{Binding ManagedRewardCooldownColor}" />
                                                                        <Button Content="{loc:Translate 'Choose Color'}"
                                                                                Padding="16,6"
                                                                                MinWidth="132"
                                                                                Click="OnPickManagedRewardColorClicked"
                                                                                Tag="Cooldown" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesBits, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <UniformGrid Columns="2">
                                                                <StackPanel Margin="0,0,14,0">
                                                                    <TextBlock Text="{loc:Translate 'Minimum Bits'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MinimumBits, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="14,0,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Maximum Bits'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MaximumBits, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesSubscription, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <UniformGrid Columns="3">
                                                                <StackPanel Margin="0,0,10,0">
                                                                    <TextBlock Text="{loc:Translate 'Sub Tier'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding SubscriptionTier, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="10,0,10,0">
                                                                    <TextBlock Text="{loc:Translate 'Min Months'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MinimumMonths, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="10,0,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Max Months'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding MaximumMonths, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,20,0,0"
                                                        Background="{DynamicResource NestedPanelBrush}"
                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'OSC Actions'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="17" />
                                                        <TextBlock Margin="0,8,0,0"
                                                                   Text="{loc:Translate 'Run all actions in order, or enable random mode above to pick one action per trigger. Queued actions serialize repeated activations for this trigger.'}"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   TextWrapping="Wrap" />
                                                        <ListBox Margin="0,12,0,0"
                                                                 MaxHeight="180"
                                                                 ItemsSource="{Binding Actions}"
                                                                 SelectedItem="{Binding DataContext.SelectedUniversalTriggerAction, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        <ContentControl Margin="0,16,0,0"
                                                                        Content="{Binding DataContext.SelectedUniversalTriggerAction, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <ContentControl.ContentTemplate>
                                                                <DataTemplate DataType="{x:Type models:UniversalTriggerAction}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{loc:Translate 'Selected Action'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <UniformGrid Columns="2"
                                                                                     Margin="0,10,0,0">
                                                                            <StackPanel Margin="0,0,14,0">
                                                                                <TextBlock Text="{loc:Translate 'OSC Address'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding OscAddress, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="14,0,0,0">
                                                                                <TextBlock Text="{loc:Translate 'Value Type'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <ComboBox ItemsSource="{Binding DataContext.UniversalTriggerValueKinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                          SelectedItem="{Binding ValueKind, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                        </UniformGrid>
                                                                        <UniformGrid Columns="3"
                                                                                     Margin="0,12,0,0">
                                                                            <StackPanel Margin="0,0,10,0">
                                                                                <TextBlock Text="{loc:Translate 'Target Value'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding TargetValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="10,0,10,0">
                                                                                <TextBlock Text="{loc:Translate 'Default Value'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="10,0,0,0">
                                                                                <TextBlock Text="{loc:Translate 'Duration'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                        </UniformGrid>
                                                                        <CheckBox Margin="0,12,0,0"
                                                                                  Content="{loc:Translate 'Add this action to the trigger queue'}"
                                                                                  IsChecked="{Binding AddToQueue, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ContentControl.ContentTemplate>
                                                        </ContentControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,18,0,0"
                                    Background="{DynamicResource PanelHighlightBrush}"
                                    BorderBrush="{DynamicResource HighlightBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRule}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ContentControl Content="{Binding SelectedRule}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type models:TriggerRule}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock FontSize="22"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
                                                                <Setter Property="Text" Value="Redeem Editor" />
                                                                <Setter Property="FontSize" Value="22" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Text" Value="{loc:Translate 'Redeem Editor'}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Style="{StaticResource HelpIconButtonStyle}"
                                                            Click="OnHelpButtonClicked"
                                                            CommandParameter="Redeem Editor"
                                                            Tag="Use this editor to build the selected rule from top to bottom. Start with the Twitch trigger details, then choose the action Crystal Relay should send, then set how long it stays active, its cooldown, and any optional bot reply. The fields shown change based on the rule type, so avatar changes, Avatar Roulette, movement rules, and parameter rules only show the options they actually use." />
                                                </DockPanel>
                                                <WrapPanel Margin="0,14,0,0">
                                                    <WrapPanel.Style>
                                                        <Style TargetType="WrapPanel">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </WrapPanel.Style>
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="{loc:Translate 'Test Redeem'}"
                                                            Command="{Binding DataContext.TestSelectedRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                </WrapPanel>

                                                <Grid Margin="0,22,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0"
                                                                Margin="0,0,14,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                            <Condition Binding="{Binding UsesChannelPointReward}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Text="{loc:Translate 'Display Name'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <Grid Margin="0">
                                                        <Grid.Style>
                                                            <Style TargetType="Grid">
                                                                <Setter Property="Grid.Column" Value="0" />
                                                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                            <Condition Binding="{Binding UsesChannelPointReward}" Value="False" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Grid.Column" Value="2" />
                                                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Grid.Style>
                                                        <StackPanel>
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{loc:Translate 'Twitch Trigger'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <ComboBox ItemsSource="{Binding DataContext.OverrideTriggerTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding TriggerType, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="{loc:Translate 'Twitch Trigger'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <Border Margin="0,6,0,0"
                                                                    Padding="12,10"
                                                                    CornerRadius="14"
                                                                    Background="{DynamicResource StatusChipBrush}"
                                                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{loc:Translate 'Channel Points'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>

                                                <Border Margin="0,20,0,0"
                                                        Background="{DynamicResource NestedPanelBrush}"
                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'Twitch Trigger Settings'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="17" />

                                                        <Border Margin="0,12,0,0"
                                                                Background="{DynamicResource PanelSecondaryBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="12">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding UsesAvatarChange}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding UsesAvatarRoulet}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{loc:Translate 'Applies to VRChat Avatar'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <ComboBox Margin="0,6,0,0"
                                                                          ItemsSource="{Binding DataContext.VrChatAvatarOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          IsEditable="True"
                                                                          IsTextSearchEnabled="True"
                                                                          StaysOpenOnEdit="True"
                                                                          TextSearch.TextPath="SearchText"
                                                                          ItemTemplate="{StaticResource VrChatAvatarOptionTemplate}"
                                                                          SelectedValuePath="Id"
                                                                          SelectedValue="{Binding SupporterAvatarId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                <Button Margin="0,8,0,0"
                                                                        Content="{loc:Translate 'Use Current Avatar'}"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Command="{Binding DataContext.UseCurrentAvatarForSupporterRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Text="{loc:Translate 'Choose the VRChat avatar this paid trigger belongs to. It only runs while you are wearing that avatar.'}"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>

                                                        <StackPanel Margin="0,10,0,0"
                                                                    Visibility="{Binding UsesChannelPointReward, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Twitch Redeem'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Twitch Redeem"
                                                                        Tag="{Binding DataContext.ManagedChannelPointRewardHelpText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </DockPanel>
                                                            <UniformGrid Columns="2"
                                                                         Margin="0,8,0,0">
                                                                <UniformGrid.Style>
                                                                    <Style TargetType="UniformGrid">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesSetTrigger}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </UniformGrid.Style>
                                                                <StackPanel Margin="0,0,14,0">
                                                                    <TextBlock Text="{loc:Translate 'Reward Name'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding ChannelPointRewardTitle, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Margin="14,0,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Reward Cost'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding ChannelPointRewardCost, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </UniformGrid>
                                                            <Border Margin="0,12,0,0"
                                                                    Background="{DynamicResource PanelSecondaryBrush}"
                                                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="14"
                                                                    Padding="12">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <StackPanel>
                                                                        <StackPanel.Style>
                                                                            <Style TargetType="StackPanel">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding UsesSetTrigger}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </StackPanel.Style>
                                                                        <CheckBox IsChecked="{Binding SharedRewardChoiceEnabled, UpdateSourceTrigger=PropertyChanged}">
                                                                            <TextBlock Text="{loc:Translate 'Use shared numbered reward'}"
                                                                                       TextWrapping="Wrap" />
                                                                        </CheckBox>
                                                                        <TextBlock Margin="26,6,0,0"
                                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   Text="{loc:Translate 'Rules with the same reward name become one Twitch reward. Viewers type the choice number in the redeem input.'}" />
                                                                        <UniformGrid Columns="2"
                                                                                     Margin="0,12,0,0">
                                                                            <UniformGrid.Style>
                                                                                <Style TargetType="UniformGrid">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding SharedRewardChoiceEnabled}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </UniformGrid.Style>
                                                                            <StackPanel Margin="0,0,14,0">
                                                                                <TextBlock Text="{loc:Translate 'Choice number'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding SharedRewardChoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="14,0,0,0">
                                                                                <TextBlock Text="{loc:Translate 'Choice label'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding SharedRewardHelpText, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                        </UniformGrid>
                                                                    </StackPanel>
                                                                    <StackPanel Visibility="{Binding UsesSetTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{loc:Translate 'Outfit Choice'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBlock Margin="0,6,0,0"
                                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   Text="{loc:Translate 'Set Trigger choices share the master reward above. Viewers type this choice number in the redeem input. Crystal Relay snapshots safe outfit values before changing parameters and restores from that copied snapshot after Active Time.'}" />
                                                                        <UniformGrid Columns="2"
                                                                                     Margin="0,12,0,0">
                                                                            <StackPanel Margin="0,0,14,0">
                                                                                <TextBlock Text="{loc:Translate 'Outfit number'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding SharedRewardChoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="14,0,0,0">
                                                                                <TextBlock Text="{loc:Translate 'Outfit name'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding SharedRewardHelpText, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                        </UniformGrid>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Margin="0,12,0,0"
                                                                    Background="{DynamicResource PanelSecondaryBrush}"
                                                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="14"
                                                                    Padding="12">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesSetTrigger}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel>
                                                                    <CheckBox IsChecked="{Binding DeleteManagedRewardWhenInactive, UpdateSourceTrigger=PropertyChanged}">
                                                                        <TextBlock Text="{loc:Translate 'Delete Twitch reward when inactive'}"
                                                                                   TextWrapping="Wrap" />
                                                                    </CheckBox>
                                                                    <TextBlock Margin="26,6,0,0"
                                                                               Foreground="{DynamicResource MutedBrush}"
                                                                               TextWrapping="Wrap"
                                                                               Text="{loc:Translate 'Frees Twitch reward slots. Crystal Relay will recreate or relink this reward when it becomes active again.'}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <StackPanel Margin="0,12,0,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesSetTrigger}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="{loc:Translate 'Managed Reward Colors'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{Binding DataContext.ManagedRewardColorsDescriptionText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <StackPanel Margin="0,10,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Ready Color'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <DockPanel Margin="0,6,0,0"
                                                                               LastChildFill="False">
                                                                        <Border Width="28"
                                                                                Height="28"
                                                                                CornerRadius="14"
                                                                                Background="{Binding ManagedRewardReadyColorBrush}"
                                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                                BorderThickness="1" />
                                                                        <TextBlock Margin="12,0,16,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="{Binding ManagedRewardReadyColor}" />
                                                                        <Button Content="{loc:Translate 'Choose Color'}"
                                                                                Padding="16,6"
                                                                                MinWidth="132"
                                                                                Click="OnPickManagedRewardColorClicked"
                                                                                Tag="Ready" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                                <StackPanel Margin="0,12,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Cooldown Color'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <DockPanel Margin="0,6,0,0"
                                                                               LastChildFill="False">
                                                                        <Border Width="28"
                                                                                Height="28"
                                                                                CornerRadius="14"
                                                                                Background="{Binding ManagedRewardCooldownColorBrush}"
                                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                                BorderThickness="1" />
                                                                        <TextBlock Margin="12,0,16,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold"
                                                                                   Text="{Binding ManagedRewardCooldownColor}" />
                                                                        <Button Content="{loc:Translate 'Choose Color'}"
                                                                                Padding="16,6"
                                                                                MinWidth="132"
                                                                                Click="OnPickManagedRewardColorClicked"
                                                                                Tag="Cooldown" />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Border Margin="0,12,0,0"
                                                                Background="{DynamicResource PanelSecondaryBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="12">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesBitsOutfitSetTrigger}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{loc:Translate 'Bits Outfit Trigger'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Margin="0,6,0,0"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{loc:Translate 'Viewers cheer at least the minimum bits and type this outfit name in the cheer message. Capitalization, spaces, punctuation, and small spelling mistakes are okay, but unclear names will not trigger. Bits outfit triggers use the same safe Set Trigger snapshot and restore flow.'}" />
                                                                <StackPanel Margin="0,12,0,0">
                                                                    <TextBlock Text="{loc:Translate 'Outfit name'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding SharedRewardHelpText, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <StackPanel Margin="0,10,0,0"
                                                                    Visibility="{Binding UsesAmountThreshold, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{loc:Translate 'Minimum Amount'}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UsesBitsOutfitSetTrigger}" Value="True">
                                                                                    <Setter Property="Text" Value="{loc:Translate 'Minimum Bits'}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Minimum Amount"
                                                                        Tag="This setting is only for bits and subscriptions overrides. For bits, it is the minimum number of bits needed in one cheer event. For subs, it is the minimum number of subscriptions or gift subs the event must include before Crystal Relay runs the rule. Paid overrides ignore avatar matching and can fire no matter which avatar you are using." />
                                                            </DockPanel>
                                                            <TextBox Text="{Binding MinimumAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesSupporterAmountTimerSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Bits/Subs Amount Timer'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Bits/Subs Amount Timer"
                                                                        Tag="{loc:Translate 'When enabled, Crystal Relay ignores the fixed Active Time for this paid override and calculates the timer from separate Bits and Subs ratios. Bits use the bit count, normal subs count as 1, and gift subs use the gift total.'}" />
                                                            </DockPanel>
                                                            <CheckBox Margin="0,8,0,0"
                                                                      Content="{loc:Translate 'Scale active time by amount'}"
                                                                      IsChecked="{Binding AmountScaledDurationEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="{loc:Translate 'When enabled, Crystal Relay ignores the fixed Active Time for this paid override and calculates the timer from separate Bits and Subs ratios. Bits use the bit count, normal subs count as 1, and gift subs use the gift total.'}" />
                                                            <StackPanel Margin="0,10,0,0"
                                                                        Visibility="{Binding UsesAmountScaledDuration, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{loc:Translate 'Bits timer'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <UniformGrid Columns="2"
                                                                             Margin="0,6,0,0">
                                                                    <StackPanel Margin="0,0,14,0">
                                                                        <TextBlock Text="{loc:Translate 'Every this many bits'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding BitsAmountUnitsPerDuration, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Margin="14,0,0,0">
                                                                        <TextBlock Text="{loc:Translate 'Adds this many seconds'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding BitsSecondsPerAmountUnit, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                </UniformGrid>
                                                                <TextBlock Margin="0,12,0,0"
                                                                           Text="{loc:Translate 'Subs timer'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <UniformGrid Columns="2"
                                                                             Margin="0,6,0,0">
                                                                    <StackPanel Margin="0,0,14,0">
                                                                        <TextBlock Text="{loc:Translate 'Every this many subs'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding SubscriptionsAmountUnitsPerDuration, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Margin="14,0,0,0">
                                                                        <TextBlock Text="{loc:Translate 'Adds this many seconds'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding SubscriptionsSecondsPerAmountUnit, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                </UniformGrid>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesSupporterAmountTimerSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Max Added Time'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Max Added Time"
                                                                        Tag="{loc:Translate 'When enabled, Crystal Relay caps the total remaining time for this same paid override rule. New bits or subs can only add time until the rule reaches this limit. Example: 1800 seconds = 30 minutes.'}" />
                                                            </DockPanel>
                                                            <CheckBox Margin="0,8,0,0"
                                                                      Content="{loc:Translate 'Limit total added time'}"
                                                                      IsChecked="{Binding MaxAccumulatedDurationEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="{loc:Translate 'When enabled, Crystal Relay caps the total remaining time for this same paid override rule. New bits or subs can only add time until the rule reaches this limit. Example: 1800 seconds = 30 minutes.'}" />
                                                            <StackPanel Margin="0,10,0,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding MaxAccumulatedDurationEnabled}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock Text="{loc:Translate 'Maximum total time in seconds'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding MaxAccumulatedDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Chat Command Fallback'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Chat Command Fallback"
                                                                        Tag="{Binding DataContext.ChatCommandFallbackHelpText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </DockPanel>
                                                            <CheckBox Margin="0,8,0,0"
                                                                      Content="{loc:Translate 'Enable chat command fallback'}"
                                                                      IsChecked="{Binding ChatCommandEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                                            <StackPanel Margin="0,10,0,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ChatCommandEnabled}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <UniformGrid Columns="2">
                                                                    <StackPanel Margin="0,0,14,0">
                                                                        <TextBlock Text="{loc:Translate 'Exact Command'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding ChatCommandText}" />
                                                                    </StackPanel>
                                                                    <StackPanel Margin="14,0,0,0">
                                                                        <TextBlock Text="{loc:Translate 'Who Can Use It'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <ComboBox ItemsSource="{Binding DataContext.ChatCommandPermissionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                  DisplayMemberPath="Label"
                                                                                  SelectedValuePath="Value"
                                                                                  SelectedValue="{Binding ChatCommandPermission, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                </UniformGrid>
                                                                <TextBlock Margin="0,10,0,0"
                                                                           Foreground="{DynamicResource MutedBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Text="{loc:Translate 'Crystal Relay matches the whole chat message exactly. Example: !wave'}" />
                                                            </StackPanel>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Border>

                                                <Border Margin="0,20,0,0"
                                                        Background="{DynamicResource NestedPanelBrush}"
                                                        BorderBrush="{DynamicResource HighlightBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="18"
                                                        Padding="16">
                                                    <StackPanel>
                                                        <TextBlock Text="{loc:Translate 'OSC Action'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="17" />
                                                        <TextBlock Margin="0,10,0,0"
                                                                   Text="{loc:Translate 'Action Type'}"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   FontWeight="SemiBold" />
                                                        <Border Margin="0,8,0,0"
                                                                Padding="14,10"
                                                                Background="{DynamicResource InputBackgroundBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SharedRewardChoiceEnabled}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{loc:Translate 'Avatar Parameter'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Margin="0,8,0,0"
                                                                Padding="14,10"
                                                                Background="{DynamicResource InputBackgroundBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{loc:Translate 'Avatar Change'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Margin="0,8,0,0"
                                                                Padding="14,10"
                                                                Background="{DynamicResource InputBackgroundBrush}"
                                                                BorderBrush="{DynamicResource InputBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="14">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingMovementRedeems, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{loc:Translate 'Player Movement'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <ComboBox ItemsSource="{Binding DataContext.AvailableActionTypesForSelectedContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  Margin="0,8,0,0"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedItem="{Binding DataContext.SelectedActionTypeOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                            <ComboBox.Style>
                                                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingMasterAvatar, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                                <Condition Binding="{Binding SharedRewardChoiceEnabled}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ComboBox.Style>
                                                        </ComboBox>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesPlayerMovement, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Movement Action'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                                Width="24"
                                                                                Height="24"
                                                                                MinWidth="24"
                                                                                MinHeight="24"
                                                                                Click="OnHelpButtonClicked"
                                                                                CommandParameter="Movement Action"
                                                                        Tag="Choose which VRChat movement input Crystal Relay should send for this rule. Directional options hold that input for the full Active Time, so they behave like a viewer-controlled push on that movement lane. Movement rules are global, which means they are not tied to one avatar set." />
                                                            </DockPanel>
                                                            <ComboBox ItemsSource="{Binding DataContext.MovementDirections, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value"
                                                                      SelectedValue="{Binding MovementDirection, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesAvatarParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Value Type'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Value Type"
                                                                        Tag="Pick the kind of VRChat parameter value this redeem should send. Bool means simple on or off values like True and False. Int means whole numbers only, like 0, 1, or 2. Float means decimal numbers, like 0.0, 0.5, or 1.0. When you switch this type, Crystal Relay resets the value boxes so they match the type you chose." />
                                                            </DockPanel>
                                                            <ComboBox ItemsSource="{Binding DataContext.ParameterTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding ParameterType, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Margin="0,12,0,0"
                                                                       Text="{loc:Translate 'Avatar Parameter'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <ComboBox ItemsSource="{Binding DataContext.AvatarParameterOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      Margin="0,8,0,0"
                                                                      IsEditable="True"
                                                                      IsTextSearchEnabled="True"
                                                                      StaysOpenOnEdit="True"
                                                                      TextSearch.TextPath="DisplayLabel"
                                                                      DisplayMemberPath="DisplayLabel"
                                                                      SelectedItem="{Binding DataContext.SelectedAvatarParameterOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                            <WrapPanel Margin="0,8,0,0">
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Content="{loc:Translate 'Copy Path'}"
                                                                        Command="{Binding DataContext.CopySelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Content="{loc:Translate 'Paste Path'}"
                                                                        Command="{Binding DataContext.PasteSelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </WrapPanel>
                                                            <TextBlock Margin="0,6,0,0"
                                                                       Text="{Binding DataContext.VrChatOscParameterStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap" />

                                                            <StackPanel Margin="0,14,0,0"
                                                                        Visibility="{Binding UsesBoolParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <StackPanel Visibility="{Binding UsesBoolToggleHint, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <DockPanel LastChildFill="False">
                                                                        <TextBlock Text="{loc:Translate 'Instant Bool Toggle'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                                Width="24"
                                                                                Height="24"
                                                                                MinWidth="24"
                                                                                MinHeight="24"
                                                                                Click="OnHelpButtonClicked"
                                                                                CommandParameter="Instant Bool Toggle"
                                                                                Tag="When Active Time is 0, this bool rule becomes a toggle instead of a timed hold. Each use flips the current VRChat bool parameter from off to on or from on to off. Use a timed Active Time above 0 when you want Crystal Relay to turn it on first and reset it later." />
                                                                    </DockPanel>
                                                                </StackPanel>
                                                                <StackPanel Visibility="{Binding UsesBoolTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <UniformGrid Columns="2"
                                                                                 Margin="0,12,0,0">
                                                                        <StackPanel Margin="0,0,14,0">
                                                                            <TextBlock Text="{loc:Translate 'When Triggered'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                      SelectedItem="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                        <StackPanel Margin="14,0,0,0">
                                                                            <TextBlock Text="{loc:Translate 'After Active Time Ends'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                      SelectedItem="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Margin="0,14,0,0"
                                                                        Visibility="{Binding UsesIntParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <StackPanel Visibility="{Binding UsesIntInstantModeOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <DockPanel LastChildFill="False">
                                                                        <TextBlock Text="{loc:Translate 'Instant Int Action'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                                Width="24"
                                                                                Height="24"
                                                                                MinWidth="24"
                                                                                MinHeight="24"
                                                                                Click="OnHelpButtonClicked"
                                                                                CommandParameter="Instant Int Action"
                                                                                Tag="{Binding IntModeHelpText}" />
                                                                    </DockPanel>
                                                                    <ComboBox ItemsSource="{Binding DataContext.IntZeroDurationModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              SelectedItem="{Binding IntZeroDurationMode, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <StackPanel Margin="0,12,0,0"
                                                                                Visibility="{Binding UsesIntFixedInstantValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <TextBlock Text="{loc:Translate 'Send This Number'}"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontWeight="SemiBold" />
                                                                        <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </StackPanel>
                                                                    <StackPanel Margin="0,12,0,0"
                                                                                Visibility="{Binding UsesIntRangeInputs, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <UniformGrid Columns="2">
                                                                            <StackPanel Margin="0,0,14,0">
                                                                                <TextBlock Text="{loc:Translate 'Minimum Number'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding RangeMinimum, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="14,0,0,0">
                                                                                <TextBlock Text="{loc:Translate 'Maximum Number'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding RangeMaximum, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                        </UniformGrid>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <StackPanel Visibility="{Binding UsesIntTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                                                        <StackPanel Margin="0,0,14,0">
                                                                            <TextBlock Text="{loc:Translate 'When Triggered, Set To'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                        <StackPanel Margin="14,0,0,0">
                                                                            <TextBlock Text="{loc:Translate 'After Active Time Ends, Set Back To'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Margin="0,14,0,0"
                                                                        Visibility="{Binding UsesTextOrFloatParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <StackPanel Visibility="{Binding UsesDirectInstantValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{loc:Translate 'Send This Value'}"
                                                                               Foreground="{DynamicResource TextBrush}"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                </StackPanel>
                                                                <StackPanel Visibility="{Binding UsesDirectTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                                                        <StackPanel Margin="0,0,14,0">
                                                                            <TextBlock Text="{loc:Translate 'When Triggered, Send This Value'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                        <StackPanel Margin="14,0,0,0">
                                                                            <TextBlock Text="{loc:Translate 'After Active Time Ends, Send This Value'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBox Text="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                        </StackPanel>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesSetTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="{loc:Translate 'Outfit Parameters'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                             <TextBlock Margin="0,6,0,0"
                                                                         Text="{loc:Translate 'Add bool, int, or float parameters that should change together. Crystal Relay snapshots safe LocalAvatarData values before sending, waits 70 seconds when needed to learn what changed, then restores changed parameters from the copied pre-trigger snapshot after Active Time.'}"
                                                                        Foreground="{DynamicResource MutedBrush}"
                                                                        TextWrapping="Wrap" />
                                                             <Border Margin="0,10,0,0"
                                                                     Padding="12,10"
                                                                     Background="{DynamicResource DangerBrush}"
                                                                     BorderBrush="{DynamicResource DangerBorderBrush}"
                                                                     BorderThickness="1"
                                                                     CornerRadius="8">
                                                                 <StackPanel>
                                                                     <TextBlock Text="{loc:Translate 'Warning: Set Trigger restore uses delayed VRChat avatar data'}"
                                                                                Foreground="#FFFFD6E2"
                                                                                FontWeight="Bold"
                                                                                TextWrapping="Wrap" />
                                                                     <TextBlock Margin="0,4,0,0"
                                                                                 Text="{loc:Translate 'After manually changing outfit toggles or parameters in VRChat, wait at least 70 seconds before testing or redeeming a Set Trigger. Crystal Relay uses LocalAvatarData snapshots and diffs for safe restore, and triggering before VRChat updates that file can restore the wrong outfit values.'}"
                                                                                Foreground="#FFFFEEF4"
                                                                                TextWrapping="Wrap" />
                                                                 </StackPanel>
                                                             </Border>
                                                             <WrapPanel Margin="0,10,0,0">
                                                                 <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                         Content="{loc:Translate 'Add Set Parameter'}"
                                                                         Command="{Binding DataContext.AddSetTriggerActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                        Content="{loc:Translate 'Delete Set Parameter'}"
                                                                        Command="{Binding DataContext.RemoveSelectedSetTriggerActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            </WrapPanel>
                                                            <ListBox Margin="0,10,0,0"
                                                                     MaxHeight="130"
                                                                     ItemsSource="{Binding SetTriggerActions}"
                                                                     SelectedItem="{Binding DataContext.SelectedSetTriggerAction, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                                     DisplayMemberPath="DisplaySummary"
                                                                     ScrollViewer.CanContentScroll="True"
                                                                     VirtualizingStackPanel.IsVirtualizing="True"
                                                                     VirtualizingStackPanel.VirtualizationMode="Recycling" />
                                                            <ContentControl Margin="0,12,0,0"
                                                                            Content="{Binding DataContext.SelectedSetTriggerAction, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                <ContentControl.Style>
                                                                    <Style TargetType="ContentControl">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.SelectedSetTriggerAction, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ContentControl.Style>
                                                                <ContentControl.ContentTemplate>
                                                                    <DataTemplate DataType="{x:Type models:SetTriggerAction}">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{loc:Translate 'Selected Set Parameter'}"
                                                                                       Foreground="{DynamicResource TextBrush}"
                                                                                       FontWeight="SemiBold" />
                                                                            <UniformGrid Columns="2"
                                                                                         Margin="0,10,0,0">
                                                                                <StackPanel Margin="0,0,14,0">
                                                                                    <TextBlock Text="{loc:Translate 'Avatar Parameter'}"
                                                                                               Foreground="{DynamicResource TextBrush}"
                                                                                               FontWeight="SemiBold" />
                                                                                    <ComboBox ItemsSource="{Binding DataContext.SetTriggerParameterOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                              Margin="0,8,0,0"
                                                                                              IsTextSearchEnabled="True"
                                                                                              TextSearch.TextPath="DisplayLabel"
                                                                                              DisplayMemberPath="DisplayLabel"
                                                                                              SelectedItem="{Binding DataContext.SelectedSetTriggerParameterOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                                    <WrapPanel Margin="0,8,0,0">
                                                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                                                Content="{loc:Translate 'Copy Path'}"
                                                                                                Command="{Binding DataContext.CopySelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                                                Content="{loc:Translate 'Paste Path'}"
                                                                                                Command="{Binding DataContext.PasteSelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                                    </WrapPanel>
                                                                                    <TextBlock Margin="0,6,0,0"
                                                                                               Text="{Binding DataContext.VrChatOscParameterStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                               Foreground="{DynamicResource MutedBrush}"
                                                                                               TextWrapping="Wrap" />
                                                                                </StackPanel>
                                                                                <StackPanel Margin="14,0,0,0">
                                                                                    <TextBlock Text="{loc:Translate 'Value Type'}"
                                                                                               Foreground="{DynamicResource TextBrush}"
                                                                                               FontWeight="SemiBold" />
                                                                                    <ComboBox ItemsSource="{Binding DataContext.ParameterTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                              SelectedItem="{Binding ParameterType, UpdateSourceTrigger=PropertyChanged}" />
                                                                                </StackPanel>
                                                                            </UniformGrid>
                                                                            <StackPanel Margin="0,12,0,0">
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Bool}">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <TextBlock Text="{loc:Translate 'When Triggered'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                          SelectedItem="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="0,12,0,0">
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Int}">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <TextBlock Text="{loc:Translate 'When Triggered, Set To'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <StackPanel Margin="0,12,0,0">
                                                                                <StackPanel.Style>
                                                                                    <Style TargetType="StackPanel">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Float}">
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </StackPanel.Style>
                                                                                <TextBlock Text="{loc:Translate 'When Triggered, Send This Value'}"
                                                                                           Foreground="{DynamicResource TextBrush}"
                                                                                           FontWeight="SemiBold" />
                                                                                <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                                                            </StackPanel>
                                                                            <TextBlock Margin="0,8,0,0"
                                                                                       Text="{loc:Translate 'Restore values come from the copied pre-trigger snapshot, not from a later VRChat file read.'}"
                                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                                       TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ContentControl.ContentTemplate>
                                                            </ContentControl>
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesAvatarChange, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Avatar To Switch To'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Avatar To Switch To"
                                                                        Tag="Choose the exact VRChat avatar this rule should switch you to. Crystal Relay shows clean avatar names here, but it still stores the real avatar ID behind the scenes so OSC avatar changes go to the correct target. Start typing to search the cached avatar list by name." />
                                                            </DockPanel>
                                                            <ComboBox ItemsSource="{Binding DataContext.VrChatAvatarOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      Margin="0,8,0,0"
                                                                      IsEditable="True"
                                                                      IsTextSearchEnabled="True"
                                                                      StaysOpenOnEdit="True"
                                                                      TextSearch.TextPath="SearchText"
                                                                      ItemTemplate="{StaticResource VrChatAvatarOptionTemplate}"
                                                                      SelectedValuePath="Id"
                                                                      SelectedValue="{Binding AvatarChangeTargetId, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button Margin="0,8,0,0"
                                                                    Content="{loc:Translate 'Use Current Avatar'}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.UseCurrentAvatarForAvatarChangeRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <TextBlock Margin="0,12,0,0"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding DataContext.MasterAvatarReturnText, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </StackPanel>

                                                        <StackPanel Margin="0,14,0,0"
                                                                    Visibility="{Binding UsesAvatarRoulet, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{loc:Translate 'Avatar Roulette Pool'}"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           FontWeight="SemiBold" />
                                                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        MinWidth="24"
                                                                        MinHeight="24"
                                                                        Click="OnHelpButtonClicked"
                                                                        CommandParameter="Avatar Roulette Pool"
                                                                        Tag="Choose the pool of avatars this Avatar Roulette rule is allowed to roll from. When the rule fires, Crystal Relay randomly picks one avatar from this pool, switches to it as a temporary avatar, then returns to the shared return avatar when the Active Time ends. The roulette rule does not rewrite your shared return avatar." />
                                                            </DockPanel>
                                                            <Button Margin="0,8,0,0"
                                                                    Content="{loc:Translate 'Pick Avatar Roulette Pool'}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.OpenAvatarRouletPoolPickerCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                            <TextBlock Margin="0,10,0,0"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding AvatarRouletPoolSummary}" />
                                                            <TextBlock Margin="0,8,0,0"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Text="{loc:Translate 'Avatar Roulette always stays temporary. It rolls from the selected pool, then uses the shared return avatar for the switch back without rewriting it.'}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <UniformGrid Columns="2" Margin="0,20,0,0">
                                                    <StackPanel Margin="0,0,14,0">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{loc:Translate 'Active Time (seconds)'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                    Width="24"
                                                                    Height="24"
                                                                    MinWidth="24"
                                                                    MinHeight="24"
                                                                    Click="OnHelpButtonClicked"
                                                                    CommandParameter="Active Time"
                                                                    Tag="{Binding DurationHelpText}" />
                                                        </DockPanel>
                                                        <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UsesAmountScaledDuration}" Value="True">
                                                                            <Setter Property="IsEnabled" Value="False" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Text="{loc:Translate 'Amount-scaled timer is enabled, so Active Time is calculated from the incoming bits/sub amount.'}"
                                                                   Visibility="{Binding UsesAmountScaledDuration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <StackPanel Margin="14,0,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding UsesCooldown}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding UsesSetTrigger}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock Text="{loc:Translate 'Cooldown (seconds)'}"
                                                                       Foreground="{DynamicResource TextBrush}"
                                                                       FontWeight="SemiBold" />
                                                            <Button Style="{StaticResource HelpIconButtonStyle}"
                                                                    Width="24"
                                                                    Height="24"
                                                                    MinWidth="24"
                                                                    MinHeight="24"
                                                                    Click="OnHelpButtonClicked"
                                                                    CommandParameter="Cooldown"
                                                                    Tag="Cooldown is the wait time before the same rule can trigger again. Crystal Relay uses it locally to block repeats, and for managed channel point redeems it also syncs the same cooldown back to Twitch. Avatar Roulette also keeps avatar-switch redeems disabled for its cooldown window." />
                                                        </DockPanel>
                                                        <TextBox Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <DockPanel Margin="0,20,0,0"
                                                           LastChildFill="False">
                                                    <TextBlock Text="{loc:Translate 'Bot Message'}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               FontWeight="SemiBold" />
                                                    <Button Style="{StaticResource HelpIconButtonStyle}"
                                                            Width="24"
                                                            Height="24"
                                                            MinWidth="24"
                                                            MinHeight="24"
                                                            Click="OnHelpButtonClicked"
                                                            CommandParameter="Bot Message"
                                                            Tag="This is an optional chat reply sent by your connected bot account after the rule fires. Use it for confirmations, jokes, or quick status messages. Placeholders like {user}, {reward}, {duration}, and {value} are filled in from the trigger that just ran." />
                                                </DockPanel>
                                                <TextBox Text="{Binding BotMessageTemplate, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         Height="100"
                                                         TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>

                            <TextBlock Margin="0,22,0,0"
                                       Text="{Binding SelectedRuleEmptyStateText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="{Binding ElementName=RuleWorkspaceScrollViewer, Path=ActualWidth}"
                                       VerticalAlignment="Center"
                                       FontSize="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRule}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsViewingUniversalTriggers}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,22,0,0"
                                       Text="{Binding SelectedRuleEmptyStateText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="{Binding ElementName=RuleWorkspaceScrollViewer, Path=ActualWidth}"
                                       VerticalAlignment="Center"
                                       FontSize="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsViewingUniversalTriggers}" Value="True" />
                                                    <Condition Binding="{Binding SelectedUniversalTrigger}" Value="{x:Null}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="5"
                    Background="{DynamicResource PanelBrush}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivitySectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top"
                               LastChildFill="False">
                        <TextBlock Text="{loc:Translate 'Activity'}" Style="{StaticResource HeadingTextStyle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                Click="OnHelpButtonClicked"
                                CommandParameter="Activity"
                                Tag="Activity is Crystal Relay's running event log. It shows Twitch connection changes, reward sync results, VRChat avatar detection, OSC events, chat-command triggers, and errors so you can see what the app is doing without guessing. If something behaves strangely, this is usually the first place to check." />
                    </DockPanel>
                    <ListBox Margin="0,18,0,0"
                             ItemsSource="{Binding LogEntries}"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="5"
                    Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAboutSectionSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Width="980"
                          HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/rikuknifesticker.png"
                               Width="320"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,300,12,22"
                               Opacity="0.9"
                               Stretch="Uniform"
                               IsHitTestVisible="False"
                               Panel.ZIndex="0"
                               RenderOptions.BitmapScalingMode="Fant">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.Theme}" Value="{x:Static models:AppTheme.DreamScape}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <StackPanel MaxWidth="980"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,250"
                                    Panel.ZIndex="1">
                        <!-- About intro explains the goal of Crystal Relay before the profile cards below. -->
                        <Border HorizontalAlignment="Center"
                                Width="940"
                                Background="{DynamicResource PanelHighlightBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="22"
                                Padding="24">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate 'About Crystal Relay'}"
                                           Style="{StaticResource HeadingTextStyle}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"
                                           TextAlignment="Center" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{loc:Translate 'Crystal Relay is built to make Twitch-to-OSC control for VRChat easier to understand and easier to use.'}"
                                           FontSize="22"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0"
                                           Text="{loc:Translate 'Crystal Relay exists because too many Twitch-to-OSC tools felt harder to learn than they needed to be.'}"
                                           FontSize="18"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,22,0,0"
                              HorizontalAlignment="Center">
                            <!-- About profile area:
                                 creator card on the left, playtester cards on the right. -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="598" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource PanelHighlightBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Made By'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{loc:Translate 'Creator and main tester'}"
                                               FontSize="16"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <ContentControl Content="{Binding AboutCreatorProfile}"
                                                    ContentTemplate="{StaticResource AboutTwitchProfileTemplate}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource PanelSecondaryBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Playtesters'}"
                                               Style="{StaticResource HeadingTextStyle}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{loc:Translate 'These streamers help test Crystal Relay before updates go out.'}"
                                               FontSize="16"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding AboutTesterProfiles}"
                                                  Margin="0,6,0,0"
                                                  ItemTemplate="{StaticResource AboutTesterProfileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"
                                                           ItemWidth="274"
                                                           HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
            <Grid x:Name="AdvertisementOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="1000"
                  Background="#F2000000"
                  ClipToBounds="True"
                  Visibility="Collapsed">
                <MediaElement x:Name="AdvertisementMediaElement"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Manual"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              MediaEnded="OnAdvertisementMediaEnded"
                              MediaFailed="OnAdvertisementMediaFailed" />
            </Grid>
        </Grid>
    </Border>
</Window>
