                                                    </DockPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Width="62"
                                                    Height="62"
                                                    Margin="16,0,0,0"
                                                    VerticalAlignment="Top"
