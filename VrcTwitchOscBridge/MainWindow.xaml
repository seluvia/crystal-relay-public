                                                                Width="24"
                                                                Height="24"
                                                                MinWidth="24"
                                                                MinHeight="24"
                                                                Margin="8,0,0,0"
                                                                Click="OnHelpButtonClicked"
                                                                CommandParameter="Bot Device Code"
                                                                Tag="This code is only used during Twitch's device-link flow for your optional bot account. Open the Twitch page shown during login, sign in to the bot account you want Crystal Relay to use for chat replies, and paste this code exactly as shown. Crystal Relay finishes the connection automatically after Twitch accepts it." />
                                                    </DockPanel>
