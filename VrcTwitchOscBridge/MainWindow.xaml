                                                            <StackPanel Margin="0,10,0,0">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
