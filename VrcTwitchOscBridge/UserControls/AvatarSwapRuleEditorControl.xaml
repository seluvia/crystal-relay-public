<UserControl x:Class="VrcTwitchOscBridge.UserControls.AvatarSwapRuleEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VrcTwitchOscBridge.Services"
             xmlns:models="clr-namespace:VrcTwitchOscBridge.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Margin" Value="0,10,10,0" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HighlightBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="WrappingButtonContentTemplate">
            <TextBlock Text="{Binding}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </DataTemplate>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="RewardLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="ContentTemplate" Value="{StaticResource WrappingButtonContentTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="HelpIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Content" Value="?" />
            <Setter Property="ToolTip" Value="{loc:Translate 'Show help'}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HelpIconChrome"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HelpIconChrome" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HelpIconChrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HelpIconChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TwitchRewardOptionTemplate">
            <StackPanel>
                <TextBlock Text="{Binding DisplayLabel}"
                           Foreground="{DynamicResource ComboTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0"
                           Text="{Binding DetailText}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetailText}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="EditorHeadingTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadingTextStyle}">
            <Setter Property="Text" Value="Redeem Editor" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=True}" Value="True">
                    <Setter Property="Text" Value="{loc:Translate 'Redeem Editor'}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsViewingCashPayments, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                    <Setter Property="Text" Value="{loc:Translate 'Cash Payment Action'}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsViewingPowerUps, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                    <Setter Property="Text" Value="{loc:Translate 'Power Up Action'}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="SetTriggerActionTemplate" DataType="{x:Type models:SetTriggerAction}">
            <StackPanel>
                <TextBlock Text="{loc:Translate 'Selected Set Parameter'}"
                           Foreground="{DynamicResource TextBrush}"
                           FontWeight="SemiBold" />
                <UniformGrid Columns="2"
                             Margin="0,10,0,0">
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="{loc:Translate 'Avatar Parameter'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding DataContext.SetTriggerParameterOptions, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                  Margin="0,8,0,0"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="DisplayLabel"
                                  DisplayMemberPath="DisplayLabel"
                                  SelectedItem="{Binding DataContext.SelectedSetTriggerParameterOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{loc:Translate 'Copy Path'}"
                                    Command="{Binding DataContext.CopySelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{loc:Translate 'Paste Path'}"
                                    Command="{Binding DataContext.PasteSelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                        </WrapPanel>
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding DataContext.VrChatOscParameterStatus, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="14,0,0,0">
                        <TextBlock Text="{loc:Translate 'Value Type'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding DataContext.ParameterTypes, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                  SelectedItem="{Binding ParameterType, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </UniformGrid>
                <StackPanel Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Bool}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Translate 'When Triggered'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                              SelectedItem="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Int}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Translate 'When Triggered, Set To'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Float}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Translate 'When Triggered, Send This Value'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0"
                           Text="{loc:Translate 'Restore values come from the copied pre-trigger snapshot, not from a later VRChat file read.'}"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel LastChildFill="False">
            <TextBlock Style="{StaticResource EditorHeadingTextStyle}" />
            <Button Style="{StaticResource HelpIconButtonStyle}"
                    Click="OnHelpButtonClicked"
                    CommandParameter="Redeem Editor"
                    Tag="Use this editor to build the selected rule from top to bottom. Start with the Twitch trigger details, then choose the action Crystal Relay should send, then set how long it stays active, its cooldown, and any optional bot reply. The fields shown change based on the rule type, so avatar changes, Avatar Roulette, movement rules, and parameter rules only show the options they actually use." />
        </DockPanel>
        <WrapPanel Margin="0,14,0,0">
            <WrapPanel.Style>
                <Style TargetType="WrapPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsViewingPowerUps, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </WrapPanel.Style>
            <Button Style="{StaticResource SecondaryButtonStyle}"
                    Content="{loc:Translate 'Test Redeem'}"
                    Command="{Binding DataContext.TestSelectedRuleCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
        </WrapPanel>

        <Grid Margin="0,22,0,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsViewingCashPayments, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsViewingPowerUps, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Margin="0,0,14,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True" />
                                    <Condition Binding="{Binding UsesChannelPointReward}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsInAvatarSwapManager, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}" Value="True" />
                                    <Condition Binding="{Binding UsesChannelPointReward}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{loc:Translate 'Display Name'}"
                           Foreground="{DynamicResource TextBrush}"
                           FontWeight="SemiBold" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <Grid Margin="0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="3" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True" />
                                    <Condition Binding="{Binding UsesChannelPointReward}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Grid.Column" Value="2" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInAvatarSwapManager, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Translate 'Twitch Trigger'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding DataContext.AvailableOverrideTriggerTypesForSelectedRule, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                              SelectedItem="{Binding TriggerType, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{loc:Translate 'Twitch Trigger'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <Border Margin="0,6,0,0"
                            Padding="12,10"
                            CornerRadius="14"
                            Background="{DynamicResource StatusChipBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{loc:Translate 'Channel Points'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Margin="0,20,0,0"
                Background="{DynamicResource NestedPanelBrush}"
                BorderBrush="{DynamicResource HighlightBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsViewingCashPayments, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsViewingPowerUps, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="{loc:Translate 'Twitch Trigger Settings'}"
                           Foreground="{DynamicResource TextBrush}"
                           FontWeight="SemiBold"
                           FontSize="17" />

                <Border Margin="0,12,0,0"
                        Background="{DynamicResource PanelSecondaryBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UsesAvatarChange}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UsesAvatarRoulet}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UsesForceMovementBitsTrigger}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{loc:Translate 'Applies to VRChat Avatar'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right"
                                    Content="{loc:Translate 'Browse...'}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding DataContext.OpenAvatarPickerCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                    CommandParameter="Supporter" />
                            <TextBlock Text="{Binding SupporterAvatarDisplayName}"
                                       Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       TextWrapping="Wrap" />
                        </DockPanel>
                        <Button Margin="0,8,0,0"
                                Content="{loc:Translate 'Use Current Avatar'}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DataContext.UseCurrentAvatarForSupporterRuleCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{loc:Translate 'Choose the VRChat avatar this paid trigger belongs to. It only runs while you are wearing that avatar.'}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding UsesChannelPointReward, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{loc:Translate 'Twitch Redeem'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                Width="24"
                                Height="24"
                                MinWidth="24"
                                MinHeight="24"
                                Click="OnHelpButtonClicked"
                                CommandParameter="Twitch Redeem"
                                Tag="{Binding DataContext.ManagedChannelPointRewardHelpText, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                    </DockPanel>
                    <StackPanel Margin="0,8,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedSetTriggerUsesSharedNumberedReward, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Translate 'Reward Source'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding DataContext.RewardSyncModeOptions, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding RewardSyncMode, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.SelectedSetTriggerUsesSharedNumberedReward, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Translate 'Existing Twitch Reward'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding DataContext.RewardOptions, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                  ItemTemplate="{StaticResource TwitchRewardOptionTemplate}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ChannelPointRewardId, UpdateSourceTrigger=PropertyChanged}" />
                        <DockPanel Margin="0,8,0,0"
                                   LastChildFill="False">
                            <Button Style="{StaticResource RewardLinkButtonStyle}"
                                    Content="{loc:Translate 'Refresh Rewards'}"
                                    Command="{Binding DataContext.RefreshTwitchRewardsCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                            <Button Margin="8,0,0,0"
                                    Style="{StaticResource RewardLinkButtonStyle}"
                                    Content="{loc:Translate 'Unlink Reward'}"
                                    Command="{Binding DataContext.UnlinkTwitchRewardCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                    CommandParameter="{Binding}" />
                        </DockPanel>
                        <TextBlock Margin="0,6,0,0"
                                   Text="{loc:Translate 'Linked rewards are configured on Twitch. Crystal Relay only listens for this reward being redeemed and will not edit its name, cost, prompt, color, input settings, visibility, or cooldown.'}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <UniformGrid Columns="2"
                                  Margin="0,8,0,0">
                        <UniformGrid.Style>
                            <Style TargetType="UniformGrid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedSetTriggerUsesSharedNumberedReward, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </UniformGrid.Style>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{loc:Translate 'Reward Name'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding ChannelPointRewardTitle, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="14,0,0,0">
                            <TextBlock Text="{loc:Translate 'Reward Cost'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding ChannelPointRewardCost, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedSetTriggerUsesSharedNumberedReward, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Translate 'Reward Description'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <TextBox Text="{Binding ChannelPointRewardDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 Height="70"
                                 TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{loc:Translate 'Shown on Twitch as the reward description. Leave blank to use the Crystal Relay default.'}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsViewingMovementRedeems, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Translate 'Reward Cooldown (seconds)'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <TextBox MaxWidth="220"
                                 HorizontalAlignment="Left"
                                 Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{loc:Translate 'Movement reward cooldown only controls the Twitch channel-point reward cooldown. Active Time still controls how long Crystal Relay holds the movement input.'}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Margin="0,12,0,0"
                            Background="{DynamicResource PanelSecondaryBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsesSetTrigger}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <CheckBox IsChecked="{Binding SharedRewardChoiceEnabled, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock Text="{loc:Translate 'Use shared numbered reward'}"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <TextBlock Margin="26,6,0,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Translate 'Rules with the same reward name become one Twitch reward. Viewers type the choice number in the redeem input.'}" />
                                <UniformGrid Columns="2"
                                             Margin="0,12,0,0">
                                    <UniformGrid.Style>
                                        <Style TargetType="UniformGrid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SharedRewardChoiceEnabled}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </UniformGrid.Style>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{loc:Translate 'Choice number'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SharedRewardChoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock Text="{loc:Translate 'Choice label'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SharedRewardHelpText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding UsesSetTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{loc:Translate 'Outfit Choice'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="{loc:Translate 'Shared mode uses this outfit number in the master reward input. Separate mode keeps the number for organization. Crystal Relay snapshots safe outfit values before changing parameters and restores them after Active Time.'}" />
                                <UniformGrid Columns="2"
                                             Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{loc:Translate 'Outfit number'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SharedRewardChoiceNumber, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock Text="{loc:Translate 'Outfit name'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SharedRewardHelpText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0"
                            Background="{DynamicResource PanelSecondaryBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedSetTriggerUsesSharedNumberedReward, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <CheckBox IsChecked="{Binding DeleteManagedRewardWhenInactive, UpdateSourceTrigger=PropertyChanged}">
                                <TextBlock Text="{loc:Translate 'Delete Twitch reward when inactive'}"
                                           TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Margin="26,6,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="{loc:Translate 'Frees Twitch reward slots. Crystal Relay will recreate or relink this reward when it becomes active again.'}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,12,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedSetTriggerUsesSharedNumberedReward, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Translate 'Managed Reward Colors'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding DataContext.ManagedRewardColorsDescriptionText, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="{loc:Translate 'Ready Color'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" />
                            <DockPanel Margin="0,6,0,0"
                                       LastChildFill="False">
                                <Border Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        Background="{Binding ManagedRewardReadyColorBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1" />
                                <TextBlock Margin="12,0,16,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold"
                                           Text="{Binding ManagedRewardReadyColor}" />
                                <Button Content="{loc:Translate 'Choose Color'}"
                                        Padding="16,6"
                                        MinWidth="132"
                                        Click="OnPickManagedRewardColorClicked"
                                        Tag="Ready" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{loc:Translate 'Cooldown Color'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" />
                            <DockPanel Margin="0,6,0,0"
                                       LastChildFill="False">
                                <Border Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        Background="{Binding ManagedRewardCooldownColorBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1" />
                                <TextBlock Margin="12,0,16,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold"
                                           Text="{Binding ManagedRewardCooldownColor}" />
                                <Button Content="{loc:Translate 'Choose Color'}"
                                        Padding="16,6"
                                        MinWidth="132"
                                        Click="OnPickManagedRewardColorClicked"
                                        Tag="Cooldown" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Margin="0,12,0,0"
                        Background="{DynamicResource PanelSecondaryBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UsesBitsOutfitSetTrigger}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{loc:Translate 'Bits Outfit Trigger'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Translate 'Viewers cheer at least the minimum bits and type this outfit name in the cheer message. Capitalization, spaces, punctuation, and small spelling mistakes are okay, but unclear names will not trigger. Bits outfit triggers use the same safe Set Trigger snapshot and restore flow.'}" />
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{loc:Translate 'Outfit name'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding SharedRewardHelpText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Background="{DynamicResource PanelSecondaryBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UsesForceMovementBitsTrigger}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{loc:Translate 'Force Movement Word Trigger'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Translate 'Viewers cheer at least the minimum bits and type this word in the cheer message. Capitalization, spaces, punctuation, and small spelling mistakes are okay, but unclear words will not trigger.'}" />
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{loc:Translate 'Word Trigger'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding SupporterKeywordText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Margin="0,10,0,0"
                            Visibility="{Binding UsesAmountThreshold, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{loc:Translate 'Minimum Amount'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsesBitsOutfitSetTrigger}" Value="True">
                                            <Setter Property="Text" Value="{loc:Translate 'Minimum Bits'}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UsesForceMovementBitsTrigger}" Value="True">
                                            <Setter Property="Text" Value="{loc:Translate 'Minimum Bits'}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                Width="24"
                                Height="24"
                                MinWidth="24"
                                MinHeight="24"
                                Click="OnHelpButtonClicked"
                                CommandParameter="Minimum Amount"
                                Tag="This setting is only for bits and subscriptions overrides. For bits, it is the minimum number of bits needed in one cheer event. For subs, it is the minimum number of subscriptions or gift subs the event must include before Crystal Relay runs the rule. Paid overrides ignore avatar matching and can fire no matter which avatar you are using." />
                    </DockPanel>
                    <TextBox Text="{Binding MinimumAmount, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding UsesSupporterAmountTimerSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{loc:Translate 'Bits/Subs Amount Timer'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                Width="24"
                                Height="24"
                                MinWidth="24"
                                MinHeight="24"
                                Click="OnHelpButtonClicked"
                                CommandParameter="Bits/Subs Amount Timer"
                                Tag="{loc:Translate 'When enabled, every matching Bits or Subs trigger extends the current timer by Active Time + the scaled amount from separate Bits and Subs ratios. Bits use the bit count, normal subs count as 1, and gift subs use the gift total.'}" />
                    </DockPanel>
                    <CheckBox Margin="0,8,0,0"
                              Content="{loc:Translate 'Add amount to active time'}"
                              IsChecked="{Binding AmountScaledDurationEnabled, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="{loc:Translate 'When enabled, Crystal Relay starts this paid override with Active Time, then adds time from separate Bits and Subs ratios. Bits use the bit count, normal subs count as 1, and gift subs use the gift total. Later same-rule events extend the running timer by the amount only.'}" />
                    <Button Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{loc:Translate 'Configure Added Time...'}"
                            Command="{Binding DataContext.OpenSupporterOverrideTimeSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding SupporterTimeSettingsSummary}" />
                </StackPanel>

                <StackPanel Margin="0,14,0,0">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{loc:Translate 'Chat Command Fallback'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                Width="24"
                                Height="24"
                                MinWidth="24"
                                MinHeight="24"
                                Click="OnHelpButtonClicked"
                                CommandParameter="Chat Command Fallback"
                                Tag="{Binding DataContext.ChatCommandFallbackHelpText, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                    </DockPanel>
                    <CheckBox Margin="0,8,0,0"
                              Content="{loc:Translate 'Enable chat command fallback'}"
                              IsChecked="{Binding ChatCommandEnabled, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ChatCommandEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{loc:Translate 'Exact Command'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Text="{Binding ChatCommandText}" />
                            </StackPanel>
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock Text="{loc:Translate 'Who Can Use It'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding DataContext.ChatCommandPermissionOptions, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding ChatCommandPermission, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Margin="0,10,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="{loc:Translate 'Crystal Relay matches the whole chat message exactly. Example: !wave'}" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </Border>

        <Border Margin="0,20,0,0"
                Background="{DynamicResource NestedPanelBrush}"
                BorderBrush="{DynamicResource HighlightBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16">
            <StackPanel>
                <TextBlock Text="{loc:Translate 'OSC Action'}"
                           Foreground="{DynamicResource TextBrush}"
                           FontWeight="SemiBold"
                           FontSize="17" />
                <TextBlock Margin="0,10,0,0"
                           Text="{loc:Translate 'Action Type'}"
                           Foreground="{DynamicResource TextBrush}"
                           FontWeight="SemiBold" />
                <Border Margin="0,8,0,0"
                        Padding="14,10"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SharedRewardChoiceEnabled}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{loc:Translate 'Avatar Parameter'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                </Border>
                <Border Margin="0,8,0,0"
                        Padding="14,10"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{loc:Translate 'Avatar Change'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                </Border>
                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding UsesAvatarChange, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Translate 'Return Behavior'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <RadioButton Margin="0,6,0,0"
                                 GroupName="AvatarReturnMode"
                                 IsChecked="{Binding IsReturnToGlobal}"
                                 Content="{loc:Translate 'Return to Global Return Avatar'}"
                                 Foreground="{DynamicResource TextBrush}" />
                    <RadioButton Margin="0,4,0,0"
                                 GroupName="AvatarReturnMode"
                                 IsChecked="{Binding IsReturnToPrevious}"
                                 Content="{loc:Translate 'Return to Previous Avatar'}"
                                 Foreground="{DynamicResource TextBrush}" />
                    <RadioButton Margin="0,4,0,0"
                                 GroupName="AvatarReturnMode"
                                 IsChecked="{Binding IsPermanent}"
                                 Content="{loc:Translate 'Permanent No Return'}"
                                 Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{loc:Translate 'Will return to the avatar you were wearing before this swap'}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsReturnToPrevious, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <Border Margin="0,8,0,0"
                        Padding="14,10"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsViewingMovementRedeems, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{loc:Translate 'Player Movement'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                </Border>
                <ComboBox ItemsSource="{Binding DataContext.AvailableActionTypesForSelectedContext, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                          Margin="0,8,0,0"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding DataContext.SelectedActionTypeOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue={x:Null}}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsViewingSupporterOverrides, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsViewingCashPayments, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.IsViewingPowerUps, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding DataContext.IsViewingAvatarTriggers, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True" />
                                        <Condition Binding="{Binding SharedRewardChoiceEnabled}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding UsesPlayerMovement, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{loc:Translate 'Movement Action'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                Width="24"
                                Height="24"
                                MinWidth="24"
                                MinHeight="24"
                                Click="OnHelpButtonClicked"
                                CommandParameter="Movement Action"
                                Tag="{loc:Translate 'Choose which VRChat movement input Crystal Relay should send for this rule. Random Movement rolls one direction per use. Glitchy Movement keeps rolling random directions until Active Time ends.'}" />
                    </DockPanel>
                    <ComboBox ItemsSource="{Binding DataContext.MovementDirections, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding MovementDirection, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding UsesAvatarParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{loc:Translate 'Value Type'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                Width="24"
                                Height="24"
                                MinWidth="24"
                                MinHeight="24"
                                Click="OnHelpButtonClicked"
                                CommandParameter="Value Type"
                                Tag="Pick the kind of VRChat parameter value this redeem should send. Bool means simple on or off values like True and False. Int means whole numbers only, like 0, 1, or 2. Float means decimal numbers, like 0.0, 0.5, or 1.0. When you switch this type, Crystal Relay resets the value boxes so they match the type you chose." />
                    </DockPanel>
                    <ComboBox ItemsSource="{Binding DataContext.ParameterTypes, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                              SelectedItem="{Binding ParameterType, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{loc:Translate 'Avatar Parameter'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding DataContext.AvatarParameterOptions, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                              Margin="0,8,0,0"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              TextSearch.TextPath="DisplayLabel"
                              DisplayMemberPath="DisplayLabel"
                              SelectedItem="{Binding DataContext.SelectedAvatarParameterOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue={x:Null}}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{loc:Translate 'Copy Path'}"
                                Command="{Binding DataContext.CopySelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{loc:Translate 'Paste Path'}"
                                Command="{Binding DataContext.PasteSelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                    </WrapPanel>
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding DataContext.VrChatOscParameterStatus, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />

                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding UsesFloatParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{loc:Translate 'Float Input Mode'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding DataContext.FloatValueModes, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                  SelectedItem="{Binding FloatValueMode, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding FloatValueModeHelpText}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding UsesFloatParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{loc:Translate 'Transition In (seconds)'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding FloatTransitionInSeconds, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="{loc:Translate 'Transition Out (seconds)'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding FloatTransitionOutSeconds, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Margin="0,6,0,0"
                                       Text="{loc:Translate '0 = snap instantly. Higher values glide the value smoothly to and from the target.'}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding UsesFloatTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{loc:Translate 'Active Boost Reward...'}"
                                    Command="{Binding DataContext.OpenActiveFloatBoostRewardCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding ActiveFloatBoostRewardStatusText}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding UsesSupporterFloatAdd, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{loc:Translate 'Bits/Subs Add'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                        Width="24"
                                        Height="24"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Click="OnHelpButtonClicked"
                                        CommandParameter="Bits/Subs Add"
                                        Tag="{loc:Translate 'Each matching Bits/Subs event adds to the current value, restarts the timer, and stops at your max value.'}" />
                            </DockPanel>
                            <CheckBox Margin="0,8,0,0"
                                      Content="{loc:Translate 'Add on top of the current value'}"
                                      IsChecked="{Binding SupporterFloatAddEnabled, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding SupporterFloatAddSummary}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding UsesActiveSupporterFloatAdd, Converter={StaticResource BoolToVisibilityConverter}}">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{loc:Translate 'Start Value'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SupporterFloatAddMinimumValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{loc:Translate 'Max Value'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SupporterFloatAddMaximumValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <DockPanel Margin="0,12,0,0"
                                           LastChildFill="False">
                                    <TextBlock Text="{loc:Translate 'Rules'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="{loc:Translate 'Add Rule'}"
                                            Click="OnAddSupporterFloatAddRangeClicked" />
                                </DockPanel>
                                <ItemsControl Margin="0,8,0,0"
                                              ItemsSource="{Binding SupporterFloatAddRanges}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SupporterFloatAddRange}">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0"
                                                            Margin="0,0,6,0">
                                                    <TextBlock Text="{loc:Translate 'From'}"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                    <TextBox Text="{Binding MinimumAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1"
                                                            Margin="6,0,6,0">
                                                    <TextBlock Text="{loc:Translate 'To'}"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                    <TextBox Text="{Binding MaximumAmount, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Margin="6,0,6,0">
                                                    <TextBlock Text="{loc:Translate 'Add'}"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                    <TextBox Text="{Binding AddValue, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <Button Grid.Column="3"
                                                        Margin="6,18,0,0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="{loc:Translate 'Remove'}"
                                                        Click="OnRemoveSupporterFloatAddRangeClicked" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,2,0,0"
                                           Text="{loc:Translate 'Use 0 in To for no limit.'}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>

                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding UsesBoolParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Visibility="{Binding UsesBoolToggleHint, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{loc:Translate 'Instant Bool Toggle'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                        Width="24"
                                        Height="24"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Click="OnHelpButtonClicked"
                                        CommandParameter="Instant Bool Toggle"
                                        Tag="When Active Time is 0, this bool rule becomes a toggle instead of a timed hold. Each use flips the current VRChat bool parameter from off to on or from on to off. Use a timed Active Time above 0 when you want Crystal Relay to turn it on first and reset it later." />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding UsesBoolTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                            <UniformGrid Columns="2"
                                         Margin="0,12,0,0">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{loc:Translate 'When Triggered'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                              SelectedItem="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="{loc:Translate 'After Active Time Ends'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                              SelectedItem="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding UsesIntParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Visibility="{Binding UsesIntInstantModeOptions, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{loc:Translate 'Instant Int Action'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <Button Style="{StaticResource HelpIconButtonStyle}"
                                        Width="24"
                                        Height="24"
                                        MinWidth="24"
                                        MinHeight="24"
                                        Click="OnHelpButtonClicked"
                                        CommandParameter="Instant Int Action"
                                        Tag="{Binding IntModeHelpText}" />
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding DataContext.IntZeroDurationModes, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                      SelectedItem="{Binding IntZeroDurationMode, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding UsesIntFixedInstantValue, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{loc:Translate 'Send This Number'}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding UsesIntRangeInputs, Converter={StaticResource BoolToVisibilityConverter}}">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{loc:Translate 'Minimum Number'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding RangeMinimum, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="14,0,0,0">
                                        <TextBlock Text="{loc:Translate 'Maximum Number'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding RangeMaximum, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding UsesIntTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{loc:Translate 'When Triggered, Set To'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="{loc:Translate 'After Active Time Ends, Set Back To'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding UsesTextOrFloatParameter, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Visibility="{Binding UsesDirectInstantValue, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{loc:Translate 'Send This Value'}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold" />
                            <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding UsesDirectTimedValues, Converter={StaticResource BoolToVisibilityConverter}}">
                            <UniformGrid Columns="2" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{loc:Translate 'When Triggered, Send This Value'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="{loc:Translate 'After Active Time Ends, Send This Value'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBox Text="{Binding ResetValue, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        <Border Background="{DynamicResource NestedPanelBrush}" CornerRadius="4" Padding="10" Margin="0,4,0,4"
                                Visibility="{Binding UsesFloatActionMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate 'FloatActionModeHeader'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding FloatActionMode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{loc:Translate 'FloatActionModeSet'}" Tag="{x:Static models:FloatActionMode.Set}" />
                                    <ComboBoxItem Content="{loc:Translate 'FloatActionModeRandom'}" Tag="{x:Static models:FloatActionMode.Random}" />
                                    <ComboBoxItem Content="{loc:Translate 'FloatActionModeAdd'}" Tag="{x:Static models:FloatActionMode.Add}" />
                                    <ComboBoxItem Content="{loc:Translate 'FloatActionModeSubtract'}" Tag="{x:Static models:FloatActionMode.Subtract}" />
                                    <ComboBoxItem Content="{loc:Translate 'FloatActionModeAddSubtract'}" Tag="{x:Static models:FloatActionMode.AddSubtract}" />
                                    <ComboBoxItem Content="{loc:Translate 'FloatActionModeMultiply'}" Tag="{x:Static models:FloatActionMode.Multiply}" />
                                    <ComboBoxItem Content="{loc:Translate 'FloatActionModeToggle'}" Tag="{x:Static models:FloatActionMode.Toggle}" />
                                    <ComboBoxItem Content="{loc:Translate 'FloatActionModeCycle'}" Tag="{x:Static models:FloatActionMode.Cycle}" />
                                    <ComboBoxItem Content="{loc:Translate 'FloatActionModeGlitchy'}" Tag="{x:Static models:FloatActionMode.Glitchy}" />
                                    <ComboBoxItem Content="{loc:Translate 'FloatActionModePulse'}" Tag="{x:Static models:FloatActionMode.Pulse}" />
                                </ComboBox>

                                <Grid Margin="0,6,0,0" Visibility="{Binding UsesFloatRangeInputs, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Translate 'FloatActionModeRangeMin'}" />
                                        <TextBox Text="{Binding FloatRangeMin, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Translate 'FloatActionModeRangeMax'}" />
                                        <TextBox Text="{Binding FloatRangeMax, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatCycleStep, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Translate 'FloatActionModeCycleStep'}" />
                                    <TextBox Text="{Binding FloatCycleStep, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatAddMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Translate 'FloatActionModeAddAmount'}" />
                                    <TextBox Text="{Binding FloatAddAmount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatSubtractMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Translate 'FloatActionModeSubtractAmount'}" />
                                    <TextBox Text="{Binding FloatSubtractAmount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatAddSubtractMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Translate 'FloatActionModeAddSubtractValue'}" />
                                    <TextBox Text="{Binding FloatAddSubtractAmount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatMultiplyMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Translate 'FloatActionModeMultiplyFactor'}" />
                                    <TextBox Text="{Binding FloatMultiplyFactor, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Grid Margin="0,6,0,0" Visibility="{Binding UsesFloatToggleValues, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Translate 'FloatActionModeToggleOn'}" />
                                        <TextBox Text="{Binding FloatToggleOnValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{loc:Translate 'FloatActionModeToggleOff'}" />
                                        <TextBox Text="{Binding FloatToggleOffValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatGlitchyInterval, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Translate 'FloatActionModeGlitchyInterval'}" />
                                    <TextBox Text="{Binding FloatGlitchyIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatPulseSeconds, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Translate 'FloatActionModePulseSeconds'}" />
                                    <TextBox Text="{Binding FloatPulseSeconds, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Margin="0,6,0,0" Visibility="{Binding UsesFloatClampMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Translate 'FloatActionModeClampLabel'}" />
                                    <ComboBox SelectedValue="{Binding FloatClampMode}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{loc:Translate 'FloatActionModeClampNone'}" Tag="{x:Static models:FloatClampMode.None}" />
                                        <ComboBoxItem Content="{loc:Translate 'FloatActionModeClampZeroToOne'}" Tag="{x:Static models:FloatClampMode.ZeroToOne}" />
                                        <ComboBoxItem Content="{loc:Translate 'FloatActionModeClampMinToMax'}" Tag="{x:Static models:FloatClampMode.MinToMax}" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding UsesSetTrigger, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{loc:Translate 'Outfit Parameters'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{loc:Translate 'Add bool, int, or float parameters that should change together. Crystal Relay snapshots safe LocalAvatarData values before sending, waits 70 seconds when needed to learn what changed, then restores changed parameters from the copied pre-trigger snapshot after Active Time.'}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" />
                    <Border Margin="0,10,0,0"
                            Padding="12,10"
                            Background="{DynamicResource DangerBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Warning: Set Trigger restore uses delayed VRChat avatar data'}"
                                       Foreground="#FFFFD6E2"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{loc:Translate 'After manually changing outfit toggles or parameters in VRChat, wait at least 70 seconds before testing or redeeming a Set Trigger. Crystal Relay uses LocalAvatarData snapshots and diffs for safe restore, and triggering before VRChat updates that file can restore the wrong outfit values.'}"
                                       Foreground="#FFFFEEF4"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,10,0,0">
                        <CheckBox IsChecked="{Binding SetTriggerAutoRestoreRelatedOutfitParameters, UpdateSourceTrigger=PropertyChanged}">
                            <TextBlock Text="{loc:Translate 'Also restore related outfit toggles'}"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Margin="26,6,0,0"
                                   Text="{Binding SetTriggerRestoreModeSummary}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="26,6,0,0"
                                   Text="{loc:Translate 'This outfit is using the legacy full safe diff restore from an older save. Change the checkbox above to move it to the new outfit restore mode.'}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsesLegacySetTriggerFullDiffRestore}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{loc:Translate 'Add Set Parameter'}"
                                Command="{Binding DataContext.AddSetTriggerActionCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="{loc:Translate 'Delete Set Parameter'}"
                                Command="{Binding DataContext.RemoveSelectedSetTriggerActionCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                    </WrapPanel>
                    <ListBox Margin="0,10,0,0"
                             MaxHeight="130"
                             ItemsSource="{Binding SetTriggerActions}"
                             SelectedItem="{Binding DataContext.SelectedSetTriggerAction, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, FallbackValue={x:Null}}"
                             DisplayMemberPath="DisplaySummary"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" />
                    <ContentControl Margin="0,12,0,0"
                                    Content="{Binding DataContext.SelectedSetTriggerAction, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedSetTriggerAction, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type models:SetTriggerAction}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Selected Set Parameter'}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontWeight="SemiBold" />
                                    <UniformGrid Columns="2"
                                                 Margin="0,10,0,0">
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="{loc:Translate 'Avatar Parameter'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding DataContext.SetTriggerParameterOptions, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                                      Margin="0,8,0,0"
                                                      IsTextSearchEnabled="True"
                                                      TextSearch.TextPath="DisplayLabel"
                                                      DisplayMemberPath="DisplayLabel"
                                                      SelectedItem="{Binding DataContext.SelectedSetTriggerParameterOption, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue={x:Null}}" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="{loc:Translate 'Copy Path'}"
                                                        Command="{Binding DataContext.CopySelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="{loc:Translate 'Paste Path'}"
                                                        Command="{Binding DataContext.PasteSelectedAvatarParameterPathCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                                            </WrapPanel>
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding DataContext.VrChatOscParameterStatus, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Margin="14,0,0,0">
                                            <TextBlock Text="{loc:Translate 'Value Type'}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding DataContext.ParameterTypes, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                                      SelectedItem="{Binding ParameterType, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <StackPanel Margin="0,12,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Bool}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{loc:Translate 'When Triggered'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding DataContext.BoolValueOptions, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}"
                                                  SelectedItem="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,12,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Int}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{loc:Translate 'When Triggered, Set To'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,12,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ParameterType}" Value="{x:Static models:OscParameterType.Float}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{loc:Translate 'When Triggered, Send This Value'}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding ParameterValue, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{loc:Translate 'Restore values come from the copied pre-trigger snapshot, not from a later VRChat file read.'}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding UsesAvatarRoulet, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="{loc:Translate 'Avatar Roulette Pool'}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold" />
                        <Button Style="{StaticResource HelpIconButtonStyle}"
                                Width="24"
                                Height="24"
                                MinWidth="24"
                                MinHeight="24"
                                Click="OnHelpButtonClicked"
                                CommandParameter="Avatar Roulette Pool"
                                Tag="Choose the pool of avatars this Avatar Roulette rule is allowed to roll from. When the rule fires, Crystal Relay randomly picks one avatar from this pool, switches to it as a temporary avatar, then returns to the shared return avatar when the Active Time ends. The roulette rule does not rewrite your shared return avatar." />
                    </DockPanel>
                    <Button Margin="0,8,0,0"
                            Content="{loc:Translate 'Pick Avatar Roulette Pool'}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DataContext.OpenAvatarRouletPoolPickerCommand, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue={x:Null}}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold"
                               Text="{Binding AvatarRouletPoolSummary}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"
                               Text="{loc:Translate 'Avatar Roulette always stays temporary. It rolls from the selected pool, then uses the shared return avatar for the switch back without rewriting it.'}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <UniformGrid Columns="2" Margin="0,20,0,0">
            <StackPanel Margin="0,0,14,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding UsesAvatarChange}" Value="True" />
                                    <Condition Binding="{Binding DataContext.Settings.AvatarChangeCooldownOnlyModeEnabled, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding IsPermanent}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{loc:Translate 'Active Time (seconds)'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <Button Style="{StaticResource HelpIconButtonStyle}"
                            Width="24"
                            Height="24"
                            MinWidth="24"
                            MinHeight="24"
                            Click="OnHelpButtonClicked"
                            CommandParameter="Active Time"
                            Tag="{Binding DurationHelpText}" />
                </DockPanel>
                <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="{loc:Translate 'Amount-scaled timer is enabled, so Active Time is the starting time before Bits/Subs added time extends the override.'}"
                           Visibility="{Binding UsesAmountScaledDuration, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <StackPanel Margin="14,0,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UsesCooldown}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding UsesSetTrigger}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding UsesLinkedExistingReward}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="{loc:Translate 'Cooldown (seconds)'}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" />
                    <Button Style="{StaticResource HelpIconButtonStyle}"
                            Width="24"
                            Height="24"
                            MinWidth="24"
                            MinHeight="24"
                            Click="OnHelpButtonClicked"
                            CommandParameter="Cooldown"
                            Tag="Cooldown is the wait time before the same rule can trigger again. Crystal Relay uses it locally to block repeats, and for managed channel point redeems it also syncs the same cooldown back to Twitch. Avatar Roulette also keeps avatar-switch redeems disabled for its cooldown window." />
                </DockPanel>
                <TextBox Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </UniformGrid>

        <DockPanel Margin="0,20,0,0"
                   LastChildFill="False">
            <TextBlock Text="{loc:Translate 'Bot Message'}"
                       Foreground="{DynamicResource TextBrush}"
                       FontWeight="SemiBold" />
            <Button Style="{StaticResource HelpIconButtonStyle}"
                    Width="24"
                    Height="24"
                    MinWidth="24"
                    MinHeight="24"
                    Click="OnHelpButtonClicked"
                    CommandParameter="Bot Message"
                    Tag="This is an optional chat reply sent by your connected bot account after the rule fires. Use it for confirmations, jokes, or quick status messages. Placeholders like {user}, {reward}, {duration}, and {value} are filled in from the trigger that just ran." />
        </DockPanel>
        <TextBox Text="{Binding BotMessageTemplate, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 Height="100"
                 TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
