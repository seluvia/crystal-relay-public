<UserControl x:Class="VrcTwitchOscBridge.UserControls.InlineRuleEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VrcTwitchOscBridge.Services"
             xmlns:uc="clr-namespace:VrcTwitchOscBridge.UserControls"
             xmlns:models="clr-namespace:VrcTwitchOscBridge.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <uc:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <uc:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource ComboDropButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DropButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="0,8,8,0">
                            <Path x:Name="DropArrow"
                                  Width="11" Height="7" Stretch="Fill"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M 0 0 L 5.5 6 L 11 0"
                                  Stroke="{DynamicResource TitleBarTextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DropButtonBorder" Property="Background" Value="{DynamicResource ComboDropButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropButtonBorder" Property="Opacity" Value="0.55" />
                                <Setter TargetName="DropArrow" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboPopupTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboPopupThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ComboPopupThumbBorder"
                                Width="8" HorizontalAlignment="Center"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboPopupThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ComboPopupThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ComboPopupVerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="{TemplateBinding Width}" Background="Transparent">
                <Border Width="8" HorizontalAlignment="Center" Margin="0,2"
                        Background="{DynamicResource ScrollTrackBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" />
                <Track x:Name="PART_Track" Margin="0,2" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}" Command="{x:Static ScrollBar.PageUpCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ComboPopupThumbStyle}" MinHeight="30" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}" Command="{x:Static ScrollBar.PageDownCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ComboPopupHorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="{TemplateBinding Height}" Background="Transparent">
                <Border Height="8" VerticalAlignment="Center" Margin="2,0"
                        Background="{DynamicResource ScrollTrackBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" />
                <Track x:Name="PART_Track" Margin="2,0">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}" Command="{x:Static ScrollBar.PageLeftCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ComboPopupThumbStyle}" MinWidth="30" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ComboPopupTrackButtonStyle}" Command="{x:Static ScrollBar.PageRightCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style x:Key="ComboPopupScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource ComboPopupVerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template" Value="{StaticResource ComboPopupHorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
                                        </Style>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      Margin="10,0,4,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{DynamicResource TitleBarTextBrush}"
                                                      IsHitTestVisible="False" />
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Margin="10,0,4,0"
                                             Foreground="{DynamicResource TitleBarTextBrush}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Visibility="Hidden"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" />
                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Style="{StaticResource ComboBoxToggleButtonStyle}" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Background="{DynamicResource InputBrush}">
                                    <Border Margin="0,4,0,0"
                                            Padding="4"
                                            Background="{DynamicResource InputBrush}"
                                            TextElement.Foreground="{DynamicResource TitleBarTextBrush}"
                                            BorderBrush="{DynamicResource PopupBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ScrollViewer.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ComboPopupScrollBarStyle}" />
                                            </ScrollViewer.Resources>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Margin="0,2,0,2"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <Border.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
                                </Style>
                            </Border.Resources>
                            <ContentPresenter TextElement.Foreground="{DynamicResource TitleBarTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboHighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ComboHighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TwitchPowerUpOptionTemplate">
            <StackPanel>
                <TextBlock Text="{Binding DisplayLabel}"
                           Foreground="{DynamicResource ComboTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0"
                           Text="{Binding DetailText}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="Collapsed">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDetailText}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Button Content="← Back"
                    Command="{Binding DataContext.BackToListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,12" />

            <TextBlock Text="Edit Trigger" Style="{StaticResource HeadingTextStyle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />

            <UniformGrid Columns="2" Margin="0,0,0,10">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{loc:Translate 'Name'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBox Text="{Binding Rule.Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="{loc:Translate 'Trigger Type'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Rule.TriggerType}" Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </UniformGrid>

            <StackPanel Margin="0,8,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rule.TriggerType}" Value="ChatCommand">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{DynamicResource NestedPanelBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate 'Chat Command'}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{loc:Translate 'Exact Command'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding Rule.ChatCommandText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="{loc:Translate 'Who Can Use It'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                <ComboBox ItemsSource="{Binding DataContext.ChatCommandPermissionOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Rule.ChatCommandPermission, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{loc:Translate 'Crystal Relay matches the whole chat message exactly. Example: !wave'}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                   FontStyle="Italic" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Channel Points reward config -->
            <StackPanel Margin="0,8,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rule.TriggerType}" Value="ChannelPoints">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{DynamicResource NestedPanelBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate 'Twitch Reward'}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Margin="0,0,0,6">
                            <RadioButton GroupName="SyncMode" Content="{loc:Translate 'Create or Manage'}"
                                         IsChecked="{Binding Rule.RewardSyncMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CreateOrManage}"
                                         Foreground="{DynamicResource TextBrush}" />
                            <RadioButton GroupName="SyncMode" Content="{loc:Translate 'Link Existing'}"
                                         IsChecked="{Binding Rule.RewardSyncMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=LinkExisting}"
                                         Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding Rule.RewardSyncMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CreateOrManage, FallbackValue=Visible}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate 'Reward Cost'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding Rule.ChannelPointRewardCost, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding Rule.RewardSyncMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=LinkExisting, FallbackValue=Collapsed}">
                            <TextBlock Text="{loc:Translate 'Existing Twitch Reward'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,2" />
                            <ComboBox ItemsSource="{Binding DataContext.TwitchRewardOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedValuePath="Id" DisplayMemberPath="Title"
                                      SelectedValue="{Binding Rule.ChannelPointRewardId, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{loc:Translate 'Refresh Rewards'}" Command="{Binding DataContext.RefreshTwitchRewardsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                                <Button Content="{loc:Translate 'Unlink Reward'}" Command="{Binding DataContext.UnlinkTwitchRewardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Rule}" Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding Rule.DeleteManagedRewardWhenInactive}" Content="{loc:Translate 'Free Twitch reward slots when inactive'}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Power Up trigger fields -->
            <StackPanel Margin="0,8,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rule.TriggerType}" Value="PowerUp">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{DynamicResource NestedPanelBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:Translate 'Twitch Custom Power-up'}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Translate 'Existing Twitch Power Up'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                        <ComboBox ItemsSource="{Binding DataContext.PowerUpOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  ItemTemplate="{StaticResource TwitchPowerUpOptionTemplate}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Rule.PowerUpId, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{loc:Translate 'Refresh Power Ups'}" Command="{Binding DataContext.RefreshTwitchRewardsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0"
                                   Text="{loc:Translate 'Safe beta links existing Twitch Custom Power-ups only. Create, edit, hide, and reprice controls stay unavailable until Twitch documents write APIs.'}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   TextWrapping="Wrap" FontSize="10" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Ready/Cooldown color fields (Channel Points only) -->
            <StackPanel Margin="0,8,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rule.TriggerType}" Value="ChannelPoints">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{DynamicResource NestedPanelBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Cooldown Colors" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{loc:Translate 'Ready Color'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                            <DockPanel LastChildFill="False">
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="{Binding Rule.ManagedRewardReadyColorBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                        Margin="0,0,8,0" />
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                           Text="{Binding Rule.ManagedRewardReadyColor}" Margin="0,0,12,0" />
                                <Button Content="{loc:Translate 'Choose Color'}" Padding="12,4"
                                        MinWidth="100" Click="OnPickReadyColorClicked"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{loc:Translate 'Cooldown Color'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                            <DockPanel LastChildFill="False">
                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="{Binding Rule.ManagedRewardCooldownColorBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                        Margin="0,0,8,0" />
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                           Text="{Binding Rule.ManagedRewardCooldownColor}" Margin="0,0,12,0" />
                                <Button Content="{loc:Translate 'Choose Color'}" Padding="12,4"
                                        MinWidth="100" Click="OnPickCooldownColorClicked"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Bits-specific fields -->
            <StackPanel Margin="0,8,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rule.TriggerType}" Value="Bits">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{DynamicResource NestedPanelBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Bits Settings" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox Content="{loc:Translate 'Add bits time to swap'}"
                                  IsChecked="{Binding Rule.AddBitsToSwapTime, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,8" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{loc:Translate 'Minimum Amount'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                <TextBox Text="{Binding Rule.MinimumAmount, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0"
                                        Visibility="{Binding Rule.AddBitsToSwapTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,4,0">
                                        <TextBlock Text="{loc:Translate 'Bits'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding Rule.BitsAmountUnitsPerDuration, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock Text="{loc:Translate 'Seconds'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                        <TextBox Text="{Binding Rule.BitsSecondsPerAmountUnit, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{loc:Translate 'Every X bits = Y seconds'}"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                           FontStyle="Italic" Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                        <CheckBox IsChecked="{Binding Profile.BitsMaxSwapTimeEnabled}" Content="{loc:Translate 'Cap max accumulated duration'}" Margin="0,8,0,0" />
                        <CheckBox IsChecked="{Binding Rule.BitsKeywordEnabled}"
                                  Content="{loc:Translate 'Require chat keyword'}"
                                  Margin="0,8,0,0" />
                        <TextBlock Text="Chat keyword" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,2" />
                        <TextBox Text="{Binding Rule.SupporterKeywordText, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Rule.BitsKeywordEnabled}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Subs-specific fields -->
            <StackPanel Margin="0,8,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rule.TriggerType}" Value="Subscriptions">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Rule.TriggerType}" Value="GiftSubscription">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Background="{DynamicResource NestedPanelBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Subscription Settings" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox Content="{loc:Translate 'Add sub time to swap'}"
                                  IsChecked="{Binding Rule.AddBitsToSwapTime, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,8" />
                        <StackPanel Visibility="{Binding Rule.AddBitsToSwapTime, Converter={StaticResource BoolToVisibilityConverter}}">
                            <UniformGrid Columns="3">
                                <StackPanel Margin="0,0,6,0">
                                    <CheckBox IsChecked="{Binding Rule.SubscriptionTier1Enabled}"
                                              Content="T1 seconds/sub"
                                              Foreground="{DynamicResource MutedBrush}"
                                              FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding Rule.SubscriptionTier1SecondsPerSub, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding Rule.SubscriptionTier1Enabled}" />
                                </StackPanel>
                                <StackPanel Margin="6,0,6,0">
                                    <CheckBox IsChecked="{Binding Rule.SubscriptionTier2Enabled}"
                                              Content="T2 seconds/sub"
                                              Foreground="{DynamicResource MutedBrush}"
                                              FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding Rule.SubscriptionTier2SecondsPerSub, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding Rule.SubscriptionTier2Enabled}" />
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <CheckBox IsChecked="{Binding Rule.SubscriptionTier3Enabled}"
                                              Content="T3 seconds/sub"
                                              Foreground="{DynamicResource MutedBrush}"
                                              FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding Rule.SubscriptionTier3SecondsPerSub, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding Rule.SubscriptionTier3Enabled}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding Rule.IsGiftSubscription}" Content="Include gift subs" Margin="0,8,0,0" />
                        <CheckBox IsChecked="{Binding Profile.SubsMaxSwapTimeEnabled}" Content="{loc:Translate 'Cap max accumulated duration'}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Avatar Change Return Behavior -->
            <Border Background="{DynamicResource NestedPanelBrush}" CornerRadius="4" Padding="10"
                    Visibility="{Binding Rule.ActionType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=AvatarChange}">
                <StackPanel>
                    <TextBlock Text="{loc:Translate 'Return Behavior'}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <RadioButton x:Name="ReturnToPreviousRadio"
                                 GroupName="AvatarReturnMode"
                                 IsChecked="{Binding Rule.ReturnToPreviousAvatar, Mode=TwoWay}"
                                 Checked="OnReturnToPreviousChecked"
                                 Content="{loc:Translate 'Return to Previous Avatar'}"
                                 Foreground="{DynamicResource TextBrush}" />
                    <RadioButton x:Name="ReturnToGlobalRadio"
                                 GroupName="AvatarReturnMode"
                                 Checked="OnReturnToGlobalChecked"
                                 Content="{loc:Translate 'Return to Global Return Avatar'}"
                                 Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Border>

            <!-- Common fields -->
            <Border Background="{DynamicResource NestedPanelBrush}" CornerRadius="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="Common" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{loc:Translate 'Active Time (seconds)'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                            <TextBox Text="{Binding Rule.DurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="8,0,0,0">
                            <TextBlock Text="{loc:Translate 'Cooldown (seconds)'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                            <TextBox Text="{Binding Rule.CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding Profile.AnySwapTimeCapEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{loc:Translate 'Maximum total time in seconds'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Profile.MaxSwapTimeSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Text="{loc:Translate 'Bot Message'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,2" />
                    <TextBox Text="{Binding Rule.BotMessageTemplate, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
