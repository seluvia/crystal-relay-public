<Window x:Class="VrcTwitchOscBridge.TwitchChatboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VrcTwitchOscBridge"
        xmlns:loc="clr-namespace:VrcTwitchOscBridge.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:VrcTwitchOscBridge.ViewModels"
        Title="{loc:Translate 'Twitch Chatbox | Crystal Relay'}"
        Icon="Assets/crystal-relay-icon.ico"
        Width="620"
        Height="760"
        MinWidth="460"
        MinHeight="360"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource BodyFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        BorderThickness="0"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <FontFamily x:Key="BodyFontFamily">Verdana</FontFamily>
        <FontFamily x:Key="HeadingFontFamily">Constantia</FontFamily>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#130B1E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#CC1C132B" />
        <SolidColorBrush x:Key="BorderBrush" Color="#4B2B78" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5EEFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#C9B8E3" />
        <SolidColorBrush x:Key="MessageTextBrush" Color="#F5EEFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#A855F7" />
        <SolidColorBrush x:Key="InputBrush" Color="#B8271A3D" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#5B3A8E" />
        <SolidColorBrush x:Key="MessageCardBrush" Color="#AA28173C" />
        <SolidColorBrush x:Key="MessageBorderBrush" Color="#5F3A93" />
        <SolidColorBrush x:Key="TimestampBrush" Color="#A892CB" />
        <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#2C1C48" />
        <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#6942A7" />
        <SolidColorBrush x:Key="SecondaryButtonTextBrush" Color="#F5EEFF" />
        <SolidColorBrush x:Key="ComboSurfaceBrush" Color="#F7F2FF" />
        <SolidColorBrush x:Key="ComboTextBrush" Color="#140C20" />
        <SolidColorBrush x:Key="ComboHighlightBrush" Color="#D8C2FF" />
        <SolidColorBrush x:Key="ComboDropButtonBrush" Color="#E9DBFF" />
        <SolidColorBrush x:Key="ComboDropButtonHoverBrush" Color="#D9C2FF" />
        <SolidColorBrush x:Key="ComboDropButtonPressedBrush" Color="#C7A8FF" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#20122F" />
        <SolidColorBrush x:Key="TitleBarTextBrush" Color="#F5EEFF" />
        <SolidColorBrush x:Key="TitleBarSubTextBrush" Color="#CBB9E5" />
        <SolidColorBrush x:Key="TitleBarButtonBrush" Color="#00000000" />
        <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#3B235B" />
        <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#543183" />
        <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#B43D62" />
        <SolidColorBrush x:Key="TitleBarClosePressedBrush" Color="#8C2648" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryButtonTextBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
        </Style>

        <Style x:Key="ChatboxSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TitleBarButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBarButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBarButtonBorder" Property="Background" Value="{DynamicResource TitleBarButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleBarButtonBorder" Property="Background" Value="{DynamicResource TitleBarButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TitleBarButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleBarCloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleBarCloseBorder" Property="Background" Value="{DynamicResource TitleBarCloseHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleBarCloseBorder" Property="Background" Value="{DynamicResource TitleBarClosePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TitleBarCloseBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboBoxEditableTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{DynamicResource ComboDropButtonBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="DropBorder"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Path HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="{DynamicResource ComboTextBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DropBorder" Property="Background" Value="{DynamicResource ComboDropButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DropBorder" Property="Background" Value="{DynamicResource ComboDropButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ComboSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="{x:Static local:ComboBoxInteraction.EnableGuardedInteractionProperty}" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Margin="12,0,8,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                                    <ToggleButton Grid.Column="1"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Style="{StaticResource ComboBoxToggleButtonStyle}" />
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   AllowsTransparency="True">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ComboSurfaceBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <ScrollViewer Margin="6"
                                                  CanContentScroll="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ComboItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ComboItemBorder" Property="Background" Value="{DynamicResource ComboHighlightBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ComboItemBorder" Property="Background" Value="{DynamicResource ComboHighlightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="ChatboxTrackButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatboxThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Width="8"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="4"
                                Opacity="0.72" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ChatboxVerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="{TemplateBinding Width}"
                  Background="Transparent">
                <Border Width="8"
                        HorizontalAlignment="Center"
                        Margin="0,2"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Opacity="0.8" />
                <Track x:Name="PART_Track"
                       Margin="0,2"
                       IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ChatboxTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageUpCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ChatboxThumbStyle}"
                               MinHeight="30" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ChatboxTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageDownCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ChatboxHorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="{TemplateBinding Height}"
                  Background="Transparent">
                <Border Height="8"
                        VerticalAlignment="Center"
                        Margin="2,0"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Opacity="0.8" />
                <Track x:Name="PART_Track"
                       Margin="2,0">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ChatboxTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageLeftCommand}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ChatboxThumbStyle}"
                               MinWidth="30" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Style="{StaticResource ChatboxTrackButtonStyle}"
                                      Command="{x:Static ScrollBar.PageRightCommand}" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style x:Key="ChatboxScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template" Value="{StaticResource ChatboxVerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template" Value="{StaticResource ChatboxHorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChatboxOptionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Border x:Name="StateChip"
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="10,4"
                                        Background="{DynamicResource ComboSurfaceBrush}"
                                        CornerRadius="10">
                                    <TextBlock x:Name="StateText"
                                               Text="{loc:Translate 'Off'}"
                                               Foreground="{DynamicResource ComboTextBrush}"
                                               FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="StateChip" Property="Background" Value="{DynamicResource ComboSurfaceBrush}" />
                                <Setter TargetName="StateText" Property="Text" Value="{loc:Translate 'On'}" />
                                <Setter TargetName="StateText" Property="Foreground" Value="{DynamicResource ComboTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>

        <DataTemplate DataType="{x:Type vm:TwitchChatMessageEntry}">
            <Border Margin="0,0,0,10"
                    Padding="12,10"
                    Background="{DynamicResource MessageCardBrush}"
                    BorderBrush="{DynamicResource MessageBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    TextElement.Foreground="{DynamicResource TextBrush}"
                    Opacity="{Binding DataContext.Settings.ChatOpacity, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right"
                                   Margin="10,0,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TimestampBrush}"
                                   Text="{Binding TimestampText}"
                                   Visibility="{Binding DataContext.Settings.ChatShowTimestamps, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding BadgeImageUrls}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,4,0"
                                                Width="18"
                                                Height="18"
                                                CornerRadius="3"
                                                BorderBrush="{DynamicResource MessageBorderBrush}"
                                                BorderThickness="1">
                                            <Image Source="{Binding}"
                                                   Stretch="UniformToFill"
                                                   SnapsToDevicePixels="True" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock FontWeight="Bold"
                                       FontFamily="{Binding DataContext.Settings.ChatFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="{Binding DataContext.Settings.ChatTextSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{Binding NameBrush}"
                                       Text="{Binding UserDisplayName}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Margin="0,6,0,0"
                               FontFamily="{Binding DataContext.Settings.ChatFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{Binding DataContext.Settings.ChatTextSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource MessageTextBrush}"
                               TextWrapping="Wrap"
                               local:ChatMessageInlinePresenter.Fragments="{Binding InlineFragments}"
                               local:ChatMessageInlinePresenter.FontScaleKey="{Binding DataContext.Settings.ChatTextSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarHost"
                Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="0"
                Padding="10,8"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel VerticalAlignment="Center">
                    <Image Source="Assets/crystal-relay-icon.png"
                           Width="18"
                           Height="18"
                           Margin="0,0,8,0" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Translate 'Twitch Chatbox'}"
                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{DynamicResource TitleBarTextBrush}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Crystal Relay"
                                   Foreground="{DynamicResource TitleBarSubTextBrush}" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="OnMinimizeButtonClick"
                            ToolTip="{loc:Translate 'Minimize'}">
                        <TextBlock Text="&#x2212;"
                                   FontSize="16"
                                   Foreground="{DynamicResource TitleBarTextBrush}" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Margin="6,0,0,0"
                            Click="OnToggleMaximizeButtonClick"
                            ToolTip="{loc:Translate 'Maximize or restore'}">
                        <TextBlock x:Name="WindowStateGlyph"
                                   Text="&#x2610;"
                                   FontSize="13"
                                   Foreground="{DynamicResource TitleBarTextBrush}" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                            Margin="6,0,0,0"
                            Click="OnCloseButtonClick"
                            ToolTip="{loc:Translate 'Close'}">
                        <TextBlock Text="&#x2715;"
                                   FontSize="13"
                                   Foreground="{DynamicResource TitleBarTextBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentHostGrid"
              Grid.Row="1"
              Margin="14">
            <Border x:Name="ChatShellBorder"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Twitch Chatbox'}"
                                       Style="{StaticResource HeadingTextStyle}"
                                       FontSize="24"
                                       FontWeight="Bold" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding ChatboxListenerStatus}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="SettingsToggleButton"
                                Width="116"
                                Height="42"
                                Margin="12,0,0,0"
                                Style="{StaticResource ChatboxSecondaryButtonStyle}"
                                Content="{loc:Translate 'Settings'}"
                                Click="OnToggleSettingsClicked" />
                    </Grid>

                    <Border x:Name="SettingsPanel"
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="14,12"
                            Visibility="Collapsed"
                            Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    Padding="12"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.ColumnSpan="2"
                                               FontWeight="Bold"
                                               Text="{loc:Translate 'Display'}" />

                                    <StackPanel Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="0,12,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{loc:Translate 'Chat Font'}" />
                                        <ComboBox ItemsSource="{Binding ChatFontOptions}"
                                                  SelectedItem="{Binding Settings.ChatFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="0,10,8,0">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{loc:Translate 'Text Size: '}" />
                                            <Run Text="{Binding Settings.ChatTextSize}" />
                                        </TextBlock>
                                        <Slider Minimum="12"
                                                Maximum="40"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.ChatTextSize, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="1"
                                                Margin="8,10,0,0">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{loc:Translate 'Card Opacity: '}" />
                                            <Run Text="{Binding Settings.ChatOpacityPercent}" />
                                            <Run Text="%" />
                                        </TextBlock>
                                        <Slider Minimum="25"
                                                Maximum="100"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.ChatOpacityPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Padding="12"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold"
                                               Text="{loc:Translate 'Behavior'}" />
                                    <ToggleButton Margin="0,12,0,0"
                                                  Content="{loc:Translate 'Show Timestamps'}"
                                                  Style="{StaticResource ChatboxOptionToggleStyle}"
                                                  IsChecked="{Binding Settings.ChatShowTimestamps, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{loc:Translate 'Timestamp Style'}" />
                                        <ComboBox Width="170"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,6,0,0"
                                                  ItemsSource="{Binding ChatTimestampFormatOptions}"
                                                  SelectedItem="{Binding SelectedChatTimestampFormatOption, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <ToggleButton x:Name="AlwaysOnTopToggleButton"
                                                  Content="{loc:Translate 'Always On Top'}"
                                                  Style="{StaticResource ChatboxOptionToggleStyle}"
                                                  IsChecked="{Binding Settings.ChatboxAlwaysOnTop, UpdateSourceTrigger=PropertyChanged}" />
                                    <ToggleButton Content="{loc:Translate 'Overlay Mode'}"
                                                  Style="{StaticResource ChatboxOptionToggleStyle}"
                                                  IsChecked="{Binding Settings.ChatboxOverlayMode, UpdateSourceTrigger=PropertyChanged}" />
                                    <ToggleButton Content="{loc:Translate 'Viewer Message Sound'}"
                                                  Style="{StaticResource ChatboxOptionToggleStyle}"
                                                  IsChecked="{Binding Settings.ChatboxViewerSoundEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,12,0,0"
                                    Padding="12"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.ColumnSpan="2"
                                               FontWeight="Bold"
                                               Text="{loc:Translate 'VRChat Chatbox'}" />

                                    <ToggleButton Grid.Row="1"
                                                  Grid.ColumnSpan="2"
                                                  Margin="0,12,0,0"
                                                  Content="{loc:Translate 'Send Chat to VRChat'}"
                                                  Style="{StaticResource ChatboxOptionToggleStyle}"
                                                  IsChecked="{Binding Settings.ChatboxOscEnabled, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="0,10,14,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{loc:Translate 'Delay Between Posts'}" />
                                        <ComboBox Width="210"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding ChatboxOscDelayOptions}"
                                                  SelectedItem="{Binding Settings.ChatboxOscDelaySeconds, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}{0} seconds}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Margin="0,10,0,0"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding ChatboxOscRelayStatusText}" />
                                    </StackPanel>

                                    <Button Grid.Row="2"
                                            Grid.Column="1"
                                            Width="118"
                                            Margin="12,34,0,0"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource ChatboxSecondaryButtonStyle}"
                                            Content="{loc:Translate 'Clear Chat'}"
                                            Click="OnClearChatClicked" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2"
                          Margin="0,14,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding ChatboxEmptyStateText}"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChatMessages.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox x:Name="ChatList"
                                 ItemsSource="{Binding ChatMessages}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ChatboxScrollBarStyle}" />
                            </ListBox.Resources>
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChatMessages.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
