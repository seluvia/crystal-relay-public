        <DataTemplate DataType="{x:Type vm:TwitchChatMessageEntry}">
            <Grid Margin="0,0,0,10"
                  Opacity="{Binding DataContext.Settings.ChatOpacity, RelativeSource={RelativeSource AncestorType=Window}}">
                <Border Style="{StaticResource ChatboxChatCardBorderStyle}"
                        Visibility="{Binding IsChatMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Border Width="4"
                                HorizontalAlignment="Left"
                                CornerRadius="4"
                                Style="{StaticResource ChatboxRoleRailStyle}" />

                        <StackPanel Style="{StaticResource ChatboxDevContentOffsetStyle}">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Margin="10,0,0,0"
                                       Style="{StaticResource ChatboxTimestampTextStyle}"
                                       Text="{Binding TimestampText}"
                                       Visibility="{Binding DataContext.Settings.ChatShowTimestamps, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <StackPanel Orientation="Horizontal">
                                <ItemsControl ItemsSource="{Binding BadgeImageUrls}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,4,0"
                                                    Width="18"
                                                    Height="18"
                                                    CornerRadius="3"
                                                    BorderBrush="{DynamicResource MessageBorderBrush}"
                                                    BorderThickness="1">
                                                <Image Source="{Binding}"
                                                       Stretch="UniformToFill"
                                                       SnapsToDevicePixels="True" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock FontWeight="Bold"
                                           FontFamily="{Binding DataContext.Settings.ChatFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="{Binding DataContext.Settings.ChatTextSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{Binding NameBrush}"
                                           Text="{Binding UserDisplayName}" />

                                <Border Margin="8,0,0,0"
                                        Padding="7,2"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource CrystalRelayDevBadgeBrush}"
                                        BorderBrush="{StaticResource CrystalRelayDevBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding IsCrystalRelayDeveloper, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Translate 'CRYSTAL RELAY DEV'}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource CrystalRelayDevBadgeTextBrush}" />
                                </Border>

                                <Border Style="{StaticResource ChatboxRoleBadgeBorderStyle}"
                                        Visibility="{Binding HasBadgeRoleCard, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding RoleCardLabel}"
                                               MaxWidth="165"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource ChatboxRoleBadgeTextBrush}" />
                                </Border>

                                <Border Style="{StaticResource ChatboxSuspiciousBadgeBorderStyle}">
                                    <TextBlock Text="{Binding SuspiciousStatusLabel}"
                                               MaxWidth="135"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="#FFF7ED" />
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource ChatboxMessageBodyTextStyle}"
                                   FontFamily="{Binding DataContext.Settings.ChatFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="{Binding DataContext.Settings.ChatTextSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   TextWrapping="Wrap"
                                   local:ChatMessageInlinePresenter.Fragments="{Binding InlineFragments}"
                                   local:ChatMessageInlinePresenter.FontScaleKey="{Binding DataContext.Settings.ChatTextSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ChatboxChannelPointCardBorderStyle}"
                        Visibility="{Binding IsChannelPointRedemption, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                CornerRadius="4"
                                Style="{StaticResource ChatboxEventRailStyle}" />

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="10,0,0,0"
                                           Style="{StaticResource ChatboxTimestampTextStyle}"
                                           Text="{Binding TimestampText}"
                                           Visibility="{Binding DataContext.Settings.ChatShowTimestamps, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <StackPanel Orientation="Horizontal">
                                    <Border HorizontalAlignment="Left"
                                            Padding="9,3"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="9">
                                        <TextBlock Text="{loc:Translate 'Channel Point Redeem'}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>

                                    <Border Margin="8,0,0,0"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource CrystalRelayDevBadgeBrush}"
                                            BorderBrush="{StaticResource CrystalRelayDevBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding IsCrystalRelayDeveloper, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{loc:Translate 'CRYSTAL RELAY DEV'}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CrystalRelayDevBadgeTextBrush}" />
                                    </Border>

                                    <Border Style="{StaticResource ChatboxRoleBadgeBorderStyle}"
                                            Visibility="{Binding HasBadgeRoleCard, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding RoleCardLabel}"
                                                   MaxWidth="165"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource ChatboxRoleBadgeTextBrush}" />
                                    </Border>

                                    <Border Style="{StaticResource ChatboxSuspiciousBadgeBorderStyle}">
                                        <TextBlock Text="{Binding SuspiciousStatusLabel}"
                                                   MaxWidth="135"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="#FFF7ED" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Margin="0,7,0,0"
                                       Style="{StaticResource ChatboxPrimaryEntryTextStyle}"
                                       FontFamily="{Binding DataContext.Settings.ChatFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="{Binding DataContext.Settings.ChatTextSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="Bold"
                                       Text="{Binding RewardTitle}"
                                       TextWrapping="Wrap" />

                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding RedemptionViewerText}"
                                           Style="{StaticResource ChatboxMutedEntryTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="10,0,0,0"
                                           Text="{Binding RedemptionCostText}"
                                           Style="{StaticResource ChatboxMutedEntryTextStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasRewardCost, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </WrapPanel>

                            <Border Margin="0,8,0,0"
                                    Padding="9,7"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Style="{StaticResource ChatboxInlinePanelStyle}"
                                    Visibility="{Binding HasRewardUserInput, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Viewer input'}"
                                               Style="{StaticResource ChatboxMutedEntryTextStyle}"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource ChatboxMessageBodyTextStyle}"
                                               Text="{Binding RewardUserInput}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ChatboxSupportCardBorderStyle}"
                        Visibility="{Binding IsSupportEvent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                CornerRadius="5"
                                Style="{StaticResource ChatboxEventRailStyle}" />

                        <StackPanel Grid.Column="1"
                                    Margin="11,0,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="10,0,0,0"
                                           Style="{StaticResource ChatboxTimestampTextStyle}"
                                           Text="{Binding TimestampText}"
                                           Visibility="{Binding DataContext.Settings.ChatShowTimestamps, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <StackPanel Orientation="Horizontal">
                                    <Border HorizontalAlignment="Left"
                                            Padding="9,3"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="9">
                                        <TextBlock Text="{Binding SupportEventLabel}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="White" />
                                    </Border>

                                    <Border Margin="8,0,0,0"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource CrystalRelayDevBadgeBrush}"
                                            BorderBrush="{StaticResource CrystalRelayDevBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding IsCrystalRelayDeveloper, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{loc:Translate 'CRYSTAL RELAY DEV'}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource CrystalRelayDevBadgeTextBrush}" />
                                    </Border>

                                    <Border Style="{StaticResource ChatboxRoleBadgeBorderStyle}"
                                            Visibility="{Binding HasBadgeRoleCard, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding RoleCardLabel}"
                                                   MaxWidth="165"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource ChatboxRoleBadgeTextBrush}" />
                                    </Border>

                                    <Border Style="{StaticResource ChatboxSuspiciousBadgeBorderStyle}">
                                        <TextBlock Text="{Binding SuspiciousStatusLabel}"
                                                   MaxWidth="135"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Foreground="#FFF7ED" />
                                    </Border>
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource ChatboxPrimaryEntryTextStyle}"
                                       FontFamily="{Binding DataContext.Settings.ChatFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="{Binding DataContext.Settings.ChatTextSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="Bold"
                                       Text="{Binding SupportHeadlineText}"
                                       TextWrapping="Wrap" />

                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding SupportDetailText}"
                                       Style="{StaticResource ChatboxMutedEntryTextStyle}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding HasSupportDetailText, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Border Margin="0,8,0,0"
                                    Padding="9,7"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Style="{StaticResource ChatboxInputInlinePanelStyle}"
                                    Visibility="{Binding HasSupportMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{loc:Translate 'Message'}"
                                               Style="{StaticResource ChatboxMutedEntryTextStyle}"
                                               FontSize="11"
                                               FontWeight="Bold" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding SupportMessage}"
                                               Style="{StaticResource ChatboxMessageBodyTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarHost"
                Grid.Row="0"
                Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,1,1,0"
                CornerRadius="0"
                Padding="10,8"
                MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <DockPanel VerticalAlignment="Center">
                    <Image Source="Assets/crystal-relay-icon.png"
                           Width="18"
                           Height="18"
                           Margin="0,0,8,0" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Translate 'Twitch Chatbox'}"
                                   FontFamily="{DynamicResource HeadingFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{DynamicResource TitleBarTextBrush}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="Crystal Relay"
                                   Foreground="{DynamicResource TitleBarSubTextBrush}" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Click="OnMinimizeButtonClick"
                            ToolTip="{loc:Translate 'Minimize'}">
                        <TextBlock Text="&#x2212;"
                                   FontSize="16"
                                   Foreground="{DynamicResource TitleBarTextBrush}" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Margin="6,0,0,0"
                            Click="OnToggleMaximizeButtonClick"
                            ToolTip="{loc:Translate 'Maximize or restore'}">
                        <TextBlock x:Name="WindowStateGlyph"
                                   Text="&#x2610;"
                                   FontSize="13"
                                   Foreground="{DynamicResource TitleBarTextBrush}" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                            Margin="6,0,0,0"
                            Click="OnCloseButtonClick"
                            ToolTip="{loc:Translate 'Close'}">
                        <TextBlock Text="&#x2715;"
                                   FontSize="13"
                                   Foreground="{DynamicResource TitleBarTextBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentHostGrid"
              Grid.Row="1"
              Margin="14">
            <Border x:Name="ChatShellBorder"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{loc:Translate 'Twitch Chatbox'}"
                                       Style="{StaticResource HeadingTextStyle}"
                                       FontSize="24"
                                       FontWeight="Bold" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding ChatboxListenerStatus}" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                x:Name="SettingsToggleButton"
                                Width="116"
                                Height="42"
                                Margin="12,0,0,0"
                                Style="{StaticResource ChatboxSecondaryButtonStyle}"
                                Content="{loc:Translate 'Settings'}"
                                Click="OnToggleSettingsClicked" />
                    </Grid>

                    <Border x:Name="SettingsPanel"
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="14,12"
                            Visibility="Collapsed"
                            Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ChatboxScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,6,0"
                                    Padding="12"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold"
                                               Text="{loc:Translate 'Display'}" />

                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{loc:Translate 'Chat Font'}" />
                                        <ComboBox ItemsSource="{Binding ChatFontOptions}"
                                                  SelectedItem="{Binding Settings.ChatFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{loc:Translate 'Text Size: '}" />
                                        </TextBlock>
                                        <TextBox x:Name="ChatTextSizeTextBox"
                                                 Width="88"
                                                 HorizontalAlignment="Left"
                                                 Style="{StaticResource ChatboxTextBoxStyle}"
                                                 Text="{Binding Settings.ChatTextSize, UpdateSourceTrigger=PropertyChanged}"
                                                 PreviewTextInput="OnChatTextSizePreviewTextInput"
                                                 PreviewKeyDown="OnChatTextSizePreviewKeyDown"
                                                 LostFocus="OnChatTextSizeLostFocus"
                                                 DataObject.Pasting="OnChatTextSizePasting" />
                                    </StackPanel>

                                    <StackPanel Margin="0,10,0,0">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       FontWeight="SemiBold"
                                                       Text="{loc:Translate 'Card Opacity: '}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Settings.ChatOpacityPercent, StringFormat={}{0}%}" />
                                        </Grid>
                                        <Slider Minimum="25"
                                                Maximum="100"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.ChatOpacityPercent, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Padding="12"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold"
                                               Text="{loc:Translate 'Behavior'}" />
                                    <StackPanel Margin="0,12,0,0">
                                        <ToggleButton Content="{loc:Translate 'Show Timestamps'}"
                                                      Style="{StaticResource ChatboxOptionToggleStyle}"
                                                      IsChecked="{Binding Settings.ChatShowTimestamps, UpdateSourceTrigger=PropertyChanged}" />
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{loc:Translate 'Timestamp Style'}" />
                                            <ComboBox Width="170"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,6,0,0"
                                                      ItemsSource="{Binding ChatTimestampFormatOptions}"
                                                      SelectedItem="{Binding SelectedChatTimestampFormatOption, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <ToggleButton x:Name="AlwaysOnTopToggleButton"
                                                  Margin="0,10,0,0"
                                                  Content="{loc:Translate 'Always On Top'}"
                                                  Style="{StaticResource ChatboxOptionToggleStyle}"
                                                  IsChecked="{Binding Settings.ChatboxAlwaysOnTop, UpdateSourceTrigger=PropertyChanged}" />
                                    <ToggleButton Margin="0,10,0,0"
                                                  Content="{loc:Translate 'Overlay Mode'}"
                                                  Style="{StaticResource ChatboxOptionToggleStyle}"
                                                  IsChecked="{Binding Settings.ChatboxOverlayMode, UpdateSourceTrigger=PropertyChanged}" />
                                    <ToggleButton Margin="0,10,0,0"
                                                  Content="{loc:Translate 'Viewer Message Sound'}"
                                                  Style="{StaticResource ChatboxOptionToggleStyle}"
                                                  IsChecked="{Binding Settings.ChatboxViewerSoundEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    Padding="12"
                                    Background="{DynamicResource PanelBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold"
                                               Text="{loc:Translate 'VRChat Chatbox'}" />

                                    <ToggleButton Margin="0,12,0,0"
                                                  Content="{loc:Translate 'Send Chat to VRChat'}"
                                                  Style="{StaticResource ChatboxOptionToggleStyle}"
                                                  IsChecked="{Binding Settings.ChatboxOscEnabled, UpdateSourceTrigger=PropertyChanged}" />

                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{loc:Translate 'Delay Between Posts'}" />
                                        <ComboBox Width="210"
                                                  HorizontalAlignment="Left"
                                                  ItemsSource="{Binding ChatboxOscDelayOptions}"
                                                  SelectedItem="{Binding Settings.ChatboxOscDelaySeconds, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}{0} seconds}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding ChatboxOscRelayStatusText}" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2"
                                  Grid.ColumnSpan="2"
                                  Margin="0,10,0,0">
                                <Button Width="118"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource ChatboxSecondaryButtonStyle}"
                                        Content="{loc:Translate 'Clear Chat'}"
                                Click="OnClearChatClicked" />
                            </Grid>
                        </Grid>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="0,14,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.ChatboxSettingsPanelOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="{Binding ChatboxEmptyStateText}"
                                   TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChatMessages.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox x:Name="ChatList"
                                 Grid.Row="0"
                                 ItemsSource="{Binding ChatMessages}"
                                 SelectedItem="{Binding SelectedChatMessage, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource ChatboxScrollBarStyle}" />
                            </ListBox.Resources>
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ChatMessages.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <StaticResource ResourceKey="ChatboxChatItemContainerStyle" />
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Grid Grid.Row="1"
                              Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0"
                                       LastChildFill="True">
                                <Button DockPanel.Dock="Left"
                                        MinWidth="132"
                                        Height="34"
                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                        Content="{Binding ChatboxModerationDrawerToggleText}"
                                        Command="{Binding ToggleChatboxModerationDrawerCommand}" />
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           MaxHeight="32"
                                           FontSize="11"
                                           LineHeight="15"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Text="{Binding ChatboxModerationScopeStatusText}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="Wrap" />
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Margin="0,8,0,0"
                                    Padding="10"
                                    MaxHeight="240"
                                    Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="{Binding IsChatboxModerationDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ScrollViewer Grid.Column="0"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ChatboxScrollBarStyle}" />
                                        </ScrollViewer.Resources>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate 'Moderation'}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding SelectedChatModerationTitle}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       MaxHeight="32"
                                                       LineHeight="15"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasSelectedChatMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding SelectedChatModerationDetailText}"
                                                       FontSize="11"
                                                       MaxHeight="32"
                                                       LineHeight="15"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasSelectedChatMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding ChatboxModerationStatusText}"
                                                       FontSize="11"
                                                       MaxHeight="32"
                                                       LineHeight="15"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap" />

                                            <TextBlock Margin="0,8,0,4"
                                                       Text="{loc:Translate 'Quick Timeouts'}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedBrush}" />
                                            <WrapPanel>
                                                <Button Width="56"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate '10s'}"
                                                        Command="{Binding TimeoutSelectedChatUser10SecondsCommand}" />
                                                <Button Width="56"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate '1m'}"
                                                        Command="{Binding TimeoutSelectedChatUser1MinuteCommand}" />
                                                <Button Width="56"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate '5m'}"
                                                        Command="{Binding TimeoutSelectedChatUser5MinutesCommand}" />
                                                <Button Width="56"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate '10m'}"
                                                        Command="{Binding TimeoutSelectedChatUser10MinutesCommand}" />
                                                <Button Width="56"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate '30m'}"
                                                        Command="{Binding TimeoutSelectedChatUser30MinutesCommand}" />
                                                <Button Width="56"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate '1h'}"
                                                        Command="{Binding TimeoutSelectedChatUser1HourCommand}" />
                                            </WrapPanel>

                                            <WrapPanel Margin="0,3,0,0">
                                                <Button Width="112"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate 'Ban'}"
                                                        Command="{Binding BanSelectedChatUserCommand}" />
                                                <Button Width="112"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate 'Purge User'}"
                                                        Command="{Binding PurgeSelectedChatUserCommand}" />
                                                <Button Width="112"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate 'Delete Message'}"
                                                        Command="{Binding DeleteSelectedChatMessageCommand}" />
                                                <Button Width="112"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate 'Mark Suspicious'}"
                                                        Command="{Binding MarkSelectedChatUserSuspiciousCommand}" />
                                                <Button Width="112"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate 'Restrict'}"
                                                        Command="{Binding RestrictSelectedChatUserCommand}" />
                                                <Button Width="112"
                                                        Margin="0,0,5,5"
                                                        Style="{StaticResource ChatboxDrawerButtonStyle}"
                                                        Content="{loc:Translate 'Clear Mark'}"
                                                        Command="{Binding ClearSelectedChatUserSuspiciousStatusCommand}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border Grid.Column="1"
                                            Width="1"
                                            Margin="4,0"
                                            Background="{DynamicResource MessageBorderBrush}" />

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0"
                                                   LastChildFill="True">
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{loc:Translate 'Activity Feed'}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                        </DockPanel>

                                        <Grid Grid.Row="1"
                                              Margin="0,6,0,0">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Text="{loc:Translate 'No activity yet.'}"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ChatActivityEntries.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <ListBox ItemsSource="{Binding ChatActivityEntries}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.Resources>
                                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ChatboxScrollBarStyle}" />
                                                </ListBox.Resources>
                                                <ListBox.Style>
                                                    <Style TargetType="ListBox">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ChatActivityEntries.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ListBox.Style>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChatboxChatItemContainerStyle}">
                                                        <Setter Property="Cursor" Value="Arrow" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:TwitchChatActivityEntry}">
                                                        <Grid Margin="0,0,0,5">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Width="44"
                                                                       Text="{Binding TimestampText}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource TimestampBrush}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Width="58"
                                                                       Margin="4,0,4,0"
                                                                       Text="{Binding KindLabel}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding MessageText}"
                                                                       FontSize="11"
                                                                       MaxHeight="34"
                                                                       LineHeight="15"
                                                                       Foreground="{DynamicResource MutedBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
