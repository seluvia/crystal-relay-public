<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CrystalRelayUpdater</AssemblyName>
    <RootNamespace>CrystalRelayUpdater</RootNamespace>
    <Version>3.2.0</Version>
    <AssemblyVersion>3.2.0.0</AssemblyVersion>
    <FileVersion>3.2.0.0</FileVersion>
    <InformationalVersion>3.2.0</InformationalVersion>
    <Product>Crystal Relay Updater</Product>
    <Title>Crystal Relay Updater</Title>
    <Description>Dedicated updater helper for Crystal Relay</Description>
    <Authors>ScreminPal</Authors>
    <Company>ScreminPal</Company>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\VrcTwitchOscBridge\Services\ApplicationUpdatePackageRules.cs"
             Link="ApplicationUpdatePackageRules.cs" />
    <Compile Include="..\VrcTwitchOscBridge\Services\ApplicationUpdateRollback.cs"
             Link="ApplicationUpdateRollback.cs" />
  </ItemGroup>
</Project>
